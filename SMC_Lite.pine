//@version=6
// ─────────────────────────────────────────────────────────
// SMC Lite · Institutional Core v1.3 | Autor: SMC Project
// TF óptimo: 1m–15m (intradía) · Activo: MES / MNQ / FX / índices
// ─────────────────────────────────────────────────────────
// FILOSOFÍA (edge institucional destilado, no feature-creep):
//   El dinero inteligente hace UNA cosa repetible y rentable:
//     1) Define un SESGO en timeframe alto (HTF draw on liquidity)
//     2) Va a barrer LIQUIDEZ en LTF (stop-hunt sobre highs/lows iguales)
//     3) Rompe estructura a favor del HTF (BOS / CHoCH)
//     4) Entra desde un POI (Order Block / FVG) en la zona correcta
//        de Premium/Discount, durante una Kill Zone.
//   Regla madre (fuentes ICT/SMC): "opera la barrida de LTF en la
//   dirección del draw del HTF". Todo lo demás es ruido.
//   Sobre esos fundamentos añade la metodología Oliver Velez como CAPA DE
//   CONFIRMACIÓN: una vela Velez (Elephant/180/RBI/VBS) que valida el
//   retesteo de un Order Block es el gatillo de mayor calidad (tier OB✓),
//   y su fusión con un sweep en la misma vela es la señal STAMPEDE.
//   Todo con scoring de confluencia y gestión de riesgo automática.
// ─────────────────────────────────────────────────────────
indicator("SMC Lite · Institutional Core", shorttitle="SMC Lite", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// ██ TYPES
// ══════════════════════════════════════════════════════════════════════════════
type OrderBlock
    box   id
    float top
    float bottom
    bool  isBull
    bool  mitigated
    int   createdAt
    bool  confirmed     // ✓ una vela Velez validó la reacción en el OB
    int   confirmBar

type FVG
    box   id
    float top
    float bottom
    bool  isBull
    int   createdAt

// ══════════════════════════════════════════════════════════════════════════════
// ██ INPUTS
// ══════════════════════════════════════════════════════════════════════════════
grpBias   = "═══ 🧭 SESGO HTF (Draw on Liquidity) ═══"
htfTF     = input.timeframe("60", "Higher Timeframe", group=grpBias, tooltip="TF que define el sesgo direccional. Intradía: 60/240. Se opera SOLO a favor de este sesgo salvo que desactives el filtro.")
useHtfBias= input.bool(true, "Filtrar señales por sesgo HTF", group=grpBias, tooltip="Núcleo del método: solo longs si HTF alcista, solo shorts si HTF bajista.")

grpStr    = "═══ 🏦 ESTRUCTURA (BOS / CHoCH) ═══"
swingLen  = input.int(5, "Swing Length", minval=2, maxval=20, group=grpStr, tooltip="Barras a cada lado para confirmar un swing. Sin repaint.")
atrMult   = input.float(0.7, "Displacement (×ATR)", minval=0.2, step=0.1, group=grpStr, tooltip="Un rompimiento estructural exige desplazamiento real, no un roce.")
showStr   = input.bool(true, "Mostrar BOS / CHoCH", group=grpStr)

grpLiq    = "═══ 💧 LIQUIDEZ & POI ═══"
eqLookback= input.int(20, "Lookback Highs/Lows Iguales", minval=5, maxval=60, group=grpLiq)
eqTol     = input.float(0.10, "Tolerancia EQH/EQL (×ATR)", minval=0.02, step=0.02, group=grpLiq)
showLiq   = input.bool(true, "Mostrar pools EQH/EQL", group=grpLiq)
showOB    = input.bool(true, "Mostrar Order Blocks", group=grpLiq)
maxOBs    = input.int(4, "Máx Order Blocks activos", minval=1, maxval=10, group=grpLiq)
obMaxAge  = input.int(60, "OB Max Age (barras)", minval=15, maxval=300, group=grpLiq)
showFVG   = input.bool(true, "Mostrar FVG", group=grpLiq)
fvgMinAtr = input.float(0.4, "FVG mínimo (×ATR)", minval=0.1, step=0.1, group=grpLiq)
maxFVGs   = input.int(4, "Máx FVG activos", minval=1, maxval=10, group=grpLiq)

grpZone   = "═══ ⚖️ PREMIUM / DISCOUNT ═══"
showPD    = input.bool(true, "Mostrar equilibrio (50%)", group=grpZone)
pdLookback= input.int(50, "Rango de referencia (barras)", minval=20, maxval=200, group=grpZone)

grpKZ     = "═══ ⏰ KILL ZONES (NY time) ═══"
useKZ     = input.bool(true, "Exigir Kill Zone para señal", group=grpKZ, tooltip="Las ineficiencias institucionales se crean en London/NY. Fuera de KZ = baja probabilidad.")
lnStart   = input.int(2, "London Start", minval=0, maxval=23, group=grpKZ)
lnEnd     = input.int(5, "London End", minval=0, maxval=23, group=grpKZ)
nyStart   = input.int(8, "NY Start", minval=0, maxval=23, group=grpKZ)
nyEnd     = input.int(11, "NY End", minval=0, maxval=23, group=grpKZ)
showKZ    = input.bool(true, "Sombrear Kill Zones", group=grpKZ)

grpSig    = "═══ 🎯 SEÑALES & RIESGO ═══"
minScore  = input.float(7.0, "Score mínimo para señal", minval=3.0, maxval=12.0, step=0.5, group=grpSig, tooltip="Confluencia mínima. 7 = alta fiabilidad. Sube a 8-9 para menos señales pero más limpias.")
requireSweep = input.bool(true, "Exigir barrida de liquidez (trigger)", group=grpSig, tooltip="El gatillo institucional real: no hay entrada sin stop-hunt previo.")
requireZone  = input.bool(true, "Exigir Discount(long)/Premium(short)", group=grpSig)
riskReward   = input.float(2.5, "Risk:Reward (TP2)", minval=1.0, step=0.5, group=grpSig)
cooldownBars = input.int(5, "Barras mínimas entre señales", minval=1, maxval=30, group=grpSig)
showSLTP     = input.bool(true, "Dibujar SL / TP", group=grpSig)
accountBal   = input.float(10000.0, "Balance de cuenta ($)", minval=100.0, group=grpSig)
riskPct      = input.float(1.0, "Riesgo por trade (%)", minval=0.1, maxval=10.0, step=0.1, group=grpSig)

grpVelez  = "═══ 🐘 OLIVER VELEZ ═══"
useVelez        = input.bool(true, "Usar patrones Velez como confluencia", group=grpVelez, tooltip="Suma peso al score cuando aparece 180 Reversal, Elephant Bar, RBI/GBI o VBS/VSS a favor del trade.")
showVelez       = input.bool(true, "Mostrar etiquetas Velez", group=grpVelez)
velezWeight     = input.float(1.5, "Peso confluencia Velez", minval=0.0, maxval=5.0, step=0.5, group=grpVelez)
showVelezSMA    = input.bool(true, "Mostrar SMA 20 (línea Velez)", group=grpVelez)
eleBodyPct      = input.int(75, "Elephant Min Body %", minval=50, maxval=95, group=grpVelez)
eleAtrMult      = input.float(1.3, "Elephant Size (×ATR)", minval=0.5, step=0.1, group=grpVelez)
eleVolMult      = input.float(1.2, "Elephant Volume (×Avg)", minval=0.5, step=0.1, group=grpVelez)
eleRequireClear = input.bool(true, "Elephant limpia 3 velas opuestas", group=grpVelez, tooltip="Metodología Velez: el 'institutional footprint' real (~87% follow-through) exige que la vela limpie el rango de 3+ velas previas del color opuesto, no solo tamaño/volumen.")
useExhaustPenalty = input.bool(true, "Regla 3-5-8: penalizar sobreextensión", group=grpVelez, tooltip="Resta score al comprar/vender dentro de la 5ª (aviso) u 8ª (agotamiento) vela consecutiva del mismo color — no se persigue un movimiento exhausto.")

grpConf   = "═══ ✅ VELEZ CONFIRMA SMC (Reingeniería) ═══"
useOBConfirm    = input.bool(true, "Velez confirma Order Blocks", group=grpConf, tooltip="Núcleo de la reingeniería: un OB se vuelve accionable SOLO cuando el precio lo toca y una vela Velez valida la reacción ahí. El OB confirmado se marca con borde y '✓ VELEZ'.")
requireOBConfirm= input.bool(false, "Exigir OB confirmado para entrar (mecánico)", group=grpConf, tooltip="ON = las señales largas/cortas solo se disparan sobre un OB confirmado por Velez (o STAMPEDE). Operativa 100% mecánica de POI + confirmación, sin entradas por score suelto.")
obConfColor     = input.color(#FFD700, "Color OB Confirmado", group=grpConf)
showConfMark    = input.bool(true, "Marcar la vela de confirmación (✅)", group=grpConf)

grpStamp  = "═══ ⭐ SEÑAL NOVEL · STAMPEDE ═══"
useStampede = input.bool(true, "Activar señal STAMPEDE (Velez × SMC)", group=grpStamp, tooltip="Fusión propietaria: barrida de liquidez con reclaim (SMC) que ADEMÁS es una Elephant Bar (Velez) en la misma vela, en zona correcta y Kill Zone. La institución caza stops Y deja huella visible al mismo tiempo — el setup de mayor convicción del script. Ignora el score mínimo por ser inherentemente de alta confluencia.")
stampColor  = input.color(#FFD700, "STAMPEDE Color", group=grpStamp)

grpVis    = "═══ 🎨 VISUAL & DASHBOARD ═══"
showEMAs  = input.bool(true, "Mostrar EMAs (9/21)", group=grpVis)
showDash  = input.bool(true, "Mostrar Dashboard", group=grpVis)

// ══════════════════════════════════════════════════════════════════════════════
// ██ CORE CALCS
// ══════════════════════════════════════════════════════════════════════════════
atr      = ta.atr(14)
avgVol   = ta.sma(volume, 20)
ema9     = ta.ema(close, 9)
ema21    = ta.ema(close, 21)
ema8     = ta.ema(close, 8)    // "lightning line" de Velez
sma20    = ta.sma(close, 20)   // línea lenta de Velez (VBS/VSS)
hasVol   = volume > avgVol * 1.2
displace = (high - low) > atr * atrMult   // vela con desplazamiento real

// ── Anatomía de vela (base para patrones Velez) ──
isBullC  = close > open
isBearC  = close < open
bodySize = math.abs(close - open)
rng      = high - low

// ── HTF Bias (draw on liquidity direccional) — sesgo HTF CONFIRMADO, sin repaint ──
// Patrón no-repaint canónico de TradingView: se pide el valor de la barra HTF ya
// CERRADA con f_htfTrend()[1] + lookahead_on. El [1] toma el dato histórico (la vela
// HTF anterior, ya confirmada) y lookahead_on solo alinea ese valor pasado — no filtra
// futuro. El sesgo deja de reevaluarse dentro de la vela HTF en formación (más lag,
// cero repaint), a diferencia del valor en vivo anterior.
f_htfTrend() =>
    e9  = ta.ema(close, 9)
    e21 = ta.ema(close, 21)
    close > e9 and e9 > e21 ? 1 : close < e9 and e9 < e21 ? -1 : 0
htfBias = request.security(syminfo.tickerid, htfTF, f_htfTrend()[1], lookahead=barmerge.lookahead_on)

// ── Sesión / Kill Zones ──
nyHour   = hour(time, "America/New_York")
inLondon = nyHour >= lnStart and nyHour < lnEnd
inNY     = nyHour >= nyStart and nyHour < nyEnd
inKZ     = inLondon or inNY

// ── Premium / Discount (dealing range) ──
rngHi    = ta.highest(high, pdLookback)
rngLo    = ta.lowest(low, pdLookback)
eqm      = (rngHi + rngLo) / 2.0
inDiscount = close < eqm
inPremium  = close > eqm

// ══════════════════════════════════════════════════════════════════════════════
// ██ MARKET STRUCTURE (BOS / CHoCH) — sin repaint
// ══════════════════════════════════════════════════════════════════════════════
isSwingHigh = high[swingLen] == ta.highest(high, swingLen * 2 + 1)
isSwingLow  = low[swingLen]  == ta.lowest(low,  swingLen * 2 + 1)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   structTrend   = 0     // 1 = alcista, -1 = bajista
var int   lastBosBar    = -999

if isSwingHigh
    lastSwingHigh := high[swingLen]
if isSwingLow
    lastSwingLow := low[swingLen]

bool bosBull = false
bool bosBear = false
bool chochBull = false
bool chochBear = false

// Rompimiento estructural confirmado (barra cerrada + desplazamiento)
if barstate.isconfirmed and (bar_index - lastBosBar) > swingLen
    if not na(lastSwingHigh) and close > lastSwingHigh and displace
        if structTrend <= 0
            chochBull := true
        else
            bosBull := true
        structTrend := 1
        lastBosBar := bar_index
        lastSwingHigh := na
    else if not na(lastSwingLow) and close < lastSwingLow and displace
        if structTrend >= 0
            chochBear := true
        else
            bosBear := true
        structTrend := -1
        lastBosBar := bar_index
        lastSwingLow := na

// ══════════════════════════════════════════════════════════════════════════════
// ██ LIQUIDEZ: pools EQH/EQL + barrida (sweep / stop-hunt)
// ══════════════════════════════════════════════════════════════════════════════
var float eqhLevel = na
var float eqlLevel = na
var int   eqhBar   = na
var int   eqlBar   = na

// [FIX] offset swingLen+1: el pool previo debe EXCLUIR la vela del swing que se evalúa.
// Con [1] la ventana incluía el propio swing, así que recentHigh solía ser el swing mismo
// (diff 0) y detectaba EQH/EQL espurios en casi todo swing — contaminando sweep y STAMPEDE.
recentHigh = ta.highest(high, eqLookback)[swingLen + 1]
recentLow  = ta.lowest(low, eqLookback)[swingLen + 1]

// Equal Highs: swing high que iguala (dentro de tolerancia) el máximo previo
if isSwingHigh and not na(recentHigh) and math.abs(high[swingLen] - recentHigh) <= atr * eqTol
    eqhLevel := math.max(high[swingLen], recentHigh)
    eqhBar := bar_index
if isSwingLow and not na(recentLow) and math.abs(low[swingLen] - recentLow) <= atr * eqTol
    eqlLevel := math.min(low[swingLen], recentLow)
    eqlBar := bar_index

eqhAlive = not na(eqhLevel) and (bar_index - eqhBar) < eqLookback * 3
eqlAlive = not na(eqlLevel) and (bar_index - eqlBar) < eqLookback * 3

// SWEEP = perforar el pool y CERRAR de vuelta (reclaim) => trampa de liquidez
sweepBull = eqlAlive and low < eqlLevel and close > eqlLevel and barstate.isconfirmed
sweepBear = eqhAlive and high > eqhLevel and close < eqhLevel and barstate.isconfirmed
if sweepBull
    eqlLevel := na
if sweepBear
    eqhLevel := na

// ══════════════════════════════════════════════════════════════════════════════
// ██ PATRONES OLIVER VELEZ (se calculan ANTES de los OB para poder confirmarlos)
// ══════════════════════════════════════════════════════════════════════════════
var int consGreen = 0
var int consRed   = 0
consGreen := isBullC ? consGreen + 1 : 0
consRed   := isBearC ? consRed + 1 : 0

// Elephant Bar: cuerpo dominante + tamaño + volumen + LIMPIA 3 velas opuestas
bodyPctV  = rng > 0 ? bodySize / rng * 100 : 0.0
isBigBull = isBullC and bodyPctV >= eleBodyPct and bodySize >= atr * eleAtrMult
isBigBear = isBearC and bodyPctV >= eleBodyPct and bodySize >= atr * eleAtrMult
eleHi3    = ta.highest(high[1], 3)
eleLo3    = ta.lowest(low[1], 3)
eleClearsBull = not eleRequireClear or (isBearC[1] and isBearC[2] and isBearC[3] and close > eleHi3)
eleClearsBear = not eleRequireClear or (isBullC[1] and isBullC[2] and isBullC[3] and close < eleLo3)
elephantUp = isBigBull and close > ema8 and volume > avgVol * eleVolMult and eleClearsBull
elephantDn = isBigBear and close < ema8 and volume > avgVol * eleVolMult and eleClearsBear

// 180 Reversal
prevRed   = close[1] < open[1]
prevGreen = close[1] > open[1]
bull180 = prevRed   and isBullC and close > high[1] and open <= close[1] and bodySize > atr * 0.5
bear180 = prevGreen and isBearC and close < low[1]  and open >= close[1] and bodySize > atr * 0.5

// RBI / GBI (continuación tras vela pequeña opuesta)
smallRed   = isBearC[1] and math.abs(close[1] - open[1]) < atr * 0.5
smallGreen = isBullC[1] and math.abs(close[1] - open[1]) < atr * 0.5
rbiSignal = smallRed   and isBullC and close > high[1] and structTrend == 1  and volume > avgVol * 0.8
gbiSignal = smallGreen and isBearC and close < low[1]  and structTrend == -1 and volume > avgVol * 0.8

// VBS / VSS (pullback de 3+ velas hacia la SMA20 y giro)
vbsSignal = nz(consRed[1])   >= 3 and isBullC and close > high[1] and low  <= sma20 + atr * 0.3 and structTrend == 1
vssSignal = nz(consGreen[1]) >= 3 and isBearC and close < low[1]  and high >= sma20 - atr * 0.3 and structTrend == -1

// Regla 3-5-8: agotamiento
exhaust5Bull = consGreen == 5
exhaust8Bull = consGreen == 8
exhaust5Bear = consRed == 5
exhaust8Bear = consRed == 8

// Vela de CONFIRMACIÓN Velez (raw, sin gate) — el gatillo que valida un POI
velezConfBull = elephantUp or bull180 or rbiSignal or vbsSignal
velezConfBear = elephantDn or bear180 or gbiSignal or vssSignal

// Confluencia Velez para el score (respeta el toggle useVelez)
velezBull = useVelez and velezConfBull
velezBear = useVelez and velezConfBear

// ══════════════════════════════════════════════════════════════════════════════
// ██ ORDER BLOCKS (última vela opuesta antes del rompimiento con desplazamiento)
// ██ REINGENIERÍA: un OB se CONFIRMA cuando el precio lo toca y una vela Velez
// ██ valida la reacción ahí. Ese es el gatillo de entrada de mayor calidad.
// ══════════════════════════════════════════════════════════════════════════════
var array<OrderBlock> obs = array.new<OrderBlock>()

f_lastOpposite(bool bull, int maxBack) =>
    int idx = 1
    for k = 1 to maxBack
        bool opp = bull ? close[k] < open[k] : close[k] > open[k]
        if opp
            idx := k
            break
    idx

// El OB SIEMPRE se registra (alimenta la confluencia); showOB solo controla su visibilidad.
f_addOB(bool bull) =>
    int k = f_lastOpposite(bull, 10)
    float t = high[k]
    float b = low[k]
    color c  = showOB ? color.new(bull ? #00E676 : #FF5252, 80) : na
    color bc = showOB ? color.new(bull ? #00E676 : #FF5252, 40) : na
    box bx = box.new(bar_index - k, t, bar_index + 5, b, border_color=bc, bgcolor=c,
         text=showOB ? (bull ? "Bull OB" : "Bear OB") : "", text_size=size.tiny,
         text_color=showOB ? color.new(bull ? #00E676 : #FF5252, 0) : na)
    OrderBlock ob = OrderBlock.new(bx, t, b, bull, false, bar_index, false, na)
    array.push(obs, ob)
    if array.size(obs) > maxOBs
        OrderBlock old = array.shift(obs)
        box.delete(old.id)

if bosBull or chochBull
    f_addOB(true)
if bosBear or chochBear
    f_addOB(false)

// Mitigación + expiry + CONFIRMACIÓN VELEZ (solo en barra cerrada, sin repaint)
bool obConfirmBull = false
bool obConfirmBear = false
float cobTop    = na
float cobBottom = na
if barstate.isconfirmed and array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        OrderBlock ob = array.get(obs, i)
        bool mit = ob.isBull ? close < ob.bottom : close > ob.top
        bool old = (bar_index - ob.createdAt) > obMaxAge
        if mit or old
            box.delete(ob.id)
            array.remove(obs, i)
        else
            // ¿el precio está tocando el OB en esta vela?
            bool tapping = low <= ob.top and high >= ob.bottom
            // Confirmación: RETESTEO (OB de vela anterior) + vela Velez a favor (una sola vez por OB).
            // El guard bar_index > createdAt evita que la propia vela de ruptura auto-confirme el OB.
            if useOBConfirm and not ob.confirmed and tapping and bar_index > ob.createdAt
                if ob.isBull and velezConfBull and close > open
                    ob.confirmed := true
                    ob.confirmBar := bar_index
                    box.set_border_color(ob.id, obConfColor)
                    box.set_border_width(ob.id, 3)
                    box.set_text(ob.id, "✓ VELEZ")
                    obConfirmBull := true
                    cobTop := ob.top
                    cobBottom := ob.bottom
                else if not ob.isBull and velezConfBear and close < open
                    ob.confirmed := true
                    ob.confirmBar := bar_index
                    box.set_border_color(ob.id, obConfColor)
                    box.set_border_width(ob.id, 3)
                    box.set_text(ob.id, "✓ VELEZ")
                    obConfirmBear := true
                    cobTop := ob.top
                    cobBottom := ob.bottom
            box.set_right(ob.id, bar_index + 5)

// ¿Precio dentro/tocando un OB válido en la dirección correcta?
f_inOB(bool bull) =>
    bool res = false
    if array.size(obs) > 0
        for i = 0 to array.size(obs) - 1
            OrderBlock ob = array.get(obs, i)
            if ob.isBull == bull and low <= ob.top and high >= ob.bottom
                res := true
    res
atBullOB = f_inOB(true)
atBearOB = f_inOB(false)

// ══════════════════════════════════════════════════════════════════════════════
// ██ FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════
var array<FVG> fvgs = array.new<FVG>()

bullFVG = low > high[2] and (low - high[2]) > atr * fvgMinAtr
bearFVG = high < low[2] and (low[2] - high) > atr * fvgMinAtr

// El FVG siempre se registra (alimenta la confluencia); showFVG solo controla su visibilidad.
if barstate.isconfirmed and (bullFVG or bearFVG)
    float t = bullFVG ? low : low[2]
    float b = bullFVG ? high[2] : high
    color c = showFVG ? color.new(bullFVG ? #26A69A : #EF5350, 70) : na
    box bx = box.new(bar_index - 2, t, bar_index + 3, b, border_color=showFVG ? color.new(bullFVG ? #26A69A : #EF5350, 50) : na, bgcolor=c)
    array.push(fvgs, FVG.new(bx, t, b, bullFVG, bar_index))
    if array.size(fvgs) > maxFVGs
        FVG old = array.shift(fvgs)
        box.delete(old.id)

f_inFVG(bool bull) =>
    bool res = false
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            FVG f = array.get(fvgs, i)
            if f.isBull == bull and low <= f.top and high >= f.bottom
                res := true
    res
atBullFVG = f_inFVG(true)
atBearFVG = f_inFVG(false)

// ══════════════════════════════════════════════════════════════════════════════
// ██ SCORING DE CONFLUENCIA
// ══════════════════════════════════════════════════════════════════════════════
f_scoreLong() =>
    float s = 0.0
    s += (useHtfBias and htfBias == 1) ? 2.0 : (not useHtfBias and htfBias == 1) ? 1.0 : 0.0
    s += structTrend == 1 ? 1.5 : 0.0
    s += sweepBull ? 2.0 : 0.0
    s += obConfirmBull ? 3.5 : atBullOB ? 1.5 : 0.0   // OB confirmado por Velez pesa mucho más que un toque pasivo
    s += atBullFVG ? 1.0 : 0.0
    s += inDiscount ? 1.5 : 0.0
    s += inKZ ? 1.0 : 0.0
    s += (hasVol and displace) ? 1.0 : 0.0
    s += velezBull ? velezWeight : 0.0
    s -= (useExhaustPenalty and exhaust8Bull) ? 2.0 : (useExhaustPenalty and exhaust5Bull) ? 1.0 : 0.0
    s

f_scoreShort() =>
    float s = 0.0
    s += (useHtfBias and htfBias == -1) ? 2.0 : (not useHtfBias and htfBias == -1) ? 1.0 : 0.0
    s += structTrend == -1 ? 1.5 : 0.0
    s += sweepBear ? 2.0 : 0.0
    s += obConfirmBear ? 3.5 : atBearOB ? 1.5 : 0.0   // OB confirmado por Velez pesa mucho más que un toque pasivo
    s += atBearFVG ? 1.0 : 0.0
    s += inPremium ? 1.5 : 0.0
    s += inKZ ? 1.0 : 0.0
    s += (hasVol and displace) ? 1.0 : 0.0
    s += velezBear ? velezWeight : 0.0
    s -= (useExhaustPenalty and exhaust8Bear) ? 2.0 : (useExhaustPenalty and exhaust5Bear) ? 1.0 : 0.0
    s

scoreLong  = f_scoreLong()
scoreShort = f_scoreShort()

// ── Filtros duros (gates) ──
gateLong  = (not useHtfBias or htfBias == 1) and (not requireSweep or sweepBull) and (not requireZone or inDiscount) and (not useKZ or inKZ)
gateShort = (not useHtfBias or htfBias == -1) and (not requireSweep or sweepBear) and (not requireZone or inPremium) and (not useKZ or inKZ)

var int lastSignalBar = -999
cooldownOK = (bar_index - lastSignalBar) >= cooldownBars

longSignal  = gateLong  and scoreLong  >= minScore and cooldownOK and barstate.isconfirmed and scoreLong >= scoreShort and (not requireOBConfirm or obConfirmBull)
shortSignal = gateShort and scoreShort >= minScore and cooldownOK and barstate.isconfirmed and scoreShort >  scoreLong and (not requireOBConfirm or obConfirmBear)

// ── 🎯 SEÑAL: OB CONFIRMADO POR VELEZ (tier de la reingeniería) ────────────────
// El precio tocó un Order Block y una vela Velez validó la reacción ahí. Setup
// completo por sí mismo (POI + confirmación), así que ignora minScore pero conserva
// sesgo HTF / zona / KZ. Es el gatillo mecánico central del indicador.
cobBull = useOBConfirm and obConfirmBull and cooldownOK and barstate.isconfirmed and (not useHtfBias or htfBias == 1)  and (not requireZone or inDiscount) and (not useKZ or inKZ)
cobBear = useOBConfirm and obConfirmBear and cooldownOK and barstate.isconfirmed and (not useHtfBias or htfBias == -1) and (not requireZone or inPremium)  and (not useKZ or inKZ)

// ── ⭐ SEÑAL NOVEL: STAMPEDE (Velez × SMC) ──────────────────────────────────────
// Barrida de liquidez CON reclaim (SMC) que en la MISMA vela es una Elephant Bar
// (Velez) — la institución caza stops y estampa su huella a la vez. Ignora minScore
// por ser inherentemente de máxima confluencia, pero conserva sesgo HTF / zona / KZ.
stampedeBull = useStampede and sweepBull and elephantUp and cooldownOK and barstate.isconfirmed and (not useHtfBias or htfBias == 1)  and (not requireZone or inDiscount) and (not useKZ or inKZ)
stampedeBear = useStampede and sweepBear and elephantDn and cooldownOK and barstate.isconfirmed and (not useHtfBias or htfBias == -1) and (not requireZone or inPremium)  and (not useKZ or inKZ)

// Señales finales: prioridad STAMPEDE > OB✓ > score. Candado direccional (long gana empates)
finalLong  = stampedeBull or cobBull or longSignal
finalShort = (stampedeBear or cobBear or shortSignal) and not finalLong

// ══════════════════════════════════════════════════════════════════════════════
// ██ GESTIÓN DE RIESGO (SL/TP + sizing) — Draw on Liquidity como objetivo
// ══════════════════════════════════════════════════════════════════════════════
f_contracts(entry, sl) =>
    float dist = math.abs(entry - sl)
    float rv = accountBal * (riskPct / 100.0)
    dist > 0 ? math.max(1, math.round(rv / (dist * syminfo.pointvalue))) : 1

f_drawTrade(bool isBuy, float entry, float sl) =>
    float _sl = sl
    float rk = math.max(isBuy ? entry - _sl : _sl - entry, atr * 0.2)
    // [FIX] tope de riesgo: un SL > 3.5×ATR volvía el TP2 (R-múltiplo) irreal y colapsaba el sizing.
    // Se recorta el stop a 2×ATR para que TP, contratos y payload queden coherentes.
    if rk > atr * 3.5
        _sl := isBuy ? entry - atr * 2.0 : entry + atr * 2.0
        rk := atr * 2.0
    float tp1 = isBuy ? entry + rk : entry - rk
    float tp2 = isBuy ? entry + rk * riskReward : entry - rk * riskReward
    int contracts = f_contracts(entry, _sl)
    if showSLTP
        line.new(bar_index, _sl, bar_index + 10, _sl, color=color.new(#FF5252, 10), style=line.style_dashed, width=2)
        line.new(bar_index, tp1, bar_index + 10, tp1, color=color.new(#FFB300, 30), style=line.style_dotted, width=1)
        line.new(bar_index, tp2, bar_index + 10, tp2, color=color.new(#00E676, 10), width=2)
    [_sl, tp1, tp2, contracts]

var string lastDir = ""
var float  lastEntry = na
var float  lastSL = na
var float  lastTP1 = na
var float  lastTP2 = na
var int    lastQty = 0

if finalLong
    float sl = (cobBull and not na(cobBottom)) ? cobBottom - atr * 0.2 : math.min(low, low[1]) - atr * 0.2
    [eSl, tp1, tp2, qty] = f_drawTrade(true, close, sl)
    bool  hot = stampedeBull or cobBull
    string txt = stampedeBull ? "⭐🐘 STAMPEDE LONG" : cobBull ? "🎯 OB✓ LONG" : "▲ LONG " + str.tostring(scoreLong, "#.#")
    label.new(bar_index, low, txt, yloc=yloc.belowbar,
         color=stampedeBull ? stampColor : cobBull ? obConfColor : #00E676,
         textcolor=hot ? color.black : color.white,
         style=label.style_label_up, size=hot ? size.normal : size.small)
    lastSignalBar := bar_index
    lastDir := stampedeBull ? "STAMPEDE-L" : cobBull ? "OB✓-L" : "LONG"
    lastEntry := close
    lastSL := eSl
    lastTP1 := tp1
    lastTP2 := tp2
    lastQty := qty

if finalShort
    float sl = (cobBear and not na(cobTop)) ? cobTop + atr * 0.2 : math.max(high, high[1]) + atr * 0.2
    [eSl, tp1, tp2, qty] = f_drawTrade(false, close, sl)
    bool  hot = stampedeBear or cobBear
    string txt = stampedeBear ? "⭐🐘 STAMPEDE SHORT" : cobBear ? "🎯 OB✓ SHORT" : "▼ SHORT " + str.tostring(scoreShort, "#.#")
    label.new(bar_index, high, txt, yloc=yloc.abovebar,
         color=stampedeBear ? stampColor : cobBear ? obConfColor : #FF5252,
         textcolor=hot ? color.black : color.white,
         style=label.style_label_down, size=hot ? size.normal : size.small)
    lastSignalBar := bar_index
    lastDir := stampedeBear ? "STAMPEDE-S" : cobBear ? "OB✓-S" : "SHORT"
    lastEntry := close
    lastSL := eSl
    lastTP1 := tp1
    lastTP2 := tp2
    lastQty := qty

// ══════════════════════════════════════════════════════════════════════════════
// ██ VISUALIZACIÓN
// ══════════════════════════════════════════════════════════════════════════════
plot(showEMAs ? ema9 : na, "EMA 9", color=color.new(#2196F3, 0), linewidth=1)
plot(showEMAs ? ema21 : na, "EMA 21", color=color.new(#FF9800, 0), linewidth=1)
plot(showVelezSMA ? sma20 : na, "SMA 20 (Velez)", color=color.new(#E91E63, 0), linewidth=2)
plot(showPD ? eqm : na, "Equilibrium 50%", color=color.new(#9E9E9E, 40), style=plot.style_stepline)

bgcolor(showKZ and inKZ ? color.new(#FFD700, 92) : na, title="Kill Zone")

// Pools de liquidez
var line eqhLine = na
var line eqlLine = na
if showLiq and barstate.islast
    if not na(eqhLine)
        line.delete(eqhLine)
    if not na(eqlLine)
        line.delete(eqlLine)
    if eqhAlive
        eqhLine := line.new(eqhBar, eqhLevel, bar_index + 3, eqhLevel, color=color.new(#FF5252, 20), style=line.style_dotted, width=1)
    if eqlAlive
        eqlLine := line.new(eqlBar, eqlLevel, bar_index + 3, eqlLevel, color=color.new(#00E676, 20), style=line.style_dotted, width=1)

// Marcas de estructura
plotshape(showStr and bosBull, "BOS Bull", shape.triangleup, location.belowbar, color.new(#00E676, 0), size=size.tiny, text="BOS")
plotshape(showStr and bosBear, "BOS Bear", shape.triangledown, location.abovebar, color.new(#FF5252, 0), size=size.tiny, text="BOS")
plotshape(showStr and chochBull, "CHoCH Bull", shape.diamond, location.belowbar, color.new(#00E676, 0), size=size.tiny, text="CHoCH")
plotshape(showStr and chochBear, "CHoCH Bear", shape.diamond, location.abovebar, color.new(#FF5252, 0), size=size.tiny, text="CHoCH")

// Marcas de barrida
plotshape(showLiq and sweepBull, "Sweep Bull", shape.xcross, location.belowbar, color.new(#00E676, 0), size=size.tiny, text="💧")
plotshape(showLiq and sweepBear, "Sweep Bear", shape.xcross, location.abovebar, color.new(#FF5252, 0), size=size.tiny, text="💧")

// ✅ Vela Velez que CONFIRMA un Order Block (el corazón de la reingeniería)
plotshape(showConfMark and obConfirmBull, "OB Confirm Bull", shape.labelup, location.belowbar, obConfColor, size=size.small, text="✅", textcolor=color.black)
plotshape(showConfMark and obConfirmBear, "OB Confirm Bear", shape.labeldown, location.abovebar, obConfColor, size=size.small, text="✅", textcolor=color.black)

// Etiquetas de patrones Velez (label.new no consume presupuesto de plots)
var int lastVelezBar = -999
if showVelez and barstate.isconfirmed and (bar_index - lastVelezBar) >= 2
    if elephantUp
        label.new(bar_index, low, "🐘", yloc=yloc.belowbar, color=color.new(#00C853, 20), textcolor=color.white, style=label.style_label_up, size=size.small)
        lastVelezBar := bar_index
    else if elephantDn
        label.new(bar_index, high, "🐘", yloc=yloc.abovebar, color=color.new(#D50000, 20), textcolor=color.white, style=label.style_label_down, size=size.small)
        lastVelezBar := bar_index
    else if bull180
        label.new(bar_index, low, "🔄 180", yloc=yloc.belowbar, color=#00E676, textcolor=color.black, style=label.style_label_up, size=size.tiny)
        lastVelezBar := bar_index
    else if bear180
        label.new(bar_index, high, "🔄 180", yloc=yloc.abovebar, color=#FF5252, textcolor=color.black, style=label.style_label_down, size=size.tiny)
        lastVelezBar := bar_index
    else if vbsSignal
        label.new(bar_index, low, "📊 VBS", yloc=yloc.belowbar, color=#26A69A, textcolor=color.black, style=label.style_label_up, size=size.tiny)
        lastVelezBar := bar_index
    else if vssSignal
        label.new(bar_index, high, "📊 VSS", yloc=yloc.abovebar, color=#EF5350, textcolor=color.black, style=label.style_label_down, size=size.tiny)
        lastVelezBar := bar_index
    else if rbiSignal
        label.new(bar_index, low, "🚦 RBI", yloc=yloc.belowbar, color=color.new(#00E676, 30), textcolor=color.white, style=label.style_label_up, size=size.tiny)
        lastVelezBar := bar_index
    else if gbiSignal
        label.new(bar_index, high, "🚦 GBI", yloc=yloc.abovebar, color=color.new(#FF5252, 30), textcolor=color.black, style=label.style_label_down, size=size.tiny)
        lastVelezBar := bar_index

// Aviso de agotamiento 3-5-8 (independiente del cooldown Velez)
if showVelez and barstate.isconfirmed
    if exhaust8Bull
        label.new(bar_index, high, "🛑 8ª", yloc=yloc.abovebar, color=#D50000, textcolor=color.white, style=label.style_label_down, size=size.tiny)
    else if exhaust8Bear
        label.new(bar_index, low, "🛑 8ª", yloc=yloc.belowbar, color=#D50000, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// ██ DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════
if showDash and barstate.islast
    var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(#131722, 10),
         border_width=1, border_color=color.new(color.gray, 70))
    c_bg = #131722
    table.cell(dash, 0, 0, "SMC LITE", bgcolor=c_bg, text_color=#FFD700, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, bgcolor=c_bg, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 1, "HTF Bias", bgcolor=c_bg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, htfBias == 1 ? "BULL 🟢" : htfBias == -1 ? "BEAR 🔴" : "FLAT ⚪", bgcolor=c_bg,
         text_color=htfBias == 1 ? #00E676 : htfBias == -1 ? #FF5252 : color.gray, text_size=size.small)
    table.cell(dash, 0, 2, "Estructura", bgcolor=c_bg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, structTrend == 1 ? "BULL 🟢" : structTrend == -1 ? "BEAR 🔴" : "FLAT ⚪", bgcolor=c_bg,
         text_color=structTrend == 1 ? #00E676 : structTrend == -1 ? #FF5252 : color.gray, text_size=size.small)
    table.cell(dash, 0, 3, "Zona P/D", bgcolor=c_bg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, inDiscount ? "DISCOUNT 🟢" : "PREMIUM 🔴", bgcolor=c_bg,
         text_color=inDiscount ? #00E676 : #FF5252, text_size=size.small)
    table.cell(dash, 0, 4, "Kill Zone", bgcolor=c_bg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, inKZ ? (inLondon ? "LONDON ✅" : "NY ✅") : "OFF ⛔", bgcolor=c_bg,
         text_color=inKZ ? #00E676 : color.gray, text_size=size.small)
    table.cell(dash, 0, 5, "Score L/S", bgcolor=c_bg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(scoreLong, "#.#") + " / " + str.tostring(scoreShort, "#.#"), bgcolor=c_bg,
         text_color=scoreLong > scoreShort ? #00E676 : scoreShort > scoreLong ? #FF5252 : color.gray, text_size=size.small)
    table.cell(dash, 0, 6, "OB / FVG", bgcolor=c_bg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(array.size(obs)) + " / " + str.tostring(array.size(fvgs)), bgcolor=c_bg,
         text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 7, "Velez / OB✓", bgcolor=c_bg, text_color=color.gray, text_size=size.small)
    string velezTxt = obConfirmBull ? "✅ OB✓ BULL" : obConfirmBear ? "✅ OB✓ BEAR" : elephantUp ? "🐘 BULL" : elephantDn ? "🐘 BEAR" : bull180 ? "🔄 180 BULL" : bear180 ? "🔄 180 BEAR" : (exhaust8Bull or exhaust8Bear) ? "🛑 8ª EXH" : velezBull ? "🟢 setup" : velezBear ? "🔴 setup" : "—"
    color velezCol = obConfirmBull ? obConfColor : obConfirmBear ? obConfColor : velezBull or elephantUp or bull180 ? #00E676 : velezBear or elephantDn or bear180 ? #FF5252 : color.gray
    table.cell(dash, 1, 7, velezTxt, bgcolor=c_bg, text_color=velezCol, text_size=size.small)
    table.cell(dash, 0, 8, "Último trade", bgcolor=c_bg, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, lastDir == "" ? "—" : lastDir + " x" + str.tostring(lastQty), bgcolor=c_bg,
         text_color=str.contains(lastDir, "L") ? #00E676 : str.contains(lastDir, "S") ? #FF5252 : color.gray, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// ██ ALERTAS
// ══════════════════════════════════════════════════════════════════════════════
f_json(dir, entry, sl, tp1, tp2, qty, score) =>
    '{"signal":"' + dir + '","ticker":"' + syminfo.ticker + '","tf":"' + timeframe.period +
     '","entry":' + str.tostring(entry) + ',"sl":' + str.tostring(sl) + ',"tp1":' + str.tostring(tp1) +
     ',"tp2":' + str.tostring(tp2) + ',"contracts":' + str.tostring(qty) + ',"score":' + str.tostring(score, "#.#") + '}'

if finalLong
    alert(f_json(stampedeBull ? "STAMPEDE_LONG" : cobBull ? "OBCONFIRM_LONG" : "LONG", lastEntry, lastSL, lastTP1, lastTP2, lastQty, scoreLong), alert.freq_once_per_bar_close)
if finalShort
    alert(f_json(stampedeBear ? "STAMPEDE_SHORT" : cobBear ? "OBCONFIRM_SHORT" : "SHORT", lastEntry, lastSL, lastTP1, lastTP2, lastQty, scoreShort), alert.freq_once_per_bar_close)

alertcondition(finalLong,     title="🎯 SMC Lite LONG",  message='{{ticker}} {{interval}} — LONG confluencia institucional')
alertcondition(finalShort,    title="🎯 SMC Lite SHORT", message='{{ticker}} {{interval}} — SHORT confluencia institucional')
alertcondition(cobBull,       title="🎯 OB Confirmado LONG",  message='{{ticker}} {{interval}} — Order Block confirmado por vela Velez (LONG)')
alertcondition(cobBear,       title="🎯 OB Confirmado SHORT", message='{{ticker}} {{interval}} — Order Block confirmado por vela Velez (SHORT)')
alertcondition(stampedeBull,  title="⭐🐘 STAMPEDE LONG",  message='{{ticker}} {{interval}} — STAMPEDE LONG (sweep + Elephant)')
alertcondition(stampedeBear,  title="⭐🐘 STAMPEDE SHORT", message='{{ticker}} {{interval}} — STAMPEDE SHORT (sweep + Elephant)')
alertcondition(sweepBull,     title="💧 Sweep alcista",  message='{{ticker}} {{interval}} — barrida de liquidez (SSL reclaim)')
alertcondition(sweepBear,     title="💧 Sweep bajista",  message='{{ticker}} {{interval}} — barrida de liquidez (BSL reclaim)')
