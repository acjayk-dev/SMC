// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ UTILIDADES DE MARCO
// ═══════════════════════════════════════════════════════════════════════════════════════════════

f_tfSec(string tf) =>
    timeframe.in_seconds(tf == "" ? timeframe.period : tf)

f_tfLabel(string tfIn) =>
    string t = tfIn == "" ? timeframe.period : tfIn
    string o = t
    if not (str.contains(t, "D") or str.contains(t, "W") or str.contains(t, "M") or str.contains(t, "S"))
        int sec = timeframe.in_seconds(t)
        o := sec >= 3600 ? str.tostring(int(sec / 3600)) + "H" : t + "m"
    o

int  chartSec  = timeframe.in_seconds()
bool tf1Use    = tf1On and f_tfSec(tf1) >= chartSec
bool tf2Use    = tf2On and f_tfSec(tf2) >= chartSec and not (tf1Use and f_tfSec(tf2) == f_tfSec(tf1))
bool tf3Use    = tf3On and f_tfSec(tf3) >= chartSec and not (tf1Use and f_tfSec(tf3) == f_tfSec(tf1)) and not (tf2Use and f_tfSec(tf3) == f_tfSec(tf2))
bool tfIgnored = (tf1On and not tf1Use) or (tf2On and not tf2Use) or (tf3On and not tf3Use)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ DETECCIÓN (corre dentro del contexto de cada marco; SOLO velas cerradas)
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Devuelve el EVENTO de un bloque nacido en esta vela (valores simples). Todas las lecturas usan [1]
// o anteriores, así que el valor es definitivo desde el primer tick y lookahead_on no adelanta nada.

f_detect() =>
    float a  = ta.atr(14)[1]
    float av = ta.sma(volume, 20)[1]
    float ph = ta.pivothigh(high[1], swingLen, swingLen)
    float pl = ta.pivotlow(low[1], swingLen, swingLen)
    var float swHi       = na
    var float swLo       = na
    var int   swHiBar    = na
    var int   swLoBar    = na
    // [v4.8] CONSUMO DEL NIVEL Y ESTADO ESTRUCTURAL. `swHiBrk`/`swLoBrk` guardan la vela en la que un
    // CIERRE se llevó ese pivote; `na` significa que sigue vivo. No se borra el nivel al romperlo porque
    // la detección necesita distinguir "lo rompió ESTE impulso" de "ya estaba roto antes".
    var int   swHiBrk    = na
    var int   swLoBrk    = na
    // [v6.0] El pivote ANTERIOR de cada lado. Dos pivotes al mismo precio son un POOL de liquidez: es
    // la estructura hacia la que va el barrido, y el motor no la conocía.
    var float swHi2      = na
    var float swLo2      = na
    var int   structDir  = 0    // 1 alcista · -1 bajista · 0 sin estructura definida todavía
    var int   structPrev = 0    // la dirección ANTERIOR al último giro
    var int   structFlip = na   // vela del último giro, para recuperar la dirección previa al impulso
    var int   lastDemBar = -100000
    var int   lastSupBar = -100000

    bool  evNew   = false
    bool  evDem   = false
    float evTop   = na
    float evBot   = na
    int   evT0    = na
    float evDisp  = na
    float evRatio = na
    float evRvol  = na
    float evBvol  = na   // [v5.6] volumen de la BASE / media, análogo a evRvol pero del otro lado
    bool  evFvg   = false
    // [v4.8] Tres estados en vez de dos, para no ampliar la tupla del request.security:
    //   0 el impulso no rompió estructura · 1 BOS de continuación · 2 CHoCH (rotura a contracorriente)
    int   evBos   = 0
    int   evType  = 0
    int   evSweep = 0    // [v6.0] 0 sin barrido · 1 pivote suelto · 2 POOL de liquidez (extremos iguales)
    // [v6.0] OJO con el nombre: `evDisp` (float, arriba) es el DESPLAZAMIENTO EN ATR — otra cosa. En la
    // primera versión de v6.0 llamé a este booleano `evDisp` también, y la tupla salió con veinte
    // elementos de los que dos eran la misma variable. Mi comprobación de aridad cuadraba el NÚMERO, no
    // la IDENTIDAD, así que no podía verlo: lo cazó el compilador de TradingView.
    bool  evHasD  = false // displacement ICT: energía + FVG + rotura de estructura, las tres
    int   evKind  = 0     // [v6.0] 0 compresión · 1 Order Block · 2 Mitigation · 3 Rejection · 4 Breaker
    int   evBaseN = 0
    int   evLegN  = 0
    bool  evMom   = false
    bool  evTight = true
    bool  evOrig  = true   // [v5.7] la base es el ORIGEN del movimiento, no una pausa dentro de él

    if not na(a) and a > 0
        // ── ¿Hay impulso? Las primeras `legBars` velas cerradas, mismo color y cuerpo real ──────
        bool legUp = true
        bool legDn = true
        for i = 1 to legBars
            bool big = math.abs(close[i] - open[i]) >= a * legBodyAtr
            legUp := legUp and big and close[i] > open[i]
            legDn := legDn and big and close[i] < open[i]

        if legUp or legDn
            bool isDem = legUp
            // ── Base: primera vela pequeña u opuesta antes del impulso ──────────────────────────
            // Todo lo que queda ENTRE la base y el presente es, por construcción, vela grande del
            // mismo color: fue rechazado como base precisamente por eso. Ese tramo es el impulso real.
            // [v4.6] El impulso se recorre hasta `legMaxBars` velas, no hasta donde llegara de rebote la
            // ventana de búsqueda de la base. Son dos cosas distintas y estaban atadas: con legBars=2 y
            // baseMaxBack=4 el bucle moría en la vela 6, así que un impulso de siete velas no encontraba
            // base y el bloque se perdía entero. Se toma el MAYOR de los dos límites para no estrechar
            // nunca la ventana de quien ya tenía baseMaxBack alto.
            int  bNear    = -1
            bool bRejOnly = false   // [v6.2] la base entró SOLO por ser vela de rechazo
            int  scanMax  = math.max(legBars + baseMaxBack, legMaxBars)
            for k = legBars + 1 to scanMax
                bool opp = isDem ? close[k] < open[k] : close[k] > open[k]
                // [v5.6] La compresión exige cuerpo pequeño Y RANGO ESTRECHO. Hasta v5.5 solo se miraba
                // el cuerpo, así que un martillo con cuerpo minúsculo y rango de 3×ATR pasaba por base —
                // y eso es lo contrario de una base. La rama `opp` (Order Block: la última vela OPUESTA
                // antes del impulso) NO lleva el límite de rango: ahí una vela grande es lo esperado.
                bool tight = math.abs(close[k] - open[k]) <= a * baseBodyAtr and (high[k] - low[k]) <= a * baseRngAtr
                // [v6.2] VELA DE RECHAZO. El límite de rango de v5.6 descartaba el martillo de libro —mecha
                // larga, luego rango > 1.2×ATR por definición— ANTES de que v6.0 pudiera leerlo como
                // rejection block. Solo sobrevivía si era del color opuesto (rama `opp`), que es un criterio
                // irrelevante para un rechazo. Los dos cambios eran correctos por separado y juntos se
                // anulaban. Ahora una mecha dominante en la dirección del rechazo también abre base.
                float kW   = isDem ? math.min(open[k], close[k]) - low[k] : high[k] - math.max(open[k], close[k])
                float kR   = high[k] - low[k]
                bool  rejC = rejOn and kR > 0 and kW >= kR * rejWickPct / 100.0 and kW >= a * rejMinAtr
                if tight or opp or rejC
                    bNear    := k
                    bRejOnly := rejC and not tight and not opp
                    break

            if bNear > 1
                // [v3.0] IMPULSO COMPLETO, no un número fijo de velas.
                int   legN   = bNear - 1
                float maxC   = close[1]
                float minC   = close[1]
                float volSum = 0.0
                bool  momOut = false
                for i = 1 to legN
                    maxC   := math.max(maxC, close[i])
                    minC   := math.min(minC, close[i])
                    volSum += volume[i]
                    float bd = math.abs(close[i] - open[i])
                    float rg = high[i] - low[i]
                    // Vela de momentum: cuerpo institucional (Elephant) o cierre en el extremo (Shaved)
                    if rg > 0
                        float wickFav = close[i] > open[i] ? high[i] - close[i] : close[i] - low[i]
                        momOut := momOut or (bd >= a * momBodyAtr and bd >= rg * 0.7) or (rg >= a * momBodyAtr * 0.7 and bd >= rg * 0.6 and wickFav <= rg * 0.1)
                float net   = math.abs(close[1] - open[legN])
                bool  sepOK = isDem ? bar_index - lastDemBar > minBarsBetween : bar_index - lastSupBar > minBarsBetween

                if net >= a * legNetAtr and sepOK
                    // ── Extensión de la base: velas pequeñas contiguas hacia atrás ──────────────
                    int bFar = bNear
                    // [v6.2] Si la base entró SOLO por ser vela de rechazo, no se extiende: extenderla podría
                    // diluir la mecha por debajo del umbral y acabar dibujando un rango ancho con la
                    // geometría CLÁSICA, que es exactamente lo que el límite de rango de v5.6 impide.
                    if baseMaxCandles > 1 and not bRejOnly
                        for k = bNear + 1 to bNear + baseMaxCandles - 1
                            // [v5.6] La extensión es compresión pura, así que aquí el límite de rango se
                            // aplica siempre: no hay rama de Order Block que respetar.
                            if math.abs(close[k] - open[k]) <= a * baseBodyAtr and (high[k] - low[k]) <= a * baseRngAtr
                                bFar := k
                            else
                                break
                    // [v5.6] VOLUMEN DE LA BASE, que nunca se había medido. La premisa de Seiden es que
                    // ahí quedó una orden SIN EJECUTAR, y la huella de eso es actividad baja en la base y
                    // alta en la salida. `rvol` medía solo la salida. Una base con volumen alto dice lo
                    // contrario —la orden se absorbió ahí— y contaba exactamente igual.
                    float bVolSum = 0.0
                    for k = bNear to bFar
                        bVolSum += volume[k]
                    float wHi = high[bNear]
                    float wLo = low[bNear]
                    float oHi = math.max(open[bNear], close[bNear])
                    float oLo = math.min(open[bNear], close[bNear])
                    for k = bNear to bFar
                        wHi := math.max(wHi, high[k])
                        wLo := math.min(wLo, low[k])
                        oHi := math.max(oHi, math.max(open[k], close[k]))
                        oLo := math.min(oLo, math.min(open[k], close[k]))
                    // Mecha a cuerpo: proximal en el CUERPO de la base (donde se colocaron las órdenes);
                    // distal en la mecha más extrema de la base o de la primera vela del impulso, que a
                    // menudo barre justo por debajo/encima antes de irse.
                    // [v6.0] REJECTION BLOCK: si la base tiene mecha dominante en la dirección del
                    // rechazo, la zona ES la región de la mecha —proximal en el borde del cuerpo, distal
                    // en el extremo— y no la geometría cuerpo→mecha del bloque clásico. ICT define esta
                    // clase por las MECHAS, y un motor body-based no podía verla.
                    float rejW  = isDem ? (oLo - wLo) : (wHi - oHi)
                    float bRng  = wHi - wLo
                    bool  isRej = rejOn and bRng > 0 and rejW >= bRng * rejWickPct / 100.0 and rejW >= a * rejMinAtr
                    // [v6.2] El distal incluye también la mecha de la PRIMERA VELA DEL IMPULSO, igual que la
                    // geometría clásica: si esa vela bajó más que la base, el stop tiene que quedar más allá
                    // de ese mínimo ya impreso, no por encima de él.
                    float top = isRej ? (isDem ? oLo : math.max(wHi, high[bNear - 1])) : (isDem ? oHi : math.max(wHi, high[bNear - 1]))
                    float bot = isRej ? (isDem ? math.min(wLo, low[bNear - 1]) : oHi) : (isDem ? math.min(wLo, low[bNear - 1]) : oLo)
                    if not isRej and top - bot < a * 0.05
                        top := isDem ? wHi : top
                        bot := isDem ? bot : wLo
                    // [v4.3] La PROPORCIÓN se mide contra la BASE —la consolidación real— y no contra la
                    // caja dibujada. En v4.1 la saqué del recorte, que estaba bien, pero la dejé sobre
                    // `top - bot`, que incluye la mecha de la primera vela del impulso; esa mecha la
                    // añadimos al distal para COLOCAR EL STOP, no porque el precio se consolidara ahí.
                    // Medía la fuerza de la salida contra un tramo que no es consolidación, el filtro
                    // quedó mucho más duro de lo previsto y empezó a matar bloques válidos. Seiden compara
                    // el recorrido con lo que el precio tardó en irse: eso es la base.
                    // [v6.2] Para un rejection block el nivel ES la mecha, así que la proporción se mide contra
                    // ella — mismo principio de v4.3: contra lo que construyó el nivel. Contra el rango entero,
                    // un martillo de 2×ATR aceptado como base habría muerto aquí y el arreglo sería cosmético.
                    float ratio = net / math.max(isRej ? rejW : wHi - wLo, a * 0.1)
                    // Recorte conservando el borde proximal
                    if top - bot > a * maxZoneAtr
                        if isDem
                            bot := top - a * maxZoneAtr
                        else
                            top := bot + a * maxZoneAtr

                    if ratio >= legRatioMin
                        // FVG dentro del impulso: hueco entre la vela i y la vela i+2, con TAMAÑO mínimo.
                        // [v3.1] Sin el mínimo, en 1m casi todos los bloques traían FVG y la etiqueta no
                        // distinguía nada: un hueco de un tick no es un desequilibrio institucional.
                        bool fvg = false
                        if legN >= 2
                            for i = 1 to legN - 1
                                float gap = isDem ? low[i] - high[i + 2] : low[i + 2] - high[i]
                                if gap > 0 and gap >= a * fvgMinAtr
                                    fvg := true
                                    break
                        // ── ESTRUCTURA: BOS vs CHoCH  [v4.8] ───────────────────────────────────────
                        // Un pivote que un CIERRE ya se llevó está GASTADO: los stops que lo defendían
                        // se ejecutaron entonces, y volver a superarlo no rompe nada. Hasta v4.7 el nivel
                        // no se consumía nunca, así que varios impulsos seguidos cobraban los 15 puntos
                        // de estructura contra el mismo máximo ya roto. Cuenta si seguía vivo cuando
                        // arrancó el impulso — o si fue este mismo impulso el que lo rompió.
                        int  legStart = bar_index - legN
                        bool hiLive   = not na(swHi) and (na(swHiBrk) or swHiBrk >= legStart)
                        bool loLive   = not na(swLo) and (na(swLoBrk) or swLoBrk >= legStart)
                        bool bos      = isDem ? (hiLive and maxC > swHi) : (loLive and minC < swLo)
                        // CHoCH: la rotura va CONTRA la dirección estructural que regía ANTES del impulso
                        // —rompió al alza estando bajista, o a la baja estando alcista—. Es la diferencia
                        // entre un nivel que continúa lo que ya pasaba y uno donde cambian las manos, y
                        // hasta v4.7 los dos puntuaban exactamente igual. `dirPre` recupera la dirección
                        // previa cuando fue este impulso el que la giró: si no, un CHoCH se clasificaría
                        // como continuación de la dirección que él mismo acaba de crear.
                        int  dirPre   = not na(structFlip) and structFlip >= legStart ? structPrev : structDir
                        bool choch    = bos and (isDem ? dirPre == -1 : dirPre == 1)
                        // Barrido de liquidez contra el último PIVOTE confirmado: ahí es donde se
                        // acumulan los stops. Un mínimo en mitad de un impulso no tiene nada que barrer.
                        // [v4.1] Se mide con el MISMO extremo que define el distal —base más la primera vela
                        // del impulso— porque es justo esa vela la que suele hacer el barrido antes de irse.
                        // Antes solo miraba las velas de la base y se perdía el caso más característico.
                        float swpLo = math.min(wLo, low[bNear - 1])
                        float swpHi = math.max(wHi, high[bNear - 1])
                        // [v6.0] FIDELIDAD DEL BARRIDO. Un barrido toma liquidez CON MECHA y vuelve: si el
                        // precio CIERRA más allá del nivel, eso es una rotura, no un barrido, y hasta v5.7
                        // contaban igual. Se mide sobre las mismas velas que definen swpLo/swpHi.
                        float swpCloLo = close[bNear - 1]
                        float swpCloHi = close[bNear - 1]
                        for k = bNear to bFar
                            swpCloLo := math.min(swpCloLo, close[k])
                            swpCloHi := math.max(swpCloHi, close[k])
                        int  sweep = 0
                        if sweepMode == "Pivote (estructura)"
                            // [v4.8] Mismo criterio de nivel vivo: no se puede barrer liquidez que un
                            // cierre anterior ya se llevó. Se mide contra el arranque de la BASE, que es
                            // quien hace el barrido, no contra el del impulso.
                            int   baseStart = bar_index - bFar
                            float lvl  = isDem ? swLo : swHi
                            float lvl2 = isDem ? swLo2 : swHi2
                            int   lvlB = isDem ? swLoBar : swHiBar
                            int   lvlK = isDem ? swLoBrk : swHiBrk
                            bool  got  = not na(lvl) and not na(lvlB) and (na(lvlK) or lvlK >= baseStart) and (bar_index - lvlB) <= sweepLookback * 2 and (isDem ? swpLo < lvl : swpHi > lvl) and (isDem ? swpCloLo >= lvl : swpCloHi <= lvl)
                            // [v6.0] ¿El nivel barrido era un POOL —dos pivotes al mismo precio— o un
                            // pivote suelto? Barrer un pool de stops es otro suceso.
                            bool  pool = got and not na(lvl2) and math.abs(lvl - lvl2) <= a * eqTolAtr
                            sweep := got ? (pool ? 2 : 1) : 0
                        else
                            float prior = isDem ? low[bFar + 1] : high[bFar + 1]
                            for k = bFar + 2 to bFar + sweepLookback
                                prior := isDem ? math.min(prior, low[k]) : math.max(prior, high[k])
                            sweep := (isDem ? swpLo < prior and swpCloLo >= prior : swpHi > prior and swpCloHi <= prior) ? 1 : 0
                        // [v5.7] ¿ORIGEN O PAUSA? Las velas justo ANTES de la base, con el mismo criterio
                        // que define el impulso: cuerpo real y mismo color. Si hay `originBars`
                        // consecutivas, el movimiento ya venía en marcha y esta base es una pausa dentro
                        // de él, no su origen. Es una pregunta distinta de la que responde `ztype`, que
                        // mide el recorrido NETO de un tramo fijo de velas.
                        int contN = 0
                        for k = bFar + 1 to bFar + originBars
                            bool cBig  = math.abs(close[k] - open[k]) >= a * legBodyAtr
                            bool cSame = isDem ? close[k] > open[k] : close[k] < open[k]
                            if cBig and cSame
                                contN += 1
                            else
                                break
                        bool isOrig = contN < originBars
                        // Tipo por el tramo de llegada a la base: reversión o continuación
                        float legIn = close[bFar + 1] - open[bFar + legInBars]
                        int   zt    = legIn <= -a * 0.5 ? (isDem ? 1 : -1) : legIn >= a * 0.5 ? (isDem ? -1 : 1) : 0

                        evNew   := true
                        evDem   := isDem
                        evTop   := top
                        evBot   := bot
                        evT0    := time[bFar]
                        evDisp  := net / a
                        evRatio := ratio
                        evRvol  := not na(av) and av > 0 ? volSum / (av * legN) : na
                        evBvol  := not na(av) and av > 0 ? bVolSum / (av * (bFar - bNear + 1)) : na
                        evFvg   := fvg
                        evBos   := bos ? (choch ? 2 : 1) : 0
                        evType  := zt
                        evSweep := sweep
                        // [v6.0] DISPLACEMENT (ICT): energía + FVG + rotura de estructura. Las TRES.
                        evHasD  := net >= a * dispMinAtr and fvg and bos
                        evBaseN := bFar - bNear + 1
                        evLegN  := legN
                        evMom   := momOut
                        // ¿La base es compresión o la última vela OPUESTA grande? La segunda es un Order
                        // Block válido, pero no prueba que el precio apenas se parara ahí.
                        evTight := math.abs(close[bNear] - open[bNear]) <= a * baseBodyAtr and (high[bNear] - low[bNear]) <= a * baseRngAtr
                        evOrig  := isOrig
                        // [v6.0] TAXONOMÍA. En ICT, Order Block y Mitigation Block son la MISMA formación
                        // distinguidas por una sola cosa: si el precio se llevó liquidez antes de
                        // desplazarse (OB) o si giró sin llegar a tomarla (MB). Hasta v5.7 las dos caían
                        // en el mismo saco. 0 compresión (S/D Seiden) · 1 Order Block · 2 Mitigation
                        // Block · 3 Rejection Block · 4 Breaker (se fija al nacer el breaker).
                        evKind  := isRej ? 3 : evTight ? 0 : (sweep > 0 ? 1 : 2)
                        if isDem
                            lastDemBar := bar_index
                        else
                            lastSupBar := bar_index

    // Los swings se actualizan DESPUÉS: BOS y barrido se miden contra la estructura previa al impulso.
    // [v4.8] Primero el CONSUMO por cierre —que además fija la dirección estructural— y luego el rearme
    // con el pivote nuevo. Por CIERRE y no por mecha, igual que f_bias y que la invalidación del bloque:
    // una mecha que atraviesa y vuelve es un barrido de liquidez, no una rotura de estructura. Un pivote
    // recién confirmado nace vivo por construcción: para serlo, las swingLen velas siguientes no lo
    // superaron, así que ningún cierre puede haberlo roto ya.
    if not na(swHi) and na(swHiBrk) and close[1] > swHi
        swHiBrk := bar_index - 1
        if structDir != 1
            structPrev := structDir
            structFlip := bar_index - 1
            structDir  := 1
    if not na(swLo) and na(swLoBrk) and close[1] < swLo
        swLoBrk := bar_index - 1
        if structDir != -1
            structPrev := structDir
            structFlip := bar_index - 1
            structDir  := -1
    if not na(ph)
        swHi2   := na(swHiBrk) ? swHi : na   // [v6.2] si un cierre ya se lo llevó, no queda liquidez con que emparejar
        swHi    := ph
        swHiBar := bar_index - swingLen
        swHiBrk := na
    if not na(pl)
        swLo2   := na(swLoBrk) ? swLo : na
        swLo    := pl
        swLoBar := bar_index - swingLen
        swLoBrk := na
    [evNew, evDem, evTop, evBot, evT0, evDisp, evRatio, evRvol, evBvol, evFvg, evBos, evType, evSweep, evBaseN, evLegN, evMom, evTight, evOrig, evHasD, evKind]

[e1n, e1d, e1t, e1b, e1t0, e1ds, e1r, e1v, e1bv, e1f, e1bo, e1y, e1s, e1bn, e1ln, e1m, e1tg, e1og, e1dp, e1kd] = request.security(syminfo.tickerid, tf1, f_detect(), lookahead = barmerge.lookahead_on)
[e2n, e2d, e2t, e2b, e2t0, e2ds, e2r, e2v, e2bv, e2f, e2bo, e2y, e2s, e2bn, e2ln, e2m, e2tg, e2og, e2dp, e2kd] = request.security(syminfo.tickerid, tf2, f_detect(), lookahead = barmerge.lookahead_on)
[e3n, e3d, e3t, e3b, e3t0, e3ds, e3r, e3v, e3bv, e3f, e3bo, e3y, e3s, e3bn, e3ln, e3m, e3tg, e3og, e3dp, e3kd] = request.security(syminfo.tickerid, tf3, f_detect(), lookahead = barmerge.lookahead_on)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ RANGO OPERATIVO (premium / discount) · velas cerradas del marco superior
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [v5.0] DEALING RANGE. El rango va del último pivote BAJO confirmado al último pivote ALTO confirmado,
// que es la definición de ICT, y no del máximo/mínimo de una ventana móvil. La diferencia importa: una
// ventana se DESLIZA, así que el descuento de un bloque cambiaba solo con que pasara el tiempo, y
// arrastraba extremos de hace N velas sin relación con lo que se está negociando.
// Si el precio se sale del rango, el rango se ESTIRA hasta el nuevo extremo: un máximo que el precio ya
// superó no es el techo de nada. Vuelve a encogerse cuando confirma un pivote nuevo que lo reancla.
// Todo con [1], como el resto del archivo: definitivo desde el primer tick y seguro con lookahead_on.
f_range() =>
    float ph = ta.pivothigh(high[1], rangeSwing, rangeSwing)
    float pl = ta.pivotlow(low[1], rangeSwing, rangeSwing)
    var float rH  = na
    var float rL  = na
    // [v5.1] Vela de cada ancla, para saber cuál es más reciente: eso dice si el último tramo del rango
    // fue alcista o bajista, que es lo que el OTE necesita para saber qué lado es el retroceso.
    var int   rHb = na
    var int   rLb = na
    if not na(ph)
        rH  := ph
        rHb := bar_index - rangeSwing
    if not na(pl)
        rL  := pl
        rLb := bar_index - rangeSwing
    if not na(rH) and high[1] > rH
        rH  := high[1]
        rHb := bar_index - 1
    if not na(rL) and low[1] < rL
        rL  := low[1]
        rLb := bar_index - 1
    [rH, rL, ta.highest(high, curveLen)[1], ta.lowest(low, curveLen)[1], na(rHb) or na(rLb) ? 0 : rHb > rLb ? 1 : -1]

[rHi, rLo, cHi, cLo, rLeg] = request.security(syminfo.tickerid, curveTf, f_range(), lookahead = barmerge.lookahead_on)

// [v3.9] Sesgo ESTRUCTURAL del marco superior: la dirección la marca el último rompimiento por CIERRE de
// un pivote confirmado. Un nivel roto se consume (queda en na) y se rearma con el siguiente pivote, así
// que el mismo máximo no puede disparar el sesgo dos veces. Todo sobre velas cerradas: sin repintado.
f_bias() =>
    float ph = ta.pivothigh(high[1], biasSwing, biasSwing)
    float pl = ta.pivotlow(low[1], biasSwing, biasSwing)
    var float bHi = na
    var float bLo = na
    var int   dir = 0
    if not na(ph)
        bHi := ph
    if not na(pl)
        bLo := pl
    if not na(bHi) and close[1] > bHi
        dir := 1
        bHi := na
    if not na(bLo) and close[1] < bLo
        dir := -1
        bLo := na
    dir

int htfDir = request.security(syminfo.tickerid, biasTf, f_bias(), lookahead = barmerge.lookahead_on)

bool  curveTfOK = f_tfSec(curveTf) > chartSec
// [v5.0] El rango vigente según el modo elegido. Todo lo que mide premium/discount —score, cortes,
// panel y las líneas dibujadas— lee estos dos valores y solo estos.
bool  pdLegacy  = pdMode == "Ventana móvil (legado)"
float dealHi    = pdLegacy ? cHi : rHi
float dealLo    = pdLegacy ? cLo : rLo
// [v5.2] El rango ES UTILIZABLE o no lo es; PUNTUARLO es otra decisión. Hasta v5.1 `usePd` —un
// interruptor de score— entraba en esta condición, así que apagarlo no quitaba 5 puntos: se llevaba por
// delante los dos cortes de descuento, el de OTE, el rango dibujado con su equilibrio, las franjas OTE y
// la lectura del panel. El score ya se filtra por su cuenta en f_score, que es donde toca.
bool  rangeOK   = curveTfOK and not na(dealHi) and not na(dealLo) and dealHi > dealLo
bool  biasTfOK  = f_tfSec(biasTf) > chartSec
bool  inRTH     = not timeframe.isintraday or not na(time(timeframe.period, sessStr, "America/New_York"))
float atrC      = ta.atr(14)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ CONTEXTO INSTITUCIONAL  [v4.9]  ·  VWAP · KILL ZONES · LIQUIDEZ D/W
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Las tres referencias que faltaban. Se calculan siempre (las funciones con estado de Pine tienen que
// llamarse en TODAS las velas o se desincronizan) y se consumen solo si están activadas.
// Nada de aquí entra en el score: se congela en el toque y se mide en la tabla.

// VWAP de sesión con bandas σ, anclado a la apertura del día: la referencia contra la que se mide la
// ejecución institucional. Calculado a mano y NO con ta.vwap a propósito — ta.vwap aborta el script con
// "The symbol has no volume data" en cuanto lo cargas en un símbolo sin volumen, y lo haría aunque el
// módulo estuviera desactivado. Así, sin volumen el acumulador se queda en cero, el VWAP sale na y los
// cortes simplemente no se marcan: el indicador sigue funcionando.
var float vwSum = 0.0
var float vwVol = 0.0
var float vwSq  = 0.0
if timeframe.change("D")
    vwSum := 0.0
    vwVol := 0.0
    vwSq  := 0.0
float vwVol0 = na(volume) ? 0.0 : volume
vwSum += hlc3 * vwVol0
vwVol += vwVol0
vwSq  += hlc3 * hlc3 * vwVol0
float vwapV  = vwVol > 0 ? vwSum / vwVol : na
float vwapSd = na(vwapV) ? na : math.sqrt(math.max(vwSq / vwVol - vwapV * vwapV, 0.0))
float vwapU  = na(vwapSd) ? na : vwapV + vwapSd * vwapSigma
float vwapL  = na(vwapSd) ? na : vwapV - vwapSd * vwapSigma
// Fuera de intradía un "VWAP de sesión" no significa nada: el ancla saltaría en cada vela.
bool vwapOK = vwapOn and timeframe.isintraday and not na(vwapV)

// Kill zones ICT. `time()` con sesión devuelve na fuera de la ventana. Solo tienen sentido en intradía.
bool kzIn = timeframe.isintraday and kzOn and ((kz1On and not na(time(timeframe.period, kz1, "America/New_York"))) or (kz2On and not na(time(timeframe.period, kz2, "America/New_York"))) or (kz3On and not na(time(timeframe.period, kz3, "America/New_York"))) or (kz4On and not na(time(timeframe.period, kz4, "America/New_York"))))

// Liquidez del día y la semana previos. El [1] dentro del contexto superior hace que el valor sea el de
// la vela D/W ya CERRADA, así que está determinado desde la apertura del día: lookahead_on no adelanta
// nada. Es el mismo patrón que curveTf y biasTf.
[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ FVG CON CICLO DE VIDA E INVERSIÓN  [v6.0]
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Marco del GRÁFICO. Todo con [1] o anterior, igual que el resto: definitivo desde el primer tick.
// El hueco de tres velas clásico: alcista si el mínimo de la vela i es mayor que el máximo de la i+2.

var array<Fvg> fvgs = array.new<Fvg>()

if barstate.isconfirmed and fvgOn and not na(atrC) and atrC > 0
    float gapUp = low[1] - high[3]
    float gapDn = low[3] - high[1]
    if gapUp > 0 and gapUp >= atrC * fvgMinIn
        fvgs.push(Fvg.new(top = low[1], bot = high[3], isBull = true,  t0 = time[3], bar0 = bar_index))
    else if gapDn > 0 and gapDn >= atrC * fvgMinIn
        fvgs.push(Fvg.new(top = low[3], bot = high[1], isBull = false, t0 = time[3], bar0 = bar_index))
    // INVERSIÓN: un CIERRE al otro lado no mata el hueco, le da la vuelta. Por cierre y no por mecha,
    // igual que el resto del archivo: una mecha que atraviesa y vuelve no ha invertido nada.
    // [v6.2] RELLENADO. Si la MECHA alcanza el borde lejano pero el cierre no lo cruza, el hueco queda
    // EQUILIBRADO: en ICT ya no es un desequilibrio abierto. Hasta v6.1 seguía pintándose como abierto
    // hasta que lo echaba el tope de memoria. Ahora sale del almacén — y así la memoria la ocupan huecos
    // vivos. Recorrido hacia atrás porque se borra mientras se recorre.
    if fvgs.size() > 0
        for i = fvgs.size() - 1 to 0
            Fvg f = fvgs.get(i)
            if not f.inverted
                if (f.isBull ? close < f.bot : close > f.top)
                    f.inverted := true
                else if (f.isBull ? low <= f.bot : high >= f.top)
                    fvgs.remove(i)
    while fvgs.size() > fvgMaxN
        fvgs.shift()

// ¿Está `px` pegado a alguno de los cuatro niveles de liquidez?
f_onLiq(float px) =>
    float tol = atrC * liqNear
    bool  o   = false
    if liqOn and not na(atrC)
        o := (not na(pdH) and math.abs(px - pdH) <= tol) or (not na(pdL) and math.abs(px - pdL) <= tol) or (not na(pwH) and math.abs(px - pwH) <= tol) or (not na(pwL) and math.abs(px - pwL) <= tol)
    o

// Posición de un precio dentro del rango: 0 = mínimo del rango · 1 = máximo.
f_pdPos(float px) =>
    rangeOK ? math.max(0.0, math.min(1.0, (px - dealLo) / (dealHi - dealLo))) : na

// [v5.1] Precio que corresponde a una posición del rango (la inversa de f_pdPos), para dibujar el OTE.
f_pdPx(float pp) =>
    rangeOK ? dealLo + pp * (dealHi - dealLo) : na

// OTE (ICT): la franja 62-79% del RETROCESO de un impulso. En posición dentro del rango sale simétrica —
// retroceder un 79% desde el máximo deja el precio al 21% del rango—, así que la franja de compra es
// [1-oteHi, 1-oteLo] y la de venta [oteLo, oteHi]. Sin el dealing range de v5.0 esto no se podía medir:
// sobre una ventana móvil los porcentajes se referían a un rango que se deslizaba solo.
f_oteLo() => math.min(oteLo, oteHi)
f_oteHi() => math.max(oteLo, oteHi)

f_inOte(float px, bool isDem) =>
    float pp = f_pdPos(px)
    bool  o  = false
    // El OTE es el retroceso DE UN IMPULSO: estrictamente solo aplica si el último tramo del rango va a
    // favor del trade. `rLeg` vale 1 si el máximo es el ancla más reciente (último tramo alcista) y -1 si
    // lo es el mínimo. Con oteDir desactivado se mide solo la franja de precio.
    // [v5.2] El OTE EXIGE el rango entre swings. Sobre la ventana móvil los porcentajes se refieren a un
    // rango que se desliza solo —que es justo por lo que el OTE no se pudo implementar antes de v5.0— y
    // además el gate direccional lee `rLeg`, que siempre viene de las anclas de swing: mezclar las dos
    // cosas daba una franja sin sentido con una dirección que no le correspondía.
    if oteOn and not pdLegacy and not na(pp) and (not oteDir or rLeg == (isDem ? 1 : -1))
        o := isDem ? (pp >= 1.0 - f_oteHi() and pp <= 1.0 - f_oteLo()) : (pp >= f_oteLo() and pp <= f_oteHi())
    o

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ ALMACÉN DE BLOQUES
// ═══════════════════════════════════════════════════════════════════════════════════════════════

var array<Zone> zones = array.new<Zone>()

f_typeTxt(Zone z) =>
    z.isDem ? (z.ztype == 1 ? "DBR" : z.ztype == -1 ? "RBR" : "D") : (z.ztype == 1 ? "RBD" : z.ztype == -1 ? "DBD" : "S")

// [v4.6] Cuántas velas DEL GRÁFICO equivalen a una vela del marco de este bloque. Es la misma conversión
// que la ventana de evaluación usa desde v3.4, ahora compartida también por la edad.
f_blkBars(Zone z) =>
    math.max(1, int(math.round(z.tfSec / float(chartSec))))

// [v4.6] LA EDAD SE CUENTA EN VELAS, no en milisegundos. `(time - z.t0)` metía en la cuenta el fin de
// semana, el cierre diario y los festivos: un bloque nacido el viernes por la tarde llegaba al lunes con
// dos días de "edad" sin que hubiera pasado una sola vela, y en futuros eso ocurre todas las semanas.
// Se mide desde el REGISTRO del bloque (z.bar0), que en marcos superiores puede ir unas velas por detrás
// de su origen real: la edad efectiva queda, como mucho, ligeramente a favor del bloque, nunca en contra.
f_young(Zone z) =>
    (bar_index - z.bar0) <= maxAgeBars * f_blkBars(z)

// Un bloque está VIVO mientras no se haya roto, no haya caducado y no esté mitigado por encima del tope.
f_live(Zone z) =>
    not z.broken and f_young(z) and z.deepest < mitigPct / 100.0

// [v3.0] Confluencia MTF GRADUADA: fracción de la altura de este bloque cubierta por un bloque vivo del
// mismo tipo en un marco SUPERIOR. Rozar una zona de 1H no es lo mismo que estar dentro de ella.
f_htfConf(Zone z) =>
    float best = 0.0
    for o in zones
        // [v4.1] f_live, no `not o.broken`: un bloque de marco superior caducado o ya mitigado por encima
        // del tope seguía regalando confluencia. Si no lo dibujas porque está muerto, tampoco confluye.
        if o.isDem == z.isDem and o.tfSec > z.tfSec and f_live(o)
            float ov = math.min(o.top, z.top) - math.max(o.bot, z.bot)
            if ov > 0
                best := math.max(best, ov / math.max(z.top - z.bot, syminfo.mintick))
    math.min(1.0, best)

// Score 0-100. `prior` = toques ANTERIORES al que se está evaluando.
// [v4.6] La confluencia MTF ya no se pasa como argumento: se lee de `z.htfConf`, que se recalcula una vez
// por vela cerrada para todos los bloques. Antes `f_htfConf` —que recorre el array entero— se invocaba
// desde dentro de otros recorridos del array (panel, dibujo, cada toque): O(n²) repetido en cada tick de
// la última vela, con hasta 150 bloques en memoria. Y además el panel la medía EN VIVO mientras el motor
// la medía en vela cerrada, así que el score que leías arriba podía no ser el que la tabla registró.
f_score(Zone z, int prior) =>
    // 1. Impulso 20 — las escalas continuas se miden contra TUS PROPIOS MÍNIMOS: el mínimo exigido
    //    puntúa 0 y el doble del mínimo puntúa el máximo. Así la escala se recalibra sola al cambiar
    //    los inputs, en vez de compararse con constantes que en intradía casi nunca se alcanzan.
    float sDisp  = math.max(0.0, math.min(8.0, (z.disp  - legNetAtr)   / math.max(legNetAtr, 0.5)  * 8.0))
    float sRatio = math.max(0.0, math.min(8.0, (z.ratio - legRatioMin) / math.max(legRatioMin, 1.0) * 8.0))
    float sMom   = z.momOut ? 4.0 : 0.0
    // 2. Huella 20
    float sFvg   = z.fvg ? 12.0 : 0.0
    float sVol   = na(z.rvol) ? 4.0 : math.max(0.0, math.min(8.0, (z.rvol - 0.9) / 0.6 * 8.0))
    // 3. Estructura 15 — [v4.8] repartidos entre continuación y cambio de carácter. Con chochEdge=0
    //    (por defecto) los dos cobran 15 y el score es idéntico al de v4.7.
    float sBos   = z.bos ? (z.choch ? 15.0 : 15.0 - chochEdge) : 0.0
    // 4. Base 10 — 1 vela de compresión 10 · 2 velas 7 · Order Block 6 · 3+ velas 4
    float sBase  = not z.baseTight ? 6.0 : z.baseN <= 1 ? 10.0 : z.baseN == 2 ? 7.0 : 4.0
    // 5. Frescura 15
    float sFresh = prior == 0 ? 15.0 : prior == 1 ? 5.0 : 0.0
    // 6-7. Liquidez 5 + tipo 5
    // [v6.0] Barrer un POOL de liquidez puntúa el máximo; un pivote suelto, la mitad.
    float sSweep = z.sweep == 2 ? 5.0 : z.sweep == 1 ? 2.5 : 0.0
    float sType  = z.ztype == 1 ? 5.0 : z.ztype == 0 ? 2.5 : 0.0
    // 8. Confluencia MTF 5, graduada
    float sMtf   = 5.0 * z.htfConf
    // 9. Curva 5 — demanda con descuento, oferta con premium
    float sPd    = 0.0
    if usePd and not na(z.pd)
        float fav = z.isDem ? 1.0 - z.pd : z.pd
        sPd := math.max(0.0, math.min(5.0, (fav - 0.5) / 0.5 * 5.0))
    sDisp + sRatio + sMom + sFvg + sVol + sBos + sBase + sFresh + sSweep + sType + sMtf + sPd

// [v4.2] Umbrales CONFIGURABLES. Estaban clavados en 80/70, pero al endurecer FVG y momentum en v3.9 se
// le quitaron ~16 puntos a la mayoría de bloques y el resultado fue cero A+ en 41 y solo 6 grados A: una
// escala en la que nadie alcanza el tramo alto no clasifica, solo decora. El score no predice —eso ya lo
// sabemos—, así que el grado es una etiqueta descriptiva de cuán de libro es el bloque, y como tal debe
// repartir la población. Ajústalos a lo que veas: si casi todo te sale B, bájalos.
f_grade(float s) =>
    s >= gradeAp ? "A+" : s >= gradeA ? "A" : "B"

f_tags(Zone z) =>
    (z.fvg ? " FVG" : "") + (z.choch ? " CHoCH" : z.bos ? " BOS" : "") + (z.sweep == 2 ? " POOL" : z.sweep == 1 ? " LIQ" : "") + (z.hasDisp ? " DISP" : "") + (z.momOut ? " MOM" : "") + (z.kind == 1 ? " OB" : z.kind == 2 ? " MIT" : z.kind == 3 ? " REJ" : "") + (z.isOrigin ? " ORG" : "") + (z.isBreaker ? " BRK" : "")

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ ALTA DE BLOQUES
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// El evento persiste durante toda la vela del marco superior (lookahead_on), así que se deduplica por
// guid en una `var` propia de cada llamada. Devuelve el resultado para el embudo del panel:
//   0 sin evento · 1 rechazado por huella · 2 descartado por duplicado · 3 registrado

f_addZone(bool use, bool ev, bool isDem, float top, float bot, int t0, float disp, float ratio, float rvol, float bvol, bool fvg, int bosKind, int zt, int sweep, int baseN, int legN, bool momOut, bool tight, bool orig, bool hasDisp, int kind, int tfIdx, string tfStr) =>
    var int lastGuid = na
    int res = 0
    // [v4.8] `bosKind` llega codificado desde f_detect: 0 sin rotura · 1 continuación · 2 CHoCH.
    bool bos   = bosKind > 0
    bool choch = bosKind == 2
    // [v4.7] El bloque se publica en cuanto el evento existe, sin esperar al cierre de la vela. Todo lo
    // que lo define viene de velas cerradas (f_detect no lee la vela en curso), así que el nivel ya no
    // puede moverse: lo que Pine confirme al cierre será idéntico a lo que se pintó en el primer tick.
    if use and ev and (liveReg or barstate.isconfirmed) and not na(t0) and not na(top) and not na(bot)
        int guid = t0 * 8 + tfIdx * 2 + (isDem ? 0 : 1)
        if na(lastGuid) or guid != lastGuid
            lastGuid := guid
            bool fpOK = footprint == "Ninguna" ? true : footprint == "FVG o BOS" ? (fvg or bos) : footprint == "FVG y BOS" ? (fvg and bos) : hasDisp
            res := 1
            if fpOK
                Zone z = Zone.new(top = top, bot = bot, isDem = isDem, t0 = t0, guid = guid, tfSec = f_tfSec(tfStr), tfLbl = f_tfLabel(tfStr), disp = disp, ratio = ratio, rvol = rvol, bvol = bvol, fvg = fvg, bos = bos, choch = choch, ztype = zt, sweep = sweep, hasDisp = hasDisp, kind = kind, baseN = baseN, legN = legN, momOut = momOut, baseTight = tight, isOrigin = orig, pd = f_pdPos((top + bot) / 2), tfIdx = tfIdx, bar0 = bar_index)
                // Si nace con el precio dentro no cuenta como toque: tiene que salir y volver.
                z.wasInside := high >= bot and low <= top
                // El bloque todavía no está en el array, así que su confluencia se calcula aquí; los demás
                // la tienen de la pasada de esta misma vela.
                z.htfConf   := f_htfConf(z)
                float newSc = f_score(z, 0)
                // [v3.0] Duplicado: bloque vivo del MISMO marco y tipo que solapa por encima del umbral.
                // Es el mismo nivel contado dos veces. Se queda el de mayor score.
                int dup = -1
                if dedupOn and zones.size() > 0
                    for i = 0 to zones.size() - 1
                        Zone o = zones.get(i)
                        if o.isDem == isDem and o.tfSec == z.tfSec and f_live(o)
                            float ov = math.min(o.top, top) - math.max(o.bot, bot)
                            float hh = math.max(math.min(o.top - o.bot, top - bot), syminfo.mintick)
                            if ov / hh >= dedupPct / 100.0
                                dup := i
                                break
                bool keep = true
                if dup >= 0
                    keep := newSc > f_score(zones.get(dup), zones.get(dup).touches)
                    if keep
                        zones.remove(dup)
                if keep
                    zones.push(z)
                    res := 3
                    if newSc >= minScore
                        // [v4.7] La alerta sale con el dibujo, no una vela después. `freq` exige const, así
                        // que son dos llamadas en vez de un ternario.
                        string msg = '{"event":"SD_BLOCK","side":"' + (isDem ? "LONG" : "SHORT") + '","ticker":"' + syminfo.ticker + '","tf":"' + z.tfLbl + '","type":"' + f_typeTxt(z) + '","proximal":' + str.tostring(isDem ? top : bot, format.mintick) + ',"distal":' + str.tostring(isDem ? bot : top, format.mintick) + ',"score":' + str.tostring(math.round(newSc)) + ',"grade":"' + f_grade(newSc) + '","structure":"' + (choch ? "CHOCH" : bos ? "BOS" : "none") + '"}'
                        if liveReg
                            alert(msg, alert.freq_once_per_bar)
                        else
                            alert(msg, alert.freq_once_per_bar_close)
                else
                    res := 2
    res

// Limpieza: bloques rotos o caducados fuera, y tope de memoria (primero los más antiguos).
var int zUnres = 0
if barstate.isconfirmed and zones.size() > 0
    for i = zones.size() - 1 to 0
        Zone z = zones.get(i)
        // [v4.6] Mismo criterio que f_young —velas, no reloj— al doble de edad: el bloque deja de estar
        // vivo en maxAgeBars pero se guarda un rato más para no truncar su evaluación abierta.
        if z.broken or (bar_index - z.bar0) > maxAgeBars * f_blkBars(z) * 2
            if z.evalOn and not z.resolved
                zUnres += 1
            zones.remove(i)
    // [v3.6] El tope de memoria descartaba bloques sin mirar si tenían una evaluación abierta.
    while zones.size() > maxZonesMem
        Zone old = zones.shift()
        if old.evalOn and not old.resolved
            zUnres += 1

int r1 = f_addZone(tf1Use, e1n, e1d, e1t, e1b, e1t0, e1ds, e1r, e1v, e1bv, e1f, e1bo, e1y, e1s, e1bn, e1ln, e1m, e1tg, e1og, e1dp, e1kd, 0, tf1)
int r2 = f_addZone(tf2Use, e2n, e2d, e2t, e2b, e2t0, e2ds, e2r, e2v, e2bv, e2f, e2bo, e2y, e2s, e2bn, e2ln, e2m, e2tg, e2og, e2dp, e2kd, 1, tf2)
int r3 = f_addZone(tf3Use, e3n, e3d, e3t, e3b, e3t0, e3ds, e3r, e3v, e3bv, e3f, e3bo, e3y, e3s, e3bn, e3ln, e3m, e3tg, e3og, e3dp, e3kd, 2, tf3)

// Embudo de formación: dónde se pierden los candidatos.
var int fnDet = 0   // eventos de bloque detectados por los marcos
var int fnFp  = 0   // ... rechazados por el filtro de huella
var int fnDup = 0   // ... descartados por duplicado
var int fnReg = 0   // ... registrados
if barstate.isconfirmed
    fnDet += (r1 > 0 ? 1 : 0) + (r2 > 0 ? 1 : 0) + (r3 > 0 ? 1 : 0)
    fnFp  += (r1 == 1 ? 1 : 0) + (r2 == 1 ? 1 : 0) + (r3 == 1 ? 1 : 0)
    fnDup += (r1 == 2 ? 1 : 0) + (r2 == 2 ? 1 : 0) + (r3 == 2 ? 1 : 0)
    fnReg += (r1 == 3 ? 1 : 0) + (r2 == 3 ? 1 : 0) + (r3 == 3 ? 1 : 0)

bool newBlock = r1 == 3 or r2 == 3 or r3 == 3

// [v4.6] CONFLUENCIA MTF: una sola pasada por vela cerrada, DESPUÉS de dar de alta los bloques nuevos y
// antes del ciclo de vida, que es donde se consume. El valor queda en el propio bloque y todo lo de abajo
// —score, panel, dibujo, tabla— lee el mismo número. Antes cada consumidor la recalculaba recorriendo el
// array entero desde dentro de otro recorrido del array, y el panel lo hacía además en la vela en curso.
if barstate.isconfirmed and zones.size() > 0
    for z in zones
        z.htfConf := f_htfConf(z)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ CICLO DE VIDA Y VERIFICACIÓN (solo vela cerrada)
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Cada bloque tocado entra en evaluación, como si lo operaras: entrada en el proximal, stop por mecha
// un colchón más allá del distal, objetivo a la misma distancia (1R). AGUANTA si llega al objetivo
// dentro de la ventana; FALLA si salta el stop, si el bloque se rompe, o si se agota la ventana.
// Reglas simétricas y pesimistas — si los bloques no valieran nada, esto daría ~50%.

var int   evN       = 0   // operaciones simuladas resueltas
var int   evHeld    = 0   // ... que alcanzaron el objetivo (1R)
var int   evHeld2   = 0   // ... que alcanzaron el doble (2R)
var int   evTimeout = 0   // ... cerradas por agotarse la ventana, sin saltar el stop
var float evRSum    = 0.0 // suma de recorridos máximos a favor
// [v4.6] Las cerradas por ventana SIN haber alcanzado el objetivo doble no son una pérdida de 1R: se sale
// a mercado y te llevas lo que haya. Se cuentan aparte y con su resultado real para que la esperanza deje
// de castigarlas como si hubieran saltado el stop.
var int   evMkt     = 0   // ... liquidadas A MERCADO sin llegar al objetivo doble: reloj o invalidación
var float evXSum    = 0.0 // suma de SUS resultados reales en R (puede ser negativa)
// [v3.3] Doce cortes de los mismos datos. Los tres últimos son EL CORTE CLAVE: si los bloques de 1m son
// ruido pero los de 15m o 1H tienen ventaja, el problema no es el motor sino el marco en el que se aplica.
// [v3.5] Los dos últimos cortes parten el histórico por la mitad. Es la defensa más importante de todas:
// una ventaja REAL aparece en las dos mitades. Si solo está en una, la produjo un periodo concreto y no
// el bloque — que es exactamente lo que hace sospechar que MES saliera +0.28 y MNQ −0.18 en TODAS sus
// filas a la vez: un desplazamiento uniforme delata al periodo, no al nivel.
// [v3.9] Tres cortes nuevos de CONTEXTO —sesión, sesgo del marco superior y descuento/premium— porque
// son las variables que quedaron fuera en v3.0 y nunca se volvieron a medir. No tocan el score: entran
// aquí, que es donde se decide con datos si aportan algo.
var array<int>   bN = array.new<int>(34, 0)    // operaciones del corte
var array<int>   b1 = array.new<int>(34, 0)    // ... que llegaron al objetivo
var array<int>   b2 = array.new<int>(34, 0)    // ... que llegaron al doble
var array<float> bS = array.new<float>(34, 0.0) // suma de MFE
var array<int>   bT = array.new<int>(34, 0)    // [v3.4] ... cerradas por ventana agotada
var array<float> bC = array.new<float>(34, 0.0) // [v3.7] suma del coste en R (depende del tamaño de cada R)
var array<int>   bM = array.new<int>(34, 0)     // [v4.6] ... liquidadas a mercado sin llegar al objetivo doble
var array<float> bX = array.new<float>(34, 0.0) // [v4.6] suma de SUS resultados reales en R
// [v5.3] Suma de CUADRADOS del resultado neto en R de cada operación. Es lo único que faltaba para poder
// calcular la varianza del corte y, con ella, el error típico de la esperanza: sin eso la tabla enseñaba
// un punto sin margen y no había forma de distinguir una ventaja real de la suerte de una muestra corta.
var array<float> bR2 = array.new<float>(34, 0.0)
// [v6.6] Operación con entrada en el 50% del bloque: 0 todas · 1 1ª mitad · 2 2ª mitad.
var array<int>   mN  = array.new<int>(3, 0)
var array<int>   m1  = array.new<int>(3, 0)
var array<int>   m2  = array.new<int>(3, 0)
var array<float> mS  = array.new<float>(3, 0.0)
var array<int>   mT  = array.new<int>(3, 0)
var array<float> mC  = array.new<float>(3, 0.0)
var array<int>   mM  = array.new<int>(3, 0)
var array<float> mX  = array.new<float>(3, 0.0)
var array<float> mR2 = array.new<float>(3, 0.0)
var float        evR2Sum = 0.0
var float        evCSum = 0.0

// [v4.6] FRONTERA DE LAS DOS MITADES, CONGELADA EN LA PRIMERA VELA. `last_bar_index / 2` se reevaluaba en
// cada operación: en histórico da lo mismo, pero en cuanto el gráfico avanza en tiempo real la frontera se
// desplaza y las operaciones ya contabilizadas quedan clasificadas con un corte distinto del de las nuevas.
// Las dos mitades dejaban de ser comparables — y son la defensa más importante de toda la tabla.
var int splitBar = int(last_bar_index / 2)

bool  touched   = false
bool  brokeAny  = false
bool  touchDemQ = false   // [v3.8] toque en demanda que además pasa el score mínimo
bool  touchSupQ = false
// Los breakers se acumulan aparte: no se puede modificar el array mientras se recorre.
var int brkSeq = 0
array<Zone> newBrk = array.new<Zone>()

// [v3.6] Evaluaciones abiertas, RECALCULADAS cada vela desde el estado real de los bloques. Antes era un
// contador acumulado y se atascaba: un bloque descartado por el tope de memoria se llevaba su cuenta sin
// devolverla, y con el modo "una operación a la vez" eso acababa bloqueando la muestra a media serie
// (11 operaciones, todas en la primera mitad, cero en la segunda). Recalculado no puede desincronizarse.
int evOpen = 0
if zones.size() > 0
    for z in zones
        if z.evalOn and not z.resolved
            evOpen += 1
// [v4.6] El hueco se congela AQUÍ, antes de recorrer los bloques. Antes se liberaba dentro del bucle, al
// resolverse una operación, de modo que un bloque tocado en esta misma vela podía ocupar el hueco — pero
// solo si estaba más adelante en el array. Quién entraba en la muestra lo decidía el orden de creación de
// los bloques, no lo que hizo el mercado. Ahora: como mucho una apertura por vela, y quien cierra libera
// el hueco para la SIGUIENTE, que es como funcionaría una cuenta de verdad.
bool slotFree = evOpen == 0

if barstate.isconfirmed and zones.size() > 0
    for z in zones
        if not z.broken
            bool inside = high >= z.bot and low <= z.top
            bool brk    = z.isDem ? (invalidBy == "Cierre" ? close < z.bot : low < z.bot) : (invalidBy == "Cierre" ? close > z.top : high > z.top)
            float h     = math.max(z.top - z.bot, syminfo.mintick)

            // Toque nuevo: el precio salió y volvió.
            if inside and not z.wasInside
                z.touches += 1
                touched := true
                // [v3.8] Alerta útil = lado + calidad + nivel, no "algo ha pasado". Una alerta que no te
                // dice cuál de los dieciséis bloques del gráfico se ha tocado no sirve para reaccionar.
                float tsc = f_score(z, z.touches - 1)
                if tsc >= minScore
                    if z.isDem
                        touchDemQ := true
                    else
                        touchSupQ := true
                    alert('{"event":"SD_TOUCH","side":"' + (z.isDem ? "LONG" : "SHORT") + '","ticker":"' + syminfo.ticker + '","tf":"' + z.tfLbl + '","type":"' + f_typeTxt(z) + '","proximal":' + str.tostring(z.isDem ? z.top : z.bot, format.mintick) + ',"distal":' + str.tostring(z.isDem ? z.bot : z.top, format.mintick) + ',"score":' + str.tostring(math.round(tsc)) + ',"grade":"' + f_grade(tsc) + '","touch":' + str.tostring(z.touches) + ',"mitigated_pct":' + str.tostring(math.round(z.deepest * 100)) + '}', alert.freq_once_per_bar_close)
                // [v3.5] Con "una operación a la vez", un bloque tocado mientras otro sigue abierto NO
                // entra en la muestra: sería el mismo movimiento contado dos veces.
                if not z.evalOn and not z.resolved and (not oneAtATime or slotFree)
                    z.evalOn   := true
                    z.evalBar  := bar_index
                    slotFree   := false
                    // [v3.7] Stop y riesgo se CONGELAN aquí. Antes se recalculaban cada vela con el ATR
                    // del momento, así que el stop se movía solo durante la operación.
                    // [v4.1] El colchón se escala con la volatilidad DEL MARCO DEL BLOQUE (raíz del tiempo,
                    // que es como escala la volatilidad). Con el ATR del gráfico, un bloque de 1H en un
                    // gráfico de 15m recibía un colchón de 15 minutos: un stop demasiado estrecho que lo
                    // sacaba antes de tiempo y hundía artificialmente las filas de marco superior.
                    float atrBlk = atrC * math.sqrt(math.max(1.0, z.tfSec / float(chartSec)))
                    float prox0  = z.isDem ? z.top : z.bot
                    // [v4.6] La UNIDAD DE LA CARRERA fija también el stop. Con "ATR" el objetivo se medía
                    // en ATR mientras el stop seguía clavado en el distal más el colchón: dos distancias
                    // distintas, justo la asimetría que v3.2 corrigió para el otro modo y que reaparecía
                    // aquí. Con el stop derivado de la unidad, objetivo y stop están siempre a la misma
                    // distancia y el ~50% de referencia sigue valiendo en los dos modos.
                    if reactUnit == "R del bloque"
                        z.stopPx  := z.isDem ? z.bot - atrBlk * evalBufAtr : z.top + atrBlk * evalBufAtr
                        z.riskPts := math.max(z.isDem ? prox0 - z.stopPx : z.stopPx - prox0, syminfo.mintick)
                    else
                        z.riskPts := math.max(atrBlk, syminfo.mintick)
                        z.stopPx  := z.isDem ? prox0 - z.riskPts : prox0 + z.riskPts
                    z.htfAt    := z.htfConf >= 0.5
                    z.scoreAt  := f_score(z, z.touches - 1)
                    // [v3.9] Contexto CONGELADO en el momento del toque: es lo que sabías al decidir.
                    z.rthAt    := inRTH
                    z.biasAt   := not biasTfOK or htfDir == 0 ? 0 : (z.isDem ? htfDir : -htfDir)
                    // [v4.1] MARGEN DE BENEFICIO (Seiden): borde del bloque contrario vivo más cercano en la
                    // dirección del trade, en R. Sin bloque contrario delante = camino despejado = suficiente.
                    float oppPx = na
                    for o in zones
                        if f_live(o) and o.isDem != z.isDem and (z.isDem ? o.bot > z.top : o.top < z.bot)
                            float e = z.isDem ? o.bot : o.top
                            oppPx := na(oppPx) ? e : (z.isDem ? math.min(oppPx, e) : math.max(oppPx, e))
                    float rrTo = na(oppPx) ? na : (z.isDem ? oppPx - z.top : z.bot - oppPx) / z.riskPts
                    // [v4.2] El corte exige que HAYA un muro y esté lejos. Contando también "no hay bloque
                    // contrario delante" como margen suficiente, el atributo salía al 93% de frecuencia —el
                    // mismo vicio que el FVG— porque con pocos bloques vivos casi nunca hay muro. Así mide
                    // lo que de verdad distingue: un nivel con recorrido por delante frente a uno ahogado.
                    z.rrAt     := not na(rrTo) and rrTo >= rrMin
                    // [v4.1] LLEGADA (Seiden): recorrido neto de las últimas velas al tocar. Acelerando =
                    // ofensiva que suele atravesar; controlada = retroceso que respeta.
                    z.softAt   := math.abs(close - close[arrBars]) / math.max(atrC, syminfo.mintick) <= arrMax
                    // [v4.9] CONTEXTO INSTITUCIONAL. VWAP: comprar una demanda por debajo del precio medio
                    // ponderado de la sesión —o vender una oferta por encima— es operar del lado bueno de
                    // la referencia contra la que se mide la ejecución. Se mide en el PROXIMAL, que es
                    // donde entrarías, no en el cierre.
                    z.vwapAt   := vwapOK and (z.isDem ? prox0 < vwapV : prox0 > vwapV)
                    // Banda σ: el toque alcanzó el extremo estadístico de la sesión, donde se espera
                    // reversión a la media. Por mecha, que es como se tocan las bandas.
                    z.sigmaAt  := vwapOK and (z.isDem ? low <= vwapL : high >= vwapU)
                    z.kzAt     := kzIn
                    // Liquidez D/W: un bloque construido sobre PDH/PDL/PWH/PWL no se formó en cualquier
                    // sitio, se formó sobre stops preparados.
                    z.liqAt    := f_onLiq(prox0)
                    // [v5.0] DESCUENTO EN EL MOMENTO DE DECIDIR. `z.pd` es una propiedad del NACIMIENTO
                    // del bloque (su punto medio, en el rango de entonces) y como tal alimenta el score.
                    // Pero lo que decide una entrada es si el PROXIMAL está en descuento AHORA, con el
                    // rango de ahora. Son dos preguntas distintas y solo se medía la primera; van las dos
                    // a la tabla, en filas contiguas, para poder compararlas.
                    float pdNow = f_pdPos(prox0)
                    z.pdAtFav  := not na(pdNow) and (z.isDem ? pdNow <= 0.5 : pdNow >= 0.5)
                    // [v5.1] OTE: no basta con estar en la mitad buena del rango —eso es media escala—,
                    // sino en la franja estrecha del retroceso donde ICT sitúa la entrada óptima.
                    z.oteAt    := f_inOte(prox0, z.isDem)
                    z.mtArm    := true
                    z.mtStart  := bar_index

            // Mitigación: hasta dónde ha penetrado el precio, medido con la mecha.
            if inside
                z.deepest := math.max(z.deepest, z.isDem ? (z.top - low) / h : (high - z.bot) / h)

            // [v6.6] OPERACIÓN EN EL 50% (mean threshold). Orden límite en el punto medio del bloque, con
            // el MISMO stop que la principal: la R es más pequeña y el objetivo, en SU R, más cercano. Si
            // el precio no llega al 50% antes de que el bloque se rompa o se agote la ventana, NO hay
            // operación: no cuenta ni como ganada ni como perdida. Mismas reglas pesimistas: stop primero
            // y por mecha, y la vela del llenado no suma recorrido a favor.
            if z.mtArm and not z.mtDone
                float mid  = (z.top + z.bot) / 2
                int   mWin = reactWindow * f_blkBars(z)
                if not z.mtFill
                    if z.isDem ? low <= mid : high >= mid
                        z.mtFill := true
                        z.mtBar  := bar_index
                        z.mtRisk := math.max(z.isDem ? mid - z.stopPx : z.stopPx - mid, syminfo.mintick)
                    else if brk or (reactWindow > 0 and bar_index - z.mtStart >= mWin)
                        z.mtDone := true
                if z.mtFill and not z.mtDone
                    bool mSh  = z.isDem ? low <= z.stopPx : high >= z.stopPx
                    if not mSh and bar_index > z.mtBar
                        z.mtMfe := math.max(z.mtMfe, (z.isDem ? high - mid : mid - low) / z.mtRisk)
                    bool mOut = reactWindow > 0 and bar_index - z.mtBar >= mWin
                    if mSh or brk or mOut
                        z.mtDone := true
                        float mx   = mSh ? -1.0 : (z.isDem ? close - mid : mid - close) / z.mtRisk
                        float mt2  = reactTarget * 2
                        float mcr  = costTicks * syminfo.mintick / z.mtRisk
                        bool  mMkt = z.mtMfe < mt2 and mx > -1.0
                        float mNet = (z.mtMfe >= mt2 ? mt2 : mMkt ? mx : -1.0) - mcr
                        int   mh   = z.mtStart < splitBar ? 1 : 2
                        for i = 0 to 2
                            if i == 0 or i == mh
                                mN.set(i, mN.get(i) + 1)
                                mS.set(i, mS.get(i) + z.mtMfe)
                                mC.set(i, mC.get(i) + mcr)
                                mR2.set(i, mR2.get(i) + mNet * mNet)
                                if z.mtMfe >= reactTarget
                                    m1.set(i, m1.get(i) + 1)
                                if z.mtMfe >= mt2
                                    m2.set(i, m2.get(i) + 1)
                                if mOut and not mSh and not brk
                                    mT.set(i, mT.get(i) + 1)
                                if mMkt
                                    mM.set(i, mM.get(i) + 1)
                                    mX.set(i, mX.get(i) + mx)

            // Muerte del bloque (usa la invalidación que hayas elegido: es otra pregunta distinta).
            bool resolvedNow = false
            bool byTime      = false
            if brk
                z.broken := true
                brokeAny := true
                if z.evalOn and not z.resolved
                    z.resolved  := true
                    resolvedNow := true
                    // [v5.4] LA CUARTA VÍA. Hasta v5.3 esta rama cerraba la operación SIN mirar el stop:
                    // `exitR` se quedaba en na y se apuntaba −1R entera aunque el stop no se hubiera
                    // tocado — el mismo defecto que v4.6 corrigió para los cierres por reloj, reaparecido
                    // por otra puerta. Y en modo MECHA era demoledor: la rotura (low < distal) SIEMPRE
                    // precede al stop (low ≤ distal − colchón), así que la maquinaria de stop, ventana y
                    // salida a mercado —v3.2 a v4.6— no llegaba a ejecutarse nunca y toda pérdida se
                    // apuntaba al máximo.
                    // Ahora: stop primero y por mecha; si no saltó, se liquida a mercado con su resultado
                    // real, que por construcción es mejor que −1R (si la mecha no alcanzó el stop, el
                    // cierre tampoco). El bloque muere igual: es la operación la que deja de mentir.
                    float bPx = z.isDem ? z.top : z.bot
                    float bRk = math.max(z.riskPts, syminfo.mintick)
                    bool  bSh = z.isDem ? low <= z.stopPx : high >= z.stopPx
                    z.exitR   := bSh ? -1.0 : (z.isDem ? close - bPx : bPx - close) / bRk

            // [v3.3] LA OPERACIÓN COMPLETA. Hasta v3.2 la prueba se cerraba al tocar 1R, así que no podía
            // ver el recorrido posterior: respondía "¿aguantó?" pero no "¿hay ventaja?". Dos sistemas con
            // el mismo 48% de aciertos son cosas opuestas si uno corre hasta 3R y el otro se para en 1R.
            // Ahora la operación vive hasta que salta el stop o se agota la ventana, registrando el
            // RECORRIDO MÁXIMO A FAVOR (MFE) en R. Con eso se puede calcular la esperanza a cualquier
            // objetivo, que es la única pregunta que importa.
            if z.evalOn and not z.resolved
                float prox   = z.isDem ? z.top : z.bot
                float stopPx = z.stopPx
                // [v4.6] Una sola unidad: la distancia proximal→stop, sea cual sea el modo. Es lo que se
                // arriesga y es lo que separa el objetivo del stop.
                float unit   = z.riskPts
                // El stop se comprueba PRIMERO y por mecha: si una vela hace las dos cosas no sabemos el
                // orden intravela, y lo honesto es dar por perdida esa vela.
                bool stopHit = z.isDem ? low <= stopPx : high >= stopPx
                if not stopHit and bar_index > z.evalBar
                    z.mfe := math.max(z.mfe, (z.isDem ? high - prox : prox - low) / unit)
                // [v3.4] La ventana se cuenta en velas DEL MARCO DEL BLOQUE, no del gráfico. Antes un
                // bloque de 15m tenía 20 velas de 1m — veinte minutos — para hacer un recorrido que
                // necesita horas: salía con MFE 0.41 y esperanza −1, que no medía el bloque sino el reloj.
                int win = reactWindow * f_blkBars(z)
                if stopHit or (reactWindow > 0 and bar_index - z.evalBar >= win)
                    z.resolved  := true
                    resolvedNow := true
                    if stopHit
                        z.exitR := -1.0
                    else
                        byTime    := true
                        evTimeout += 1
                        // [v4.6] Salida A MERCADO: el resultado es el recorrido neto en el momento de
                        // cerrar, que es lo que te llevas de verdad. Puede ser positivo o negativo, pero
                        // no es −1R: el stop no llegó a saltar.
                        z.exitR := (z.isDem ? close - prox : prox - close) / unit

            if resolvedNow
                float m  = z.mfe
                float t1 = reactTarget
                float t2 = reactTarget * 2
                // [v3.7] Coste en R de ESTA operación: los mismos ticks pesan mucho más cuando la R es
                // pequeña, así que no se puede restar un promedio global al final.
                float cr = costTicks * syminfo.mintick / math.max(z.riskPts, syminfo.mintick)
                // [v4.6] Tres desenlaces, no dos. Si el MFE alcanzó el objetivo doble, la operación se
                // habría cerrado AHÍ aunque luego saltara el stop o expirara el reloj: cuenta como ganada.
                // Si no lo alcanzó y la ventana se agotó, se liquida a mercado con su resultado real. Solo
                // el resto —stop tocado sin haber pasado por el objetivo— pierde la R entera.
                // [v5.4] Una salida es "a mercado" cuando NO fue un stop, venga del reloj o de la
                // invalidación del bloque. Antes lo decidía `byTime`, que dejaba fuera las roturas y las
                // mandaba a la rama de −1R. `byTime` sigue significando solo "se agotó el reloj": es otra
                // pregunta, alimenta la columna T/o y no cambia.
                bool  toMkt = m < t2 and not na(z.exitR) and z.exitR > -1.0
                float xr    = toMkt ? z.exitR : 0.0
                // [v5.3] Resultado NETO en R de esta operación concreta, con la regla de los tres
                // desenlaces y descontado su coste. Sumado da exactamente la misma esperanza que la
                // fórmula reconstruida de v4.6; elevado al cuadrado da la varianza, que es lo que faltaba.
                float rNet  = (m >= t2 ? t2 : toMkt ? xr : -1.0) - cr
                evN     += 1
                evRSum  += m
                evCSum  += cr
                evR2Sum += rNet * rNet
                if m >= t1
                    evHeld += 1
                if m >= t2
                    evHeld2 += 1
                if toMkt
                    evMkt  += 1
                    evXSum += xr
                bool early = z.evalBar < splitBar
                bool pdFav = na(z.pd) ? false : (z.isDem ? z.pd <= 0.5 : z.pd >= 0.5)
                for k = 0 to 33
                    // [v6.6] "R ≥ N ticks" en k==30 y la combinación base 1v + suave + descuento en k==31.
                    // [v4.8] CHoCH en k==5. [v5.6] "base tranquila" en k==9. [v5.0] "al tocar" en k==14.
                    // [v5.1] OTE en k==15. [v4.9] Institucionales en k==18..21.
                    // [v6.0] DISP en k==6, LIQ pasa a "sweep > 0" en k==7 y POOL entra en k==8.
                    bool has = k == 0 ? z.scoreAt >= gradeAp : k == 1 ? (z.scoreAt >= gradeA and z.scoreAt < gradeAp) : k == 2 ? z.scoreAt < gradeA : k == 3 ? z.fvg : k == 4 ? z.bos : k == 5 ? z.choch : k == 6 ? z.hasDisp : k == 7 ? z.sweep > 0 : k == 8 ? z.sweep == 2 : k == 9 ? z.htfAt : k == 10 ? (z.baseTight and z.baseN <= 1) : k == 11 ? (not na(z.bvol) and z.bvol <= baseVolMax) : k == 12 ? z.isOrigin : k == 13 ? z.kind == 2 : k == 14 ? z.kind == 3 : k == 15 ? z.momOut : k == 16 ? z.rthAt : k == 17 ? z.biasAt == 1 : k == 18 ? pdFav : k == 19 ? z.pdAtFav : k == 20 ? z.oteAt : k == 21 ? z.rrAt : k == 22 ? z.softAt : k == 23 ? z.vwapAt : k == 24 ? z.sigmaAt : k == 25 ? z.kzAt : k == 26 ? z.liqAt : k == 27 ? z.tfIdx == 0 : k == 28 ? z.tfIdx == 1 : k == 29 ? z.tfIdx == 2 : k == 30 ? z.riskPts / syminfo.mintick >= cutMinTicks : k == 31 ? (z.baseTight and z.baseN <= 1 and z.softAt and z.pdAtFav) : k == 32 ? early : not early
                    if has
                        bN.set(k, bN.get(k) + 1)
                        bS.set(k, bS.get(k) + m)
                        bC.set(k, bC.get(k) + cr)
                        if m >= t1
                            b1.set(k, b1.get(k) + 1)
                        if m >= t2
                            b2.set(k, b2.get(k) + 1)
                        if byTime
                            bT.set(k, bT.get(k) + 1)
                        bR2.set(k, bR2.get(k) + rNet * rNet)
                        if toMkt
                            bM.set(k, bM.get(k) + 1)
                            bX.set(k, bX.get(k) + xr)

            // BREAKER: la rotura CON DESPLAZAMIENTO no solo mata el bloque, cambia el control. El mismo
            // rango queda como bloque contrario. Sin desplazamiento la rotura es deriva y el bloque
            // simplemente muere. Nace con el precio dentro: tiene que alejarse y volver.
            if brk and useBreaker and math.abs(close - open) >= atrC * breakerDispAtr
                brkSeq += 1
                // [v3.9] Faltaba tfIdx: los breakers nacían con marco `na` y se caían de los tres cortes
                // por marco de la tabla — se medían en el total pero en ninguna de sus filas.
                Zone b = Zone.new(top = z.top, bot = z.bot, isDem = not z.isDem, t0 = time, guid = -brkSeq, tfSec = z.tfSec, tfLbl = z.tfLbl, disp = math.abs(close - open) / math.max(atrC, syminfo.mintick), ratio = legRatioMin, rvol = na, bvol = na, fvg = false, bos = true, choch = true, ztype = 1, sweep = 0, hasDisp = false, kind = 4, baseN = 1, legN = 1, momOut = false, baseTight = true, isOrigin = false, pd = f_pdPos((z.top + z.bot) / 2), tfIdx = z.tfIdx, bar0 = bar_index)
                b.isBreaker := true
                b.wasInside := true
                newBrk.push(b)

            z.wasInside := inside

if newBrk.size() > 0
    for b in newBrk
        zones.push(b)
        // [v4.6] El breaker nace después de la pasada de confluencia de esta vela: se la calcula él.
        b.htfConf := f_htfConf(b)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ DIBUJO (objetos pre-asignados; solo se mueven coordenadas)
// ═══════════════════════════════════════════════════════════════════════════════════════════════

var array<box>  slotBox  = array.new<box>()
var array<box>  slotMit  = array.new<box>()
var array<line> slotLine = array.new<line>()

if barstate.isfirst
    for i = 1 to maxRender
        slotBox.push(box.new(na, na, na, na, xloc = xloc.bar_time, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom))
        slotMit.push(box.new(na, na, na, na, xloc = xloc.bar_time, border_width = 0))
        slotLine.push(line.new(na, na, na, na, xloc = xloc.bar_time, width = 2))

f_render() =>
    int nz       = zones.size()
    int rendered = 0
    if nz > 0
        // [v3.8] Se dibujan los bloques MÁS CERCANOS AL PRECIO, no los más recientes. Antes el tope de
        // dibujo se llenaba con los últimos nacidos, que suelen quedar lejos, y el nivel hacia el que el
        // precio se dirige —el único que importa ahora mismo— podía no pintarse.
        array<float> scs  = array.new<float>(nz, na)
        array<bool>  used = array.new<bool>(nz, true)
        for i = 0 to nz - 1
            Zone z = zones.get(i)
            if f_live(z)
                float sc = f_score(z, z.touches)
                if sc >= showMinScore and not (showFresh and z.touches > 0)
                    scs.set(i, sc)
                    used.set(i, false)
        for slot = 1 to maxRender
            int   best  = -1
            float bestD = na
            for i = 0 to nz - 1
                if not used.get(i)
                    Zone  o = zones.get(i)
                    float d = math.abs(close - (o.isDem ? o.top : o.bot))
                    if na(bestD) or d < bestD
                        bestD := d
                        best  := i
            if best < 0
                break
            used.set(best, true)
            Zone   z   = zones.get(best)
            float  sc  = scs.get(best)
            box    b   = slotBox.get(rendered)
            box    mb  = slotMit.get(rendered)
            line   l   = slotLine.get(rendered)
            color  cz  = z.isDem ? colDem : colSup
            // [v4.3] La transparencia iba atada a 80/70 fijos. Al endurecer FVG y momentum en v3.9 casi
            // todos los bloques cayeron por debajo de 70 y acabaron pintándose al 84% —90% si estaban
            // tocados—, es decir, invisibles sobre fondo oscuro. Ahora sigue a los umbrales de grado y
            // parte de una opacidad que tú controlas.
            // [v4.5] El clamp va DESPUÉS de sumar el recargo por bloque tocado. Antes se limitaba a 95 y
            // luego se le sumaban 6: con zoneOpac alto daba 101, y Pine rechaza cualquier transparencia
            // por encima de 100 — error en tiempo de ejecución, no un fallo visual.
            int    tr0 = sc >= gradeAp ? zoneOpac - 8 : sc >= gradeA ? zoneOpac : zoneOpac + 8
            int    tr  = math.max(0, math.min(100, tr0 + (z.touches > 0 ? 6 : 0)))
            int    xr  = time + chartSec * 1000 * extendBars
            float  hh  = z.top - z.bot
            string tch = z.touches > 0 ? " · T" + str.tostring(z.touches) : ""
            box.set_lefttop(b, z.t0, z.top)
            box.set_rightbottom(b, xr, z.bot)
            box.set_bgcolor(b, color.new(cz, tr))
            box.set_border_color(b, color.new(cz, 40))
            box.set_text(b, z.tfLbl + " " + f_typeTxt(z) + " · " + str.tostring(math.round(sc)) + " " + f_grade(sc) + f_tags(z) + tch)
            box.set_text_color(b, color.new(color.white, 15))
            // [v3.8] Franja de MITIGACIÓN: la parte del bloque que el precio ya se ha comido. Se veía
            // solo como "M62%" en el texto; dibujada, se entiende de un vistazo cuánto queda vivo.
            if z.deepest >= 0.03
                box.set_lefttop(mb, z.t0, z.isDem ? z.top : z.bot + hh * z.deepest)
                box.set_rightbottom(mb, xr, z.isDem ? z.top - hh * z.deepest : z.bot)
                box.set_bgcolor(mb, color.new(cz, 55))
            else
                box.set_lefttop(mb, na, na)
                box.set_rightbottom(mb, na, na)
            float prox = z.isDem ? z.top : z.bot
            line.set_xy1(l, z.t0, prox)
            line.set_xy2(l, xr, prox)
            line.set_color(l, color.new(cz, 0))
            rendered += 1
    // Los huecos sobrantes se aparcan fuera del gráfico.
    if rendered < slotBox.size()
        for j = rendered to slotBox.size() - 1
            box.set_lefttop(slotBox.get(j), na, na)
            box.set_rightbottom(slotBox.get(j), na, na)
            box.set_lefttop(slotMit.get(j), na, na)
            box.set_rightbottom(slotMit.get(j), na, na)
            line.set_xy1(slotLine.get(j), na, na)
            line.set_xy2(slotLine.get(j), na, na)

if showZones and barstate.islast
    f_render()

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ DIBUJO DEL CONTEXTO INSTITUCIONAL  [v4.9]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [v5.2] `vwapOK`, no `vwapOn`: fuera de intradía el ancla salta en cada vela y el "VWAP" dibujado era
// el hlc3 de cada barra — una línea sin significado. La medición ya lo filtraba; el dibujo no.
plot(vwapOK and vwapShow ? vwapV : na, "VWAP sesión",  color = color.new(vwapCol, 0),  linewidth = 2)
plot(vwapOK and vwapShow ? vwapU : na, "VWAP banda +", color = color.new(vwapBCol, 40))
plot(vwapOK and vwapShow ? vwapL : na, "VWAP banda −", color = color.new(vwapBCol, 40))

// PDH/PDL/PWH/PWL con objetos pre-asignados, igual que los bloques: solo se mueven coordenadas.
var array<line>  liqLn  = array.new<line>()
var array<label> liqLb  = array.new<label>()
var array<box>   oteBox = array.new<box>()
if barstate.isfirst
    // [v5.0] 7 ranuras: 4 de liquidez D/W + el techo, el equilibrio y el suelo del rango operativo.
    for i = 1 to 7
        liqLn.push(line.new(na, na, na, na, xloc = xloc.bar_time, style = line.style_dashed, width = 1))
        liqLb.push(label.new(na, na, "", xloc = xloc.bar_time, style = label.style_none, size = size.tiny))
    for i = 1 to 2
        oteBox.push(box.new(na, na, na, na, xloc = xloc.bar_time, text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top))

// [v6.0] FVG: una ranura por hueco en memoria. Abiertos en un color, invertidos en otro — que es el
// punto: un FVG invertido ya no es el mismo nivel, actúa del lado contrario.
var array<box> fvgBx = array.new<box>()
if barstate.isfirst
    for i = 1 to 40
        fvgBx.push(box.new(na, na, na, na, xloc = xloc.bar_time, border_width = 0))

f_fvgDraw() =>
    int n = 0
    if fvgOn and fvgShow and fvgs.size() > 0
        for f in fvgs
            if n < fvgBx.size()
                box b = fvgBx.get(n)
                color c = f.inverted ? fvgInvCol : fvgCol
                box.set_lefttop(b, f.t0, f.top)
                box.set_rightbottom(b, time + chartSec * 1000 * extendBars, f.bot)
                box.set_bgcolor(b, color.new(c, f.inverted ? 80 : 88))
                box.set_border_color(b, color.new(c, 55))
                n += 1
    if n < fvgBx.size()
        for j = n to fvgBx.size() - 1
            box.set_lefttop(fvgBx.get(j), na, na)
            box.set_rightbottom(fvgBx.get(j), na, na)

// [v5.1] Franja OTE: caja extendida a la derecha, con su etiqueta en el borde superior.
f_oteBox(int slot, bool show, float top, float bot, string txt, color c) =>
    box b = oteBox.get(slot)
    if show and not na(top) and not na(bot) and top > bot
        box.set_lefttop(b, time - chartSec * 1000 * 100, top)
        box.set_rightbottom(b, time + chartSec * 1000 * extendBars, bot)
        box.set_bgcolor(b, color.new(c, 88))
        box.set_border_color(b, color.new(c, 55))
        box.set_text(b, txt)
        box.set_text_color(b, color.new(c, 20))
    else
        box.set_lefttop(b, na, na)
        box.set_rightbottom(b, na, na)

f_lvlLine(int slot, bool show, float px, string txt, color c) =>
    line  l = liqLn.get(slot)
    label b = liqLb.get(slot)
    if show and not na(px)
        int x1 = time - chartSec * 1000 * 100
        int x2 = time + chartSec * 1000 * extendBars
        line.set_xy1(l, x1, px)
        line.set_xy2(l, x2, px)
        line.set_color(l, color.new(c, 30))
        label.set_xy(b, x2, px)
        label.set_text(b, txt)
        label.set_textcolor(b, color.new(c, 0))
    else
        line.set_xy1(l, na, na)
        line.set_xy2(l, na, na)
        label.set_xy(b, na, na)

if barstate.islast
    f_fvgDraw()
    bool lqShow = liqOn and liqShow
    f_lvlLine(0, lqShow, pdH, "PDH", liqDCol)
    f_lvlLine(1, lqShow, pdL, "PDL", liqDCol)
    f_lvlLine(2, lqShow, pwH, "PWH", liqWCol)
    f_lvlLine(3, lqShow, pwL, "PWL", liqWCol)
    // [v5.0] El rango operativo y su equilibrio. Ver el 50% dibujado es la mitad del valor de tener un
    // dealing range de verdad: por encima estás pagando premium y por debajo comprando con descuento.
    bool eqShow = rangeOK and showEq
    f_lvlLine(4, eqShow, dealHi, "Rango ↑", eqCol)
    f_lvlLine(5, eqShow, rangeOK ? (dealHi + dealLo) / 2 : na, "EQ 50%", eqCol)
    f_lvlLine(6, eqShow, dealLo, "Rango ↓", eqCol)
    // [v5.1] Las dos franjas OTE. Caja y no líneas porque el OTE es una ZONA, no un nivel: lo que
    // importa es ver de un vistazo si el proximal del bloque cae dentro. La de compra ocupa la parte
    // baja del rango y la de venta la alta; son simétricas y no se solapan.
    bool otShow = rangeOK and oteOn and not pdLegacy and showOte
    f_oteBox(0, otShow and (not oteDir or rLeg == 1),  f_pdPx(1.0 - f_oteLo()), f_pdPx(1.0 - f_oteHi()), "OTE compra", oteBuyCol)
    f_oteBox(1, otShow and (not oteDir or rLeg == -1), f_pdPx(f_oteHi()),       f_pdPx(f_oteLo()),       "OTE venta",  oteSellCol)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ PANEL
// ═══════════════════════════════════════════════════════════════════════════════════════════════

f_row(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.tiny, text_halign = text.align_left)

f_pctTxt(int part, int whole) =>
    whole > 0 ? str.tostring(part / float(whole) * 100.0, "#") + "%" : "—"

// [v3.8] Una fila del panel para el bloque más cercano por arriba o por abajo. Es lo único de toda la
// pantalla que responde a la pregunta que de verdad te haces mirando el gráfico: ¿dónde está el siguiente
// nivel y a cuánto lo tengo?
f_nearRow(table t, int r, string k, bool found, float px, float sc, float dist, float hgt, color cz) =>
    string v = "—"
    color  c = color.gray
    if found
        bool dentro = dist <= 0
        // Precio · a cuánto está · R del bloque (proximal→distal: lo que arriesgarías) · calidad.
        v := str.tostring(px, format.mintick) + "  ·  " + (dentro ? "DENTRO" : str.tostring(dist, format.mintick) + " pts") + "  ·  R " + str.tostring(hgt, format.mintick) + "  ·  " + str.tostring(math.round(sc)) + " " + f_grade(sc)
        c := dentro ? #FFD700 : cz
    f_row(t, r, k, v, c)

f_dash() =>
    // Recuento de bloques vivos. Se hace aquí, no en el bucle de ciclo de vida, porque ese solo corre en
    // vela cerrada y el panel se dibuja también sobre la vela en curso.
    int   cntDem   = 0
    int   cntSup   = 0
    float bestLive = 0.0
    // Bloque más cercano a cada lado: la demanda de proximal más ALTO que el precio aún no ha roto, y la
    // oferta de proximal más BAJO. Si el precio está dentro de uno, ese gana por definición.
    bool  hasD = false
    bool  hasS = false
    float dPx  = na
    float dSc  = na
    float dHt  = na
    float sPx  = na
    float sSc  = na
    float sHt  = na
    if zones.size() > 0
        for z in zones
            if f_live(z)
                float sc = f_score(z, z.touches)
                bestLive := math.max(bestLive, sc)
                // [v4.5] La R que se muestra incluye el COLCHÓN más allá del distal, igual que la que usa
                // la tabla de verificación. Antes mostraba solo la altura de la caja: la cifra con la que
                // dimensionabas la posición era menor que la que el indicador usa para medirse a sí mismo.
                float rk = (z.top - z.bot) + atrC * math.sqrt(math.max(1.0, z.tfSec / float(chartSec))) * evalBufAtr
                if z.isDem
                    cntDem += 1
                    if z.bot <= close and (not hasD or z.top > dPx)
                        hasD := true
                        dPx  := z.top
                        dSc  := sc
                        dHt  := rk
                else
                    cntSup += 1
                    if z.top >= close and (not hasS or z.bot < sPx)
                        hasS := true
                        sPx  := z.bot
                        sSc  := sc
                        sHt  := rk

    var table tb = table.new(position.top_right, 2, 10, bgcolor = color.new(#0D1117, 5), border_width = 1, border_color = color.new(color.gray, 80))
    table.cell(tb, 0, 0, "S&D BLOCKS v6.6", text_color = #FFD700, bgcolor = #161B22, text_size = size.small)
    table.cell(tb, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.white, bgcolor = #161B22, text_size = size.small)

    // Lo accionable primero: dónde está el siguiente nivel a cada lado.
    f_nearRow(tb, 1, "▲ Oferta arriba",   hasS, sPx, sSc, sPx - close, sHt, colSup)
    f_nearRow(tb, 2, "▼ Demanda abajo",   hasD, dPx, dSc, close - dPx, dHt, colDem)

    // [v3.9] Una sola fila de contexto: sesión, sesgo del marco superior y posición en el rango. Las tres
    // cosas que cambian cómo lees un bloque, sin gastar tres filas en decirlas.
    float  pdNow = f_pdPos(close)
    string sSess = inRTH ? "RTH" : "nocturna"
    string sBias = not biasTfOK ? "⚠ marco ≤ gráfico" : htfDir == 1 ? "▲ alcista" : htfDir == -1 ? "▼ bajista" : "— sin sesgo"
    // [v5.2] Si el OTE está pedido pero el modo de rango no lo permite, se dice — antes callaba y la
    // columna vacía parecía "no hay setup" cuando en realidad era "no se está midiendo".
    string sOte  = oteOn and pdLegacy ? " · OTE n/d (rango legado)" : f_inOte(close, true) ? " · OTE compra" : f_inOte(close, false) ? " · OTE venta" : ""
    string sPd   = not rangeOK ? "s/d" : str.tostring(pdNow * 100, "#") + "% " + (pdNow >= 0.5 ? "premium" : "descuento") + sOte
    f_row(tb, 3, "Contexto", sSess + "  ·  " + sBias + " " + f_tfLabel(biasTf) + "  ·  " + sPd, not inRTH ? #FFA726 : htfDir == 1 ? #00E676 : htfDir == -1 ? #FF5252 : color.white)

    string sMarcos = (tf1Use ? f_tfLabel(tf1) + " " : "") + (tf2Use ? f_tfLabel(tf2) + " " : "") + (tf3Use ? f_tfLabel(tf3) : "")
    f_row(tb, 4, "Bloques vivos", "D " + str.tostring(cntDem) + " · S " + str.tostring(cntSup) + " · " + sMarcos + (tfIgnored ? " ⚠" : "") + (bestLive > 0 ? " · mejor " + str.tostring(math.round(bestLive)) : ""), tfIgnored ? #FFA726 : color.white)

    // [v4.9] Fila institucional: de qué lado del VWAP estás, si es kill zone y si el precio anda pegado
    // a la liquidez del día o la semana previos. Las tres se leen de un vistazo antes de apretar.
    string sVw = not vwapOK ? "s/d" : close >= vwapV ? "▲ sobre VWAP" : "▼ bajo VWAP"
    string sKz = not (timeframe.isintraday and kzOn) ? "—" : kzIn ? "KZ ✓" : "fuera de KZ"
    string sLq = not liqOn ? "—" : f_onLiq(close) ? "⚠ sobre liquidez D/W" : "sin liquidez cerca"
    int fvgOpen = 0
    int fvgInv  = 0
    if fvgOn and fvgs.size() > 0
        for f in fvgs
            if f.inverted
                fvgInv += 1
            else
                fvgOpen += 1
    f_row(tb, 5, "Institucional", sVw + "  ·  " + sKz + "  ·  " + sLq + (fvgOn ? "  ·  FVG " + str.tostring(fvgOpen) + "/" + str.tostring(fvgInv) + " inv" : ""), not vwapOK ? color.gray : kzIn ? #00E676 : color.white)

    // [v3.8] El embudo de formación es diagnóstico, no operativa: fuera del panel salvo que lo pidas.
    if showFunnel
        f_row(tb, 6, "Detectados", str.tostring(fnDet), color.white)
        f_row(tb, 7, "Sin huella ✖", str.tostring(fnFp) + " · " + f_pctTxt(fnFp, fnDet), fnDet > 0 and fnFp > fnDet / 2 ? #FFA726 : color.gray)
        f_row(tb, 8, "Duplicados ✖", str.tostring(fnDup) + " · " + f_pctTxt(fnDup, fnDet), color.gray)
        f_row(tb, 9, "Registrados", str.tostring(fnReg) + " · " + f_pctTxt(fnReg, fnDet), fnReg > 0 ? #00E676 : #FF5252)

if showDash and barstate.islast
    f_dash()

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ TABLA DE VERIFICACIÓN
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Si A+ no aguanta más que B, el score está mal y hay que cambiarlo. Si una columna de atributo no se
// separa de la media, ese odds enhancer no está aportando nada medible EN ESTE activo y marco.

// FREC. es imprescindible: sin ella no se distingue un atributo que NO FUNCIONA de uno que tiene CASI
// TODO EL MUNDO. Un atributo presente en el 90% de los bloques no puede separar nada por definición.
// [v3.3] ESP. es la columna que decide: esperanza en R operando ese corte con objetivo al DOBLE del
// objetivo base y stop a 1R. Positiva = ventaja real. Es lo único que no se puede discutir.
// [v4.6] La esperanza tiene ahora TRES desenlaces. Antes toda operación que no llegaba al objetivo doble
// restaba 1R entera, incluidas las que el reloj cerró sin que el stop llegara a saltar — y con filas al
// 35-40% de cierres por tiempo, ese error se comía media fila. Ahora:
//   · MFE ≥ objetivo doble           → +2T  (habrías salido en el objetivo)
//   · ventana agotada sin llegar ahí → su resultado REAL a mercado, positivo o negativo
//   · el resto (stop tocado)         → −T
// `nm` = operaciones liquidadas a mercado · `sx` = suma de sus resultados en R.
// [v5.3] SEMIANCHO DEL INTERVALO DE CONFIANZA AL 95% de la esperanza. `sq` es la suma de cuadrados del
// resultado neto por operación; con la media ya conocida sale la varianza muestral, de ahí el error
// típico y de ahí el margen. Normal en vez de t de Student: con n≥30 la diferencia es despreciable y por
// debajo de 30 el problema no es la distribución elegida, es que no hay muestra.
// Esto es lo que convierte la columna Esp. de "parece positivo" a "distinguible de cero o no".
f_ci95(int n, float mean, float sq) =>
    float o = na
    if n > 1 and not na(mean) and not na(sq)
        float varr = math.max(0.0, (sq - n * mean * mean) / (n - 1))
        o := 1.96 * math.sqrt(varr / n)
    o

// [v5.3] El color de Esp. ya NO depende de un umbral fijo (+0.15) que ignoraba el tamaño de la muestra:
// depende de si el INTERVALO excluye el cero. Verde = ventaja distinguible del azar. Rojo = desventaja
// distinguible. Amarillo = la muestra no permite decidir, que con n corta es casi siempre — y saberlo es
// justamente el punto. Gris = por debajo de la muestra mínima.
f_espCol(int n, float esp, float ci) =>
    n < evalMinN or na(esp) or na(ci) ? color.gray : esp - ci > 0 ? #00E676 : esp + ci < 0 ? #FF5252 : #FFD700

f_evRow(table t, int r, string k, int n, int n1, int n2, float sm, int nt, float sc, int nm, float sx, float sq, int total, bool head) =>
    float p1   = n > 0 ? n1 / float(n) * 100.0 : na
    float p2   = n > 0 ? n2 / float(n) : na
    // [v3.7] NETA de costes: el coste medio en R de este corte, que no es el mismo para todos porque
    // depende del tamaño de la R de cada operación.
    float esp  = n <= 0 ? na : (n2 * (reactTarget * 2) + sx - (n - n2 - nm) - sc) / n
    float freq = total > 0 ? n / float(total) * 100.0 : na
    float pto  = n > 0 ? nt / float(n) * 100.0 : na
    // [v5.4] Lo que de verdad se sacó de las salidas A MERCADO — reloj agotado o bloque invalidado, todo
    // lo que no fue un stop. Si es muy negativo, esa fila no está midiendo niveles que aguanten: está
    // midiendo precio que se queda muerto dentro del bloque.
    float pxr  = nm > 0 ? sx / nm : na
    float ci   = f_ci95(n, esp, sq)
    color c    = n < evalMinN ? color.gray : color.white
    color ce   = f_espCol(n, esp, ci)
    color cf   = na(freq) ? color.gray : freq >= 80 ? #FFA726 : color.gray
    // [v3.4] Muchos cierres por tiempo = la fila mide el reloj, no el bloque. Se avisa en naranja.
    color ct   = na(pto) ? color.gray : pto >= 35 ? #FFA726 : color.gray
    table.cell(t, 0, r, k, text_color = head ? color.white : color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, r, str.tostring(n), text_color = c, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 2, r, head or na(freq) ? "—" : str.tostring(freq, "#") + "%", text_color = cf, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 3, r, na(p1) ? "—" : str.tostring(p1, "#") + "%", text_color = c, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 4, r, na(p2) ? "—" : str.tostring(p2 * 100, "#") + "%", text_color = c, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 5, r, n > 0 ? str.tostring(sm / n, "#.##") : "—", text_color = c, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 6, r, na(pto) ? "—" : str.tostring(pto, "#") + "%", text_color = ct, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 7, r, na(pxr) ? "—" : (pxr >= 0 ? "+" : "") + str.tostring(pxr, "#.##"), text_color = na(pxr) ? color.gray : c, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 8, r, na(esp) ? "—" : (esp >= 0 ? "+" : "") + str.tostring(esp, "#.##"), text_color = ce, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 9, r, na(ci) ? "—" : "±" + str.tostring(ci, "#.##"), text_color = na(ci) ? color.gray : c, text_size = size.tiny, text_halign = text.align_right)

// [v3.9] Fila compacta del modo Resumen: solo N, aciertos al objetivo doble y esperanza neta. Con esas
// tres cifras y las dos mitades ya se decide; lo demás es investigación.
f_evMini(table t, int r, string k, int n, int n2, float sc, int nm, float sx, float sq, bool head) =>
    float p2  = n > 0 ? n2 / float(n) : na
    // [v4.6] Misma fórmula de tres desenlaces que la tabla completa.
    float esp = n <= 0 ? na : (n2 * (reactTarget * 2) + sx - (n - n2 - nm) - sc) / n
    float ci  = f_ci95(n, esp, sq)
    color c   = n < evalMinN ? color.gray : color.white
    color ce  = f_espCol(n, esp, ci)
    table.cell(t, 0, r, k, text_color = head ? color.white : color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, r, str.tostring(n), text_color = c, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 2, r, na(p2) ? "—" : str.tostring(p2 * 100, "#") + "%", text_color = c, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 3, r, na(esp) ? "—" : (esp >= 0 ? "+" : "") + str.tostring(esp, "#.##"), text_color = ce, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 4, r, na(ci) ? "—" : "±" + str.tostring(ci, "#.##"), text_color = na(ci) ? color.gray : c, text_size = size.tiny, text_halign = text.align_right)

f_evalTable() =>
    bool   full = evalMode == "Completo"
    string sT1  = str.tostring(reactTarget, "#.#") + "R"
    string sT2  = str.tostring(reactTarget * 2, "#.#") + "R"
    var table ev = table.new(position.bottom_right, 10, 41, bgcolor = color.new(#0D1117, 5), border_width = 1, border_color = color.new(color.gray, 80))
    array<string> bNames = array.from("Grado A+", "Grado A", "Grado B", "con FVG", "con BOS", "  · de ellos CHoCH", "con DISPLACEMENT", "con LIQ", "  · de ellos POOL", "con MTF", "base 1 vela", "base tranquila ≤" + str.tostring(baseVolMax, "#.#") + "x", "origen del movimiento", "Mitigation Block", "Rejection Block", "con MOM", "toque en RTH", "a favor del sesgo", "con descuento (al nacer)", "  · y al tocar", "  · y en OTE " + str.tostring(math.min(oteLo, oteHi) * 100, "#") + "-" + str.tostring(math.max(oteLo, oteHi) * 100, "#") + "%", "muro lejos ≥" + str.tostring(rrMin, "#.#") + "R", "llegada suave", "a favor del VWAP", "en banda " + str.tostring(vwapSigma, "#.#") + "σ", "en kill zone", "sobre liquidez D/W", "Marco " + f_tfLabel(tf1), "Marco " + f_tfLabel(tf2), "Marco " + f_tfLabel(tf3), "R ≥ " + str.tostring(cutMinTicks) + " ticks", "base 1v + suave + descuento", "▸ 1ª MITAD", "▸ 2ª MITAD")

    if full
        table.cell(ev, 0, 0, "Operación simulada", text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_left)
        table.cell(ev, 1, 0, "N",      text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 2, 0, "Frec.",  text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 3, 0, "≥" + sT1, text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 4, 0, "≥" + sT2, text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 5, 0, "MFE",    text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 6, 0, "T/o",    text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 7, 0, "M/R",    text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 8, 0, "Esp.",   text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 9, 0, "IC 95%", text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        f_evRow(ev, 1, "TODOS", evN, evHeld, evHeld2, evRSum, evTimeout, evCSum, evMkt, evXSum, evR2Sum, evN, true)
        for k = 0 to 33
            f_evRow(ev, k + 2, bNames.get(k), bN.get(k), b1.get(k), b2.get(k), bS.get(k), bT.get(k), bC.get(k), bM.get(k), bX.get(k), bR2.get(k), evN, false)
        // [v6.6] La operación en el 50%, con sus dos mitades. Frec. = de cada 100 operaciones principales,
        // cuántas llegaron a llenar la orden del 50%.
        f_evRow(ev, 36, "ENTRADA EN EL 50%", mN.get(0), m1.get(0), m2.get(0), mS.get(0), mT.get(0), mC.get(0), mM.get(0), mX.get(0), mR2.get(0), evN, false)
        f_evRow(ev, 37, "  · 1ª mitad", mN.get(1), m1.get(1), m2.get(1), mS.get(1), mT.get(1), mC.get(1), mM.get(1), mX.get(1), mR2.get(1), evN, false)
        f_evRow(ev, 38, "  · 2ª mitad", mN.get(2), m1.get(2), m2.get(2), mS.get(2), mT.get(2), mC.get(2), mM.get(2), mX.get(2), mR2.get(2), evN, false)
        table.cell(ev, 0, 39, "sin resolver: " + str.tostring(zUnres) + " · mitades en v" + str.tostring(splitBar) + (oneAtATime ? " · UNA OPERACIÓN A LA VEZ" : ""), text_color = oneAtATime ? #FFD700 : color.gray, text_size = size.tiny, text_halign = text.align_left)
        for c = 1 to 8
            table.cell(ev, c, 39, "", text_size = size.tiny)
        table.cell(ev, 9, 39, "stop " + sT1 + " / " + str.tostring(reactWindow) + "v · " + str.tostring(costTicks, "#.#") + "t", text_color = color.gray, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 0, 40, "VERDE = el IC excluye el cero · AMARILLO = la muestra no decide · M/R = R media de las salidas a mercado (reloj o invalidación, nunca stop) · 34 cortes: exígelo en las dos MITADES y en los dos activos · ENTRADA EN EL 50%: mismo stop, R menor; Frec. = % de operaciones que llenaron el 50%", text_color = color.new(color.gray, 35), text_size = size.tiny, text_halign = text.align_left)
        for c = 1 to 9
            table.cell(ev, c, 40, "", text_size = size.tiny)
    else
        table.cell(ev, 0, 0, "Verificación", text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_left)
        table.cell(ev, 1, 0, "N",       text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 2, 0, "≥" + sT2, text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 3, 0, "Esp.",    text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        table.cell(ev, 4, 0, "IC 95%",  text_color = #FFD700, bgcolor = #161B22, text_size = size.tiny, text_halign = text.align_right)
        f_evMini(ev, 1, "TODOS",      evN,        evHeld2,    evCSum,     evMkt,      evXSum,     evR2Sum,     true)
        f_evMini(ev, 2, "▸ 1ª mitad", bN.get(32), b2.get(32), bC.get(32), bM.get(32), bX.get(32), bR2.get(32), false)
        f_evMini(ev, 3, "▸ 2ª mitad", bN.get(33), b2.get(33), bC.get(33), bM.get(33), bX.get(33), bR2.get(33), false)
        f_evMini(ev, 4, "ENTRADA EN EL 50%", mN.get(0), m2.get(0), mC.get(0), mM.get(0), mX.get(0), mR2.get(0), false)
        table.cell(ev, 0, 5, "verde solo si el IC excluye el cero · las mitades deben coincidir en signo", text_color = color.new(color.gray, 35), text_size = size.tiny, text_halign = text.align_left)
        for c = 1 to 4
            table.cell(ev, c, 5, "", text_size = size.tiny)

if showEval and barstate.islast
    f_evalTable()

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ PRICE ACTION · OLIVER VELEZ  —  MÓDULO AISLADO, SOLO PINTA  [v4.0]
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// AISLADO A PROPÓSITO. Todo lo que hay debajo de esta línea calcula sus propios valores, lee los bloques
// solo para consultar si el precio está dentro de alguno, y su única salida al gráfico es barcolor() más
// una etiqueta opcional. Ninguna variable de aquí entra en la detección, el score, el ciclo de vida ni la
// tabla de verificación: puedes encender y apagar este módulo entero y las estadísticas no se mueven un
// decimal. Por eso está al final — para que sea imposible que se cuele hacia arriba.
//
// Todas las definiciones se miden en ATR y en porcentaje del rango, no en puntos, así que valen igual en
// MNQ que en MES y en cualquier marco.

float paRng  = high - low
float paBody = math.abs(close - open)
float paUpW  = high - math.max(open, close)
float paDnW  = math.min(open, close) - low
bool  paUp   = close > open
bool  paDn   = close < open
float paPrvB = math.abs(close[1] - open[1])
float paPrvR = high[1] - low[1]
float paHH   = ta.highest(high, eleClear)[1]
float paLL   = ta.lowest(low,  eleClear)[1]
float paAvgV = ta.sma(volume, 20)
bool  paVol  = not eleVol or na(paAvgV) or paAvgV <= 0 or volume > paAvgV
bool  paOK   = paMode != "Desactivado" and not na(atrC) and atrC > 0 and paRng > 0

// ── Definiciones ──────────────────────────────────────────────────────────────────────────────
// ELEPHANT (Velez): cuerpo institucional que limpia las velas previas, con volumen detrás.
bool eleU = paOK and eleOn and paUp and paBody >= atrC * eleBody and paBody >= paRng * eleBodyP / 100.0 and close > paHH and paVol
bool eleD = paOK and eleOn and paDn and paBody >= atrC * eleBody and paBody >= paRng * eleBodyP / 100.0 and close < paLL and paVol
// SHAVED: cierra en su extremo, sin mecha a favor.
bool shvU = paOK and shvOn and paUp and paRng >= atrC * shvRng and paBody >= paRng * 0.6 and paUpW <= paRng * shvWick / 100.0
bool shvD = paOK and shvOn and paDn and paRng >= atrC * shvRng and paBody >= paRng * 0.6 and paDnW <= paRng * shvWick / 100.0
// PIN / TAIL (Velez): mecha dominante y cuerpo pequeño — rechazo puro.
bool pinU = paOK and pinOn and paRng >= atrC * pinRng and paDnW >= paRng * pinWick / 100.0 and paBody <= paRng * pinBodyP / 100.0
bool pinD = paOK and pinOn and paRng >= atrC * pinRng and paUpW >= paRng * pinWick / 100.0 and paBody <= paRng * pinBodyP / 100.0
// 180 (Velez): vela con cuerpo real anulada por la siguiente, que cierra más allá de su apertura.
bool v18U = paOK and v18On and paPrvR > 0 and close[1] < open[1] and paPrvB >= paPrvR * 0.6 and paUp and paBody >= paRng * v18Body / 100.0 and paBody >= paPrvB * v18Size / 100.0 and close > open[1]
bool v18D = paOK and v18On and paPrvR > 0 and close[1] > open[1] and paPrvB >= paPrvR * 0.6 and paDn and paBody >= paRng * v18Body / 100.0 and paBody >= paPrvB * v18Size / 100.0 and close < open[1]
// OUTSIDE: envuelve el rango previo y cierra más allá de su extremo.
bool outU = paOK and outOn and high > high[1] and low < low[1] and close > high[1] and paRng >= atrC * outRng
bool outD = paOK and outOn and high > high[1] and low < low[1] and close < low[1]  and paRng >= atrC * outRng
// RBI / GBI (Velez): vela contraria pequeña que la siguiente ignora. Continuación.
bool rbiU = paOK and rbiOn and close[1] < open[1] and paPrvB <= atrC * rbiSmall and paUp and close > high[1]
bool rbiD = paOK and rbiOn and close[1] > open[1] and paPrvB <= atrC * rbiSmall and paDn and close < low[1]
// INSIDE: compresión dentro de la vela madre.
bool insB = paOK and insOn and high <= high[1] and low >= low[1]

// AGOTAMIENTO 3-5-8 (Velez): velas consecutivas del mismo color. Solo muta en vela cerrada, como el resto
// del script, así que la cuenta que ves es la de la última vela confirmada.
var int paRunU = 0
var int paRunD = 0
if barstate.isconfirmed
    paRunU := paUp ? paRunU + 1 : 0
    paRunD := paDn ? paRunD + 1 : 0
bool exhU = paOK and exhOn and paRunU >= exhA
bool exhD = paOK and exhOn and paRunD >= exhA

// ── ¿Está el precio dentro de un bloque vivo? SOLO LECTURA ────────────────────────────────────
bool paInDem = false
bool paInSup = false
if paMode == "Solo dentro de bloques" and zones.size() > 0
    for z in zones
        if f_live(z) and high >= z.bot and low <= z.top
            if z.isDem
                paInDem := true
            else
                paInSup := true

// ── Prioridad: de lo más específico a lo más genérico. Una vela = un patrón, o el gráfico se vuelve
// ilegible. Para cambiar el orden efectivo, apaga el patrón que te esté tapando al de debajo.
string paName = ""
color  paCol  = na
bool   paBull = true
if eleU
    paName := "ELE"
    paCol  := eleCUp
else if eleD
    paName := "ELE"
    paCol  := eleCDn
    paBull := false
else if v18U
    paName := "180"
    paCol  := v18CUp
else if v18D
    paName := "180"
    paCol  := v18CDn
    paBull := false
else if outU
    paName := "OUT"
    paCol  := outCUp
else if outD
    paName := "OUT"
    paCol  := outCDn
    paBull := false
else if pinU
    paName := "PIN"
    paCol  := pinCUp
else if pinD
    paName := "PIN"
    paCol  := pinCDn
    paBull := false
else if shvU
    paName := "SHV"
    paCol  := shvCUp
else if shvD
    paName := "SHV"
    paCol  := shvCDn
    paBull := false
else if rbiU
    paName := "RBI"
    paCol  := rbiCUp
else if rbiD
    paName := "GBI"
    paCol  := rbiCDn
    paBull := false
else if insB
    paName := "IN"
    paCol  := insCol
else if exhU
    paName := paRunU >= exhB ? "8" : "5"
    paCol  := exhCol
else if exhD
    paName := paRunD >= exhB ? "8" : "5"
    paCol  := exhCol
    paBull := false

// El inside bar y el agotamiento no tienen dirección propia, así que el filtro por bloque los deja pasar
// esté el precio donde esté; los demás solo pintan con el nivel a favor.
bool paNeutral = paName == "IN" or paName == "5" or paName == "8"
bool paCtxOK   = paMode != "Solo dentro de bloques" or paNeutral or (paBull ? paInDem : paInSup)
color paFinal  = paName != "" and paCtxOK ? color.new(paCol, paOpac) : na

barcolor(paFinal, title = "Price Action · Velez")

if paTagOn and not na(paFinal) and barstate.isconfirmed
    label.new(bar_index, paBull ? low : high, paName, style = paBull ? label.style_label_up : label.style_label_down, color = color.new(paCol, 25), textcolor = color.white, size = size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ ALERTAS
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Para webhook usa "Cualquier llamada a alert()": entrega el JSON completo del bloque (SD_BLOCK).

alertcondition(newBlock,  "🧱 Bloque nuevo",      "{{ticker}} {{interval}} · Bloque de oferta/demanda registrado")
alertcondition(touchDemQ, "🟢 DEMANDA tocada",    "{{ticker}} {{interval}} · El precio entra en una demanda de score suficiente @ {{close}}")
alertcondition(touchSupQ, "🔴 OFERTA tocada",     "{{ticker}} {{interval}} · El precio entra en una oferta de score suficiente @ {{close}}")
alertcondition(touched,   "👀 Bloque tocado (cualquiera)", "{{ticker}} {{interval}} · El precio entra en un bloque @ {{close}}")
alertcondition(brokeAny,  "⚠️ Bloque roto",       "{{ticker}} {{interval}} · Bloque invalidado @ {{close}}")
