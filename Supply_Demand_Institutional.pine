// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// SMC + VWAP · INSTITUTIONAL v7.0
// Smart Money Concepts puro, confirmado por las bandas VWAP · Price Action de Oliver Velez
// TF operativo 1-15 min · MNQ / MES
//
// v7.0 — REINGENIERÍA: LOS BLOQUES DE OFERTA/DEMANDA SE SUSTITUYEN POR SMC PURO
//   El motor de oferta/demanda de v1-v6.7 (score, embudo, tabla de verificación, MTF) se retira entero;
//   su historial queda en git. El módulo de Price Action de Oliver Velez se conserva tal cual.
//
//   ① ESTRUCTURA. Swings por pivotes confirmados (N velas a cada lado, sin repintado). Un CIERRE más
//     allá del último swing vivo es una rotura: BOS si va a favor de la estructura vigente, CHoCH si va
//     en contra. Cada swing se gasta con su primera rotura.
//   ② ORDER BLOCK. En cada rotura: el extremo del tramo que rompió (mínimo para alcista, máximo para
//     bajista) y la ÚLTIMA vela de color contrario en ese extremo o justo antes. La zona va de su máximo
//     a su mínimo, estirada hasta el extremo del tramo para que el stop quede fuera de la mecha.
//     Por defecto se exige DESPLAZAMIENTO: el impulso tiene que haber dejado un FVG.
//   ③ CONFIRMACIÓN VWAP (sesión, bandas σ). Un OB solo se pinta y se opera si pasa la regla elegida:
//     · Tendencia: la rotura cierra del lado bueno del VWAP (compras sobre él, ventas bajo él).
//     · Descuento: el OB está del lado barato del VWAP (demanda bajo él, oferta sobre él).
//     · Banda σ: el OB alcanza la banda 1σ contraria (extremo de la sesión, reversión a la media).
//   ④ LIQUIDEZ. Máximos/mínimos iguales (EQH/EQL) y barridos de swing con mecha que cierran dentro.
//   ⑤ FVG. Huecos de tres velas, vivos hasta que el precio los rellena.
//   ⑥ TRADING. Cada OB pintado abre su operación con su stop y su objetivo: por defecto con orden límite
//     en el proximal (retest), o a mercado al formarse. Stop a 2 ticks más allá del OB y objetivo 3R.
//   ⑦ PRICE ACTION · VELEZ. Sin cambios; "Solo dentro de OB" lee ahora los order blocks.
//
//   SIN REPINTADO: todo se calcula en vela cerrada. La orden límite del retest se coloca al cierre de la
//   vela que confirma el OB y se llena cuando el precio vuelve al proximal (máx. N velas de espera). En
//   modo mercado se llena al cierre de esa misma vela (process_orders_on_close).
//   Comisión y deslizamiento se configuran en Propiedades: sin ellos el backtest sale optimista.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

strategy("SMC + VWAP Institutional v7.0", shorttitle="SMC VWAP", overlay=true,
     max_boxes_count=500, max_labels_count=500, max_lines_count=500, max_bars_back=500,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=10,
     calc_on_every_tick=false, process_orders_on_close=true)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ TIPOS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

type OB
    box    bx
    float  top
    float  bot
    bool   bull
    bool   choch
    bool   fvg
    bool   conf               // pasó la confirmación VWAP: se pinta y se opera
    int    bar0               // vela de la rotura que lo creó
    bool   touched = false
    string oid     = ""       // orden límite pendiente (modo retest); vacío si no hay o ya se llenó

type Gap
    box   bx
    float top
    float bot
    bool  bull

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ INPUTS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

gSt = "① Estructura SMC"
gOb = "② Order Blocks"
gVw = "③ Confirmación VWAP"
gLq = "④ Liquidez"
gFv = "⑤ Fair Value Gaps"
gTr = "⑥ Trading automático"
gPa = "⑦ Price Action · Oliver Velez"
gVs = "⑧ Panel y alertas"

swingLen   = input.int(5, "Longitud del swing (velas a cada lado)", minval=2, maxval=30, group=gSt, tooltip="Un pivote alto/bajo necesita N velas a cada lado para confirmarse. 3-5 en 1-5 min; 5-10 en 15 min. Más alto = estructura más mayor y menos señales.")
showStruct = input.bool(true, "Dibujar BOS / CHoCH", group=gSt)
showSwings = input.bool(false, "Marcar swings (HH · HL · LH · LL)", group=gSt)
colBull    = input.color(#089981, "Alcista", inline="cs", group=gSt)
colBear    = input.color(#F23645, "Bajista", inline="cs", group=gSt)

obFrom     = input.string("BOS y CHoCH", "Crear OB en", options=["BOS y CHoCH", "Solo CHoCH", "Solo BOS"], group=gOb, tooltip="CHoCH: el OB que origina el cambio de carácter (giro). BOS: el OB de continuación tras romper a favor.")
obNeedFvg  = input.bool(true, "Exigir desplazamiento (FVG en el impulso)", group=gOb, tooltip="SMC puro: un OB solo vale si el impulso que lo abandona dejó un desequilibrio (FVG). Sin él es una vela cualquiera.")
obLook     = input.int(10, "Búsqueda de la vela contraria (velas)", minval=1, maxval=50, group=gOb)
obMax      = input.int(5, "OB vivos por lado", minval=1, maxval=30, group=gOb)
obInval    = input.string("Cierre", "Invalidación", options=["Cierre", "Mecha"], group=gOb, tooltip="Cuándo muere el OB: con un CIERRE más allá del distal o con cualquier MECHA que lo atraviese.")
obShowUnc  = input.bool(false, "Mostrar OB sin confirmación VWAP (tenues, no se operan)", group=gOb)
obOpac     = input.int(70, "Transparencia", minval=0, maxval=95, group=gOb)

vwConf     = input.string("Tendencia", "Regla de confirmación", options=["Tendencia", "Descuento", "Banda σ", "Ninguna"], group=gVw, tooltip="TENDENCIA: la rotura cierra del lado bueno del VWAP (compras sobre él, ventas bajo él). DESCUENTO: el OB está del lado barato del VWAP (demanda bajo él, oferta sobre él). BANDA σ: el OB alcanza la banda 1σ contraria. NINGUNA: todo OB vale. Sin VWAP (sin volumen o fuera de intradía) solo pasa 'Ninguna'.")
vwSig1     = input.float(1.0, "Banda interior (σ)", minval=0.25, maxval=4.0, step=0.25, group=gVw)
vwSig2     = input.float(2.0, "Banda exterior (σ)", minval=0.5, maxval=5.0, step=0.25, group=gVw)
vwShow     = input.bool(true, "Dibujar VWAP y bandas", group=gVw)
vwCol      = input.color(#FF6D00, "VWAP", inline="vc", group=gVw)
vwBCol     = input.color(#5C6BC0, "bandas", inline="vc", group=gVw)

eqShow     = input.bool(true, "Máximos / mínimos iguales (EQH · EQL)", group=gLq)
eqTol      = input.float(0.1, "Tolerancia de igualdad (×ATR)", minval=0.01, maxval=1.0, step=0.01, group=gLq)
swpShow    = input.bool(true, "Barridos de liquidez ($)", group=gLq, tooltip="Mecha más allá de un swing vivo que cierra de vuelta dentro: tomó los stops sin romper la estructura.")

fvgShow    = input.bool(true, "Dibujar FVG", group=gFv)
fvgMin     = input.float(0.2, "Hueco mínimo (×ATR)", minval=0.0, step=0.05, group=gFv, tooltip="También es el tamaño mínimo del FVG que valida el desplazamiento de un OB.")
fvgMax     = input.int(10, "FVG vivos", minval=1, maxval=50, group=gFv)
fvgCol     = input.color(#42A5F5, "Color", group=gFv)

trOn       = input.bool(true, "Activar trading automático", group=gTr, tooltip="Cada OB pintado abre su operación con su stop y su take profit. Apagado, solo dibuja.")
trEntry    = input.string("Retest del OB (límite)", "Entrada", options=["Al formarse (mercado)", "Retest del OB (límite)"], group=gTr, tooltip="AL FORMARSE: orden a mercado al cierre de la vela que rompe la estructura y crea el OB. RETEST: orden límite en el proximal del OB, que espera a que el precio vuelva (entrada SMC clásica).")
trExpire   = input.int(100, "Retest: velas máximas de espera", minval=1, maxval=2000, group=gTr)
trDir      = input.string("Ambas", "Dirección", options=["Ambas", "Solo compras", "Solo ventas"], group=gTr)
trQty      = input.int(1, "Tamaño del lote (contratos)", minval=1, maxval=10, group=gTr)
trSlMode   = input.string("OB ± ticks", "Stop loss", options=["OB ± ticks", "Ticks desde la entrada"], group=gTr, tooltip="OB ± TICKS: N ticks por debajo del OB alcista o por encima del bajista. TICKS DESDE LA ENTRADA: distancia fija.")
trSlTicks  = input.int(2, "Stop loss: ticks", minval=0, maxval=5000, group=gTr)
trTpMode   = input.string("Ratio R:R", "Take profit", options=["Ratio R:R", "Ticks desde la entrada"], group=gTr)
trTpRR     = input.float(3.0, "Take profit: ratio R:R", minval=0.1, step=0.1, group=gTr)
trTpTicks  = input.int(40, "Take profit: ticks", minval=1, maxval=20000, group=gTr)

// ── ⑦ PRICE ACTION · OLIVER VELEZ ────────────────────────────────────────────────────────────
// Módulo PURAMENTE VISUAL y aislado: calcula sus propios patrones, solo llama a barcolor() y lee los
// OB en modo consulta. No toca la estructura, los OB, la confirmación VWAP ni las órdenes.
paMode   = input.string("Desactivado", "Pintar velas", options=["Desactivado", "Todas las velas", "Solo dentro de OB"], group=gPa, tooltip="Solo dentro de OB: las velas alcistas se pintan únicamente dentro de un OB alcista vivo, y las bajistas dentro de uno bajista. Es la lectura de Velez —la vela de giro vale donde hay un nivel detrás— pero es solo un filtro de PINTADO: no cambia ninguna señal.")
paTagOn  = input.bool(false, "Etiquetar el patrón sobre la vela", group=gPa)
paOpac   = input.int(0, "Transparencia del pintado", minval=0, maxval=90, group=gPa)

eleOn    = input.bool(true,  "Elephant",  inline="p1", group=gPa, tooltip="VELEZ · Elephant bar: cuerpo institucional que limpia las velas previas con volumen. Cuerpo ≥ N×ATR y ≥ N% del rango, cierre más allá de las últimas velas.")
eleBody  = input.float(1.0,  "×ATR",      inline="p1", group=gPa, step=0.1, minval=0.2)
eleBodyP = input.int(70,     "% rango",   inline="p1", group=gPa, minval=30, maxval=100)
eleCUp   = input.color(#00E676, "", inline="p1", group=gPa)
eleCDn   = input.color(#FF1744, "", inline="p1", group=gPa)
eleClear = input.int(3, "Elephant: velas previas que debe superar", minval=1, maxval=10, group=gPa)
eleVol   = input.bool(true, "Elephant: exigir volumen sobre la media de 20", group=gPa)

shvOn    = input.bool(true,  "Shaved",    inline="p2", group=gPa, tooltip="Shaved bar: cierra en su extremo, sin mecha a favor. Urgencia del comprador o del vendedor hasta el último tick.")
shvRng   = input.float(0.7,  "×ATR",      inline="p2", group=gPa, step=0.1, minval=0.2)
shvWick  = input.int(10,     "% mecha",   inline="p2", group=gPa, minval=0, maxval=40)
shvCUp   = input.color(#26C6DA, "", inline="p2", group=gPa)
shvCDn   = input.color(#EC407A, "", inline="p2", group=gPa)

pinOn    = input.bool(true,  "Pin / Tail", inline="p3", group=gPa, tooltip="VELEZ · Bottoming / Topping Tail: rechazo. Mecha dominante, cuerpo pequeño. La mecha es el rastro de las órdenes que absorbieron el movimiento.")
pinRng   = input.float(0.8,  "×ATR",      inline="p3", group=gPa, step=0.1, minval=0.2)
pinWick  = input.int(60,     "% mecha",   inline="p3", group=gPa, minval=40, maxval=90)
pinCUp   = input.color(#FFD700, "", inline="p3", group=gPa)
pinCDn   = input.color(#FF9800, "", inline="p3", group=gPa)
pinBodyP = input.int(30, "Pin: cuerpo máximo (% del rango)", minval=5, maxval=50, group=gPa)

v18On    = input.bool(true,  "180",        inline="p4", group=gPa, tooltip="VELEZ · 180 bar: una vela con cuerpo real anulada por la siguiente en sentido contrario, que cierra más allá de su apertura. El giro completo en dos velas.")
v18Body  = input.int(60,     "% rango",   inline="p4", group=gPa, minval=30, maxval=100)
v18Size  = input.int(80,     "% previa",  inline="p4", group=gPa, minval=40, maxval=200)
v18CUp   = input.color(#7C4DFF, "", inline="p4", group=gPa)
v18CDn   = input.color(#F50057, "", inline="p4", group=gPa)

outOn    = input.bool(true,  "Outside",   inline="p5", group=gPa, tooltip="Outside bar: envuelve el rango de la vela previa y cierra más allá de su extremo.")
outRng   = input.float(1.0,  "×ATR",      inline="p5", group=gPa, step=0.1, minval=0.3)
outCUp   = input.color(#64DD17, "", inline="p5", group=gPa)
outCDn   = input.color(#D50000, "", inline="p5", group=gPa)

rbiOn    = input.bool(true,  "RBI / GBI", inline="p6", group=gPa, tooltip="VELEZ · Red Bar Ignored / Green Bar Ignored: una vela contraria PEQUEÑA que la siguiente ignora por completo. Patrón de CONTINUACIÓN, no de giro.")
rbiSmall = input.float(0.5,  "cuerpo ×ATR", inline="p6", group=gPa, step=0.05, minval=0.1)
rbiCUp   = input.color(#1DE9B6, "", inline="p6", group=gPa)
rbiCDn   = input.color(#FF6E40, "", inline="p6", group=gPa)

insOn    = input.bool(true,  "Inside",    inline="p7", group=gPa, tooltip="Inside bar: compresión dentro de la vela madre. No dice dirección, dice que el mercado está decidiendo.")
insCol   = input.color(#9E9E9E, "", inline="p7", group=gPa)

exhOn    = input.bool(true,  "Agotamiento 3-5-8", inline="p8", group=gPa, tooltip="VELEZ · Regla 3-5-8: velas consecutivas del mismo color. A la quinta el movimiento está extendido; a la octava, agotado. Es la prioridad más baja: solo pinta si la vela no encaja en ningún otro patrón.")
exhA     = input.int(5,      "aviso",     inline="p8", group=gPa, minval=3, maxval=12)
exhB     = input.int(8,      "extremo",   inline="p8", group=gPa, minval=4, maxval=20)
exhCol   = input.color(#FFEA00, "", inline="p8", group=gPa)


showDash   = input.bool(true, "Panel", group=gVs)
alOb       = input.bool(true, "Alerta: OB confirmado (JSON)", group=gVs, tooltip="Crea la alerta con 'Cualquier llamada a alert()'. Las órdenes llevan su propio JSON (SMC_ORDER): alerta 'Ejecuciones de órdenes'.")
alStruct   = input.bool(false, "Alerta: BOS / CHoCH", group=gVs)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ CÁLCULOS BASE · VWAP DE SESIÓN CON BANDAS σ
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Calculado a mano y NO con ta.vwap: ta.vwap aborta el script en un símbolo sin volumen. Así el
// acumulador se queda en cero, el VWAP sale na y la confirmación simplemente no pasa.

atrC = ta.atr(14)
tk   = syminfo.mintick

var float vwSum = 0.0
var float vwVol = 0.0
var float vwSq  = 0.0
if timeframe.change("D")
    vwSum := 0.0
    vwVol := 0.0
    vwSq  := 0.0
float vwVol0 = na(volume) ? 0.0 : volume
vwSum += hlc3 * vwVol0
vwVol += vwVol0
vwSq  += hlc3 * hlc3 * vwVol0
// Fuera de intradía un VWAP de sesión no significa nada: el ancla saltaría en cada vela.
bool  vwapOK = timeframe.isintraday and vwVol > 0
float vwapV  = vwapOK ? vwSum / vwVol : na
float vwSd   = vwapOK ? math.sqrt(math.max(vwSq / vwVol - vwapV * vwapV, 0.0)) : na
float vwU1   = vwapV + vwSd * vwSig1
float vwL1   = vwapV - vwSd * vwSig1
float vwU2   = vwapV + vwSd * vwSig2
float vwL2   = vwapV - vwSd * vwSig2

pV  = plot(vwShow ? vwapV : na, "VWAP", color = vwCol, linewidth = 2, style = plot.style_linebr)
pU1 = plot(vwShow ? vwU1 : na, "VWAP +σ interior", color = color.new(vwBCol, 45), style = plot.style_linebr)
pL1 = plot(vwShow ? vwL1 : na, "VWAP −σ interior", color = color.new(vwBCol, 45), style = plot.style_linebr)
pU2 = plot(vwShow ? vwU2 : na, "VWAP +σ exterior", color = color.new(vwBCol, 15), style = plot.style_linebr)
pL2 = plot(vwShow ? vwL2 : na, "VWAP −σ exterior", color = color.new(vwBCol, 15), style = plot.style_linebr)
fill(pU1, pU2, color = color.new(vwBCol, 92), title = "Banda superior")
fill(pL1, pL2, color = color.new(vwBCol, 92), title = "Banda inferior")

// La regla de confirmación. Sin VWAP solo pasa "Ninguna": confirmar contra un dato que no existe sería
// aprobar a ciegas.
f_vwapConf(bool bull, float top, float bot) =>
    switch vwConf
        "Ninguna"   => true
        "Tendencia" => vwapOK and (bull ? close > vwapV : close < vwapV)
        "Descuento" => vwapOK and (bull ? top <= vwapV : bot >= vwapV)
        =>             vwapOK and (bull ? bot <= vwL1 : top >= vwU1)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ ESTADO
// ═══════════════════════════════════════════════════════════════════════════════════════════════

var array<OB>  obs  = array.new<OB>()
var array<Gap> gaps = array.new<Gap>()

var float  swHi     = na
var int    swHiBar  = na
var bool   swHiLive = false
var bool   swHiSwp  = false
var float  swLo     = na
var int    swLoBar  = na
var bool   swLoLive = false
var bool   swLoSwp  = false
var int    trend    = 0        // 1 alcista · -1 bajista · 0 sin estructura todavía
var string lastEvt  = "—"
var int    trN      = 0

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ CICLO DE VIDA DE LOS OB (antes de crear los de esta vela: un OB no se toca al nacer)
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// En modo retest la orden límite está en el proximal, así que el primer toque ES el llenado: a partir
// de ahí la operación vive sola con su stop y su objetivo, y lo que le pase al OB ya no la toca.

if obs.size() > 0
    for i = obs.size() - 1 to 0
        OB o = obs.get(i)
        if not o.touched and (o.bull ? low <= o.top : high >= o.bot)
            o.touched := true
            o.oid     := ""
            box.set_bgcolor(o.bx, color.new(o.bull ? colBull : colBear, math.min(obOpac + (o.conf ? 12 : 25), 95)))
        bool dead = o.bull ? (obInval == "Cierre" ? close : low) < o.bot : (obInval == "Cierre" ? close : high) > o.top
        bool late = o.oid != "" and bar_index - o.bar0 > trExpire
        if (dead or late) and o.oid != ""
            strategy.cancel(o.oid)
            strategy.cancel(o.oid + " X")
            o.oid := ""
        if dead
            box.delete(o.bx)
            obs.remove(i)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ FAIR VALUE GAPS
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Hueco de tres velas: el mínimo de la vela actual por encima del máximo de hace dos (alcista), o al
// revés. Vive hasta que el precio lo rellena entero.

if gaps.size() > 0
    for i = gaps.size() - 1 to 0
        Gap g = gaps.get(i)
        if g.bull ? low <= g.bot : high >= g.top
            box.delete(g.bx)
            gaps.remove(i)

bool fvgUp = low > high[2] and low - high[2] >= atrC * fvgMin
bool fvgDn = high < low[2] and low[2] - high >= atrC * fvgMin
if fvgShow and (fvgUp or fvgDn)
    float gT = fvgUp ? low : low[2]
    float gB = fvgUp ? high[2] : high
    box gb = box.new(time[1], gT, time, gB, xloc = xloc.bar_time, extend = extend.right, border_width = 0, bgcolor = color.new(fvgCol, 86), text = "FVG", text_size = size.tiny, text_color = color.new(fvgCol, 40), text_halign = text.align_left)
    gaps.push(Gap.new(gb, gT, gB, fvgUp))
    if gaps.size() > fvgMax
        box.delete(gaps.shift().bx)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ ESTRUCTURA · SWINGS Y LIQUIDEZ
// ═══════════════════════════════════════════════════════════════════════════════════════════════

float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)

if not na(ph)
    int pb = bar_index - swingLen
    // EQH: dos máximos al mismo precio sin que el primero se haya roto. Encima hay un pool de stops.
    if eqShow and swHiLive and math.abs(ph - swHi) <= atrC * eqTol
        line.new(swHiBar, swHi, pb, ph, color = color.new(colBear, 25), style = line.style_dotted)
        label.new(pb, math.max(ph, swHi), "EQH", style = label.style_label_down, color = #00000000, textcolor = colBear, size = size.tiny)
    if showSwings
        label.new(pb, ph, na(swHi) ? "H" : ph > swHi ? "HH" : "LH", style = label.style_label_down, color = #00000000, textcolor = color.gray, size = size.tiny)
    swHi     := ph
    swHiBar  := pb
    swHiLive := true
    swHiSwp  := false

if not na(pl)
    int pb = bar_index - swingLen
    if eqShow and swLoLive and math.abs(pl - swLo) <= atrC * eqTol
        line.new(swLoBar, swLo, pb, pl, color = color.new(colBull, 25), style = line.style_dotted)
        label.new(pb, math.min(pl, swLo), "EQL", style = label.style_label_up, color = #00000000, textcolor = colBull, size = size.tiny)
    if showSwings
        label.new(pb, pl, na(swLo) ? "L" : pl < swLo ? "LL" : "HL", style = label.style_label_up, color = #00000000, textcolor = color.gray, size = size.tiny)
    swLo     := pl
    swLoBar  := pb
    swLoLive := true
    swLoSwp  := false

// Barrido: la mecha toma los stops del swing y el CIERRE vuelve dentro. No rompe estructura.
if swHiLive and not swHiSwp and high > swHi and close <= swHi
    swHiSwp := true
    if swpShow
        label.new(bar_index, high, "$", style = label.style_label_down, color = #00000000, textcolor = colBear, size = size.small)
if swLoLive and not swLoSwp and low < swLo and close >= swLo
    swLoSwp := true
    if swpShow
        label.new(bar_index, low, "$", style = label.style_label_up, color = #00000000, textcolor = colBull, size = size.small)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ ROTURAS (BOS / CHoCH) → ORDER BLOCK → CONFIRMACIÓN VWAP → OPERACIÓN
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Una sola pasada para los dos lados (d = 0 alcista, d = 1 bajista), en línea y no en una función: la
// búsqueda lee la historia con desplazamiento variable y así no depende de dónde se llame.

bool brkUp = swHiLive and close > swHi
bool brkDn = swLoLive and close < swLo

for d = 0 to 1
    bool bull = d == 0
    if bull ? brkUp : brkDn
        bool  ch  = bull ? trend == -1 : trend == 1
        float lvl = bull ? swHi : swLo
        int   lb  = bull ? swHiBar : swLoBar
        color c   = bull ? colBull : colBear
        trend   := bull ? 1 : -1
        lastEvt := (ch ? "CHoCH" : "BOS") + (bull ? " ▲" : " ▼")
        if bull
            swHiLive := false
        else
            swLoLive := false
        if showStruct
            line.new(lb, lvl, bar_index, lvl, color = c, style = ch ? line.style_solid : line.style_dashed)
            label.new(int(math.round((lb + bar_index) / 2.0)), lvl, ch ? "CHoCH" : "BOS", style = bull ? label.style_label_down : label.style_label_up, color = #00000000, textcolor = c, size = size.tiny)
        if alStruct
            alert(syminfo.ticker + " " + timeframe.period + " · " + lastEvt + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

        int win = math.min(bar_index - lb, 300)
        if (obFrom == "BOS y CHoCH" or (obFrom == "Solo CHoCH") == ch) and win >= 1
            // Extremo del tramo que rompió: el mínimo (alcista) o el máximo (bajista) desde el swing roto.
            int   ext  = 1
            float extP = bull ? low[1] : high[1]
            if win >= 2
                for i = 2 to win
                    float p = bull ? low[i] : high[i]
                    if bull ? p < extP : p > extP
                        extP := p
                        ext  := i
            // La ÚLTIMA vela de color contrario en el extremo o justo antes. Si no la hay, el extremo.
            int obI = ext
            for k = ext to math.min(ext + obLook, win)
                if bull ? close[k] < open[k] : close[k] > open[k]
                    obI := k
                    break
            float top = bull ? high[obI] : math.max(high[obI], extP)
            float bot = bull ? math.min(low[obI], extP) : low[obI]
            // Desplazamiento: un FVG a favor dentro del impulso, del extremo a la vela de la rotura.
            bool fvg = false
            if ext >= 2
                for j = 0 to ext - 2
                    float g = bull ? low[j] - high[j + 2] : low[j + 2] - high[j]
                    if g > 0 and g >= atrC * fvgMin
                        fvg := true
                        break
            bool cf = f_vwapConf(bull, top, bot)
            if (fvg or not obNeedFvg) and top > bot and (cf or obShowUnc)
                string txt = (ch ? "OB · CHoCH" : "OB · BOS") + (fvg ? " · FVG" : "") + (cf ? "" : " · s/c")
                box bx = box.new(time[obI], top, time, bot, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(c, cf ? 30 : 75), bgcolor = color.new(c, cf ? obOpac : math.min(obOpac + 20, 95)), text = txt, text_size = size.tiny, text_color = color.new(c, cf ? 10 : 50), text_halign = text.align_right, text_valign = text.align_top)
                OB o = OB.new(bx = bx, top = top, bot = bot, bull = bull, choch = ch, fvg = fvg, conf = cf, bar0 = bar_index)
                obs.push(o)
                // Tope por lado: sale el más antiguo, con su orden pendiente si la tenía.
                int cnt = 0
                for x in obs
                    if x.bull == bull
                        cnt += 1
                if cnt > obMax
                    for i = 0 to obs.size() - 1
                        OB x = obs.get(i)
                        if x.bull == bull
                            if x.oid != ""
                                strategy.cancel(x.oid)
                                strategy.cancel(x.oid + " X")
                            box.delete(x.bx)
                            obs.remove(i)
                            break

                if cf and alOb
                    alert('{"event":"SMC_OB","side":"' + (bull ? "LONG" : "SHORT") + '","ticker":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","structure":"' + (ch ? "CHOCH" : "BOS") + '","top":' + str.tostring(top, format.mintick) + ',"bottom":' + str.tostring(bot, format.mintick) + ',"vwap":' + str.tostring(vwapV, format.mintick) + '}', alert.freq_once_per_bar_close)

                // ── Operación: cada OB pintado (confirmado) abre la suya ──
                if cf and trOn and (bull ? trDir != "Solo ventas" : trDir != "Solo compras")
                    bool  mkt   = trEntry == "Al formarse (mercado)"
                    float entry = mkt ? close : bull ? top : bot
                    float sl    = trSlMode == "OB ± ticks" ? (bull ? bot - trSlTicks * tk : top + trSlTicks * tk) : (bull ? entry - trSlTicks * tk : entry + trSlTicks * tk)
                    float risk  = bull ? entry - sl : sl - entry
                    float tpD   = trTpMode == "Ratio R:R" ? risk * trTpRR : trTpTicks * tk
                    float tp    = bull ? entry + tpD : entry - tpD
                    if risk > 0
                        trN += 1
                        string oid = (bull ? "Buy #" : "Sell #") + str.tostring(trN)
                        string msg = '{"event":"SMC_ORDER","side":"' + (bull ? "buy" : "sell") + '","type":"' + (mkt ? "market" : "limit") + '","ticker":"' + syminfo.ticker + '","qty":' + str.tostring(trQty) + ',"entry":' + str.tostring(entry, format.mintick) + ',"sl":' + str.tostring(sl, format.mintick) + ',"tp":' + str.tostring(tp, format.mintick) + '}'
                        if mkt
                            strategy.entry(oid, bull ? strategy.long : strategy.short, qty = trQty, comment = oid, alert_message = msg)
                        else
                            strategy.entry(oid, bull ? strategy.long : strategy.short, qty = trQty, limit = entry, comment = oid, alert_message = msg)
                            o.oid := oid
                        strategy.exit(oid + " X", from_entry = oid, stop = sl, limit = tp, comment_loss = "SL " + oid, comment_profit = "TP " + oid)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ PANEL
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// islastconfirmedhistory + isrealtime en vez de islast: una estrategia sin calc_on_every_tick no
// ejecuta la vela abierta, así que islast no llegaría a ser cierto al cargar.

var table dash = table.new(position.top_right, 2, 7, bgcolor = color.new(#161B22, 5), border_width = 1, border_color = color.new(color.gray, 70))

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = size.small, text_halign = text.align_right)

if showDash and (barstate.islastconfirmedhistory or barstate.isrealtime)
    int nUp = 0
    int nDn = 0
    for o in obs
        if o.conf
            if o.bull
                nUp += 1
            else
                nDn += 1
    string vwTxt = not vwapOK ? "sin datos" : close > vwU2 ? "▲ sobre +σ ext" : close > vwU1 ? "▲ +σ int … +σ ext" : close >= vwapV ? "▲ sobre VWAP" : close >= vwL1 ? "▼ bajo VWAP" : close >= vwL2 ? "▼ −σ int … −σ ext" : "▼ bajo −σ ext"
    float  pos   = strategy.position_size
    int    nCl   = strategy.closedtrades
    string clTxt = nCl == 0 ? "—" : str.tostring(nCl) + " · " + str.tostring(100.0 * strategy.wintrades / nCl, "#") + "% · " + str.tostring(strategy.netprofit, "#,##0")
    table.cell(dash, 0, 0, "SMC + VWAP v7.0", text_color = #FFD700, text_size = size.small)
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.white, text_size = size.small)
    f_row(1, "Estructura", trend == 1 ? "ALCISTA" : trend == -1 ? "BAJISTA" : "—", trend == 1 ? colBull : trend == -1 ? colBear : color.gray)
    f_row(2, "Último", lastEvt, color.white)
    f_row(3, "VWAP", vwTxt, not vwapOK ? color.gray : close >= vwapV ? colBull : colBear)
    f_row(4, "OB vivos", "▲ " + str.tostring(nUp) + " · ▼ " + str.tostring(nDn), color.white)
    f_row(5, "Posición", pos > 0 ? "LARGO " + str.tostring(pos) : pos < 0 ? "CORTO " + str.tostring(-pos) : "plano", pos > 0 ? colBull : pos < 0 ? colBear : color.gray)
    f_row(6, "Cerradas", clTxt, color.white)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ PRICE ACTION · OLIVER VELEZ  —  MÓDULO AISLADO, SOLO PINTA  [v4.0]
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// AISLADO A PROPÓSITO. Todo lo que hay debajo de esta línea calcula sus propios valores, lee los OB solo
// para consultar si el precio está dentro de alguno, y su única salida al gráfico es barcolor() más una
// etiqueta opcional. Ninguna variable de aquí entra en la estructura, los OB ni las órdenes: puedes
// encender y apagar este módulo entero y el backtest no se mueve un decimal. Por eso está al final.
//
// Todas las definiciones se miden en ATR y en porcentaje del rango, no en puntos, así que valen igual en
// MNQ que en MES y en cualquier marco.

float paRng  = high - low
float paBody = math.abs(close - open)
float paUpW  = high - math.max(open, close)
float paDnW  = math.min(open, close) - low
bool  paUp   = close > open
bool  paDn   = close < open
float paPrvB = math.abs(close[1] - open[1])
float paPrvR = high[1] - low[1]
float paHH   = ta.highest(high, eleClear)[1]
float paLL   = ta.lowest(low,  eleClear)[1]
float paAvgV = ta.sma(volume, 20)
bool  paVol  = not eleVol or na(paAvgV) or paAvgV <= 0 or volume > paAvgV
bool  paOK   = paMode != "Desactivado" and not na(atrC) and atrC > 0 and paRng > 0

// ── Definiciones ──────────────────────────────────────────────────────────────────────────────
// ELEPHANT (Velez): cuerpo institucional que limpia las velas previas, con volumen detrás.
bool eleU = paOK and eleOn and paUp and paBody >= atrC * eleBody and paBody >= paRng * eleBodyP / 100.0 and close > paHH and paVol
bool eleD = paOK and eleOn and paDn and paBody >= atrC * eleBody and paBody >= paRng * eleBodyP / 100.0 and close < paLL and paVol
// SHAVED: cierra en su extremo, sin mecha a favor.
bool shvU = paOK and shvOn and paUp and paRng >= atrC * shvRng and paBody >= paRng * 0.6 and paUpW <= paRng * shvWick / 100.0
bool shvD = paOK and shvOn and paDn and paRng >= atrC * shvRng and paBody >= paRng * 0.6 and paDnW <= paRng * shvWick / 100.0
// PIN / TAIL (Velez): mecha dominante y cuerpo pequeño — rechazo puro.
bool pinU = paOK and pinOn and paRng >= atrC * pinRng and paDnW >= paRng * pinWick / 100.0 and paBody <= paRng * pinBodyP / 100.0
bool pinD = paOK and pinOn and paRng >= atrC * pinRng and paUpW >= paRng * pinWick / 100.0 and paBody <= paRng * pinBodyP / 100.0
// 180 (Velez): vela con cuerpo real anulada por la siguiente, que cierra más allá de su apertura.
bool v18U = paOK and v18On and paPrvR > 0 and close[1] < open[1] and paPrvB >= paPrvR * 0.6 and paUp and paBody >= paRng * v18Body / 100.0 and paBody >= paPrvB * v18Size / 100.0 and close > open[1]
bool v18D = paOK and v18On and paPrvR > 0 and close[1] > open[1] and paPrvB >= paPrvR * 0.6 and paDn and paBody >= paRng * v18Body / 100.0 and paBody >= paPrvB * v18Size / 100.0 and close < open[1]
// OUTSIDE: envuelve el rango previo y cierra más allá de su extremo.
bool outU = paOK and outOn and high > high[1] and low < low[1] and close > high[1] and paRng >= atrC * outRng
bool outD = paOK and outOn and high > high[1] and low < low[1] and close < low[1]  and paRng >= atrC * outRng
// RBI / GBI (Velez): vela contraria pequeña que la siguiente ignora. Continuación.
bool rbiU = paOK and rbiOn and close[1] < open[1] and paPrvB <= atrC * rbiSmall and paUp and close > high[1]
bool rbiD = paOK and rbiOn and close[1] > open[1] and paPrvB <= atrC * rbiSmall and paDn and close < low[1]
// INSIDE: compresión dentro de la vela madre.
bool insB = paOK and insOn and high <= high[1] and low >= low[1]

// AGOTAMIENTO 3-5-8 (Velez): velas consecutivas del mismo color. Solo muta en vela cerrada, como el resto
// del script, así que la cuenta que ves es la de la última vela confirmada.
var int paRunU = 0
var int paRunD = 0
if barstate.isconfirmed
    paRunU := paUp ? paRunU + 1 : 0
    paRunD := paDn ? paRunD + 1 : 0
bool exhU = paOK and exhOn and paRunU >= exhA
bool exhD = paOK and exhOn and paRunD >= exhA

// ── ¿Está el precio dentro de un OB vivo confirmado? SOLO LECTURA ────────────────────────────────────
bool paInDem = false
bool paInSup = false
if paMode == "Solo dentro de OB" and obs.size() > 0
    for z in obs
        if z.conf and high >= z.bot and low <= z.top
            if z.bull
                paInDem := true
            else
                paInSup := true

// ── Prioridad: de lo más específico a lo más genérico. Una vela = un patrón, o el gráfico se vuelve
// ilegible. Para cambiar el orden efectivo, apaga el patrón que te esté tapando al de debajo.
string paName = ""
color  paCol  = na
bool   paBull = true
if eleU
    paName := "ELE"
    paCol  := eleCUp
else if eleD
    paName := "ELE"
    paCol  := eleCDn
    paBull := false
else if v18U
    paName := "180"
    paCol  := v18CUp
else if v18D
    paName := "180"
    paCol  := v18CDn
    paBull := false
else if outU
    paName := "OUT"
    paCol  := outCUp
else if outD
    paName := "OUT"
    paCol  := outCDn
    paBull := false
else if pinU
    paName := "PIN"
    paCol  := pinCUp
else if pinD
    paName := "PIN"
    paCol  := pinCDn
    paBull := false
else if shvU
    paName := "SHV"
    paCol  := shvCUp
else if shvD
    paName := "SHV"
    paCol  := shvCDn
    paBull := false
else if rbiU
    paName := "RBI"
    paCol  := rbiCUp
else if rbiD
    paName := "GBI"
    paCol  := rbiCDn
    paBull := false
else if insB
    paName := "IN"
    paCol  := insCol
else if exhU
    paName := paRunU >= exhB ? "8" : "5"
    paCol  := exhCol
else if exhD
    paName := paRunD >= exhB ? "8" : "5"
    paCol  := exhCol
    paBull := false

// El inside bar y el agotamiento no tienen dirección propia, así que el filtro por OB los deja pasar
// esté el precio donde esté; los demás solo pintan con el nivel a favor.
bool paNeutral = paName == "IN" or paName == "5" or paName == "8"
bool paCtxOK   = paMode != "Solo dentro de OB" or paNeutral or (paBull ? paInDem : paInSup)
color paFinal  = paName != "" and paCtxOK ? color.new(paCol, paOpac) : na

barcolor(paFinal, title = "Price Action · Velez")

if paTagOn and not na(paFinal) and barstate.isconfirmed
    label.new(bar_index, paBull ? low : high, paName, style = paBull ? label.style_label_up : label.style_label_down, color = color.new(paCol, 25), textcolor = color.white, size = size.tiny)
