//@version=6
// ─────────────────────────────────────────────────────────
// SMC CHoCH Confirmation v1.0 | Autor: J | TF óptimo: 1-5m | Activo: MNQ/MES
// Estructura HH/HL/LH/LL · Barridos de liquidez · CHoCH/BOS por cierre de cuerpo
// Reglas: desplazamiento ATR · volumen · FVG · barrido previo · sesgo HTF
// Velas de confirmación coloreadas (paleta sin verde/rojo)
// ─────────────────────────────────────────────────────────

// ══ [1] DECLARACIÓN ══
indicator("SMC CHoCH Confirmation", "CHoCH Conf", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=500)

// ══ [2] TIPOS ══
type Zone
    box   bx
    float top
    float bot
    int   dir
    bool  active = true

type Choch
    int   dir
    int   bar
    float level
    int   levelBar
    bool  rDisp  = false
    bool  rVol   = false
    bool  rSweep = false
    bool  rHtf   = false
    bool  rFvg   = false
    float fvgTop
    float fvgBot
    int   fvgBar
    bool  valid  = false
    bool  done   = false
    label lbl
    line  ln

// ══ [3] MÉTODOS Y FUNCIONES ══
method extend(Zone z) =>
    if z.active
        box.set_right(z.bx, bar_index)
        if (z.dir == 1 and close < z.bot) or (z.dir == -1 and close > z.top)
            z.active := false
            box.set_bgcolor(z.bx, color.new(color.gray, 92))
            box.set_border_color(z.bx, color.new(color.gray, 75))

f_ck(bool b) =>
    b ? "✓" : "✗"

// Estructura en TF superior (misma lógica: ruptura por cierre de swing)
f_htfTrend(simple int len) =>
    var int   tr = 0
    var float sh = na
    var float sl = na
    float phH = ta.pivothigh(high, len, len)
    float plH = ta.pivotlow(low, len, len)
    if not na(phH)
        sh := phH
    if not na(plH)
        sl := plH
    if not na(sh) and close > sh
        tr := 1
        sh := na
    if not na(sl) and close < sl
        tr := -1
        sl := na
    tr

// ══ [4] INPUTS ══
grpStr = "═══ 🧱 ESTRUCTURA ═══"
grpVal = "═══ ✅ REGLAS CHoCH ═══"
grpPat = "═══ 🕯️ VELAS DE CONFIRMACIÓN ═══"
grpZon = "═══ 📦 ZONAS ═══"
grpDsh = "═══ 📊 DASHBOARD ═══"

swingLen   = input.int(5, "Longitud de swing", minval=2, maxval=20, group=grpStr, tooltip="Velas a cada lado para confirmar un swing. 3-5 en 1m, 5-8 en 5m.")
showSwings = input.bool(true, "Mostrar HH/HL/LH/LL", group=grpStr)
showBOS    = input.bool(true, "Mostrar BOS", group=grpStr)
showSweep  = input.bool(true, "Mostrar barridos de liquidez", group=grpStr)
chochCol   = input.color(#2979FF, "Color CHoCH", group=grpStr)

atrLen     = input.int(14, "ATR", minval=5, maxval=50, group=grpVal)
dispMult   = input.float(1.5, "Desplazamiento (x ATR)", minval=0.5, maxval=5, step=0.1, group=grpVal, tooltip="Cuerpo mínimo de la vela de ruptura. Regla: 1.5-2x ATR.")
volLen     = input.int(20, "Media de volumen", minval=5, maxval=100, group=grpVal)
volMult    = input.float(1.2, "Volumen mínimo (x media)", minval=0.5, maxval=5, step=0.1, group=grpVal)
sweepLook  = input.int(20, "Barrido previo dentro de (velas)", minval=3, maxval=100, group=grpVal, tooltip="El CHoCH debe venir precedido de un barrido de liquidez en este rango.")
htfTf      = input.timeframe("5", "Temporalidad superior", group=grpVal, tooltip="Sesgo de estructura en TF mayor. Ej: marcar en 5m, entrar en 1m.")
reqDisp    = input.bool(true, "Exigir desplazamiento", group=grpVal)
reqVol     = input.bool(true, "Exigir volumen", group=grpVal)
reqFvg     = input.bool(true, "Exigir FVG", group=grpVal)
reqSweep   = input.bool(true, "Exigir barrido previo", group=grpVal)
reqHtf     = input.bool(true, "Exigir confirmación HTF", group=grpVal)
showWeak   = input.bool(true, "Mostrar CHoCH no validados (?)", group=grpVal)

showPat    = input.bool(true, "Colorear velas de confirmación", group=grpPat)
ctxOnly    = input.bool(true, "Reversión solo tras barrido", group=grpPat, tooltip="Pin bar, envolvente y estrella solo se colorean si hubo barrido de liquidez reciente.")
showTags   = input.bool(true, "Marcadores ▲▼", group=grpPat)
pinRatio   = input.float(2.0, "Pin bar: mecha ≥ x cuerpo", minval=1.0, maxval=5, step=0.5, group=grpPat)
colDisp    = input.color(#FFD600, "Desplazamiento", group=grpPat, inline="c1")
colEng     = input.color(#E040FB, "Envolvente", group=grpPat, inline="c1")
colStar    = input.color(#FF9100, "Morning/Evening star", group=grpPat, inline="c2")
colPin     = input.color(#00E5FF, "Pin bar", group=grpPat, inline="c2")
colIB      = input.color(#B0BEC5, "Inside bar ruptura", group=grpPat)

showFVG    = input.bool(true, "Mostrar FVG del CHoCH", group=grpZon)
showOB     = input.bool(true, "Mostrar Order Block del CHoCH", group=grpZon)
fvgCol     = input.color(color.new(#00BFA5, 82), "Color FVG", group=grpZon)
obCol      = input.color(color.new(#FFAB00, 82), "Color OB", group=grpZon)
obLook     = input.int(20, "Buscar OB hasta (velas)", minval=3, maxval=50, group=grpZon)
maxZones   = input.int(10, "Zonas máximas", minval=1, maxval=50, group=grpZon)

showDash   = input.bool(true, "Mostrar dashboard", group=grpDsh)

// ══ [5] VARIABLES var ══
var float lastSH       = na
var int   lastSHBar    = na
var bool  shBroken     = true
var bool  shSwept      = false
var float lastSL       = na
var int   lastSLBar    = na
var bool  slBroken     = true
var bool  slSwept      = false
var int   trend        = 0
var int   sweepBullBar = -100000
var int   sweepBearBar = -100000
var Choch pend         = na
var Choch lastC        = na
var array<Zone> zones  = array.new<Zone>()

// ══ [6] CÁLCULOS CORE ══
float atr    = ta.atr(atrLen)
float volAvg = ta.sma(volume, volLen)
float body   = math.abs(close - open)
float rng    = high - low
float upW    = high - math.max(open, close)
float loW    = math.min(open, close) - low
bool  volOK  = na(volAvg) or volAvg == 0 ? true : volume >= volAvg * volMult

// Anti-repaint: valor HTF de la vela cerrada anterior ([1]) + lookahead_on (patrón estándar sin repintado)
int htfTrend = request.security(syminfo.tickerid, htfTf, f_htfTrend(swingLen)[1], lookahead=barmerge.lookahead_on)

// ══ [7] LÓGICA DE DETECCIÓN ══
// ── Swings ──
float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)

if not na(ph)
    if showSwings
        string tH = na(lastSH) ? "SH" : ph > lastSH ? "HH" : "LH"
        label.new(bar_index - swingLen, ph, tH, style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny)
    lastSH    := ph
    lastSHBar := bar_index - swingLen
    shBroken  := false
    shSwept   := false

if not na(pl)
    if showSwings
        string tL = na(lastSL) ? "SL" : pl < lastSL ? "LL" : "HL"
        label.new(bar_index - swingLen, pl, tL, style=label.style_label_up, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny)
    lastSL    := pl
    lastSLBar := bar_index - swingLen
    slBroken  := false
    slSwept   := false

// ── Barridos de liquidez (mecha atraviesa el swing, cierre vuelve dentro) ──
bool sweepBull = barstate.isconfirmed and not na(lastSL) and not slBroken and not slSwept and low < lastSL and close > lastSL
bool sweepBear = barstate.isconfirmed and not na(lastSH) and not shBroken and not shSwept and high > lastSH and close < lastSH

if sweepBull
    slSwept      := true
    sweepBullBar := bar_index
    if showSweep
        line.new(lastSLBar, lastSL, bar_index, lastSL, color=color.gray, style=line.style_dotted)
        label.new(bar_index, low, "Barrido", style=label.style_label_up, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny)

if sweepBear
    shSwept      := true
    sweepBearBar := bar_index
    if showSweep
        line.new(lastSHBar, lastSH, bar_index, lastSH, color=color.gray, style=line.style_dotted)
        label.new(bar_index, high, "Barrido", style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny)

// ── Validación del CHoCH pendiente (se cierra en la vela siguiente a la ruptura) ──
bool alertBull = false
bool alertBear = false

if not na(pend) and not pend.done and barstate.isconfirmed and bar_index == pend.bar + 1
    if not pend.rFvg
        bool gap = pend.dir == 1 ? low > high[2] : high < low[2]
        if gap
            pend.rFvg   := true
            pend.fvgTop := pend.dir == 1 ? low : low[2]
            pend.fvgBot := pend.dir == 1 ? high[2] : high
            pend.fvgBar := bar_index - 1
    pend.valid := (not reqDisp or pend.rDisp) and (not reqVol or pend.rVol) and (not reqFvg or pend.rFvg) and (not reqSweep or pend.rSweep) and (not reqHtf or pend.rHtf)
    pend.done  := true
    label.set_tooltip(pend.lbl, "Cierre de cuerpo ✓\nDesplazamiento " + f_ck(pend.rDisp) + "\nVolumen " + f_ck(pend.rVol) + "\nFVG " + f_ck(pend.rFvg) + "\nBarrido previo " + f_ck(pend.rSweep) + "\nHTF alineado " + f_ck(pend.rHtf))
    if pend.valid
        label.set_text(pend.lbl, "CHoCH ✓")
        label.set_color(pend.lbl, chochCol)
        label.set_textcolor(pend.lbl, color.white)
        line.set_color(pend.ln, chochCol)
        line.set_width(pend.ln, 2)
        line.set_style(pend.ln, line.style_solid)
        if pend.dir == 1
            alertBull := true
        else
            alertBear := true
        if showFVG and pend.rFvg
            box bxF = box.new(pend.fvgBar, pend.fvgTop, bar_index, pend.fvgBot, border_color=color.new(fvgCol, 40), bgcolor=fvgCol, text="FVG", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
            zones.push(Zone.new(bxF, pend.fvgTop, pend.fvgBot, pend.dir))
        if showOB
            float obT = na
            float obB = na
            int   obX = na
            for i = 2 to obLook + 1
                bool opp = pend.dir == 1 ? close[i] < open[i] : close[i] > open[i]
                if opp
                    obT := high[i]
                    obB := low[i]
                    obX := bar_index - i
                    break
            if not na(obT)
                box bxO = box.new(obX, obT, bar_index, obB, border_color=color.new(obCol, 40), bgcolor=obCol, text="OB", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
                zones.push(Zone.new(bxO, obT, obB, pend.dir))
        while zones.size() > maxZones * 2
            Zone old = zones.shift()
            box.delete(old.bx)
    else
        if showWeak
            label.set_text(pend.lbl, "CHoCH ?")
            label.set_textcolor(pend.lbl, color.new(chochCol, 40))
            line.set_color(pend.ln, color.new(chochCol, 60))
        else
            label.delete(pend.lbl)
            line.delete(pend.ln)
    lastC := pend

// ── Rupturas de estructura por cierre de cuerpo ──
bool bullBreak = barstate.isconfirmed and not na(lastSH) and not shBroken and close > lastSH
bool bearBreak = barstate.isconfirmed and not na(lastSL) and not slBroken and close < lastSL

if bullBreak
    shBroken := true
    int midX = int(math.avg(lastSHBar, bar_index))
    if trend == -1
        bool fvgNow = low > high[2]
        line  ln = line.new(lastSHBar, lastSH, bar_index, lastSH, color=color.new(chochCol, 50), style=line.style_dashed)
        label lb = label.new(midX, lastSH, "CHoCH…", style=label.style_label_down, color=color.new(chochCol, 100), textcolor=color.new(chochCol, 30), size=size.small)
        pend := Choch.new(dir=1, bar=bar_index, level=lastSH, levelBar=lastSHBar, rDisp=close > open and body >= dispMult * atr, rVol=volOK, rSweep=bar_index - sweepBullBar <= sweepLook, rHtf=htfTrend == 1, rFvg=fvgNow, fvgTop=fvgNow ? low : na, fvgBot=fvgNow ? high[2] : na, fvgBar=fvgNow ? bar_index - 1 : na, lbl=lb, ln=ln)
    else if showBOS
        line.new(lastSHBar, lastSH, bar_index, lastSH, color=color.gray, style=line.style_dotted)
        label.new(midX, lastSH, "BOS", style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny)
    trend := 1

if bearBreak
    slBroken := true
    int midX = int(math.avg(lastSLBar, bar_index))
    if trend == 1
        bool fvgNow = high < low[2]
        line  ln = line.new(lastSLBar, lastSL, bar_index, lastSL, color=color.new(chochCol, 50), style=line.style_dashed)
        label lb = label.new(midX, lastSL, "CHoCH…", style=label.style_label_up, color=color.new(chochCol, 100), textcolor=color.new(chochCol, 30), size=size.small)
        pend := Choch.new(dir=-1, bar=bar_index, level=lastSL, levelBar=lastSLBar, rDisp=close < open and body >= dispMult * atr, rVol=volOK, rSweep=bar_index - sweepBearBar <= sweepLook, rHtf=htfTrend == -1, rFvg=fvgNow, fvgTop=fvgNow ? low[2] : na, fvgBot=fvgNow ? high : na, fvgBar=fvgNow ? bar_index - 1 : na, lbl=lb, ln=ln)
    else if showBOS
        line.new(lastSLBar, lastSL, bar_index, lastSL, color=color.gray, style=line.style_dotted)
        label.new(midX, lastSL, "BOS", style=label.style_label_up, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny)
    trend := -1

// ── Velas de confirmación ──
bool ctxBull  = not ctxOnly or bar_index - sweepBullBar <= sweepLook
bool ctxBear  = not ctxOnly or bar_index - sweepBearBar <= sweepLook

bool dispBull = close > open and body >= dispMult * atr
bool dispBear = close < open and body >= dispMult * atr
bool engBull  = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body > body[1] and ctxBull
bool engBear  = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body > body[1] and ctxBear
bool starBull = close[2] < open[2] and body[2] >= 0.5 * atr and body[1] <= 0.3 * body[2] and close > open and close > (open[2] + close[2]) / 2 and ctxBull
bool starBear = close[2] > open[2] and body[2] >= 0.5 * atr and body[1] <= 0.3 * body[2] and close < open and close < (open[2] + close[2]) / 2 and ctxBear
bool pinBull  = rng > 0 and loW >= pinRatio * math.max(body, syminfo.mintick) and upW <= 0.25 * rng and ctxBull
bool pinBear  = rng > 0 and upW >= pinRatio * math.max(body, syminfo.mintick) and loW <= 0.25 * rng and ctxBear
bool ibBull   = high[1] <= high[2] and low[1] >= low[2] and close > high[2] and close > open
bool ibBear   = high[1] <= high[2] and low[1] >= low[2] and close < low[2] and close < open

// Prioridad: desplazamiento > envolvente > estrella > pin bar > inside bar
int pat  = dispBull or dispBear ? 1 : engBull or engBear ? 2 : starBull or starBear ? 3 : pinBull or pinBear ? 4 : ibBull or ibBear ? 5 : 0
int pdir = pat == 1 ? (dispBull ? 1 : -1) : pat == 2 ? (engBull ? 1 : -1) : pat == 3 ? (starBull ? 1 : -1) : pat == 4 ? (pinBull ? 1 : -1) : pat == 5 ? (ibBull ? 1 : -1) : 0
color patCol = pat == 1 ? colDisp : pat == 2 ? colEng : pat == 3 ? colStar : pat == 4 ? colPin : pat == 5 ? colIB : na

// ══ [8] GESTIÓN DE OBJETOS ══
if zones.size() > 0
    for z in zones
        z.extend()

// ══ [9] PLOTS ══
barcolor(showPat ? patCol : na, title="Velas de confirmación")

bool tags = showPat and showTags
plotshape(tags and pat == 1 and pdir == 1,  "Desplazamiento ▲", shape.triangleup,   location.belowbar, colDisp, size=size.tiny)
plotshape(tags and pat == 1 and pdir == -1, "Desplazamiento ▼", shape.triangledown, location.abovebar, colDisp, size=size.tiny)
plotshape(tags and pat == 2 and pdir == 1,  "Envolvente ▲",     shape.triangleup,   location.belowbar, colEng,  size=size.tiny)
plotshape(tags and pat == 2 and pdir == -1, "Envolvente ▼",     shape.triangledown, location.abovebar, colEng,  size=size.tiny)
plotshape(tags and pat == 3 and pdir == 1,  "Morning star ▲",   shape.triangleup,   location.belowbar, colStar, size=size.tiny)
plotshape(tags and pat == 3 and pdir == -1, "Evening star ▼",   shape.triangledown, location.abovebar, colStar, size=size.tiny)
plotshape(tags and pat == 4 and pdir == 1,  "Pin bar ▲",        shape.triangleup,   location.belowbar, colPin,  size=size.tiny)
plotshape(tags and pat == 4 and pdir == -1, "Pin bar ▼",        shape.triangledown, location.abovebar, colPin,  size=size.tiny)
plotshape(tags and pat == 5 and pdir == 1,  "Inside bar ▲",     shape.triangleup,   location.belowbar, colIB,   size=size.tiny)
plotshape(tags and pat == 5 and pdir == -1, "Inside bar ▼",     shape.triangledown, location.abovebar, colIB,   size=size.tiny)

// ══ [10] ALERTAS ══
alertcondition(alertBull, "CHoCH alcista validado", "{{ticker}} {{interval}} — CHoCH ▲ validado @ {{close}}")
alertcondition(alertBear, "CHoCH bajista validado", "{{ticker}} {{interval}} — CHoCH ▼ validado @ {{close}}")
alertcondition(sweepBull, "Barrido sell-side",      "{{ticker}} {{interval}} — Barrido de mínimos @ {{close}}")
alertcondition(sweepBear, "Barrido buy-side",       "{{ticker}} {{interval}} — Barrido de máximos @ {{close}}")

// ══ [11] DASHBOARD ══
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(#1a1a2e, 10), border_width=1, border_color=color.new(color.gray, 70))
if showDash and barstate.islast
    color okC = #00E5FF
    color noC = #FF9100
    table.cell(dash, 0, 0, "🧱 CHoCH Conf", text_color=#FFD700, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 1, "Estructura", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, trend == 1 ? "Alcista ▲" : trend == -1 ? "Bajista ▼" : "—", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "Sesgo HTF " + htfTf, text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, htfTrend == 1 ? "Alcista ▲" : htfTrend == -1 ? "Bajista ▼" : "—", text_color=color.white, text_size=size.small)
    if not na(lastC)
        table.cell(dash, 0, 3, "Último CHoCH", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 3, (lastC.dir == 1 ? "▲ " : "▼ ") + str.tostring(lastC.level, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(dash, 0, 4, "Desplazamiento", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 4, f_ck(lastC.rDisp), text_color=lastC.rDisp ? okC : noC, text_size=size.small)
        table.cell(dash, 0, 5, "Volumen", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 5, f_ck(lastC.rVol), text_color=lastC.rVol ? okC : noC, text_size=size.small)
        table.cell(dash, 0, 6, "FVG", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 6, f_ck(lastC.rFvg), text_color=lastC.rFvg ? okC : noC, text_size=size.small)
        table.cell(dash, 0, 7, "Barrido previo", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 7, f_ck(lastC.rSweep), text_color=lastC.rSweep ? okC : noC, text_size=size.small)
        table.cell(dash, 0, 8, "HTF alineado", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 8, f_ck(lastC.rHtf), text_color=lastC.rHtf ? okC : noC, text_size=size.small)
        table.cell(dash, 0, 9, "Estado", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 9, lastC.valid ? "VÁLIDO ✓" : "NO VÁLIDO ?", text_color=lastC.valid ? okC : noC, text_size=size.small)
