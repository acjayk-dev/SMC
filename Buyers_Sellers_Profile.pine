// ~~ Constants {
int VOL_LEN=40
int ABS_RAD=math.min(3,swingLen)
float PIV_VOL_X=2.2
float ABS_BODY_MAX=0.40
float ABS_VOL_X=1.5
float ABS_SIG=0.45
string SRC_CLV="Intravela · posición del cierre"
string SRC_TICK="Intravela · regla del tick"
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Order Flow {
// Parte compradora de cada vela del gráfico, por posición del cierre de sus velas intravela ponderada por volumen.
intrabar_buy(array<float> h,array<float> l,array<float> c,array<float> v)=>
    float b=0.0
    float t=0.0
    int n=v.size()
    if n>0
        for i=0 to n-1
            float vi=math.max(nz(v.get(i),0.0),0.0)
            float ri=h.get(i)-l.get(i)
            float fi=ri>0?math.max(0.0,math.min(1.0,(c.get(i)-l.get(i))/ri)):0.5
            b+=vi*fi
            t+=vi
    [b,t]

[ltfH,ltfL,ltfC,ltfV]=request.security_lower_tf(syminfo.tickerid,ltfTf,[high,low,close,volume],ignore_invalid_timeframe=true)
[ibBuy,ibTot]=intrabar_buy(ltfH,ltfL,ltfC,ltfV)

// Regla del tick sobre las velas intravela: cada una va a compras si cierra por encima de la anterior y a
// ventas si cierra por debajo; si iguala, repite la dirección previa. El último cierre se arrastra entre velas.
var float ltfPrevC=na
var int ltfPrevDir=0
float tkBuy=0.0
float tkTot=0.0
int nLtf=ltfC.size()
if nLtf>0
    for i=0 to nLtf-1
        float ci=ltfC.get(i)
        float vi=math.max(nz(ltfV.get(i),0.0),0.0)
        int di=na(ltfPrevC)?0:ci>ltfPrevC?1:ci<ltfPrevC?-1:ltfPrevDir
        tkBuy+=di>0?vi:di==0?vi*0.5:0.0
        tkTot+=vi
        ltfPrevC:=ci
        ltfPrevDir:=di

float barRng=high-low
float clvFrac=barRng>0?math.max(0.0,math.min(1.0,(close-low)/barRng)):0.5
bool ibWanted=deltaSrc!="Estimación por vela"
bool ibOk=deltaSrc==SRC_CLV?ibTot>0:deltaSrc==SRC_TICK?tkTot>0:false
float buyFrac=deltaSrc==SRC_CLV and ibTot>0?ibBuy/ibTot:deltaSrc==SRC_TICK and tkTot>0?tkBuy/tkTot:clvFrac
float delta=math.max(nz(volume,0.0),0.0)*(2.0*buyFrac-1.0)
float deltaAvg=ta.sma(math.abs(delta),deltaLen)

// Cobertura: qué parte del historial tuvo datos intravela. Donde no los hay se usa la estimación por vela.
var int covN=0
var int covIb=0
if barstate.isconfirmed and ibWanted
    covN+=1
    covIb+=ibOk?1:0
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Bar History Buffers {
// Buffers circulares escritos en cada vela, para reconstruir el perfil dentro de código condicional sin el
// operador de historial (Pine avisa de inconsistencia si se usa en funciones llamadas condicionalmente).
int BUF=profLb+swingLen
var array<float> hBuf=array.new_float(BUF,na)
var array<float> lBuf=array.new_float(BUF,na)
var array<float> vBuf=array.new_float(BUF,0.0)
var array<float> bBuf=array.new_float(BUF,0.5)
hBuf.set(bar_index%BUF,high)
lBuf.set(bar_index%BUF,low)
vBuf.set(bar_index%BUF,math.max(nz(volume,0.0),0.0))
bBuf.set(bar_index%BUF,buyFrac)

// Valor guardado hace `ago` velas (ago no puede superar bar_index ni BUF-1)
buf_at(array<float> b,int ago)=>b.get((bar_index-ago)%BUF)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Types {
type Lvl
    float p
    float sc
    float raw
    float node
    float evid
    float nStr
    bool supp
    int born            // hora de la vela del pivot
    int bornIdx
    int touches
    line ln
    bool flipped=false
    int flipBar=0
    int confT           // hora de la vela en que se confirmó
    int rtBar           // primer test tras invertirse; marca el retest válido (na hasta entonces)

type Trade
    bool isLong
    int grade
    int openBar
    float entry
    float sl
    float tp1
    float tp2
    float curStop
    bool tp1Hit=false
    bool done=false
    float res=0.0
    bool shown=false
    line lEn
    line lSl
    line lT1
    line lT2
    label lb
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Helpers {
clip(float x)=>math.max(0.0,math.min(1.0,x))
lstyle(string s)=>s=="Punteada"?line.style_dotted:s=="Discontinua"?line.style_dashed:line.style_solid
lwidth(float s)=>s>=82?4:s>=62?3:2
lalpha(float s)=>s>=82?8:s>=62?22:s>=45?38:52
rings(float s)=>s>=82?4:s>=66?3:s>=50?2:1
rsize(int r)=>r>=4?size.large:r==3?size.normal:r==2?size.small:size.tiny
ralpha(int r)=>r>=4?68:r==3?52:r==2?30:4
row_id(float p,float bot,float step,int rows)=>math.max(0,math.min(rows-1,int(math.floor((p-bot)/step))))
lvl_col(bool supp)=>supp?supCol:resCol
line_x1(int born,int confT)=>lineFrom=="Pivot"?born:confT

clear_boxes(array<box> a)=>
    while a.size()>0
        box.delete(a.pop())

clear_lines(array<line> a)=>
    while a.size()>0
        line.delete(a.pop())

clear_labels(array<label> a)=>
    while a.size()>0
        label.delete(a.pop())

profile(int newest,int oldest,int rows)=>
    float lo=buf_at(lBuf,newest)
    float hi=buf_at(hBuf,newest)
    for i=newest to oldest
        lo:=math.min(lo,buf_at(lBuf,i))
        hi:=math.max(hi,buf_at(hBuf,i))
    float span=math.max(hi-lo,syminfo.mintick*rows)
    float bot=lo-(span-(hi-lo))*0.5
    float step=span/rows
    array<float> tot=array.new_float(rows,0.0)
    array<float> buy=array.new_float(rows,0.0)
    for i=newest to oldest
        float l=buf_at(lBuf,i)
        float h=buf_at(hBuf,i)
        float r=h-l
        float v=buf_at(vBuf,i)
        float bf=nz(buf_at(bBuf,i),0.5)
        int r0=row_id(l,bot,step,rows)
        int r1=row_id(h,bot,step,rows)
        for j=r0 to r1
            float rl=bot+j*step
            float ov=r>0?math.max(0.0,math.min(h,rl+step)-math.max(l,rl)):step
            float frac=r>0?ov/r:1.0
            if frac>0
                float av=v*frac
                tot.set(j,tot.get(j)+av)
                buy.set(j,buy.get(j)+av*bf)
    [bot,step,tot,buy]

// Filas [lo,hi] alrededor del POC que reúnen pct del volumen del perfil
value_area(array<float> tot,int poc,float pct)=>
    float total=tot.sum()
    int n=tot.size()
    int lo=poc
    int hi=poc
    float acc=tot.get(poc)
    while acc<total*pct and (lo>0 or hi<n-1)
        float up=hi<n-1?tot.get(hi+1):-1.0
        float dn=lo>0?tot.get(lo-1):-1.0
        if up>=dn
            hi+=1
            acc+=up
        else
            lo-=1
            acc+=dn
    [lo,hi]

// Distancia de px al nivel contrario más cercano (resistencia encima para compras, soporte debajo para ventas)
nearest_opp(array<Lvl> a,bool isLong,float px)=>
    float best=na
    if a.size()>0
        for i=0 to a.size()-1
            Lvl lv=a.get(i)
            if lv.supp!=isLong
                float d=isLong?lv.p-px:px-lv.p
                if d>0 and (na(best) or d<best)
                    best:=d
    best

grade_of(float pts)=>pts>=gradeA?0:pts>=gradeB?1:pts>=gradeC?2:3
grade_txt(int g)=>g==0?"A":g==1?"B":"C"
grade_alpha(int g)=>g==0?0:g==1?30:55

profile_node(float raw,bool supp,float atrP,float bot,float step,array<float> tot,array<float> buy)=>
    float mx=math.max(tot.max(),0.0000001)
    float rad=math.max(atrP*srchAtr,step*2.0)
    float bestP=raw
    float bestE=-1.0
    float bestS=0.0
    float bestPk=0.0
    float bestDir=0.5
    int rows=tot.size()
    for r=0 to rows-1
        float p=bot+(r+0.5)*step
        float d=math.abs(p-raw)
        if d<=rad
            float rv=tot.get(r)
            float str=rv/mx
            float lv=r>0?tot.get(r-1):rv
            float rv2=r<rows-1?tot.get(r+1):rv
            float nAvg=math.max((lv+rv2)*0.5,mx*0.01)
            float pk=clip((rv/nAvg-0.85)/0.65)
            float bSh=rv>0?clip(buy.get(r)/rv):0.5
            float dir=supp?bSh:1.0-bSh
            float prox=1.0-d/rad
            float e=0.50*str+0.20*pk+0.20*dir+0.10*prox
            if e>bestE
                bestE:=e
                bestP:=p
                bestS:=str
                bestPk:=pk
                bestDir:=dir
    [bestP,math.max(bestE,0.0),bestS,bestPk,bestDir]

nearby(array<Lvl> a,float p,bool supp,float tol)=>
    int id=-1
    float best=1e20
    if a.size()>0
        for i=0 to a.size()-1
            Lvl lv=a.get(i)
            if lv.supp==supp
                float d=math.abs(lv.p-p)
                if d<=tol and d<best
                    best:=d
                    id:=i
    id

make_line(int x1,float p,bool supp,float sc)=>line.new(x1,p,time,p,xloc=xloc.bar_time,extend=extend.none,
 color=color.new(lvl_col(supp),lalpha(sc)),width=lwidth(sc),style=lstyle(lvlStyle))

store_lvl(array<Lvl> a,float p,float raw,float node,float evid,float nStr,bool supp,float sc,int born,int bornIdx,float atrP)=>
    bool changed=false
    float tol=math.max(atrP*mergeAtr,syminfo.mintick)
    int id=nearby(a,p,supp,tol)
    if id>=0
        Lvl lv=a.get(id)
        lv.touches:=lv.touches+1
        if sc>lv.sc
            lv.p:=p
            lv.sc:=sc
            lv.raw:=raw
            lv.node:=node
            lv.evid:=evid
            lv.nStr:=nStr
            lv.born:=born
            lv.bornIdx:=bornIdx
            lv.confT:=time
            line.set_xy1(lv.ln,line_x1(born,time),p)
            line.set_xy2(lv.ln,time,p)
            changed:=true
        else
            // Bonus decreciente: el 2º toque suma entero, el 3º la mitad y a partir del 4º nada.
            float bonus=lv.touches<=3?retestBonus/(lv.touches-1):0.0
            lv.sc:=math.min(100.0,lv.sc+bonus)
        line.set_color(lv.ln,color.new(lvl_col(supp),lalpha(lv.sc)))
        line.set_width(lv.ln,lwidth(lv.sc))
    else
        a.push(Lvl.new(p=p,sc=sc,raw=raw,node=node,evid=evid,nStr=nStr,supp=supp,born=born,bornIdx=bornIdx,touches=1,
         ln=make_line(line_x1(born,time),p,supp,sc),confT=time))
        changed:=true
    changed

remove_lvl(array<Lvl> a,int id)=>
    Lvl lv=a.get(id)
    line.delete(lv.ln)
    a.remove(id)
    0

trim_lvls(array<Lvl> a)=>
    while a.size()>maxLvl
        int weak=0
        float sc=a.get(0).sc
        for i=1 to a.size()-1
            if a.get(i).sc<sc
                sc:=a.get(i).sc
                weak:=i
        remove_lvl(a,weak)
    0

update_lvls(array<Lvl> a)=>
    if a.size()>0
        for i=0 to a.size()-1
            Lvl lv=a.get(i)
            line.set_xy2(lv.ln,time,lv.p)
            line.set_color(lv.ln,color.new(lvl_col(lv.supp),lalpha(lv.sc)))
            line.set_width(lv.ln,lwidth(lv.sc))
            line.set_style(lv.ln,lv.flipped?line.style_dashed:lstyle(lvlStyle))
    0

// 1=soporte, -1=resistencia, 2=los dos lados dentro de la fila
level_row(array<Lvl> a,float lo,float hi)=>
    bool hasS=false
    bool hasR=false
    if a.size()>0
        for i=0 to a.size()-1
            Lvl lv=a.get(i)
            if lv.p>=lo and lv.p<=hi
                hasS:=hasS or lv.supp
                hasR:=hasR or not lv.supp
    hasS and hasR?2:hasS?1:hasR?-1:0

score_tip(Lvl lv)=>"Pivot original: "+str.tostring(lv.raw,format.mintick)+"\nNodo del perfil: "+str.tostring(lv.node,format.mintick)
 +"\nEvidencia del perfil: "+str.tostring(lv.evid*100.0,"#")+"%\nFuerza del nodo vs POC: "+str.tostring(lv.nStr*100.0,"#")
 +"%\nNivel final: "+str.tostring(lv.p,format.mintick)
 +"\nToques de pivot: "+str.tostring(lv.touches)+(lv.flipped?"\nInvertido (nivel roto, ahora con el papel contrario)":"")

// El perfil llega ya calculado (una vez por vela) y los rasgos de la vela del pivot vienen del ámbito global,
// porque esto se ejecuta de forma condicional.
pivot_eval(array<Lvl> a,float bot,float step,array<float> tot,array<float> buy,float raw,bool supp,float atrP,float vSc,float wSc,float aSc,int bornTime,float atr)=>
    [node,evid,nStr,pk,dir]=profile_node(raw,supp,atrP,bot,step,tot,buy)
    bool ok=nStr>=nodeMin and evid>=evidMin
    float pull=ok?pullMax*clip(evid/0.65):0.0
    float p=raw+(node-raw)*pull
    float sc=100.0*(0.50*evid+0.20*aSc+0.15*vSc+0.15*wSc)
    // Se descarta el candidato que el cierre actual ya invalida (se rompería en la misma vela en que nace)
    float buf=math.max(nz(atr,0.0)*breakAtr,0.0)
    bool valid=supp?close>=p-buf:close<=p+buf
    ok and valid and sc>=scoreMin?store_lvl(a,p,raw,node,evid,nStr,supp,sc,bornTime,bar_index-swingLen,atrP):false

manage_breaks(array<Lvl> a,float atr)=>
    bool sBreak=false
    bool rBreak=false
    if a.size()>0
        float buf=math.max(nz(atr,0.0)*breakAtr,0.0)
        float tol=math.max(nz(atr,0.0)*mergeAtr,syminfo.mintick)
        for i=a.size()-1 to 0
            Lvl lv=a.get(i)
            bool broken=barstate.isconfirmed and (lv.supp?close<lv.p-buf:close>lv.p+buf)
            bool expired=maxAge>0 and bar_index-lv.bornIdx>maxAge
            if broken
                sBreak:=sBreak or lv.supp
                rBreak:=rBreak or not lv.supp
            // Inversión (una vez): la resistencia rota pasa a soporte y al revés, salvo que ese lado ya tenga nivel aquí
            bool flip=broken and not expired and flipLvls and not lv.flipped and nearby(a,lv.p,not lv.supp,tol)<0
            if flip
                lv.supp:=not lv.supp
                lv.flipped:=true
                lv.flipBar:=bar_index
                lv.sc:=lv.sc*0.9
            else if broken or expired
                remove_lvl(a,i)
    [sBreak,rBreak]

draw_markers(array<Lvl> a,array<label> lbs,array<line> lns)=>
    if showDots and a.size()>0
        for i=0 to a.size()-1
            Lvl lv=a.get(i)
            color base=lvl_col(lv.supp)
            if showRaw
                lbs.push(label.new(x=lv.born,y=lv.raw,text="",xloc=xloc.bar_time,yloc=yloc.price,style=label.style_circle,
                 color=color.new(rawCol,60),textcolor=rawCol,size=size.tiny))
                lns.push(line.new(x1=lv.born,y1=lv.raw,x2=lv.born,y2=lv.p,xloc=xloc.bar_time,color=color.new(coreCol,45),
                 width=1,style=line.style_dotted))
            int rc=rings(lv.sc)
            for r=rc to 1
                color fill=r==1?color.new(coreCol,lv.evid>=0.45?0:22):color.new(base,ralpha(r))
                lbs.push(label.new(x=lv.born,y=lv.p,text="",xloc=xloc.bar_time,yloc=yloc.price,style=label.style_circle,
                 color=fill,textcolor=color.white,size=rsize(r)))
            if showDotScore
                lbs.push(label.new(x=lv.born,y=lv.p,text=str.tostring(lv.sc,"#"),xloc=xloc.bar_time,yloc=yloc.price,
                 style=label.style_none,color=color.new(color.black,100),textcolor=color.white,size=size.tiny,
                  tooltip=score_tip(lv)))
    0

draw_edge(array<Lvl> a,array<label> lbs)=>
    if showEdge and a.size()>0
        for i=0 to a.size()-1
            Lvl lv=a.get(i)
            color c=lvl_col(lv.supp)
            lbs.push(label.new(x=bar_index,y=lv.p,text="",xloc=xloc.bar_index,yloc=yloc.price,style=label.style_circle,
             color=c,textcolor=c,size=size.tiny))
            lbs.push(label.new(x=bar_index+1,y=lv.p,text=str.tostring(lv.sc,"#"),xloc=xloc.bar_index,yloc=yloc.price,
             style=label.style_label_left,color=color.new(c,100),textcolor=c,size=size.small))
    0

draw_profile(array<Lvl> a,array<box> bx,array<line> ln,array<label> lb)=>
    int bars=math.max(1,math.min(profLb,bar_index+1))
    [bot,step,tot,buy]=profile(0,bars-1,profRows)
    float mx=tot.max()
    if mx>0
        int poc=tot.indexof(mx)
        [vaLo,vaHi]=value_area(tot,poc,vaPct/100.0)
        int x=bar_index+profOff
        for r=0 to profRows-1
            float rv=tot.get(r)
            if rv>0
                float str=rv/mx
                float bSh=clip(buy.get(r)/rv)
                int tw=math.max(1,int(math.round(profW*str)))
                int bw=int(math.round(tw*bSh))
                int sw=tw-bw
                float y0=bot+(r+0.08)*step
                float y1=bot+(r+0.92)*step
                bool inVA=r>=vaLo and r<=vaHi
                int fade=math.min(92,int(math.round(76.0-46.0*str))+(showVA and not inVA?12:0))
                if bw>0
                    bx.push(box.new(left=x,top=y1,right=x+bw,bottom=y0,xloc=xloc.bar_index,border_color=color.new(buyCol,100),
                     bgcolor=color.new(buyCol,fade)))
                if sw>0
                    bx.push(box.new(left=x+bw,top=y1,right=x+tw,bottom=y0,xloc=xloc.bar_index,border_color=color.new(sellCol,100),
                     bgcolor=color.new(sellCol,fade)))
                if showPoc and r==poc
                    bx.push(box.new(left=x,top=y1,right=x+tw,bottom=y0,xloc=xloc.bar_index,border_color=pocCol,border_width=2,
                     bgcolor=color.new(pocCol,88)))
                if showLvlRows
                    int side=level_row(a,y0,y1)
                    if side!=0
                        color c=side==2?coreCol:side>0?supCol:resCol
                        bx.push(box.new(left=x,top=y1,right=x+tw,bottom=y0,xloc=xloc.bar_index,border_color=c,border_width=2,
                         bgcolor=color.new(coreCol,93)))
        if showPoc
            float p=bot+(poc+0.5)*step
            ln.push(line.new(x1=math.max(0,bar_index-18),y1=p,x2=x,y2=p,xloc=xloc.bar_index,color=color.new(pocCol,25),width=2))
            lb.push(label.new(x=x+profW+2,y=p,text="POC "+str.tostring(p,format.mintick),xloc=xloc.bar_index,yloc=yloc.price,
             style=label.style_label_left,color=color.new(pocCol,100),textcolor=pocCol,size=size.tiny))
        if showVA
            float vah=bot+(vaHi+1)*step
            float val=bot+vaLo*step
            ln.push(line.new(x1=math.max(0,bar_index-18),y1=vah,x2=x+profW,y2=vah,xloc=xloc.bar_index,color=color.new(rawCol,30),width=1,style=line.style_dashed))
            ln.push(line.new(x1=math.max(0,bar_index-18),y1=val,x2=x+profW,y2=val,xloc=xloc.bar_index,color=color.new(rawCol,30),width=1,style=line.style_dashed))
            lb.push(label.new(x=x+profW+2,y=vah,text="VAH "+str.tostring(vah,format.mintick),xloc=xloc.bar_index,yloc=yloc.price,
             style=label.style_label_left,color=color.new(rawCol,100),textcolor=rawCol,size=size.tiny))
            lb.push(label.new(x=x+profW+2,y=val,text="VAL "+str.tostring(val,format.mintick),xloc=xloc.bar_index,yloc=yloc.price,
             style=label.style_label_left,color=color.new(rawCol,100),textcolor=rawCol,size=size.tiny))
    0
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Core Series {
avgVol=ta.sma(volume,VOL_LEN)
atr=ta.atr(14)
ph=ta.pivothigh(high,swingLen,swingLen)
pl=ta.pivotlow(low,swingLen,swingLen)
ready=bar_index>VOL_LEN+swingLen*2+5

// Rasgos de la vela del pivot, calculados en cada vela para que su historial sea por vela
atrPiv=math.max(nz(atr[swingLen],syminfo.mintick),syminfo.mintick)
vbPiv=nz(avgVol[swingLen],volume[swingLen])
absV=math.max(nz(volume,0.0),0.0)
absBase=nz(avgVol,absV)
absVRat=absBase>0?absV/absBase:1.0
absBRat=math.abs(close-open)/math.max(high-low,syminfo.mintick)
absBar=math.sqrt(clip((ABS_BODY_MAX-absBRat)/ABS_BODY_MAX)*clip((absVRat-1.0)/(ABS_VOL_X-1.0)))
absPiv=nz(ta.highest(absBar,ABS_RAD*2+1)[swingLen-ABS_RAD],0.0)
pvVSc=clip(((vbPiv>0?nz(volume[swingLen],0.0)/vbPiv:1.0)-0.8)/(PIV_VOL_X-0.8))
pvRng=math.max(high[swingLen]-low[swingLen],syminfo.mintick)
pvWSup=clip(((math.min(open[swingLen],close[swingLen])-low[swingLen])/pvRng)/0.50)
pvWRes=clip(((high[swingLen]-math.max(open[swingLen],close[swingLen]))/pvRng)/0.50)
pvTime=time[swingLen]

// Tendencia del marco superior con su última vela cerrada (t[1] + lookahead_on = sin repintado): 2/-2 fuerte, 1/-1 débil, 0 sin datos
htf_trend()=>
    float e50=ta.ema(close,50)
    float e200=ta.ema(close,200)
    int t=na(e200)?0:e50>e200?(close>e50?2:1):(close<e50?-2:-1)
    t[1]
htfTrend=nz(request.security(syminfo.tickerid,htfTf,htf_trend(),lookahead=barmerge.lookahead_on),0)

// VWAP: de la sesión CME (reinicio a las 18:00 ET) o RTH, anclado a las 09:30 ET y sin valor fuera de esa sesión
bool inRth=not na(time(timeframe.period,"0930-1600","America/New_York"))
bool rthStart=inRth and not inRth[1]
float vwCme=ta.vwap(hlc3)
float vwRth=ta.vwap(hlc3,rthStart)
vwapV=vwapMode=="RTH 09:30"?(inRth?vwRth:na):vwCme

atrPct=nz(ta.percentrank(atr,500),50.0)
volOk=atrPct>=atrLoPct and atrPct<=atrHiPct
inSess=not useSess or not na(time(timeframe.period,sess,sessTz))
volRel=nz(avgVol)>0?volume/avgVol:1.0
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Objects & State {
var array<Lvl> lvls=array.new<Lvl>()
var array<label> mLb=array.new_label()
var array<label> eLb=array.new_label()
var array<label> pLb=array.new_label()
var array<box> pBx=array.new_box()
var array<line> tLn=array.new_line()
var array<Trade> trades=array.new<Trade>()    // operaciones mostradas (con dibujo y alertas)
var array<Trade> shadows=array.new<Trade>()   // todas las señales A/B/C, solo para estadísticas
// Estadísticas, índice 0=A, 1=B, 2=C (todas las señales del grado), 3=OPERADAS (las mostradas):
// operaciones, ganadoras, suma de R, R ganado bruto, R perdido bruto
var array<float> stN=array.new_float(4,0.0)
var array<float> stW=array.new_float(4,0.0)
var array<float> stR=array.new_float(4,0.0)
var array<float> stGW=array.new_float(4,0.0)
var array<float> stGL=array.new_float(4,0.0)
var int lastSig=-100000
var array<int> lastSh=array.new_int(3,-100000)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Pivot Evaluation {
bool newSup=false
bool newRes=false

// Solo con la vela cerrada, para que un pivot en tiempo real no aparezca y desaparezca dentro de la vela.
// El perfil se calcula una sola vez aunque haya pivot alto y bajo en la misma vela.
if ready and barstate.isconfirmed and (not na(pl) or not na(ph))
    int pvBars=math.max(1,math.min(profLb,bar_index-swingLen+1))
    [pvBot,pvStep,pvTot,pvBuy]=profile(swingLen,swingLen+pvBars-1,profRows)
    if not na(pl)
        newSup:=pivot_eval(lvls,pvBot,pvStep,pvTot,pvBuy,pl,true,atrPiv,pvVSc,pvWSup,absPiv,pvTime,atr)
    if not na(ph)
        newRes:=pivot_eval(lvls,pvBot,pvStep,pvTot,pvBuy,ph,false,atrPiv,pvVSc,pvWRes,absPiv,pvTime,atr)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Level Lifecycle {
[supBreak,resBreak]=manage_breaks(lvls,atr)
trim_lvls(lvls)
update_lvls(lvls)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Market Context (POC / Value Area en caché para el motor de señales) {
var float ctxPoc=na
var float ctxVah=na
var float ctxVal=na
if ready and barstate.isconfirmed and (na(ctxPoc) or bar_index%ctxRefresh==0)
    int cBars=math.max(1,math.min(profLb,bar_index+1))
    [cBot,cStep,cTot,cBuy]=profile(0,cBars-1,profRows)
    float cMx=cTot.max()
    if cMx>0
        int cPoc=cTot.indexof(cMx)
        [cLo,cHi]=value_area(cTot,cPoc,vaPct/100.0)
        ctxPoc:=cBot+(cPoc+0.5)*cStep
        ctxVah:=cBot+(cHi+1)*cStep
        ctxVal:=cBot+cLo*cStep
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Trade Engine {
set_x2(line l,int x)=>
    if not na(l)
        line.set_x2(l,x)
    0

del_trade(Trade t)=>
    if not na(t.lEn)
        line.delete(t.lEn)
        line.delete(t.lSl)
        line.delete(t.lT1)
        line.delete(t.lT2)
    if not na(t.lb)
        label.delete(t.lb)
    0

record(Trade t,int idx)=>
    stN.set(idx,stN.get(idx)+1.0)
    stR.set(idx,stR.get(idx)+t.res)
    if t.res>0
        stW.set(idx,stW.get(idx)+1.0)
        stGW.set(idx,stGW.get(idx)+t.res)
    else if t.res<0
        stGL.set(idx,stGL.get(idx)-t.res)
    0

// Cierra con r (en R, antes de costes) y descuenta el coste de la operación completa
close_trade(Trade t,float r)=>
    float risk=math.abs(t.entry-t.sl)
    float costR=risk>0?costTk*syminfo.mintick/risk:0.0
    t.done:=true
    t.res:=r-costR
    record(t,t.shown?3:t.grade)
    set_x2(t.lEn,bar_index)
    set_x2(t.lSl,bar_index)
    set_x2(t.lT1,bar_index)
    set_x2(t.lT2,bar_index)
    if not na(t.lb)
        label.set_text(t.lb,grade_txt(t.grade)+(t.isLong?" ▲ ":" ▼ ")+(t.res>=0?"+":"")+str.tostring(t.res,"#.##")+"R")
    0

// Resuelve una operación abierta en la vela cerrada actual. Cuando una vela toca a la vez varios precios, se
// elige siempre la lectura prudente: primero el stop, y TP1 + vuelta a la entrada cuenta como break-even.
update_trade(Trade t)=>
    string ev=""
    if not t.done and bar_index>t.openBar
        float risk=math.abs(t.entry-t.sl)
        float w1=tp1Pct/100.0
        float bank=t.tp1Hit?w1*tp1R:0.0
        float rest=t.tp1Hit?1.0-w1:1.0
        bool eos=flatEnd and useSess and not inSess
        bool hitStop=t.isLong?low<=t.curStop:high>=t.curStop
        bool hitT1=t.isLong?high>=t.tp1:low<=t.tp1
        bool hitT2=t.isLong?high>=t.tp2:low<=t.tp2
        if eos
            float mv=risk>0?(t.isLong?open-t.entry:t.entry-open)/risk:0.0
            close_trade(t,bank+rest*mv)
            ev:="FIN DE SESIÓN"
        else if hitStop
            close_trade(t,t.tp1Hit?bank:-1.0)
            ev:=t.tp1Hit?"BREAK-EVEN":"STOP"
        else if hitT2
            t.tp1Hit:=true
            close_trade(t,w1*tp1R+(1.0-w1)*tp2R)
            ev:="TP2"
        else
            if hitT1 and not t.tp1Hit
                t.tp1Hit:=true
                t.curStop:=t.entry
                ev:="TP1"
                if t.isLong?low<=t.entry:high>=t.entry
                    close_trade(t,w1*tp1R)
                    ev:="TP1 + BREAK-EVEN"
            if not t.done and bar_index-t.openBar>=maxBars
                float bank2=t.tp1Hit?w1*tp1R:0.0
                float rest2=t.tp1Hit?1.0-w1:1.0
                float mv2=risk>0?(t.isLong?close-t.entry:t.entry-close)/risk:0.0
                close_trade(t,bank2+rest2*mv2)
                ev:="TIEMPO"
        if not t.done
            set_x2(t.lEn,bar_index+1)
            set_x2(t.lSl,bar_index+1)
            set_x2(t.lT1,bar_index+1)
            set_x2(t.lT2,bar_index+1)
    ev

// Operación de estadísticas: sin dibujo ni alertas
shadow_trade(bool isLong,int g,float entry,float sl)=>
    float risk=math.abs(entry-sl)
    Trade.new(isLong=isLong,grade=g,openBar=bar_index,entry=entry,sl=sl,tp1=isLong?entry+risk*tp1R:entry-risk*tp1R,
     tp2=isLong?entry+risk*tp2R:entry-risk*tp2R,curStop=sl)

open_trade(bool isLong,int g,float entry,float sl,string trig,Lvl lv,float pts)=>
    float risk=math.abs(entry-sl)
    float tp1=isLong?entry+risk*tp1R:entry-risk*tp1R
    float tp2=isLong?entry+risk*tp2R:entry-risk*tp2R
    line lEn=na
    line lSl=na
    line lT1=na
    line lT2=na
    if showTrades
        lEn:=line.new(bar_index,entry,bar_index+1,entry,color=color.new(rawCol,10),width=1)
        lSl:=line.new(bar_index,sl,bar_index+1,sl,color=color.new(resCol,10),width=1)
        lT1:=line.new(bar_index,tp1,bar_index+1,tp1,color=color.new(supCol,40),width=1,style=line.style_dashed)
        lT2:=line.new(bar_index,tp2,bar_index+1,tp2,color=color.new(supCol,10),width=1)
    string tip=(isLong?"COMPRA ":"VENTA ")+grade_txt(g)+"  ("+str.tostring(pts,"#.#")+" pts)"
     +"\nGatillo: "+trig
     +"\nNivel: "+str.tostring(lv.p,format.mintick)+" (score "+str.tostring(lv.sc,"#")+(lv.flipped?", invertido":"")+")"
     +"\nEntrada: "+str.tostring(entry,format.mintick)+"   SL: "+str.tostring(sl,format.mintick)
     +"\nTP1: "+str.tostring(tp1,format.mintick)+"   TP2: "+str.tostring(tp2,format.mintick)
    label lb=label.new(bar_index,isLong?low:high,grade_txt(g)+(isLong?" ▲":" ▼"),yloc=yloc.price,
     style=isLong?label.style_label_up:label.style_label_down,color=color.new(lvl_col(isLong),grade_alpha(g)),
     textcolor=color.white,size=size.small,tooltip=tip)
    Trade.new(isLong=isLong,grade=g,openBar=bar_index,entry=entry,sl=sl,tp1=tp1,tp2=tp2,curStop=sl,shown=true,
     lEn=lEn,lSl=lSl,lT1=lT1,lT2=lT2,lb=lb)

// Operaciones de estadísticas: se resuelven y las cerradas salen del array (su resultado ya está anotado)
if barstate.isconfirmed and shadows.size()>0
    for i=shadows.size()-1 to 0
        Trade t=shadows.get(i)
        update_trade(t)
        if t.done
            shadows.remove(i)

// Operaciones mostradas: todos los eventos de la vela van en una sola alerta
string evMsg=""
if barstate.isconfirmed and trades.size()>0
    for i=0 to trades.size()-1
        Trade t=trades.get(i)
        if not t.done
            string ev=update_trade(t)
            if ev!=""
                evMsg+=(evMsg==""?"":" || ")+(t.isLong?"COMPRA ":"VENTA ")+grade_txt(t.grade)+" @ "+str.tostring(t.entry,format.mintick)+" → "+ev
                 +(t.done?" ("+(t.res>=0?"+":"")+str.tostring(t.res,"#.##")+"R)":" (stop a break-even)")

// Recorta el dibujo de las operaciones mostradas más antiguas ya cerradas
while trades.size()>maxDrawn
    if trades.first().done
        del_trade(trades.shift())
    else
        break

bool hasOpen=false
if trades.size()>0
    for i=0 to trades.size()-1
        if not trades.get(i).done
            hasOpen:=true
            break

if evMsg!=""
    alert(syminfo.ticker+" "+timeframe.period+" | "+evMsg,alert.freq_once_per_bar_close)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Signal Engine {
float zone=nz(atr,0.0)*zoneAtr
float tLo=ta.lowest(low,3)
float tHi=ta.highest(high,3)
float lo2=math.min(low,low[1])
float hi2=math.max(high,high[1])
float low1=low[1]
float high1=high[1]
float clPos=high>low?(close-low)/(high-low):0.5
bool bullBody=close>open and clPos>=0.5
bool bearBody=close<open and clPos<=0.5
bool absNow=absBar>=ABS_SIG
bool absPrev=nz(absBar[1])>=ABS_SIG
bool dFlipUp=not na(deltaAvg) and delta>0 and delta>=deltaAvg and math.min(nz(delta[1]),nz(delta[2]))<0
bool dFlipDn=not na(deltaAvg) and delta<0 and -delta>=deltaAvg and math.max(nz(delta[1]),nz(delta[2]))>0

// Nivel más fuerte de un lado testado en las últimas 3 velas, que aguanta en este cierre y tiene al menos un
// gatillo. Devuelve su índice, el número de gatillos y sus nombres. También registra el primer test de cada
// nivel invertido: solo ese episodio vale como ruptura y retest.
scan_triggers(array<Lvl> a,bool supp,bool bodyOk,bool flipOk)=>
    int bestId=-1
    int bestN=0
    float bestSc=-1.0
    string bestName=""
    if a.size()>0
        for i=0 to a.size()-1
            Lvl lv=a.get(i)
            // Un nivel recién invertido necesita unas velas para que la propia vela de rotura no cuente como retest
            bool fresh=not lv.flipped or bar_index-lv.flipBar>3
            if lv.supp==supp and fresh
                bool touched=supp?tLo<=lv.p+zone:tHi>=lv.p-zone
                if barstate.isconfirmed and lv.flipped and touched and na(lv.rtBar)
                    lv.rtBar:=bar_index
                bool holds=supp?close>lv.p:close<lv.p
                if bodyOk and lv.sc>=sigMinLvl and touched and holds
                    bool sw=useSweep and (supp?lo2<lv.p:hi2>lv.p)
                    // La vela de absorción tiene que estar en el nivel, no en cualquier parte
                    bool ab=useAbs and (supp?(absNow and low<=lv.p+zone) or (absPrev and low1<=lv.p+zone):(absNow and high>=lv.p-zone) or (absPrev and high1>=lv.p-zone))
                    bool df=useDflip and flipOk
                    bool rt=useRetest and lv.flipped and not na(lv.rtBar) and bar_index-lv.rtBar<=2
                    int n=(sw?1:0)+(ab?1:0)+(df?1:0)+(rt?1:0)
                    if n>0 and lv.sc>bestSc
                        string nm=sw?"Barrida":""
                        nm:=ab?(nm==""?"Absorción":nm+" + Absorción"):nm
                        nm:=df?(nm==""?"Giro del delta":nm+" + Giro del delta"):nm
                        nm:=rt?(nm==""?"Ruptura y retest":nm+" + Ruptura y retest"):nm
                        bestSc:=lv.sc
                        bestId:=i
                        bestN:=n
                        bestName:=nm
    [bestId,bestN,bestName]

// Puntos de confluencia, stop y veredicto de los filtros duros para una candidata
candidate(bool isLong,Lvl lv,int nTrig)=>
    float a=nz(atr,0.0)
    float sl=isLong?math.min(lv.p,tLo)-a*slAtr:math.max(lv.p,tHi)+a*slAtr
    float risk=math.abs(close-sl)
    float room=nearest_opp(lvls,isLong,close)
    // El objetivo final tiene que caber antes del siguiente nivel contrario
    bool roomOk=na(room) or (risk>0 and room/risk>=math.max(roomMin,tp2R))
    bool riskOk=risk>0 and risk<=a*maxRiskAtr
    int al=htfTrend*(isLong?1:-1)
    bool htfOk=htfMode!="Filtro" or al>0
    float pts=3.0*lv.sc/100.0
    if htfMode!="Off"
        pts+=al>=2?2.0:al==1?1.0:al<0?-2.0:0.0
    pts+=(isLong?close>vwapV:close<vwapV)?1.0:0.0
    bool vaLoc=not na(ctxPoc) and (math.abs(lv.p-ctxPoc)<=zone or (isLong?lv.p<=ctxVal+zone:lv.p>=ctxVah-zone))
    pts+=vaLoc?1.0:0.0
    pts+=math.min(nTrig-1.0,2.0)
    pts+=(isLong?delta>0:delta<0)?1.0:0.0
    pts+=volRel>=1.2?1.0:0.0
    pts+=lv.touches>=2?0.5:0.0
    [pts,sl,roomOk and riskOk and htfOk]

[lId,lN,lName]=scan_triggers(lvls,true,bullBody,dFlipUp)
[sId,sN,sName]=scan_triggers(lvls,false,bearBody,dFlipDn)

bool longSig=false
bool shortSig=false
int minG=minGrade=="A"?0:minGrade=="B"?1:2

// La mejor candidata de la vela pasa por los filtros. Si tiene grado A, B o C se sigue SIEMPRE en estadísticas
// (con su propia espera por grado), y además se muestra y avisa si cumple el grado mínimo y "una a la vez".
if ready and barstate.isconfirmed and inSess and volOk
    float bestPts=-100.0
    bool bestLong=false
    float bestSl=na
    int bestLv=-1
    string bestName=""
    if lId>=0
        [lp,lsl,lok]=candidate(true,lvls.get(lId),lN)
        if lok and lp>bestPts
            bestPts:=lp
            bestLong:=true
            bestSl:=lsl
            bestLv:=lId
            bestName:=lName
    if sId>=0
        [sp,ssl,sok]=candidate(false,lvls.get(sId),sN)
        if sok and sp>bestPts
            bestPts:=sp
            bestLong:=false
            bestSl:=ssl
            bestLv:=sId
            bestName:=sName
    if bestLv>=0
        int g=grade_of(bestPts)
        if g<=2
            if bar_index-lastSh.get(g)>cooldown
                shadows.push(shadow_trade(bestLong,g,close,bestSl))
                lastSh.set(g,bar_index)
            if showSig and g<=minG and bar_index-lastSig>cooldown and not (oneTrade and hasOpen)
                Trade nt=open_trade(bestLong,g,close,bestSl,bestName,lvls.get(bestLv),bestPts)
                trades.push(nt)
                lastSig:=bar_index
                longSig:=bestLong
                shortSig:=not bestLong
                alert(syminfo.ticker+" "+timeframe.period+" | "+(bestLong?"COMPRA ":"VENTA ")+grade_txt(g)+" | "+bestName
                 +" | Entrada "+str.tostring(nt.entry,format.mintick)+" SL "+str.tostring(nt.sl,format.mintick)
                 +" TP1 "+str.tostring(nt.tp1,format.mintick)+" TP2 "+str.tostring(nt.tp2,format.mintick),alert.freq_once_per_bar_close)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Drawing {
if barstate.islast
    clear_labels(mLb)
    clear_labels(eLb)
    clear_labels(pLb)
    clear_boxes(pBx)
    clear_lines(tLn)

    draw_markers(lvls,mLb,tLn)
    draw_edge(lvls,eLb)
    if showProf
        draw_profile(lvls,pBx,tLn,pLb)

plot(showVwap?vwapV:na,"VWAP",color=color.new(coreCol,15),linewidth=2,style=plot.style_linebr)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Dashboard {
dash_pos(string p)=>p=="Arriba izquierda"?position.top_left:p=="Abajo derecha"?position.bottom_right:p=="Abajo izquierda"?position.bottom_left:position.top_right
var table dash=table.new(dash_pos(dashPos),5,13,bgcolor=color.new(#131722,6),border_width=1,border_color=color.new(color.gray,82),
 frame_width=1,frame_color=color.new(color.gray,60))
dSz=dashSize=="Diminuto"?size.tiny:dashSize=="Normal"?size.normal:size.small
color dTxt=color.new(color.white,8)
color dMut=color.new(color.gray,5)

dcell(int c,int r,string t,color tc)=>
    table.cell(dash,c,r,t,text_color=tc,text_size=dSz,text_halign=text.align_left)
    0

stat_row(int r,string name,float n,float w,float sr,float gw,float gl)=>
    float wr=n>0?w/n*100.0:na
    float ar=n>0?sr/n:na
    float pf=gl>0?gw/gl:na
    dcell(0,r,name,dTxt)
    dcell(1,r,n>0?str.tostring(n,"#"):"-",dTxt)
    dcell(2,r,na(wr)?"-":str.tostring(wr,"#")+"%",na(wr)?dMut:wr>=55?supCol:wr<45?resCol:dTxt)
    dcell(3,r,na(ar)?"-":(ar>=0?"+":"")+str.tostring(ar,"#.##")+"R",na(ar)?dMut:ar>0?supCol:resCol)
    dcell(4,r,na(pf)?(gw>0?"∞":"-"):str.tostring(pf,"#.##"),na(pf)?(gw>0?supCol:dMut):pf>=1.3?supCol:pf<1.0?resCol:dTxt)
    0

var bool dashMerged=false
if showDash and barstate.islast
    if not dashMerged
        for r=0 to 7
            table.merge_cells(dash,1,r,4,r)
        dashMerged:=true
    string ht=htfTrend>=2?"ALCISTA ▲▲":htfTrend==1?"ALCISTA ▲":htfTrend<=-2?"BAJISTA ▼▼":htfTrend==-1?"BAJISTA ▼":"—"
    float dS=nearest_opp(lvls,false,close)
    float dR=nearest_opp(lvls,true,close)
    string pos="Plano"
    color posC=dMut
    if trades.size()>0
        Trade lt=trades.last()
        if not lt.done
            pos:=(lt.isLong?"COMPRA ":"VENTA ")+grade_txt(lt.grade)+" @ "+str.tostring(lt.entry,format.mintick)+" · SL "+str.tostring(lt.curStop,format.mintick)
             +(lt.tp1Hit?" · TP1 ✓ (BE)":" · TP1 "+str.tostring(lt.tp1,format.mintick))
            posC:=lt.isLong?supCol:resCol
    string cov=ibWanted and covN>0?" · datos "+str.tostring(100.0*covIb/covN,"#")+"% hist.":""
    dcell(0,0,"PSR PRO",coreCol)
    dcell(1,0,syminfo.ticker+" · "+timeframe.period,dTxt)
    dcell(0,1,"Marco "+htfTf,dMut)
    dcell(1,1,ht+(htfMode=="Filtro"?"  (filtro)":""),htfTrend>0?supCol:htfTrend<0?resCol:dMut)
    dcell(0,2,"VWAP "+(vwapMode=="RTH 09:30"?"RTH":"CME"),dMut)
    dcell(1,2,na(vwapV)?"— (fuera de RTH)":(close>vwapV?"Encima · ":"Debajo · ")+str.tostring(vwapV,format.mintick),na(vwapV)?dMut:close>vwapV?supCol:resCol)
    dcell(0,3,"Volatilidad",dMut)
    dcell(1,3,"ATR "+str.tostring(atr,format.mintick)+" · pctl "+str.tostring(atrPct,"#")+(volOk?" · OK":atrPct<atrLoPct?" · DEMASIADO BAJA":" · DEMASIADO ALTA"),volOk?dTxt:resCol)
    dcell(0,4,"Sesión",dMut)
    dcell(1,4,inSess?"ABIERTA":"CERRADA",inSess?supCol:dMut)
    dcell(0,5,"Flujo",dMut)
    dcell(1,5,(ibOk?(deltaSrc==SRC_TICK?"Tick ":"Intravela ")+ltfTf:"Estimación por vela")+" · Δ "+str.tostring(delta,"#")+cov,delta>0?supCol:resCol)
    dcell(0,6,"S / R próximos",dMut)
    dcell(1,6,(na(dS)?"—":str.tostring(close-dS,format.mintick))+"  /  "+(na(dR)?"—":str.tostring(close+dR,format.mintick)),dTxt)
    dcell(0,7,"Posición",dMut)
    dcell(1,7,pos,posC)
    dcell(0,8,"Grado",dMut)
    dcell(1,8,"Ops",dMut)
    dcell(2,8,"Acierto",dMut)
    dcell(3,8,"R medio",dMut)
    dcell(4,8,"PF",dMut)
    for g=0 to 2
        stat_row(9+g,grade_txt(g)+(g>minG?" (sin señal)":""),stN.get(g),stW.get(g),stR.get(g),stGW.get(g),stGL.get(g))
    stat_row(12,"OPERADAS",stN.get(3),stW.get(3),stR.get(3),stGW.get(3),stGL.get(3))
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Alerts {
alertcondition(newSup,"Soporte nuevo","Un pivot bajo confirmado por el perfil de volumen se ha convertido en soporte.")
alertcondition(newRes,"Resistencia nueva","Un pivot alto confirmado por el perfil de volumen se ha convertido en resistencia.")
alertcondition(supBreak,"Soporte roto","Un soporte activo se ha roto con un cierre confirmado.")
alertcondition(resBreak,"Resistencia rota","Una resistencia activa se ha roto con un cierre confirmado.")
alertcondition(longSig,"PSR Pro COMPRA","{{ticker}} {{interval}}: señal de COMPRA de PSR Pro @ {{close}}")
alertcondition(shortSig,"PSR Pro VENTA","{{ticker}} {{interval}}: señal de VENTA de PSR Pro @ {{close}}")
// Para el detalle completo (grado, gatillo, entrada, SL, TP1, TP2 y los eventos TP1 / BE / stop / objetivo)
// crea la alerta con "Cualquier llamada a la función alert()".
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}
