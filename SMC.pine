//@version=6
// ─────────────────────────────────────────────────────────
// SMC Pro - Institutional v6.6 | Multi-Timeframe Auto-Calibrated para MES/MNQ Micro-Futures
// v6.2: Auto-Calibración Dinámica por Timeframe (effSwingLen, effObMaxAge, effFvgMinSize, effFvgMaxAge, effAtrMult, effBosCooldown, effPdLookback)
// v6.3: Session-Weighted Scoring, Volatility-Adaptive minScore, Squeeze Detection, Signal Interlock, Trailing Stop
// v6.4: Order Flow realineado a criterios institucionales (Absorción con volumen+rango, Agotamiento AND en vez de OR,
//       inside bar direccional por tendencia, Cumulative Delta Divergence integrado a la pata de Absorción)
// v6.5: Price Action / SMC realineado a criterios institucionales — Order Block = última vela de color opuesto
//       (no el extremo del swing), EQH/EQL con separación mínima entre coincidencias, IDM confirmado por sweep
//       posterior (no solo por formación), Premium/Discount anclado al leg activo, Wyckoff Spring/UTAD exige
//       contexto de rango (ADX bajo)
// v6.6: Alertas realineadas a práctica institucional — alertas de SALIDA (SL/TP1/TP2/Trailing hit, ausentes
//       hasta ahora), detección de flanco en alertas de estado (Dead Zone/Near OB/Near Key Level/OTE Zone,
//       antes repetían en cada barra), y convención de nombres 🎯 SEÑAL (riesgo definido) vs ℹ️ CONTEXTO
// ─────────────────────────────────────────────────────────
indicator("SMC Pro v6.6 · MES/MNQ Multi-TF Auto", shorttitle="SMC v6.6", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)
max_bars_back(time, 500)

// ══════════════════════════════════════════════════════════════════════════════
// ██ TYPES
// ══════════════════════════════════════════════════════════════════════════════

type OrderBlock
    box    id
    float  top
    float  bottom
    float  bodyHigh
    float  bodyLow
    bool   isBullish
    bool   mitigated
    int    creationIndex
    bool   hasFVG
    bool   isBreaker
    int    strength       // 1=Normal, 2=Unicorn, 3=HTF_Aligned

type FVG
    float top
    float bottom
    bool  isBullish
    int   index
    box   id

// ══════════════════════════════════════════════════════════════════════════════
// ██ METHODS
// ══════════════════════════════════════════════════════════════════════════════

method extend(OrderBlock ob) =>
    if not ob.mitigated
        box.set_right(ob.id, bar_index + 5)

method mitigate(OrderBlock ob, bool remove, color mitColor) =>
    ob.mitigated := true
    if remove
        box.delete(ob.id)
    else
        box.set_bgcolor(ob.id, color.new(mitColor, 60))
        box.set_border_color(ob.id, mitColor)
        box.set_text(ob.id, "MITIGATED")

method toBreaker(OrderBlock ob, bool toBullish, color newColor) =>
    ob.isBreaker := true
    ob.isBullish := toBullish
    box.set_border_style(ob.id, line.style_dashed)
    box.set_bgcolor(ob.id, color.new(newColor, 70))
    box.set_border_color(ob.id, newColor)
    box.set_text(ob.id, "💔 Breaker")

// v6.0: Age-based expiry method
method isExpired(OrderBlock ob, int maxAge) =>
    not ob.mitigated and not ob.isBreaker and (bar_index - ob.creationIndex) > maxAge

f_ma(src, len, type) =>
    switch type
        "SMA"  => ta.sma(src, len)
        "EMA"  => ta.ema(src, len)
        "WMA"  => ta.wma(src, len)
        "HMA"  => ta.hma(src, len)
        "VWMA" => ta.vwma(src, len)
        =>        ta.ema(src, len)

// Helper SL/TP unificado
f_sl_tp(isBuy, slLevel, tpRef, _atr, _rr, _show, _showTP2) =>
    if _show and not na(slLevel)
        float _sl = slLevel
        float _rk = math.max(isBuy ? tpRef - _sl : _sl - tpRef, _atr * 0.1)
        if _rk > _atr * 3.5
            _sl := isBuy ? tpRef - _atr * 2.0 : tpRef + _atr * 2.0
            _rk := _atr * 2.0
        float _tp1 = isBuy ? tpRef + _rk * _rr * 0.5 : tpRef - _rk * _rr * 0.5
        float _tp2 = isBuy ? tpRef + _rk * _rr       : tpRef - _rk * _rr
        line.new(bar_index, _sl, bar_index + 8, _sl, color=color.new(#FF5252, 20), style=line.style_dashed, width=2)
        if _showTP2
            line.new(bar_index, _tp1, bar_index + 8, _tp1, color=color.new(#00E676, 50), width=1, style=line.style_dashed)
        line.new(bar_index, _tp2, bar_index + 8, _tp2, color=color.new(#00E676, 20), width=2)

f_calc_contracts(accountBal, riskPct, entryPrice, slPrice) =>
    float dist = math.abs(entryPrice - slPrice)
    float riskVal = accountBal * (riskPct / 100)
    int contracts = dist > 0 ? math.max(1, math.round(riskVal / (dist * syminfo.pointvalue))) : 1
    contracts

// v6.5 fix: definición institucional de Order Block = ÚLTIMA vela de color OPUESTO al impulso antes del
// BOS/CHoCH (no el extremo del swing). Busca hacia atrás desde el origen del impulso; si no encuentra ninguna
// vela opuesta en la ventana (todo el tramo fue del mismo color, caso raro), cae al extremo del swing como antes.
f_lastOppositeCandle(bullishOB, maxBars, fallbackIdx) =>
    int idx = fallbackIdx
    for k = 1 to maxBars
        bool isOpposite = bullishOB ? close[k] < open[k] : close[k] > open[k]
        if isOpposite
            idx := k
            break
    idx

