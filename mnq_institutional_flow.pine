//@version=6
// ─────────────────────────────────────────────────────────
// MNQ Institutional Flow v2.0 | Autor: J | TF óptimo: 1m–5m | Activo: MNQ/NQ
// VWAP RTH ±σ · ORB · Initial Balance · PDH/PDL/PDC · Overnight H/L
// Régimen Gamma (niveles NQ, NDX o QQQ) · RVOL por hora del día
// Momentum intradía (Gao et al. 2018) · Señales calificadas A+/A/B/C con SL/TP
// ─────────────────────────────────────────────────────────

// ══ [1] DECLARACIÓN ══
indicator("MNQ Institutional Flow", "MNQ IF", overlay=true, max_labels_count=500, max_lines_count=500)

// ══ [2] TIPOS ══
type Setup
    string tag      // "ORB", "FADE", "MOM"
    int    dir      // 1 = largo, -1 = corto
    float  entry
    float  stop
    float  tp1
    float  tp2
    int    score    // confluencias cumplidas (0–4)
    string notes    // detalle de confluencias para tooltip

// ══ [3] MÉTODOS Y FUNCIONES ══
method grade(Setup this) =>
    this.score >= 4 ? "A+" : this.score == 3 ? "A" : this.score == 2 ? "B" : "C"

method riskPts(Setup this) =>
    na(this.stop) ? na : math.abs(this.entry - this.stop)

f_hm(string s, int pos) =>
    int(str.tonumber(str.substring(s, pos, pos + 2)))

f_chk(bool ok, string txt) =>
    (ok ? "✔ " : "✘ ") + txt + "\n"

// Nivel más cercano en la dirección del trade (resistencia en largos, soporte en cortos)
f_nextLevel(float px, int dir, array<float> lv) =>
    float best = na
    for l in lv
        if not na(l) and (dir == 1 ? l > px : l < px)
            best := na(best) ? l : dir == 1 ? math.min(best, l) : math.max(best, l)
    best

// ¿Hay algún nivel dentro de [lo, hi]?
f_anyIn(array<float> lv, float lo, float hi) =>
    bool hit = false
    for l in lv
        if not na(l) and l >= lo and l <= hi
            hit := true
    hit

// ══ [4] INPUTS ══
grpSess = "═══ 🕘 SESIÓN ═══"
grpLvl  = "═══ 📐 NIVELES ═══"
grpGex  = "═══ 🧲 GAMMA (manual) ═══"
grpSig  = "═══ 🎯 SEÑALES ═══"
grpRisk = "═══ 🛡️ RIESGO ═══"
grpDash = "═══ 📊 DASHBOARD ═══"

rthSess    = input.session("0930-1600", "Sesión RTH (NY)", group=grpSess, tooltip="Horario regular de Nueva York. VWAP, ORB, IB, RVOL y momentum se anclan aquí.")
onSess     = input.session("1800-0930", "Sesión Overnight (NY)", group=grpSess, tooltip="Globex. Define ONH/ONL. Requiere que el gráfico muestre el horario extendido (por defecto en futuros CME).")
orbMins    = input.int(5, "Minutos ORB", minval=1, maxval=60, group=grpSess, tooltip="5 = ORB de Zarattini & Aziz. Usar en gráficos de 1 a 5 min (el TF debe dividir este valor).")
ibMins     = input.int(60, "Minutos Initial Balance", minval=15, maxval=120, group=grpSess, tooltip="60 = IB clásico de Market Profile (09:30–10:30).")

showFill   = input.bool(true, "Relleno entre ±1σ y ±2σ", group=grpLvl)
showBand3  = input.bool(false, "Bandas ±3σ", group=grpLvl, tooltip="Las ±3σ son el stop de referencia de los fades aunque estén ocultas.")
showORB    = input.bool(true, "ORB", group=grpLvl, inline="l1")
showIB     = input.bool(true, "Initial Balance", group=grpLvl, inline="l1")
showPD     = input.bool(true, "PDH / PDL / PDC", group=grpLvl, inline="l2", tooltip="Máximo, mínimo y cierre de la sesión RTH anterior.")
showON     = input.bool(true, "ONH / ONL", group=grpLvl, inline="l2")
showLvlLbl = input.bool(true, "Etiquetas de niveles en el borde derecho", group=grpLvl)

gexUnits     = input.string("NQ / MNQ", "Unidades de los niveles", options=["NQ / MNQ", "NDX", "QQQ"], group=grpGex, tooltip="Si tu proveedor publica niveles de NDX o QQQ, se convierten a precio del futuro con el ratio en vivo de la sesión RTH.")
gammaFlip    = input.float(0.0, "Gamma Flip", minval=0, step=0.25, group=grpGex, tooltip="Nivel de gamma flip. Actualizar cada mañana. 0 = desactivado.")
callWall     = input.float(0.0, "Call Wall", minval=0, step=0.25, group=grpGex, tooltip="Resistencia por gamma. 0 = oculto.")
putWall      = input.float(0.0, "Put Wall", minval=0, step=0.25, group=grpGex, tooltip="Soporte por gamma. 0 = oculto.")
useGexFilter = input.bool(true, "Filtrar señales por régimen", group=grpGex, tooltip="Gamma negativa: solo breakouts. Gamma positiva: solo fades en bandas ±2σ. Sin flip cargado: todas.")

showBreak = input.bool(true, "Señales Breakout ORB", group=grpSig)
showFade  = input.bool(true, "Señales Fade ±2σ", group=grpSig)
showMom   = input.bool(true, "Señal Momentum última media hora", group=grpSig, tooltip="Dirección del retorno cierre RTH previo → 10:00 (Gao et al. 2018), confirmada por la media hora 15:00–15:30.")
minGrade  = input.string("C", "Calificación mínima", options=["A+", "A", "B", "C"], group=grpSig, tooltip="Cada señal suma hasta 4 confluencias.\nORB: contexto (gamma negativa o lado del cierre previo), RVOL, espacio ≥ 1R hasta el siguiente nivel, cierre con convicción.\nFADE: contexto (gamma positiva o RVOL bajo), mecha de rechazo, confluencia con nivel clave, espacio ≥ 1R hasta VWAP.\nMOM: base B, +1 si la media hora 15:00–15:30 coincide, +1 con RVOL alto.\nA+ = 4 · A = 3 · B = 2 · C = 0–1.")
rvolMin   = input.float(1.2, "RVOL de referencia", minval=0.5, maxval=5, step=0.1, group=grpSig, tooltip="Volumen RTH acumulado frente al promedio a la misma hora. Por encima = participación institucional (favorece breakouts); por debajo = rotación (favorece fades).")
rvolDays  = input.int(10, "Sesiones para RVOL", minval=5, maxval=50, group=grpSig, tooltip="Promedio móvil de las últimas N sesiones. Requiere al menos 3 sesiones de historia en el gráfico.")
cooldown  = input.int(10, "Barras entre señales", minval=1, maxval=100, group=grpSig)
fadeStart = input.int(30, "Fades desde (min tras apertura)", minval=5, maxval=120, group=grpSig, tooltip="Las bandas σ son demasiado estrechas al inicio de la sesión. 30 = 10:00 NY.")
breakCut  = input.int(330, "Sin breakouts tras (min tras apertura)", minval=30, maxval=390, group=grpSig, tooltip="330 = 15:00 NY")
fadeCut   = input.int(375, "Sin fades tras (min tras apertura)", minval=60, maxval=390, group=grpSig, tooltip="375 = 15:45 NY")

showRisk = input.bool(true, "Proyectar SL / TP de la última señal", group=grpRisk)
orbStop  = input.string("Extremo opuesto", "Stop del breakout ORB", options=["Extremo opuesto", "Medio ORB"], group=grpRisk, tooltip="Extremo opuesto = stop original de Zarattini & Aziz. Medio ORB = mitad de riesgo, más barridos.")
rr1      = input.float(1.0, "TP1 breakout (R)", minval=0.5, maxval=10, step=0.5, group=grpRisk)
rr2      = input.float(2.0, "TP2 breakout (R)", minval=0.5, maxval=20, step=0.5, group=grpRisk, tooltip="Fades: TP1 = ±1σ y TP2 = VWAP. Stop del fade = más allá de ±3σ o del extremo de la vela.")
riskBars = input.int(30, "Largo de la proyección (barras)", minval=5, maxval=200, group=grpRisk)

showDash = input.bool(true, "Mostrar dashboard", group=grpDash)
dashPos  = input.string("Arriba derecha", "Posición", options=["Arriba derecha", "Arriba izquierda", "Abajo derecha", "Abajo izquierda"], group=grpDash)
dashSize = input.string("Small", "Tamaño", options=["Tiny", "Small", "Normal"], group=grpDash)

// Paleta
C_BULL = #00E676
C_BEAR = #FF5252
C_GOLD = #FFD700
C_ORB  = #2196F3
C_IB   = #B388FF
C_PD   = #90A4AE
C_ON   = #FFB74D
C_GEX  = #E040FB
C_BG   = #131722

// ══ [5] VARIABLES var ══
var int    lastOpenT    = na
var float  vwSum        = 0.0
var float  vwVol        = 0.0
var float  vwSq         = 0.0
var float  cumVol       = 0.0
var float  orbH         = na
var float  orbL         = na
var float  ibH          = na
var float  ibL          = na
var float  rthH         = na
var float  rthL         = na
var float  pdh          = na
var float  pdl          = na
var float  pdc          = na
var float  onH          = na
var float  onL          = na
var float  lastRthClose = na
var float  r30          = na
var float  p1500        = na
var float  r12          = na
var float  gexRatio     = na
var bool   longFired    = false
var bool   shortFired   = false
var bool   momShown     = false
var int    lastSig      = -999
var string lastSigTxt   = "—"
var string lastRiskTxt  = "—"
var color  lastSigCol   = color.gray
var map<int, float> volAvg = map.new<int, float>()
var map<int, int>   volCnt = map.new<int, int>()
var array<line>     riskLines = array.new<line>()
var array<linefill> riskFills = array.new<linefill>()
var array<label>    riskLbls  = array.new<label>()
var array<line>     gexLines  = array.new<line>()
var array<label>    lvlLbls   = array.new<label>()

// ══ [6] CÁLCULOS CORE ══
tz = "America/New_York"
int  oH      = f_hm(rthSess, 0)
int  oM      = f_hm(rthSess, 2)
int  sessLen = f_hm(rthSess, 5) * 60 + f_hm(rthSess, 7) - (oH * 60 + oM)
bool tfOK    = timeframe.isintraday and timeframe.in_seconds() <= 900
bool rawRTH  = not na(time(timeframe.period, rthSess, tz))
bool rawON   = not na(time(timeframe.period, onSess, tz))
bool inRTH   = tfOK and rawRTH
bool inON    = tfOK and rawON
bool newDay  = dayofmonth(time, tz) != dayofmonth(time[1], tz)
bool newSess = inRTH and (not inRTH[1] or newDay)
bool newON   = inON and not inON[1]
int  openT   = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), oH, oM)

// Overnight (Globex): ONH / ONL
if newON
    onH := high
    onL := low
else if inON
    onH := math.max(onH, high)
    onL := math.min(onL, low)

if newSess
    lastOpenT  := openT
    pdh        := rthH
    pdl        := rthL
    pdc        := lastRthClose
    rthH       := high
    rthL       := low
    vwSum      := 0.0
    vwVol      := 0.0
    vwSq       := 0.0
    cumVol     := 0.0
    orbH       := high
    orbL       := low
    ibH        := high
    ibL        := low
    r30        := na
    p1500      := na
    r12        := na
    longFired  := false
    shortFired := false
    momShown   := false

// Minutos desde la apertura al inicio (elapsed) y al cierre (elapsedC) de la barra.
// Se miden contra la hora oficial de apertura, no contra la primera barra cargada.
float elapsed  = inRTH ? (time - openT) / 60000.0 : na
float elapsedC = inRTH ? (time_close - openT) / 60000.0 : na
bool  inORB    = inRTH and elapsed < orbMins
bool  orbDone  = inRTH and elapsed >= orbMins
bool  inIB     = inRTH and elapsed < ibMins
bool  ibDone   = inRTH and elapsed >= ibMins

if inRTH and not newSess
    rthH := math.max(rthH, high)
    rthL := math.min(rthL, low)
    if inORB
        orbH := math.max(orbH, high)
        orbL := math.min(orbL, low)
    if inIB
        ibH := math.max(ibH, high)
        ibL := math.min(ibL, low)

if inRTH
    float v = nz(volume)
    vwSum        += hlc3 * v
    vwVol        += v
    vwSq         += hlc3 * hlc3 * v
    cumVol       += v
    lastRthClose := close

float vwapVal = vwVol > 0 ? vwSum / vwVol : na
float vwStd   = vwVol > 0 ? math.sqrt(math.max(vwSq / vwVol - vwapVal * vwapVal, 0.0)) : na
float up1     = vwapVal + vwStd
float dn1     = vwapVal - vwStd
float up2     = vwapVal + vwStd * 2
float dn2     = vwapVal - vwStd * 2
float up3     = vwapVal + vwStd * 3
float dn3     = vwapVal - vwStd * 3
float zVwap   = vwStd > 0 ? (close - vwapVal) / vwStd : na
float atr     = ta.atr(14)

// Momentum intradía (Gao et al. 2018): r1 = cierre RTH previo → 10:00, r12 = 15:00 → 15:30.
// Se toma el cierre de la barra que termina en la hora exacta (sin una barra de retraso).
if inRTH and na(r30) and not na(pdc) and elapsedC >= 30
    r30 := close / pdc - 1
if inRTH and na(p1500) and elapsedC >= sessLen - 60
    p1500 := close
if inRTH and na(r12) and not na(p1500) and elapsedC >= sessLen - 30
    r12 := close / p1500 - 1

// RVOL por hora del día: volumen RTH acumulado vs. su promedio a la misma hora en sesiones previas.
int   rvKey = inRTH ? int(math.round(elapsedC)) : na
int   rvCnt = inRTH and volCnt.contains(rvKey) ? volCnt.get(rvKey) : 0
float rvAvg = rvCnt > 0 ? volAvg.get(rvKey) : na
float rvol  = rvCnt >= 3 and rvAvg > 0 ? cumVol / rvAvg : na
if inRTH and barstate.isconfirmed and cumVol > 0
    volAvg.put(rvKey, na(rvAvg) ? cumVol : rvAvg + (cumVol - rvAvg) / math.min(rvCnt + 1, rvolDays))
    volCnt.put(rvKey, rvCnt + 1)

// Gamma: conversión de unidades NDX/QQQ → futuro con el ratio de la sesión RTH
float srcPx = request.security(gexUnits == "QQQ" ? "NASDAQ:QQQ" : "NASDAQ:NDX", timeframe.period, close, ignore_invalid_symbol=true)
if gexUnits == "NQ / MNQ"
    gexRatio := 1.0
else if inRTH and srcPx > 0
    gexRatio := close / srcPx

float gFlip    = gammaFlip > 0 ? gammaFlip * gexRatio : na
float cWall    = callWall > 0 ? callWall * gexRatio : na
float pWall    = putWall > 0 ? putWall * gexRatio : na
bool  gexKnown = not na(gFlip)
bool  posGamma = gexKnown and close >= gFlip
bool  negGamma = gexKnown and close < gFlip

// ══ [7] LÓGICA DE DETECCIÓN ══
int minScore = switch minGrade
    "A+" => 4
    "A"  => 3
    "B"  => 2
    =>      0

bool  breakOK = not useGexFilter or not gexKnown or negGamma
bool  fadeOK  = not useGexFilter or not gexKnown or posGamma
bool  cdOK    = bar_index - lastSig >= cooldown
bool  crossUp = ta.crossover(close, orbH)
bool  crossDn = ta.crossunder(close, orbL)
float rng     = high - low
float clv     = rng > 0 ? (close - low) / rng : 0.5

f_breakSetup(int dir) =>
    bool  isL  = dir == 1
    float stop = orbStop == "Medio ORB" ? (orbH + orbL) / 2 : isL ? orbL : orbH
    float risk = math.abs(close - stop)
    float lvl  = f_nextLevel(close, dir, array.from(pdh, pdl, pdc, onH, onL, ibDone ? ibH : na, ibDone ? ibL : na, cWall, pWall, gFlip))
    bool  ctx  = gexKnown ? negGamma : isL ? close > pdc : close < pdc
    bool  vol  = not na(rvol) and rvol >= rvolMin
    bool  room = na(lvl) or math.abs(lvl - close) >= risk
    bool  conv = isL ? clv >= 0.7 : clv <= 0.3
    int   sc   = (ctx ? 1 : 0) + (vol ? 1 : 0) + (room ? 1 : 0) + (conv ? 1 : 0)
    string n   = f_chk(ctx, gexKnown ? "Gamma negativa (tendencial)" : isL ? "Sobre el cierre previo" : "Bajo el cierre previo")
                 + f_chk(vol, "RVOL " + (na(rvol) ? "N/D" : str.tostring(rvol, "0.00") + "x"))
                 + f_chk(room, "Espacio ≥ 1R" + (na(lvl) ? " (sin nivel)" : " hasta " + str.tostring(lvl, format.mintick)))
                 + f_chk(conv, "Cierre con convicción")
    Setup.new("ORB", dir, close, stop, close + dir * risk * rr1, close + dir * risk * rr2, sc, n)

f_fadeSetup(int dir) =>
    bool  isL  = dir == 1
    float stop = isL ? math.min(low, dn3) - syminfo.mintick : math.max(high, up3) + syminfo.mintick
    float risk = math.abs(close - stop)
    float tol  = atr * 0.5
    bool  ctx  = gexKnown ? posGamma : not na(rvol) and rvol < rvolMin
    bool  wick = rng > 0 and (isL ? math.min(open, close) - low : high - math.max(open, close)) >= rng * 0.5
    array<float> lv = array.from(pdh, pdl, pdc, onH, onL, cWall, pWall, gFlip)
    bool  conf = isL ? f_anyIn(lv, low - tol, dn2 + tol) : f_anyIn(lv, up2 - tol, high + tol)
    bool  room = math.abs(vwapVal - close) >= risk
    int   sc   = (ctx ? 1 : 0) + (wick ? 1 : 0) + (conf ? 1 : 0) + (room ? 1 : 0)
    string n   = f_chk(ctx, gexKnown ? "Gamma positiva (reversión)" : "RVOL bajo (rotación)")
                 + f_chk(wick, "Mecha de rechazo ≥ 50%")
                 + f_chk(conf, "Confluencia con nivel clave")
                 + f_chk(room, "Espacio ≥ 1R hasta VWAP")
    Setup.new("FADE", dir, close, stop, isL ? dn1 : up1, vwapVal, sc, n)

f_momSetup(int dir) =>
    bool agree = not na(r12) and math.sign(r12) == dir
    bool vol   = not na(rvol) and rvol >= rvolMin
    string n   = "Base: r(cierre previo→10:00) " + str.tostring(r30 * 100, "+0.00;-0.00") + "%\n"
                 + f_chk(agree, "15:00–15:30 en la misma dirección")
                 + f_chk(vol, "RVOL alto")
                 + "Salida: cierre RTH"
    Setup.new("MOM", dir, close, na, na, na, 2 + (agree ? 1 : 0) + (vol ? 1 : 0), n)

bool baseBL = showBreak and tfOK and barstate.isconfirmed and orbDone and elapsed < breakCut and crossUp and close > vwapVal and not longFired and breakOK and cdOK
bool baseBS = showBreak and tfOK and barstate.isconfirmed and orbDone and elapsed < breakCut and crossDn and close < vwapVal and not shortFired and breakOK and cdOK
bool baseFL = showFade and tfOK and barstate.isconfirmed and inRTH and elapsed >= math.max(fadeStart, orbMins) and elapsed < fadeCut and low <= dn2 and close > dn2 and fadeOK and cdOK
bool baseFS = showFade and tfOK and barstate.isconfirmed and inRTH and elapsed >= math.max(fadeStart, orbMins) and elapsed < fadeCut and high >= up2 and close < up2 and fadeOK and cdOK
bool baseMom = showMom and tfOK and barstate.isconfirmed and inRTH and elapsedC >= sessLen - 30 and not momShown and not na(r30) and r30 != 0

Setup sBL  = baseBL ? f_breakSetup(1) : na
Setup sBS  = baseBS ? f_breakSetup(-1) : na
Setup sFL  = baseFL ? f_fadeSetup(1) : na
Setup sFS  = baseFS ? f_fadeSetup(-1) : na
Setup sMom = baseMom ? f_momSetup(r30 > 0 ? 1 : -1) : na

bool sigBreakLong  = baseBL and sBL.score >= minScore
bool sigBreakShort = baseBS and sBS.score >= minScore
bool sigFadeLong   = baseFL and not (sigBreakLong or sigBreakShort) and sFL.score >= minScore
bool sigFadeShort  = baseFS and not (sigBreakLong or sigBreakShort or sigFadeLong) and sFS.score >= minScore
bool sigMom        = baseMom and sMom.score >= minScore
bool sigMomLong    = sigMom and r30 > 0
bool sigMomShort   = sigMom and r30 < 0

// ══ [8] GESTIÓN DE OBJETOS ══
f_riskTxt(Setup s) =>
    float r = s.riskPts()
    na(r) ? "Salida al cierre RTH" : "R " + str.tostring(r, "0.00") + " pts · $" + str.tostring(r * syminfo.pointvalue, "#,##0") + "/ct"

f_alertMsg(Setup s) =>
    string m = syminfo.ticker + " " + timeframe.period + " | " + s.tag + (s.dir == 1 ? " ▲ " : " ▼ ") + "[" + s.grade() + "] @ " + str.tostring(s.entry, format.mintick)
    na(s.stop) ? m + " | " + f_riskTxt(s) : m + " | SL " + str.tostring(s.stop, format.mintick) + " | TP1 " + str.tostring(s.tp1, format.mintick) + " | TP2 " + str.tostring(s.tp2, format.mintick) + " | " + f_riskTxt(s)

f_fire(Setup s) =>
    bool   isL = s.dir == 1
    color  c   = s.tag == "MOM" ? C_GOLD : isL ? C_BULL : C_BEAR
    string tip = s.tag + (isL ? " LARGO" : " CORTO") + " · Calificación " + s.grade() + " (" + str.tostring(s.score) + "/4)\n"
                 + "Entrada " + str.tostring(s.entry, format.mintick)
                 + (na(s.stop) ? "" : " · SL " + str.tostring(s.stop, format.mintick) + " · TP1 " + str.tostring(s.tp1, format.mintick) + " · TP2 " + str.tostring(s.tp2, format.mintick))
                 + "\n" + f_riskTxt(s) + "\n\n" + s.notes
    label.new(bar_index, isL ? low : high, s.tag + (isL ? " ▲ " : " ▼ ") + s.grade(),
         color=color.new(c, s.score >= 3 ? 0 : s.score == 2 ? 25 : 50), textcolor=isL or s.tag == "MOM" ? color.black : color.white,
         style=isL ? label.style_label_up : label.style_label_down, size=s.score >= 3 ? size.small : size.tiny, tooltip=tip)
    if showRisk and not na(s.stop)
        for f in riskFills
            linefill.delete(f)
        for ln in riskLines
            line.delete(ln)
        for lb in riskLbls
            label.delete(lb)
        riskFills.clear()
        riskLines.clear()
        riskLbls.clear()
        int  x2   = bar_index + riskBars
        line lEn  = line.new(bar_index, s.entry, x2, s.entry, color=color.new(color.gray, 20), style=line.style_dotted)
        line lSl  = line.new(bar_index, s.stop, x2, s.stop, color=C_BEAR, width=2)
        line lTp1 = line.new(bar_index, s.tp1, x2, s.tp1, color=color.new(C_BULL, 40), style=line.style_dashed)
        line lTp2 = line.new(bar_index, s.tp2, x2, s.tp2, color=C_BULL, width=2)
        riskLines.push(lEn)
        riskLines.push(lSl)
        riskLines.push(lTp1)
        riskLines.push(lTp2)
        riskFills.push(linefill.new(lEn, lSl, color.new(C_BEAR, 88)))
        riskFills.push(linefill.new(lEn, lTp2, color.new(C_BULL, 90)))
        riskLbls.push(label.new(x2, s.stop, "SL " + str.tostring(s.stop, format.mintick), style=label.style_label_left, color=color.new(C_BEAR, 20), textcolor=color.white, size=size.tiny))
        riskLbls.push(label.new(x2, s.tp1, "TP1 " + str.tostring(s.tp1, format.mintick), style=label.style_label_left, color=color.new(C_BULL, 50), textcolor=color.black, size=size.tiny))
        riskLbls.push(label.new(x2, s.tp2, "TP2 " + str.tostring(s.tp2, format.mintick), style=label.style_label_left, color=color.new(C_BULL, 20), textcolor=color.black, size=size.tiny))
    tip

Setup act = sigBreakLong ? sBL : sigBreakShort ? sBS : sigFadeLong ? sFL : sigFadeShort ? sFS : na
if not na(act)
    f_fire(act)
    lastSig := bar_index
    if act.tag == "ORB"
        if act.dir == 1
            longFired := true
        else
            shortFired := true
    lastSigTxt  := act.tag + (act.dir == 1 ? " ▲ " : " ▼ ") + act.grade() + " · " + str.tostring(act.entry, format.mintick)
    lastRiskTxt := f_riskTxt(act)
    lastSigCol  := act.dir == 1 ? C_BULL : C_BEAR
    alert(f_alertMsg(act), alert.freq_once_per_bar_close)

if baseMom
    momShown := true
if sigMom
    f_fire(sMom)
    lastSigTxt  := sMom.tag + (sMom.dir == 1 ? " ▲ " : " ▼ ") + sMom.grade() + " · " + str.tostring(sMom.entry, format.mintick)
    lastRiskTxt := f_riskTxt(sMom)
    lastSigCol  := C_GOLD
    alert(f_alertMsg(sMom), alert.freq_once_per_bar_close)

// Niveles gamma (solo la sesión actual: son datos del día) y etiquetas de niveles
f_lvlLbl(float y, string txt, color c) =>
    if not na(y)
        lvlLbls.push(label.new(bar_index + 3, y, txt + " " + str.tostring(y, format.mintick), style=label.style_label_left, color=color.new(C_BG, 100), textcolor=c, size=size.tiny))

f_gexLine(float y, string txt, color c, string st, int w) =>
    if not na(y) and not na(lastOpenT)
        gexLines.push(line.new(lastOpenT, y, time, y, xloc=xloc.bar_time, extend=extend.right, color=c, style=st, width=w))
        lvlLbls.push(label.new(bar_index + 3, y, txt + " " + str.tostring(y, format.mintick), style=label.style_label_left, color=color.new(c, 75), textcolor=color.white, size=size.tiny))

if barstate.islast
    for ln in gexLines
        line.delete(ln)
    for lb in lvlLbls
        label.delete(lb)
    gexLines.clear()
    lvlLbls.clear()
    f_gexLine(gFlip, "γ Flip", C_GEX, line.style_solid, 2)
    f_gexLine(cWall, "Call Wall", C_BEAR, line.style_dashed, 1)
    f_gexLine(pWall, "Put Wall", C_BULL, line.style_dashed, 1)
    if showLvlLbl and inRTH
        f_lvlLbl(vwapVal, "VWAP", C_GOLD)
        if showPD
            f_lvlLbl(pdh, "PDH", C_PD)
            f_lvlLbl(pdl, "PDL", C_PD)
            f_lvlLbl(pdc, "PDC", C_PD)
        if showON
            f_lvlLbl(onH, "ONH", C_ON)
            f_lvlLbl(onL, "ONL", C_ON)
        if showIB and ibDone
            f_lvlLbl(ibH, "IBH", C_IB)
            f_lvlLbl(ibL, "IBL", C_IB)

// ══ [9] PLOTS ══
pU1 = plot(inRTH ? up1 : na, "+1σ", color.new(C_BEAR, 60), 1, plot.style_linebr)
pD1 = plot(inRTH ? dn1 : na, "-1σ", color.new(C_BULL, 60), 1, plot.style_linebr)
pU2 = plot(inRTH ? up2 : na, "+2σ", color.new(C_BEAR, 20), 1, plot.style_linebr)
pD2 = plot(inRTH ? dn2 : na, "-2σ", color.new(C_BULL, 20), 1, plot.style_linebr)
plot(inRTH and showBand3 ? up3 : na, "+3σ", color.new(C_BEAR, 0), 1, plot.style_linebr, linestyle=plot.linestyle_dotted)
plot(inRTH and showBand3 ? dn3 : na, "-3σ", color.new(C_BULL, 0), 1, plot.style_linebr, linestyle=plot.linestyle_dotted)
fill(pU1, pU2, showFill ? color.new(C_BEAR, 92) : na, "Zona +1σ/+2σ")
fill(pD1, pD2, showFill ? color.new(C_BULL, 92) : na, "Zona -1σ/-2σ")
plot(inRTH ? vwapVal : na, "VWAP", C_GOLD, 2, plot.style_linebr)
plot(showORB and orbDone ? orbH : na, "ORB High", C_ORB, 2, plot.style_linebr)
plot(showORB and orbDone ? orbL : na, "ORB Low",  C_ORB, 2, plot.style_linebr)
plot(showIB and ibDone ? ibH : na, "IB High", C_IB, 1, plot.style_linebr, linestyle=plot.linestyle_dashed)
plot(showIB and ibDone ? ibL : na, "IB Low",  C_IB, 1, plot.style_linebr, linestyle=plot.linestyle_dashed)
plot(showPD and inRTH ? pdh : na, "PDH", C_PD, 1, plot.style_linebr, linestyle=plot.linestyle_dashed)
plot(showPD and inRTH ? pdl : na, "PDL", C_PD, 1, plot.style_linebr, linestyle=plot.linestyle_dashed)
plot(showPD and inRTH ? pdc : na, "PDC", color.new(C_PD, 30), 1, plot.style_linebr, linestyle=plot.linestyle_dotted)
plot(showON and inRTH ? onH : na, "ONH", C_ON, 1, plot.style_linebr, linestyle=plot.linestyle_dashed)
plot(showON and inRTH ? onL : na, "ONL", C_ON, 1, plot.style_linebr, linestyle=plot.linestyle_dashed)
bgcolor(showORB and inORB ? color.new(C_ORB, 90) : na, title="Ventana ORB")

// ══ [10] ALERTAS ══
alertcondition(sigBreakLong,  "ORB Breakout Long",    "{{ticker}} {{interval}} — ORB ▲ @ {{close}}")
alertcondition(sigBreakShort, "ORB Breakout Short",   "{{ticker}} {{interval}} — ORB ▼ @ {{close}}")
alertcondition(sigFadeLong,   "Fade -2σ Long",        "{{ticker}} {{interval}} — FADE ▲ @ {{close}}")
alertcondition(sigFadeShort,  "Fade +2σ Short",       "{{ticker}} {{interval}} — FADE ▼ @ {{close}}")
alertcondition(sigMomLong,    "Momentum 15:30 Long",  "{{ticker}} — MOM ▲ última media hora")
alertcondition(sigMomShort,   "Momentum 15:30 Short", "{{ticker}} — MOM ▼ última media hora")
// Para el mensaje completo (calificación, SL, TP, riesgo en $) crear la alerta con
// "Cualquier llamada a la función alert()".

// ══ [11] DASHBOARD ══
var table dash = table.new(dashPos == "Arriba izquierda" ? position.top_left : dashPos == "Abajo derecha" ? position.bottom_right : dashPos == "Abajo izquierda" ? position.bottom_left : position.top_right,
     2, 10, bgcolor=color.new(C_BG, 5), frame_color=color.new(C_GOLD, 60), frame_width=1, border_width=1, border_color=color.new(color.gray, 80))
if showDash and barstate.islast
    sz = switch dashSize
        "Tiny"  => size.tiny
        "Small" => size.small
        =>         size.normal
    string sesTxt = not tfOK ? "TF no soportado (intradía ≤ 15m)" : inRTH ? "RTH · faltan " + str.tostring(math.max(sessLen - elapsedC, 0), "#") + " min" : inON ? "Overnight (Globex)" : "Fuera de sesión"
    string vwTxt  = not inRTH or na(zVwap) ? "—" : str.tostring(zVwap, "+0.00;-0.00") + "σ " + (zVwap >= 0 ? "▲ sobre VWAP" : "▼ bajo VWAP")
    color  vwCol  = not inRTH or na(zVwap) ? color.gray : zVwap >= 0 ? C_BULL : C_BEAR
    string orbTxt = not inRTH ? "—" : inORB ? "Formándose" : (close > orbH ? "Rompió ▲" : close < orbL ? "Rompió ▼" : "Dentro") + " · " + str.tostring(orbH - orbL, "0.00") + " pts"
    string ibTxt  = not inRTH ? "—" : inIB ? "Formándose" : (close > ibH ? "Extensión ▲" : close < ibL ? "Extensión ▼" : "Dentro (balance)") + " · " + str.tostring(ibH - ibL, "0.00") + " pts"
    string regTxt = not gexKnown ? (gammaFlip > 0 ? "Esperando ratio " + gexUnits : "N/D (sin flip)") : (posGamma ? "POSITIVA → reversión" : "NEGATIVA → tendencia") + " · " + str.tostring(close - gFlip, "+0.00;-0.00")
    color  regCol = not gexKnown ? color.gray : posGamma ? C_BULL : C_BEAR
    string rvTxt  = na(rvol) ? "Calentando (≥ 3 sesiones)" : str.tostring(rvol, "0.00") + "x " + (rvol >= rvolMin ? "· institucional" : "· rotación")
    color  rvCol  = na(rvol) ? color.gray : rvol >= rvolMin ? C_GOLD : color.white
    string momTxt = na(r30) ? "Pendiente (10:00)" : str.tostring(r30 * 100, "+0.00;-0.00") + "%" + (na(r12) ? "" : " · 15:00 " + str.tostring(r12 * 100, "+0.00;-0.00") + "%")
    color  momCol = na(r30) ? color.gray : r30 > 0 ? C_BULL : C_BEAR
    table.cell(dash, 0, 0, "📊 MNQ INSTITUTIONAL FLOW", text_color=C_GOLD, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=color.white, text_size=sz)
    table.cell(dash, 0, 1, "Sesión",      text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 1, sesTxt,        text_color=tfOK ? color.white : C_BEAR, text_size=sz)
    table.cell(dash, 0, 2, "VWAP z",      text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 2, vwTxt,         text_color=vwCol, text_size=sz)
    table.cell(dash, 0, 3, "ORB",         text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 3, orbTxt,        text_color=color.white, text_size=sz)
    table.cell(dash, 0, 4, "Initial Bal", text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 4, ibTxt,         text_color=color.white, text_size=sz)
    table.cell(dash, 0, 5, "Gamma",       text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 5, regTxt,        text_color=regCol, text_size=sz)
    table.cell(dash, 0, 6, "RVOL",        text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 6, rvTxt,         text_color=rvCol, text_size=sz)
    table.cell(dash, 0, 7, "Mom 30m",     text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 7, momTxt,        text_color=momCol, text_size=sz)
    table.cell(dash, 0, 8, "Última señal", text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 8, lastSigTxt,    text_color=lastSigCol, text_size=sz)
    table.cell(dash, 0, 9, "Riesgo",      text_color=color.gray, text_size=sz, text_halign=text.align_left)
    table.cell(dash, 1, 9, lastRiskTxt,   text_color=color.white, text_size=sz)
