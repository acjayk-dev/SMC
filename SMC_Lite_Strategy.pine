//@version=6
// ─────────────────────────────────────────────────────────
// SMC Lite · Institutional Core — STRATEGY v1.0 | Autor: SMC Project
// Activo objetivo: MNQ (Micro E-mini Nasdaq-100) · TF: 1m / 2m / 5m
// ─────────────────────────────────────────────────────────
// Versión EJECUTABLE del indicador SMC Lite para validación estadística
// en el Strategy Tester de TradingView. MISMA lógica de señales; añade:
//   · strategy.entry / strategy.exit con SL, TP1 parcial y TP2
//   · Break-even automático: al tocar TP1, el stop del resto pasa a la entrada
//   · Sizing por riesgo (% de cuenta) → contratos reales
//   · Costos MNQ precargados: comisión + slippage (tick = 0.25 pts, $2/pt)
//   · Filtro de horario de sesión para backtest limpio
// OBJETIVO: leer Profit Factor, Win Rate, Expectancy, Max Drawdown y Nº
// de trades. Optimizar con datos (in-sample) y VALIDAR en fechas no vistas
// (out-of-sample) para descartar sobre-ajuste.
// ─────────────────────────────────────────────────────────
strategy("SMC Lite Strategy · MNQ", shorttitle="SMC Lite STR", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=500,
     initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     slippage=2,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     pyramiding=0)

// ══════════════════════════════════════════════════════════════════════════════
// ██ TYPES
// ══════════════════════════════════════════════════════════════════════════════
type OrderBlock
    box   id
    float top
    float bottom
    bool  isBull
    bool  mitigated
    int   createdAt

type FVG
    box   id
    float top
    float bottom
    bool  isBull
    int   createdAt

// ══════════════════════════════════════════════════════════════════════════════
// ██ INPUTS
// ══════════════════════════════════════════════════════════════════════════════
grpBias   = "═══ 🧭 SESGO HTF (Draw on Liquidity) ═══"
htfTF     = input.timeframe("15", "Higher Timeframe", group=grpBias, tooltip="Sesgo direccional. Para MNQ 1-2m usa 15; para 5m usa 30 o 60.")
useHtfBias= input.bool(true, "Filtrar por sesgo HTF", group=grpBias)

grpStr    = "═══ 🏦 ESTRUCTURA (BOS / CHoCH) ═══"
swingLen  = input.int(5, "Swing Length", minval=2, maxval=20, group=grpStr)
atrMult   = input.float(0.7, "Displacement (×ATR)", minval=0.2, step=0.1, group=grpStr)
showStr   = input.bool(true, "Mostrar BOS / CHoCH", group=grpStr)

grpLiq    = "═══ 💧 LIQUIDEZ & POI ═══"
eqLookback= input.int(20, "Lookback Highs/Lows Iguales", minval=5, maxval=60, group=grpLiq)
eqTol     = input.float(0.10, "Tolerancia EQH/EQL (×ATR)", minval=0.02, step=0.02, group=grpLiq)
showLiq   = input.bool(true, "Mostrar pools EQH/EQL", group=grpLiq)
showOB    = input.bool(true, "Mostrar Order Blocks", group=grpLiq)
maxOBs    = input.int(4, "Máx Order Blocks activos", minval=1, maxval=10, group=grpLiq)
obMaxAge  = input.int(60, "OB Max Age (barras)", minval=15, maxval=300, group=grpLiq)
showFVG   = input.bool(true, "Mostrar FVG", group=grpLiq)
fvgMinAtr = input.float(0.4, "FVG mínimo (×ATR)", minval=0.1, step=0.1, group=grpLiq)
maxFVGs   = input.int(4, "Máx FVG activos", minval=1, maxval=10, group=grpLiq)

grpZone   = "═══ ⚖️ PREMIUM / DISCOUNT ═══"
showPD    = input.bool(true, "Mostrar equilibrio (50%)", group=grpZone)
pdLookback= input.int(50, "Rango de referencia (barras)", minval=20, maxval=200, group=grpZone)

grpKZ     = "═══ ⏰ KILL ZONES (NY time) ═══"
useKZ     = input.bool(true, "Exigir Kill Zone", group=grpKZ)
lnStart   = input.int(2, "London Start", minval=0, maxval=23, group=grpKZ)
lnEnd     = input.int(5, "London End", minval=0, maxval=23, group=grpKZ)
nyStart   = input.int(8, "NY Start", minval=0, maxval=23, group=grpKZ)
nyEnd     = input.int(11, "NY End", minval=0, maxval=23, group=grpKZ)
showKZ    = input.bool(true, "Sombrear Kill Zones", group=grpKZ)

grpSig    = "═══ 🎯 SEÑALES & RIESGO ═══"
minScore  = input.float(7.0, "Score mínimo", minval=3.0, maxval=12.0, step=0.5, group=grpSig)
requireSweep = input.bool(true, "Exigir barrida de liquidez (trigger)", group=grpSig)
requireZone  = input.bool(true, "Exigir Discount(long)/Premium(short)", group=grpSig)
riskReward   = input.float(2.5, "Risk:Reward (TP2)", minval=1.0, step=0.5, group=grpSig)
useTP1BE     = input.bool(true, "TP1 parcial + Break-Even en el resto", group=grpSig, tooltip="Al tocar TP1 (1R) cierra 50% y mueve el stop del resto a la entrada. Convierte muchos perdedores en cero.")
tp1Pct       = input.int(50, "% cerrado en TP1", minval=10, maxval=90, step=10, group=grpSig)
cooldownBars = input.int(5, "Barras mínimas entre señales", minval=1, maxval=30, group=grpSig)
riskPct      = input.float(1.0, "Riesgo por trade (%)", minval=0.1, maxval=10.0, step=0.1, group=grpSig)
maxSlAtr     = input.float(3.5, "SL máximo (×ATR)", minval=1.0, step=0.5, group=grpSig, tooltip="Recorta stops absurdamente anchos: si el SL estructural supera esto, se fija a 2×ATR.")

grpBT     = "═══ 🧪 BACKTEST WINDOW ═══"
useDateFilter = input.bool(false, "Filtrar rango de fechas", group=grpBT, tooltip="Actívalo para separar in-sample (optimizar) de out-of-sample (validar).")
startDate = input.time(timestamp("2024-01-01 00:00"), "Desde", group=grpBT)
endDate   = input.time(timestamp("2026-01-01 00:00"), "Hasta", group=grpBT)

grpVis    = "═══ 🎨 VISUAL ═══"
showEMAs  = input.bool(true, "Mostrar EMAs (9/21)", group=grpVis)

// ══════════════════════════════════════════════════════════════════════════════
// ██ CORE CALCS
// ══════════════════════════════════════════════════════════════════════════════
atr      = ta.atr(14)
avgVol   = ta.sma(volume, 20)
ema9     = ta.ema(close, 9)
ema21    = ta.ema(close, 21)
hasVol   = volume > avgVol * 1.2
displace = (high - low) > atr * atrMult

f_htfTrend() =>
    e9  = ta.ema(close, 9)
    e21 = ta.ema(close, 21)
    close > e9 and e9 > e21 ? 1 : close < e9 and e9 < e21 ? -1 : 0
htfBias = request.security(syminfo.tickerid, htfTF, f_htfTrend(), lookahead=barmerge.lookahead_off)

nyHour   = hour(time, "America/New_York")
inLondon = nyHour >= lnStart and nyHour < lnEnd
inNY     = nyHour >= nyStart and nyHour < nyEnd
inKZ     = inLondon or inNY

rngHi    = ta.highest(high, pdLookback)
rngLo    = ta.lowest(low, pdLookback)
eqm      = (rngHi + rngLo) / 2.0
inDiscount = close < eqm
inPremium  = close > eqm

inDateWindow = not useDateFilter or (time >= startDate and time <= endDate)

// ══════════════════════════════════════════════════════════════════════════════
// ██ MARKET STRUCTURE (BOS / CHoCH) — sin repaint
// ══════════════════════════════════════════════════════════════════════════════
isSwingHigh = high[swingLen] == ta.highest(high, swingLen * 2 + 1)
isSwingLow  = low[swingLen]  == ta.lowest(low,  swingLen * 2 + 1)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   structTrend   = 0
var int   lastBosBar    = -999

if isSwingHigh
    lastSwingHigh := high[swingLen]
if isSwingLow
    lastSwingLow := low[swingLen]

bool bosBull = false
bool bosBear = false
bool chochBull = false
bool chochBear = false

if barstate.isconfirmed and (bar_index - lastBosBar) > swingLen
    if not na(lastSwingHigh) and close > lastSwingHigh and displace
        if structTrend <= 0
            chochBull := true
        else
            bosBull := true
        structTrend := 1
        lastBosBar := bar_index
        lastSwingHigh := na
    else if not na(lastSwingLow) and close < lastSwingLow and displace
        if structTrend >= 0
            chochBear := true
        else
            bosBear := true
        structTrend := -1
        lastBosBar := bar_index
        lastSwingLow := na

// ══════════════════════════════════════════════════════════════════════════════
// ██ LIQUIDEZ: pools EQH/EQL + barrida
// ══════════════════════════════════════════════════════════════════════════════
var float eqhLevel = na
var float eqlLevel = na
var int   eqhBar   = na
var int   eqlBar   = na

recentHigh = ta.highest(high, eqLookback)[1]
recentLow  = ta.lowest(low, eqLookback)[1]

if isSwingHigh and not na(recentHigh) and math.abs(high[swingLen] - recentHigh) <= atr * eqTol
    eqhLevel := math.max(high[swingLen], recentHigh)
    eqhBar := bar_index
if isSwingLow and not na(recentLow) and math.abs(low[swingLen] - recentLow) <= atr * eqTol
    eqlLevel := math.min(low[swingLen], recentLow)
    eqlBar := bar_index

eqhAlive = not na(eqhLevel) and (bar_index - eqhBar) < eqLookback * 3
eqlAlive = not na(eqlLevel) and (bar_index - eqlBar) < eqLookback * 3

sweepBull = eqlAlive and low < eqlLevel and close > eqlLevel and barstate.isconfirmed
sweepBear = eqhAlive and high > eqhLevel and close < eqhLevel and barstate.isconfirmed
if sweepBull
    eqlLevel := na
if sweepBear
    eqhLevel := na

// ══════════════════════════════════════════════════════════════════════════════
// ██ ORDER BLOCKS
// ══════════════════════════════════════════════════════════════════════════════
var array<OrderBlock> obs = array.new<OrderBlock>()

f_lastOpposite(bool bull, int maxBack) =>
    int idx = 1
    for k = 1 to maxBack
        bool opp = bull ? close[k] < open[k] : close[k] > open[k]
        if opp
            idx := k
            break
    idx

f_addOB(bool bull) =>
    int k = f_lastOpposite(bull, 10)
    float t = high[k]
    float b = low[k]
    color c  = showOB ? color.new(bull ? #00E676 : #FF5252, 80) : na
    color bc = showOB ? color.new(bull ? #00E676 : #FF5252, 40) : na
    box bx = box.new(bar_index - k, t, bar_index + 5, b, border_color=bc, bgcolor=c,
         text=showOB ? (bull ? "Bull OB" : "Bear OB") : "", text_size=size.tiny,
         text_color=showOB ? color.new(bull ? #00E676 : #FF5252, 0) : na)
    OrderBlock ob = OrderBlock.new(bx, t, b, bull, false, bar_index)
    array.push(obs, ob)
    if array.size(obs) > maxOBs
        OrderBlock old = array.shift(obs)
        box.delete(old.id)

if bosBull or chochBull
    f_addOB(true)
if bosBear or chochBear
    f_addOB(false)

if barstate.isconfirmed and array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        OrderBlock ob = array.get(obs, i)
        bool mit = ob.isBull ? close < ob.bottom : close > ob.top
        bool old = (bar_index - ob.createdAt) > obMaxAge
        if mit or old
            box.delete(ob.id)
            array.remove(obs, i)
        else
            box.set_right(ob.id, bar_index + 5)

f_inOB(bool bull) =>
    bool res = false
    if array.size(obs) > 0
        for i = 0 to array.size(obs) - 1
            OrderBlock ob = array.get(obs, i)
            if ob.isBull == bull and low <= ob.top and high >= ob.bottom
                res := true
    res
atBullOB = f_inOB(true)
atBearOB = f_inOB(false)

// ══════════════════════════════════════════════════════════════════════════════
// ██ FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════
var array<FVG> fvgs = array.new<FVG>()

bullFVG = low > high[2] and (low - high[2]) > atr * fvgMinAtr
bearFVG = high < low[2] and (low[2] - high) > atr * fvgMinAtr

if barstate.isconfirmed and (bullFVG or bearFVG)
    float t = bullFVG ? low : low[2]
    float b = bullFVG ? high[2] : high
    color c = showFVG ? color.new(bullFVG ? #26A69A : #EF5350, 70) : na
    box bx = box.new(bar_index - 2, t, bar_index + 3, b, border_color=showFVG ? color.new(bullFVG ? #26A69A : #EF5350, 50) : na, bgcolor=c)
    array.push(fvgs, FVG.new(bx, t, b, bullFVG, bar_index))
    if array.size(fvgs) > maxFVGs
        FVG old = array.shift(fvgs)
        box.delete(old.id)

f_inFVG(bool bull) =>
    bool res = false
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            FVG f = array.get(fvgs, i)
            if f.isBull == bull and low <= f.top and high >= f.bottom
                res := true
    res
atBullFVG = f_inFVG(true)
atBearFVG = f_inFVG(false)

// ══════════════════════════════════════════════════════════════════════════════
// ██ SCORING DE CONFLUENCIA
// ══════════════════════════════════════════════════════════════════════════════
f_scoreLong() =>
    float s = 0.0
    s += (useHtfBias and htfBias == 1) ? 2.0 : (not useHtfBias and htfBias == 1) ? 1.0 : 0.0
    s += structTrend == 1 ? 1.5 : 0.0
    s += sweepBull ? 2.0 : 0.0
    s += atBullOB ? 2.0 : 0.0
    s += atBullFVG ? 1.0 : 0.0
    s += inDiscount ? 1.5 : 0.0
    s += inKZ ? 1.0 : 0.0
    s += (hasVol and displace) ? 1.0 : 0.0
    s

f_scoreShort() =>
    float s = 0.0
    s += (useHtfBias and htfBias == -1) ? 2.0 : (not useHtfBias and htfBias == -1) ? 1.0 : 0.0
    s += structTrend == -1 ? 1.5 : 0.0
    s += sweepBear ? 2.0 : 0.0
    s += atBearOB ? 2.0 : 0.0
    s += atBearFVG ? 1.0 : 0.0
    s += inPremium ? 1.5 : 0.0
    s += inKZ ? 1.0 : 0.0
    s += (hasVol and displace) ? 1.0 : 0.0
    s

scoreLong  = f_scoreLong()
scoreShort = f_scoreShort()

gateLong  = (not useHtfBias or htfBias == 1) and (not requireSweep or sweepBull) and (not requireZone or inDiscount) and (not useKZ or inKZ)
gateShort = (not useHtfBias or htfBias == -1) and (not requireSweep or sweepBear) and (not requireZone or inPremium) and (not useKZ or inKZ)

var int lastSignalBar = -999
cooldownOK = (bar_index - lastSignalBar) >= cooldownBars

longSignal  = gateLong  and scoreLong  >= minScore and cooldownOK and barstate.isconfirmed and scoreLong >= scoreShort and inDateWindow
shortSignal = gateShort and scoreShort >= minScore and cooldownOK and barstate.isconfirmed and scoreShort >  scoreLong and inDateWindow

// ══════════════════════════════════════════════════════════════════════════════
// ██ NIVELES DE RIESGO (SL / TP)
// ══════════════════════════════════════════════════════════════════════════════
f_levels(bool isBuy, float rawSl, float entry) =>
    float sl = rawSl
    float rk = math.max(isBuy ? entry - sl : sl - entry, atr * 0.2)
    if rk > atr * maxSlAtr
        sl := isBuy ? entry - atr * 2.0 : entry + atr * 2.0
        rk := atr * 2.0
    float tp1 = isBuy ? entry + rk : entry - rk
    float tp2 = isBuy ? entry + rk * riskReward : entry - rk * riskReward
    [sl, tp1, tp2, rk]

f_contracts(entry, sl) =>
    float dist = math.abs(entry - sl)
    float rv = strategy.equity * (riskPct / 100.0)
    dist > 0 ? math.max(1, math.round(rv / (dist * syminfo.pointvalue))) : 1

// ══════════════════════════════════════════════════════════════════════════════
// ██ EJECUCIÓN
// ══════════════════════════════════════════════════════════════════════════════
var float posSl  = na
var float posTp1 = na
var float posTp2 = na
var float posEntry = na
var bool  tp1Hit = false

// --- ENTRADAS ---
if longSignal and strategy.position_size == 0
    float rawSl = math.min(low, low[1]) - atr * 0.2
    [sl, tp1, tp2, rk] = f_levels(true, rawSl, close)
    int qty = f_contracts(close, sl)
    posSl := sl
    posTp1 := tp1
    posTp2 := tp2
    posEntry := close
    tp1Hit := false
    lastSignalBar := bar_index
    strategy.entry("L", strategy.long, qty=qty)

if shortSignal and strategy.position_size == 0
    float rawSl = math.max(high, high[1]) + atr * 0.2
    [sl, tp1, tp2, rk] = f_levels(false, rawSl, close)
    int qty = f_contracts(close, sl)
    posSl := sl
    posTp1 := tp1
    posTp2 := tp2
    posEntry := close
    tp1Hit := false
    lastSignalBar := bar_index
    strategy.entry("S", strategy.short, qty=qty)

// --- GESTIÓN DE SALIDA (SL + TP1 parcial + Break-Even en el resto) ---
if strategy.position_size > 0
    if useTP1BE and high >= posTp1
        tp1Hit := true
    float restStop = (useTP1BE and tp1Hit) ? posEntry : posSl
    if useTP1BE
        strategy.exit("L-TP1", from_entry="L", qty_percent=tp1Pct, limit=posTp1, stop=posSl)
        strategy.exit("L-Rest", from_entry="L", limit=posTp2, stop=restStop)
    else
        strategy.exit("L-Exit", from_entry="L", limit=posTp2, stop=posSl)

if strategy.position_size < 0
    if useTP1BE and low <= posTp1
        tp1Hit := true
    float restStop = (useTP1BE and tp1Hit) ? posEntry : posSl
    if useTP1BE
        strategy.exit("S-TP1", from_entry="S", qty_percent=tp1Pct, limit=posTp1, stop=posSl)
        strategy.exit("S-Rest", from_entry="S", limit=posTp2, stop=restStop)
    else
        strategy.exit("S-Exit", from_entry="S", limit=posTp2, stop=posSl)

// ══════════════════════════════════════════════════════════════════════════════
// ██ VISUALIZACIÓN
// ══════════════════════════════════════════════════════════════════════════════
plot(showEMAs ? ema9 : na, "EMA 9", color=color.new(#2196F3, 0), linewidth=1)
plot(showEMAs ? ema21 : na, "EMA 21", color=color.new(#FF9800, 0), linewidth=1)
plot(showPD ? eqm : na, "Equilibrium 50%", color=color.new(#9E9E9E, 40), style=plot.style_stepline)
bgcolor(showKZ and inKZ ? color.new(#FFD700, 92) : na, title="Kill Zone")

plotshape(showStr and bosBull, "BOS Bull", shape.triangleup, location.belowbar, color.new(#00E676, 0), size=size.tiny, text="BOS")
plotshape(showStr and bosBear, "BOS Bear", shape.triangledown, location.abovebar, color.new(#FF5252, 0), size=size.tiny, text="BOS")
plotshape(showStr and chochBull, "CHoCH Bull", shape.diamond, location.belowbar, color.new(#00E676, 0), size=size.tiny, text="CHoCH")
plotshape(showStr and chochBear, "CHoCH Bear", shape.diamond, location.abovebar, color.new(#FF5252, 0), size=size.tiny, text="CHoCH")
plotshape(showLiq and sweepBull, "Sweep Bull", shape.xcross, location.belowbar, color.new(#00E676, 0), size=size.tiny, text="💧")
plotshape(showLiq and sweepBear, "Sweep Bear", shape.xcross, location.abovebar, color.new(#FF5252, 0), size=size.tiny, text="💧")
