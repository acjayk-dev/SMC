//@version=6
indicator("Structure & Trend Dashboard", "Structure MTF Dashboard", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
DATA                    = #DBDBDB
HEADERS                 = #808080
BACKGROUND              = #161616
BORDERS                 = #2E2E2E
BULL                    = #089981
BEAR                    = #f23645

//---------------------------------------------------------------------------------------------------------------------}
// Types
//---------------------------------------------------------------------------------------------------------------------{
type FVG
    box bx
    bool is_bull
    float top
    float bot

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
grp_smc     = "Market Structure"
show_smc    = input.bool(true, "Show Market Structure", group = grp_smc)
smc_tf      = input.timeframe("", "Structure Timeframe", group = grp_smc, tooltip = "Calculates Key Levels from this timeframe, breaks occur on chart timeframe. Higher timeframe levels are taken from closed bars only.")
swing_len   = input.int(5, "Swing Length", minval = 1, group = grp_smc)
show_candles= input.bool(true, "Color Candles Based on Trend", group = grp_smc, tooltip = "Works even when the structure drawings are hidden. Candles stay uncolored until the first break.")

grp_bias    = "HTF Bias"
bias_tf1    = input.timeframe("60", "Bias Timeframes", group = grp_bias, inline = "bias")
bias_tf2    = input.timeframe("240", "", group = grp_bias, inline = "bias", tooltip = "BOS/CHoCH in the direction of both bias timeframes are labeled larger and get their own alerts; breaks against both are faded. A bias timeframe not higher than the chart is ignored.")
hide_counter= input.bool(false, "Hide Counter-Trend Break Labels", group = grp_bias, tooltip = "Hides the labels of breaks against both bias timeframes. Their lines, candle colors and BOS/CHoCH alerts are unchanged.")

grp_liq     = "Liquidity Sweeps"
show_liq    = input.bool(true, "Show Liquidity Sweeps", group = grp_liq)
liq_tf      = input.timeframe("", "Liquidity Timeframe", group = grp_liq, tooltip = "Timeframe for detecting key liquidity levels to be swept. Higher timeframe levels are taken from closed bars only.")

grp_fvg     = "Fair Value Gaps"
show_fvg    = input.bool(true, "Show Fair Value Gaps", group = grp_fvg)
fvg_limit   = input.int(5, "Max Active FVGs", minval = 1, group = grp_fvg, tooltip = "Limits the number of active FVGs so they don't extend indefinitely. The oldest one beyond the limit stops extending but stays on the chart.")
fvg_min_atr = input.float(0.0, "Min FVG Size (ATR)", minval = 0, step = 0.1, group = grp_fvg, tooltip = "Minimum gap size as a multiple of ATR(14). 0 = every gap.")

DASHBOARD_GROUP         = 'Dashboard'
dashboardInput          = input.bool(true, 'Enable Dashboard', group = DASHBOARD_GROUP, tooltip = 'Enable or disable the trend dashboard. Each timeframe uses the same break rule as the chart structure; higher timeframes are read from their last closed bar.')
dashboardPositionInput  = input.string('Top Right', 'Position', group = DASHBOARD_GROUP, options = ['Top Right','Bottom Right','Bottom Left'])
dashboardSizeInput      = input.string('Small', 'Size', group = DASHBOARD_GROUP, options = ['Tiny','Small','Normal','Large','Huge'])

//---------------------------------------------------------------------------------------------------------------------}
// Variables
//---------------------------------------------------------------------------------------------------------------------{
var parsedDashboardPosition = switch dashboardPositionInput
    'Top Right'       => position.top_right
    'Bottom Right'    => position.bottom_right
    'Bottom Left'     => position.bottom_left

var parsedDashboardSize     = switch dashboardSizeInput
    'Tiny'            => size.tiny
    'Small'           => size.small
    'Normal'          => size.normal
    'Large'           => size.large
    'Huge'            => size.huge

var fvg_arr = array.new<FVG>()

// Structure variables
var float active_ph = na
var int active_ph_t = na
var float active_pl = na
var int active_pl_t = na

var line ph_line = na
var line pl_line = na

// 0 = no break yet
var int chart_trend = 0

// Liquidity variables
var float liq_ph = na
var int liq_ph_t = na
var float liq_pl = na
var int liq_pl_t = na

var line liq_ph_line_glow = na
var line liq_ph_line = na
var line liq_pl_line_glow = na
var line liq_pl_line = na

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Same rule as the chart structure: a close beyond the last pivot breaks it and the pivot is consumed
f_get_trend(len, off) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    var float last_ph = na
    var float last_pl = na
    var int tr = 0
    if not na(ph)
        last_ph := ph
    if not na(pl)
        last_pl := pl
    if close > last_ph
        tr := 1
        last_ph := na
    if close < last_pl
        tr := -1
        last_pl := na
    tr[off]

f_get_pivots(len, off) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    var float p_h = na
    var int p_h_t = na
    var float p_l = na
    var int p_l_t = na
    if not na(ph)
        p_h := ph
        p_h_t := time[len]
    if not na(pl)
        p_l := pl
        p_l_t := time[len]
    [p_h[off], p_h_t[off], p_l[off], p_l_t[off]]

// Higher timeframes are read from their last closed bar (offset 1 + lookahead), so realtime matches history.
// Same and lower timeframes need no offset: lookahead_on would return the first intrabar instead of the last.
f_is_htf(string tf) =>
    timeframe.in_seconds(tf) > timeframe.in_seconds()

f_trend(string tf) =>
    bool htf = f_is_htf(tf)
    nz(request.security(syminfo.tickerid, tf, f_get_trend(swing_len, htf ? 1 : 0), lookahead = htf ? barmerge.lookahead_on : barmerge.lookahead_off))

f_pivots(string tf) =>
    bool htf = f_is_htf(tf)
    request.security(syminfo.tickerid, tf, f_get_pivots(swing_len, htf ? 1 : 0), lookahead = htf ? barmerge.lookahead_on : barmerge.lookahead_off)

f_trend_text(string tf_name, int tr) =>
    tf_name + ' (' + (tr == 1 ? 'Bull' : tr == -1 ? 'Bear' : '—') + ')'

f_trend_color(int tr) =>
    tr == 1 ? BULL : tr == -1 ? BEAR : HEADERS

cell(table t_able, int column, int row, string data, color text_col = #FFFFFF, string align = text.align_center, color background = na, float height = 0) =>
    t_able.cell(column, row, data, text_color = text_col, text_size = parsedDashboardSize, text_halign = align, bgcolor = background, height = height)

divider(table t_able, int row, int lastColumn) =>
    string rowDivider = '━━━━━━━━━━━━━━━━━━━━━━'
    t_able.merge_cells(0, row, lastColumn, row)
    cell(t_able, 0, row, rowDivider, text_col = BORDERS, align = text.align_center, height = 0.5)

trend_row(table t_able, int row, string htf_name, int htf_trend, string ltf_name, int ltf_trend) =>
    bool aligned = htf_trend != 0 and htf_trend == ltf_trend
    cell(t_able, 0, row, f_trend_text(htf_name, htf_trend), text_col = f_trend_color(htf_trend))
    cell(t_able, 1, row, f_trend_text(ltf_name, ltf_trend), text_col = f_trend_color(ltf_trend))
    cell(t_able, 2, row, aligned ? '☑' : '☐', text_col = (aligned ? BULL : HEADERS))

//---------------------------------------------------------------------------------------------------------------------}
// Data Requests
//---------------------------------------------------------------------------------------------------------------------{
trend_D   = f_trend("1D")
trend_H4  = f_trend("240")
trend_H1  = f_trend("60")
trend_M15 = f_trend("15")
trend_M5  = f_trend("5")
trend_M1  = f_trend("1")

[h_ph, h_ph_t, h_pl, h_pl_t] = f_pivots(smc_tf == "" ? timeframe.period : smc_tf)
[l_ph, l_ph_t, l_pl, l_pl_t] = f_pivots(liq_tf == "" ? timeframe.period : liq_tf)

int bias_1      = f_trend(bias_tf1)
int bias_2      = f_trend(bias_tf2)
bool use_bias_1 = f_is_htf(bias_tf1)
bool use_bias_2 = f_is_htf(bias_tf2)

float atr = ta.atr(14)

// 1 = every active bias timeframe agrees with the break direction, -1 = every one is against it, 0 = mixed / no bias
f_bias_class(int dir) =>
    bool any_bias = use_bias_1 or use_bias_2
    bool with_all = any_bias and (not use_bias_1 or bias_1 == dir) and (not use_bias_2 or bias_2 == dir)
    bool against_all = any_bias and (not use_bias_1 or bias_1 == -dir) and (not use_bias_2 or bias_2 == -dir)
    with_all ? 1 : against_all ? -1 : 0

f_break_label(int x, float y, bool is_bos, int bias, color col, string style) =>
    if not (hide_counter and bias == -1)
        label.new(x, y, is_bos ? "BOS" : "CHoCH", xloc.bar_time, textcolor = bias == -1 ? color.new(col, 65) : col, style = style, color = #00000000, size = bias == 1 ? size.small : size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Main Logic & Visuals
//---------------------------------------------------------------------------------------------------------------------{
// Events are evaluated on closed bars only (no live-bar flicker); open lines and boxes still follow the live bar
bool bull_bos   = false
bool bull_choch = false
bool bear_bos   = false
bool bear_choch = false
bool bull_aligned = false
bool bear_aligned = false
bool sweep_high = false
bool sweep_low  = false

// Market Structure (always computed: candle colors and alerts depend on it)
if show_smc
    if not na(ph_line)
        line.set_x2(ph_line, time)
    if not na(pl_line)
        line.set_x2(pl_line, time)

if barstate.isconfirmed
    if not na(h_ph) and (na(active_ph_t) or h_ph_t != active_ph_t)
        active_ph := h_ph
        active_ph_t := h_ph_t
        ph_line := show_smc ? line.new(active_ph_t, active_ph, time, active_ph, xloc.bar_time, color = color.new(BEAR, 50), style = line.style_dashed) : na

    if not na(h_pl) and (na(active_pl_t) or h_pl_t != active_pl_t)
        active_pl := h_pl
        active_pl_t := h_pl_t
        pl_line := show_smc ? line.new(active_pl_t, active_pl, time, active_pl, xloc.bar_time, color = color.new(BULL, 50), style = line.style_dashed) : na

    if not na(active_ph) and close > active_ph
        // The first break has no prior trend to change, so it is a BOS
        bool is_bos = chart_trend != -1
        bull_bos := is_bos
        bull_choch := not is_bos
        int bias = f_bias_class(1)
        bull_aligned := bias == 1
        chart_trend := 1
        if show_smc
            line.set_x2(ph_line, time)
            line.set_color(ph_line, BULL)
            line.set_style(ph_line, line.style_solid)
            f_break_label(math.round(math.avg(line.get_x1(ph_line), time)), active_ph, is_bos, bias, BULL, label.style_label_down)

        active_ph := na
        ph_line := na

    if not na(active_pl) and close < active_pl
        bool is_bos = chart_trend != 1
        bear_bos := is_bos
        bear_choch := not is_bos
        int bias = f_bias_class(-1)
        bear_aligned := bias == 1
        chart_trend := -1
        if show_smc
            line.set_x2(pl_line, time)
            line.set_color(pl_line, BEAR)
            line.set_style(pl_line, line.style_solid)
            f_break_label(math.round(math.avg(line.get_x1(pl_line), time)), active_pl, is_bos, bias, BEAR, label.style_label_up)

        active_pl := na
        pl_line := na

// Liquidity Sweeps
if show_liq
    if not na(liq_ph_line)
        line.set_x2(liq_ph_line_glow, time)
        line.set_x2(liq_ph_line, time)
    if not na(liq_pl_line)
        line.set_x2(liq_pl_line_glow, time)
        line.set_x2(liq_pl_line, time)

if barstate.isconfirmed
    if not na(l_ph) and (na(liq_ph_t) or l_ph_t != liq_ph_t)
        liq_ph := l_ph
        liq_ph_t := l_ph_t
        line.delete(liq_ph_line_glow)
        line.delete(liq_ph_line)
        if show_liq
            liq_ph_line_glow := line.new(liq_ph_t, liq_ph, time, liq_ph, xloc.bar_time, color=color.new(BEAR, 80), width=6)
            liq_ph_line := line.new(liq_ph_t, liq_ph, time, liq_ph, xloc.bar_time, color=color.new(BEAR, 0), width=2, style = line.style_dashed)

    if not na(l_pl) and (na(liq_pl_t) or l_pl_t != liq_pl_t)
        liq_pl := l_pl
        liq_pl_t := l_pl_t
        line.delete(liq_pl_line_glow)
        line.delete(liq_pl_line)
        if show_liq
            liq_pl_line_glow := line.new(liq_pl_t, liq_pl, time, liq_pl, xloc.bar_time, color=color.new(BULL, 80), width=6)
            liq_pl_line := line.new(liq_pl_t, liq_pl, time, liq_pl, xloc.bar_time, color=color.new(BULL, 0), width=2, style = line.style_dashed)

    if not na(liq_ph) and high > liq_ph
        if close <= liq_ph // Swept
            sweep_high := true
            if show_liq
                label.new(time, high, "×", xloc.bar_time, textcolor = BEAR, style = label.style_none, size = size.normal)
                line.set_x2(liq_ph_line_glow, time)
                line.set_x2(liq_ph_line, time)
                line.set_style(liq_ph_line, line.style_solid)
        else // Broken completely
            line.delete(liq_ph_line_glow)
            line.delete(liq_ph_line)

        liq_ph := na
        liq_ph_line := na
        liq_ph_line_glow := na

    if not na(liq_pl) and low < liq_pl
        if close >= liq_pl // Swept
            sweep_low := true
            if show_liq
                label.new(time, low, "×", xloc.bar_time, textcolor = BULL, style = label.style_none, size = size.normal)
                line.set_x2(liq_pl_line_glow, time)
                line.set_x2(liq_pl_line, time)
                line.set_style(liq_pl_line, line.style_solid)
        else // Broken completely
            line.delete(liq_pl_line_glow)
            line.delete(liq_pl_line)

        liq_pl := na
        liq_pl_line := na
        liq_pl_line_glow := na

// Fair Value Gaps
if show_fvg
    for f in fvg_arr
        box.set_right(f.bx, time)

    if barstate.isconfirmed
        float min_gap = fvg_min_atr * nz(atr)
        if not na(high[2]) and not na(low[2])
            if low > high[2] and close[1] > high[2] and low - high[2] >= min_gap
                b = box.new(time[2], low, time, high[2], xloc = xloc.bar_time, bgcolor = color.new(BULL, 80), border_color = color.new(BULL, 100))
                array.push(fvg_arr, FVG.new(b, true, low, high[2]))

            if high < low[2] and close[1] < low[2] and low[2] - high >= min_gap
                b = box.new(time[2], low[2], time, high, xloc = xloc.bar_time, bgcolor = color.new(BEAR, 80), border_color = color.new(BEAR, 100))
                array.push(fvg_arr, FVG.new(b, false, low[2], high))

        if array.size(fvg_arr) > 0
            for i = array.size(fvg_arr) - 1 to 0
                f = array.get(fvg_arr, i)
                if f.is_bull and low < f.bot
                    box.delete(f.bx)
                    array.remove(fvg_arr, i)
                else if not f.is_bull and high > f.top
                    box.delete(f.bx)
                    array.remove(fvg_arr, i)

        // Beyond the limit the oldest gap stops extending but is not deleted
        while array.size(fvg_arr) > fvg_limit
            array.shift(fvg_arr)

barcolor(show_candles and chart_trend != 0 ? (chart_trend == 1 ? BULL : BEAR) : na)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard Render
//---------------------------------------------------------------------------------------------------------------------{
var table t_able = dashboardInput ? table.new(parsedDashboardPosition, 3, 11, bgcolor = BACKGROUND, border_width = 0, frame_color = BORDERS, frame_width = 1, force_overlay = false) : na

if dashboardInput and barstate.islast
    t_able.merge_cells(0, 0, 2, 0)
    cell(t_able, 0, 0, 'Trend Alignment', text_col = DATA, align = text.align_center)

    divider(t_able, 1, 2)

    cell(t_able, 0, 2, 'HTF', text_col = HEADERS)
    cell(t_able, 1, 2, 'LTF', text_col = HEADERS)
    cell(t_able, 2, 2, 'Aligned', text_col = HEADERS)

    divider(t_able, 3, 2)
    trend_row(t_able, 4, '1D', trend_D, '1H', trend_H1)
    divider(t_able, 5, 2)
    trend_row(t_able, 6, '4H', trend_H4, 'M15', trend_M15)
    divider(t_able, 7, 2)
    trend_row(t_able, 8, '1H', trend_H1, 'M5', trend_M5)
    divider(t_able, 9, 2)
    trend_row(t_able, 10, 'M15', trend_M15, 'M1', trend_M1)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bull_bos,   "Bullish BOS",   "Structure: bullish BOS on {{ticker}} {{interval}} @ {{close}}")
alertcondition(bull_choch, "Bullish CHoCH", "Structure: bullish CHoCH on {{ticker}} {{interval}} @ {{close}}")
alertcondition(bear_bos,   "Bearish BOS",   "Structure: bearish BOS on {{ticker}} {{interval}} @ {{close}}")
alertcondition(bear_choch, "Bearish CHoCH", "Structure: bearish CHoCH on {{ticker}} {{interval}} @ {{close}}")
alertcondition(bull_aligned, "Bullish Break (HTF aligned)", "Structure: bullish BOS/CHoCH with the HTF bias on {{ticker}} {{interval}} @ {{close}}")
alertcondition(bear_aligned, "Bearish Break (HTF aligned)", "Structure: bearish BOS/CHoCH with the HTF bias on {{ticker}} {{interval}} @ {{close}}")
alertcondition(sweep_high, "Buy-side Sweep",  "Liquidity: buy-side sweep (high swept) on {{ticker}} {{interval}}")
alertcondition(sweep_low,  "Sell-side Sweep", "Liquidity: sell-side sweep (low swept) on {{ticker}} {{interval}}")

//---------------------------------------------------------------------------------------------------------------------}
