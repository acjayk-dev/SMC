//@version=6
// ─────────────────────────────────────────────────────────
// Oliver Velez v0.8 — Fase 1: velas + medias | Fase 2: entradas | Fase 3: stops, objetivos y trailing
//                     Fase 4: filtros (sesión, horas de reversa, volumen, marco superior) y estadísticas
//                     Fase 5: soporte y resistencia (Cap. 12)
// Fuente de verdad: Estrategia.md (citas = capítulo del manual)
// TF operativo: 1 / 2 / 5 min | Analítico: 15 / 60 min y Diario
// ─────────────────────────────────────────────────────────

// ══ [1] DECLARACIÓN ══
indicator("Oliver Velez — Velas, Entradas y Gestión", shorttitle="OV", overlay=true, max_labels_count=500, max_boxes_count=100, max_lines_count=50)

// ══ [2] TIPOS ══
// Zona de soporte/resistencia nacida en un pivote (Cap. 12: "no son precios específicos, son áreas")
type SRZone
    box   bx
    float top
    float bot
    bool  isRes
    bool  flipped

// ══ [4] INPUTS ══
grpMA    = "═══ 📈 MEDIAS MÓVILES ═══"
grpEB    = "═══ 🐘 VELA ELEFANTE ═══"
grpTL    = "═══ 🕯️ COLAS BT / TT ═══"
grpNR    = "═══ 🔹 NRB / NB ═══"
grpCtx   = "═══ 🔁 CONTEXTO 3-5 VELAS ═══"
grpVis   = "═══ 🎨 MARCAS Y PANEL ═══"
grpCol   = "═══ 🎨 COLORES Y PINTADO DE VELAS ═══"
grpEnt   = "═══ 🎯 ENTRADAS (FASE 2) ═══"
grpSet   = "═══ 🧩 SETUPS ═══"
grpRisk  = "═══ 🛡️ STOPS, OBJETIVOS Y TRAILING (FASE 3) ═══"
grpFlt   = "═══ 🕒 FILTROS Y SESIÓN (FASE 4) ═══"
grpStat  = "═══ 📊 ESTADÍSTICAS (FASE 4) ═══"
grpSR    = "═══ 🧱 SOPORTE Y RESISTENCIA (FASE 5) ═══"

smaFastLen = input.int(8,   "8mm",            minval=1, group=grpMA, tooltip="SMA rápida. Soporta los movimientos más poderosos (Cap. 5).")
smaMedLen  = input.int(20,  "20mm / 21mm",    options=[20, 21], group=grpMA, tooltip="SMA media. 20 y 21 son intercambiables (Cap. 3, 5).")
smaSlowLen = input.int(200, "200mm (Goliat)", minval=1, group=grpMA, tooltip="SMA lenta. Más poderosa cuando está plana (Cap. 5).")
showMAs    = input.bool(true, "Mostrar medias", group=grpMA)

avgLen     = input.int(20, "Periodo del promedio de rango/cuerpo", minval=5, maxval=100, group=grpEB,
     tooltip="[PROPUESTO] Velas anteriores usadas para comparar el tamaño (no incluye la vela actual).")
ebMult     = input.float(1.5, "Multiplicador Elefante", minval=1.0, step=0.1, group=grpEB,
     tooltip="[PROPUESTO] Cuerpo > mult × promedio del cuerpo de las velas anteriores. Cap. 1: 'WRB velas de cuerpo amplio'; la fuerza la da la distancia entre la apertura y el cierre.")
ebBodyPct  = input.float(0.5, "Cuerpo mínimo de la Elefante (fracción del rango)", minval=0.3, maxval=1.0, step=0.05, group=grpEB,
     tooltip="[PROPUESTO] Cap. 1: vela de cuerpo sólido; la mayor parte del rango es color.")
ebClosePct = input.float(0.333, "Cierre en el tercio extremo", minval=0.1, maxval=0.5, step=0.01, group=grpEB,
     tooltip="[PROPUESTO, derivado de la regla 2/3] Toro: cierre ≥ máximo − rango × valor. Oso: cierre ≤ mínimo + rango × valor.")
weakPct    = input.float(0.5,   "Control débil (color borrado)",   minval=0.1, maxval=1.0, step=0.01, group=grpEB, tooltip="Cap. 1: se borra ~1/2 del color.")
lostPct    = input.float(0.667, "Control perdido (color borrado)", minval=0.1, maxval=1.0, step=0.01, group=grpEB, tooltip="Cap. 1: se borra 2/3 o más del color.")

tailPct    = input.float(0.667, "Cola mínima (fracción del rango)", minval=0.5, maxval=0.95, step=0.01, group=grpTL,
     tooltip="Cap. 11.4: la cola representa 2/3 o más del rango de la vela.")

nrbMult    = input.float(0.5, "Multiplicador NRB (rango)",  minval=0.1, maxval=1.0, step=0.05, group=grpNR, tooltip="[PROPUESTO] Rango < mult × promedio del rango.")
nbMult     = input.float(0.5, "Multiplicador NB (cuerpo)",  minval=0.1, maxval=1.0, step=0.05, group=grpNR, tooltip="[PROPUESTO] Cuerpo < mult × promedio del cuerpo.")

ctxMin     = input.int(3, "Velas mínimas de caída/subida previa", minval=2, maxval=8, group=grpCtx,
     tooltip="Cap. 7 y 11: BT/TT/NRB/NB son más fuertes tras 3 a 5 velas de caída (altos más bajos o velas rojas) o de subida (bajos más altos o velas verdes).")

showEB      = input.bool(false, "Marca Vela Elefante",   group=grpVis, tooltip="Desactivado por defecto: el pintado de velas ya las identifica.")
showTail    = input.bool(false, "Marca Colas BT / TT",   group=grpVis, tooltip="Desactivado por defecto: el pintado de velas ya las identifica.")
showNRB     = input.bool(false, "Marca NRB",             group=grpVis, tooltip="Desactivado por defecto: el pintado de velas ya las identifica.")
showNB      = input.bool(false, "Marca NB",              group=grpVis, tooltip="Muy frecuente; actívalo solo para revisar.")
showDash    = input.bool(true,  "Panel de estado",       group=grpVis)
txtSize     = input.string("Diminuto", "Tamaño de texto (entradas y panel)", options=["Diminuto", "Pequeño", "Normal"], group=grpVis)
showTrendBg = input.bool(false, "Fondo según tendencia", group=grpVis)

// Una sola configuración de colores: cada elemento tiene un único color, usado en su marca y en su pintado
paintOn   = input.bool(true, "Pintar velas", group=grpCol,
     tooltip="Interruptor general del pintado. Cada patrón y setup tiene abajo su casilla (pintar o no) y su color, que también se usa en su marca.")
paintMode = input.string("Solo cuerpo", "Modo de pintado", options=["Solo cuerpo", "Vela completa"], group=grpCol,
     tooltip="Solo cuerpo: redibuja el cuerpo encima de la vela original y conserva la mecha. Vela completa: pinta cuerpo, mecha y borde.")
paintConf = input.bool(true, "Solo velas cerradas", group=grpCol, tooltip="Evita que el color cambie mientras la vela se forma.")
spBar     = input.string("Vela de señal", "Setups: vela a pintar", options=["Vela de señal", "Vela de entrada"], group=grpCol,
     tooltip="Vela de señal: la vela que forma el patrón (vela 1 del 180, vela roja del RBI, última vela de la base, etc.), aunque luego no gatille. Vela de entrada: la vela donde se activa la entrada mostrada.")
spPrio    = input.bool(true, "Setups con prioridad sobre patrones de vela", group=grpCol, tooltip="Si una vela es a la vez setup y patrón de vela (Elefante, BT, TT, NRB, NB), usar el color del setup.")

colBull   = input.color(#00C853, "Base ▲ ▼ ▬",  inline="cb", group=grpCol,
     tooltip="Alcista / bajista / neutro: etiquetas de entrada, panel, fondo de tendencia y pintado del resto de velas según tendencia.")
colBear   = input.color(#FF1744, "",            inline="cb", group=grpCol)
colNeut   = input.color(#9E9E9E, "",            inline="cb", group=grpCol)
pTrend    = input.bool(false, "Pintar el resto según tendencia", inline="ptr", group=grpCol)
trTransp  = input.int(50, "Transp.", minval=0, maxval=90, inline="ptr", group=grpCol)

pEB       = input.bool(true,  "Elefante",       inline="peb", group=grpCol)
cEBUp     = input.color(#00E676, "▲",           inline="peb", group=grpCol)
cEBDn     = input.color(#FF1744, "▼",           inline="peb", group=grpCol)
pTail     = input.bool(true,  "BT / TT",        inline="ptl", group=grpCol)
cBTp      = input.color(#00BCD4, "▲",           inline="ptl", group=grpCol)
cTTp      = input.color(#E040FB, "▼",           inline="ptl", group=grpCol)
pGBR      = input.bool(true,  "GBR / RBR",      inline="pgr", group=grpCol, tooltip="Vela Verde / Roja de Reversa (Cap. 11.1).")
cGBRp     = input.color(#AEEA00, "▲",           inline="pgr", group=grpCol)
cRBRp     = input.color(#FF6E40, "▼",           inline="pgr", group=grpCol)
pNRB      = input.bool(true,  "NRB",            inline="pnr", group=grpCol)
cNRBp     = input.color(#FFD600, "",            inline="pnr", group=grpCol)
pNB       = input.bool(false, "NB",             inline="pnr", group=grpCol)
cNBp      = input.color(#FF9100, "",            inline="pnr", group=grpCol)

spVBS     = input.bool(true, "VBS / VSS",       inline="sp1", group=grpCol)
cVBS      = input.color(#00B0FF, "▲",           inline="sp1", group=grpCol)
cVSS      = input.color(#FF6D00, "▼",           inline="sp1", group=grpCol)
spREV     = input.bool(true, "Reversa 3-5",     inline="sp2", group=grpCol)
cREVL     = input.color(#76FF03, "▲",           inline="sp2", group=grpCol)
cREVS     = input.color(#F50057, "▼",           inline="sp2", group=grpCol)
spCLI     = input.bool(true, "CDB / CAS",       inline="sp3", group=grpCol)
cCDB      = input.color(#FFEA00, "▲",           inline="sp3", group=grpCol)
cCAS      = input.color(#D500F9, "▼",           inline="sp3", group=grpCol)
spMOM     = input.bool(true, "Momentum",        inline="sp4", group=grpCol)
cMOML     = input.color(#1DE9B6, "▲",           inline="sp4", group=grpCol)
cMOMS     = input.color(#FF3D00, "▼",           inline="sp4", group=grpCol)
sp180     = input.bool(true, "Toro / Oso 180",  inline="sp5", group=grpCol)
c180L     = input.color(#2962FF, "▲",           inline="sp5", group=grpCol)
c180S     = input.color(#FF4081, "▼",           inline="sp5", group=grpCol)
spRBI     = input.bool(true, "RBI / GBI",       inline="sp6", group=grpCol)
cRBI      = input.color(#64DD17, "▲",           inline="sp6", group=grpCol)
cGBI      = input.color(#DD2C00, "▼",           inline="sp6", group=grpCol)
spBOP     = input.bool(true, "BOP / BDP",       inline="sp7", group=grpCol)
cBOP      = input.color(#18FFFF, "▲",           inline="sp7", group=grpCol)
cBDP      = input.color(#AA00FF, "▼",           inline="sp7", group=grpCol)

colEntry  = input.color(#B0BEC5, "Operación: entrada / stop / objetivos", inline="ctr", group=grpCol)
colStop   = input.color(#FF5252, "",            inline="ctr", group=grpCol)
colTgt    = input.color(#69F0AE, "",            inline="ctr", group=grpCol)

cSup      = input.color(#26A69A, "S/R: soporte / resistencia / día anterior", inline="csr", group=grpCol)
cRes      = input.color(#EF5350, "",            inline="csr", group=grpCol)
cPDC      = input.color(#FFB300, "",            inline="csr", group=grpCol)
c200      = input.color(#B0BEC5, "200mm normal / plana", inline="c2", group=grpCol)
c200F     = input.color(#FFD54F, "",            inline="c2", group=grpCol)

showEntries = input.bool(true, "Mostrar entradas", group=grpEnt)
entryStyle  = input.string("Texto", "Estilo de etiqueta", options=["Texto", "Caja"], group=grpEnt, tooltip="Texto: flecha y nombre sin fondo (más limpio). Caja: etiqueta con fondo.")
showPending = input.bool(false, "Mostrar nivel de entrada pendiente", group=grpEnt, tooltip="Puntos en el nivel de la orden stop. El panel ya muestra el nivel actual.")
offMode     = input.string("Auto", "Offset de entrada y stop", options=["Auto", "$0.01", "1 tick"], group=grpEnt,
     tooltip="Cap. 10.1, 15, 16, 17: $0.01 por encima del máximo (largos) / por debajo del mínimo (cortos). Auto: $0.01 en acciones y 1 tick en futuros, forex o cripto, donde $0.01 no es un precio válido.")
earlyOn     = input.bool(true, "Entrada temprana 2/3 con TIF", group=grpEnt,
     tooltip="Cap. 11.4, 17.1: entrar cuando la vela recupera 2/3 de la vela de referencia, respetando TIF (1-2 min: vela cerrada; 5 min: 4:52; 15 min: 14:30; 60 min: 57:00). En tiempo real puede desaparecer si la vela cierra por debajo del nivel.")
cooldown    = input.int(5, "Velas mínimas entre señales del mismo lado", minval=1, maxval=50, group=grpEnt, tooltip="[PROPUESTO] Evita señales repetidas en velas consecutivas.")

onVBS        = input.bool(true, "VBS / VSS (Cap. 10.1)", group=grpSet)
vbsMin       = input.int(3, "Retroceso mínimo (velas)", minval=1, maxval=10, group=grpSet, tooltip="Cap. 10.1: 3 o más altos más bajos o velas rojas (VBS); bajos más altos o velas verdes (VSS).")
vbsMinStrong = input.int(2, "Retroceso mínimo en tendencia muy poderosa", minval=1, maxval=10, group=grpSet, tooltip="Cap. 10.1: 2 suelen funcionar en tendencias muy poderosas (8mm y 20mm a favor y 8mm del lado correcto de la 20mm).")
useLoc       = input.bool(true, "VBS/VSS y Reversa: exigir soporte / resistencia", group=grpSet,
     tooltip="Cap. 10.1 (ubicaciones) y Cap. 12, Reglas #1-#4: 'Limita todas tus compras a algún área de soporte'. Vale cualquiera de las 8 formas: zona de pivote, retroceso 33%-55%, línea de tendencia, 8mm/20mm a favor, 200mm plana, cierre del día anterior o muy lejos de la 20mm. Tolerancia = 'Cercanía (× ATR)'.")
locMult      = input.float(0.2, "Cercanía (× ATR)", minval=0.05, step=0.05, group=grpSet)
vbsSig       = input.bool(false, "VBS/VSS: exigir señal de piso / techo", group=grpSet,
     tooltip="Cap. 10.1 lista BT, GBR, NRB y NB entre los complementos de la VBS; el Cap. 11.5 exige una de las 7 señales de reversa para comprar una caída de 3-5 velas. Prevalece la regla específica de la VBS (Cap. 10.1): desactivado. El requisito del Cap. 11.5 se aplica a la Reversa 3-5.")
onREV        = input.bool(true, "Reversa 3-5 con BT/TT/NRB/NB (Cap. 7, 11)", group=grpSet, tooltip="Señal de piso/techo tras 3-5 velas en contra, sin ir contra la 20mm (tendencia a favor o lateral).")
holdBars     = input.int(3, "Vigencia de la señal de piso / techo (velas extra)", minval=0, maxval=10, group=grpSet,
     tooltip="Cap. 11.1-11.4: con BT, GBR, NB o NRB se compra 'la próxima vez que se viole el máximo de una vela anterior'. Reversa y CDB/CAS siguen armadas estas velas extra, con el gatillo en el máximo (mínimo) de la vela anterior, hasta activarse o hasta que se pierda el mínimo (máximo) de la vela de señal. 0 = solo la vela siguiente. [PROPUESTO] 3.")
onCLIM       = input.bool(true, "CDB / CAS climáticas (Cap. 15)", group=grpSet)
climBars     = input.int(5, "Velas climáticas mínimas", minval=3, maxval=15, group=grpSet, tooltip="Cap. 15: 5 o más altos más bajos / velas rojas (CDB) o bajos más altos / velas verdes (CAS).")
skipFirst    = input.bool(true, "Tras CDB/CAS, ignorar la primera VSS/VBS", group=grpSet,
     tooltip="Cap. 15: 'La primera configuración de venta después de una caída climática posee bajas posibilidades' (y la primera de compra tras un avance climático).")
climDist     = input.float(2.0, "Distancia a la 20mm (× ATR)", minval=0.5, step=0.1, group=grpSet, tooltip="[PROPUESTO] El manual lo describe como concepto visual.")
onMOM        = input.bool(true, "Momentum con Elefante de ignición (Cap. 10.3)", group=grpSet, tooltip="[PROPUESTO] Ignición = la Elefante no viene tras 3+ velas en su misma dirección.")
momRoom      = input.float(1.0, "Momentum: espacio libre mínimo (× riesgo)", minval=0.0, step=0.25, group=grpSet,
     tooltip="[PROPUESTO] Cap. 10.3: 'no queremos comprar justo frente a una resistencia inmediata o muy cercana'. Sin resistencia (soporte en ventas) entre la entrada y esta distancia: zona, retroceso, línea de tendencia, 8mm/20mm en contra, 200mm plana o cierre del día anterior. 0 = desactivado.")
on180        = input.bool(true, "Toro / Oso 180 (Cap. 17.1)", group=grpSet)
v180Body     = input.float(0.5,   "180: cuerpo mínimo (fracción del rango)", minval=0.3, maxval=1.0, step=0.05, group=grpSet, tooltip="[PROPUESTO] Cap. 17.1: la mayoría del rango debe ser del color de la vela 1.")
v180Ext      = input.float(0.333, "180: apertura/cierre en el tercio extremo", minval=0.1, maxval=0.5, step=0.01, group=grpSet, tooltip="[PROPUESTO] Cap. 17.1: abre en un extremo y cierra en el otro.")
v180Big      = input.bool(true, "180: vela 1 más grande que el promedio", group=grpSet, tooltip="[PROPUESTO] Rango de la vela 1 > promedio del rango de las velas anteriores. Reduce señales en velas pequeñas.")
onRBI        = input.bool(true, "RBI / GBI (Cap. 17.2)", group=grpSet)
rbiIdeal     = input.bool(true, "Exigir vela 2 ideal (tercio extremo)", group=grpSet, tooltip="Cap. 17.2: ideal, no requerido. [PROPUESTO] activado para reducir ruido.")
rbiTrend     = input.bool(true, "RBI/GBI: exigir tendencia a favor", group=grpSet,
     tooltip="[PROPUESTO] Cap. 17.2, punto 4: 'ayuda al trader a entrar en tendencias poderosas que ya están en curso'. RBI con tendencia alcista del Cap. 6 (regular, de poder o súper); GBI con bajista.")
onBOP        = input.bool(true, "BOP / BDP (Cap. 16)", group=grpSet)
baseBars     = input.int(3, "Velas de la base", minval=2, maxval=20, group=grpSet, tooltip="[PROPUESTO] El manual no fija un mínimo.")
baseAtr      = input.float(1.0, "Altura máxima de la base (× ATR)", minval=0.2, step=0.1, group=grpSet, tooltip="[PROPUESTO] Cap. 16: base ajustada y delgada, no amplia ni volátil.")
bop20Req     = input.bool(true, "BOP/BDP: la base no cruza la 20mm", group=grpSet,
     tooltip="Cap. 16: 'Las pausas usualmente no cruzan la 20mm por mucho; los altos cruzan por debajo de ella'. Tolerancia = 'Cercanía (× ATR)'.")
bopVolReq    = input.bool(true, "BOP/BDP: exigir volumen liviano en la base", group=grpSet, tooltip="Cap. 16, configuración punto 4: 'El volumen durante la base debe ser liviano, no pesado'. Se ignora si el símbolo no tiene volumen.")

showTrade  = input.bool(true, "Mostrar gestión de la operación", group=grpRisk, tooltip="Una operación virtual a la vez: entrada, stop, objetivos y salida.")
hideInPos  = input.bool(true, "Ocultar señales con posición abierta", group=grpRisk)
tooClose   = input.float(0.25, "Stop 'muy cerca' si riesgo < (× ATR)", minval=0.0, step=0.05, group=grpRisk,
     tooltip="[PROPUESTO] Cap. 10.1: si el stop bajo la vela de entrada está muy cerca, usar el mínimo de la vela anterior.")
tooFar     = input.float(1.5, "Stop 'muy lejos' si riesgo > (× ATR)", minval=0.5, step=0.1, group=grpRisk,
     tooltip="[PROPUESTO] Cap. 8.1, 17.1: si el stop por evento está muy lejos, usar el retroceso de 2/3 de la vela de entrada.")
bdpStopBase = input.bool(false, "BDP: stop sobre la base completa", group=grpRisk, tooltip="Cap. 16: sobre la vela de rompimiento o sobre la base completa (a elección).")
mlpdUsd    = input.float(0.0, "Pérdida máxima diaria MLPD ($) — 0 = sin MLPT", minval=0.0, step=50, group=grpRisk,
     tooltip="Cap. 8, 8.2: la MLPT (pérdida máxima por trade) es el 25%-50% de la MLPD. Limita el stop si el de evento es mayor.")
mlptPct    = input.float(0.5, "MLPT (fracción de la MLPD)", minval=0.25, maxval=0.5, step=0.05, group=grpRisk)
posQty     = input.float(100, "Tamaño (acciones / contratos)", minval=1, group=grpRisk, tooltip="Solo para convertir la MLPT de $ a precio.")
swingLook  = input.int(20, "Velas para buscar el pivote anterior", minval=5, maxval=200, group=grpRisk,
     tooltip="[PROPUESTO] Cap. 10.1: T1 = 50% de retroceso del movimiento; T2 = pivote anterior.")
tgtMode    = input.string("T2", "Cerrar la posición en", options=["T1", "T2", "Último objetivo", "Solo stop / trailing"], group=grpRisk,
     tooltip="Si el objetivo elegido no existe (el precio ya lo superó), se usa el siguiente disponible.")
beOn       = input.bool(true, "Break-even a 1:1", group=grpRisk, tooltip="Cap. 22 (Glosario): al llegar a 1:1 riesgo/beneficio, stop al precio de entrada.")
trailMode  = input.string("Vela a vela", "Trailing", options=["Vela a vela", "8mm", "20mm", "Ninguno"], group=grpRisk,
     tooltip="Cap. 9. Se activa tras 2 velas a favor (1 en Momentum). Vela a vela: stop bajo el mínimo de la vela anterior. 8mm/20mm: salir al cierre del otro lado de la media [PROPUESTO por cierre].")
exhaustOn  = input.bool(true, "Salir con señal de agotamiento (vela a vela)", group=grpRisk,
     tooltip="Según el setup. VBS/VSS y el resto (Cap. 10.1): cola en contra, Elefante a favor o vela contraria que elimina más del 50% de la anterior. CDB/CAS (Cap. 15): solo una RBR/GBR mayor. RBI/GBI (Cap. 17.2): ninguna; sale el trailing cuando se elimina el mínimo (máximo) de la vela de reverso.")
climBE     = input.bool(true, "CDB/CAS: break-even tras 2 velas a favor", group=grpRisk,
     tooltip="Cap. 15: 'muchos iFundTraders optan por un enfoque de ganar o perder moviendo su stop a Break Even una vez tienen el avance de dos velas'.")

tz        = input.string("America/New_York", "Zona horaria de la sesión", group=grpFlt, tooltip="Los horarios del manual están en hora del Este (ET).")
useSess   = input.bool(true, "Operar solo dentro de la sesión", group=grpFlt, tooltip="Solo en marcos intradía.")
sessStr   = input.session("0930-1600", "Sesión", group=grpFlt, tooltip="Por defecto, horario regular de EE.UU. (ET).")
cutoffMin = input.int(15, "Sin entradas nuevas en los últimos (min)", minval=0, maxval=120, group=grpFlt,
     tooltip="[NO ENCONTRADO en el manual] [PROPUESTO] Filtro de cierre de mercado.")
eodExit   = input.bool(true, "Cerrar la posición al final de la sesión", group=grpFlt, tooltip="[PROPUESTO] Operativa intradía: no se mantienen posiciones fuera de la sesión.")
rtShow    = input.bool(false, "Resaltar horas de reversa", group=grpFlt,
     tooltip="Cap. 13-14 (ET): 9:35, 10:00, 10:30, 11:15-11:30, 12:00, 13:30, 14:15-14:30, 15:00, 15:30. Las más importantes: 10:00, 11:15 y 14:15-14:30.")
rtTol     = input.int(10, "Tolerancia de hora de reversa (± min)", minval=0, maxval=30, group=grpFlt, tooltip="[PROPUESTO]")
rtClim    = input.bool(true, "CDB/CAS: exigir hora de reversa", group=grpFlt,
     tooltip="Cap. 15: la hora de reacción es el punto 5 de la configuración climática y, a diferencia del volumen (punto 4), el manual no la marca como no requerida. En la vela de señal o en la de entrada, con la tolerancia de abajo.")
rtAll     = input.bool(false, "Todas las entradas: exigir hora de reversa", group=grpFlt, tooltip="Cap. 10.1: en VBS/VSS la hora es un complemento, no un requisito.")
volReq    = input.bool(false, "Exigir volumen > promedio en la vela de señal", group=grpFlt, tooltip="Cap. 10.1, 15: el manual dice que no es un requisito.")
useHtf    = input.bool(false, "Filtro de tendencia del marco superior", group=grpFlt,
     tooltip="Cap. 4: el 15 min se usa para el análisis de tendencia. Largos solo si el marco superior no es bajista (y viceversa). No se aplica a CDB/CAS, que son contratendencia por definición.")
htfTf     = input.timeframe("15", "Marco superior", group=grpFlt)

showStats = input.bool(true, "Mostrar estadísticas", group=grpStat, tooltip="Resultados en R de las operaciones virtuales cerradas en el historial cargado.")
statPos   = input.string("Abajo derecha", "Posición de la tabla", options=["Abajo derecha", "Abajo izquierda", "Arriba izquierda"], group=grpStat)

showZones = input.bool(true, "Zonas de máximo / mínimo anterior", group=grpSR,
     tooltip="Cap. 12: soporte en máximo o mínimo anterior y resistencia en mínimo o máximo anterior. Cada zona nace en un pivote y se extiende hasta que el precio cierra al otro lado; entonces cambia de rol (resistencia → soporte y viceversa). Si se rompe otra vez, se elimina [PROPUESTO].")
pivLen    = input.int(5, "Velas a cada lado del pivote", minval=2, maxval=20, group=grpSR, tooltip="[PROPUESTO] El pivote se confirma N velas después (no repinta).")
maxZones  = input.int(4, "Zonas activas por tipo", minval=1, maxval=10, group=grpSR)
zoneAtr   = input.float(0.3, "Grosor de la zona (× ATR)", minval=0.05, step=0.05, group=grpSR,
     tooltip="[PROPUESTO] Cap. 12: 'Los precios de soporte y resistencia no son precios específicos. Son áreas. Cuando el precio va a ellas o cerca es suficiente'.")
showFib   = input.bool(true, "Retrocesos 33% / 50% / 55% del último tramo", group=grpSR,
     tooltip="Cap. 12: soporte/resistencia de retroceso del 33% y del 50%-55% (≈ 1/2) del último tramo entre pivotes.")
showTL    = input.bool(true, "Líneas de tendencia", group=grpSR,
     tooltip="Cap. 6 y 12: une los dos últimos pivotes con bajo más alto (soporte) o alto más bajo (resistencia), solo si la 20mm tiene la misma pendiente entre ambos pivotes ('suele coincidir con la 20mm'). Se rompe al cerrar al otro lado por más de 'Cercanía (× ATR)' [PROPUESTO].")
showPDC   = input.bool(true, "Cierre del día anterior (PDC)", group=grpSR, tooltip="Cap. 12: soporte/resistencia del precio de cierre del día anterior.")
showPDHL  = input.bool(false, "Máximo y mínimo del día anterior", group=grpSR, tooltip="[NO ENCONTRADO en el manual] Referencia adicional.")
flatLen   = input.int(20, "200mm plana: velas para medir la pendiente", minval=5, maxval=100, group=grpSR, tooltip="[PROPUESTO] Cap. 5 y 12: la 200mm plana es el soporte/resistencia más fiable.")
flatAtr   = input.float(0.5, "200mm plana si se mueve menos de (× ATR)", minval=0.05, step=0.05, group=grpSR, tooltip="[PROPUESTO]")
srReq     = input.bool(false, "Todas las entradas: exigir soporte / resistencia", group=grpSR,
     tooltip="Cap. 12, Reglas #1-#4, aplicadas también a BOP, 180, RBI y Momentum (VBS/VSS y Reversa ya lo exigen en SETUPS). Cuenta cualquiera: zona de pivote, retroceso 33%-55%, línea de tendencia, 8mm/20mm a favor, 200mm plana, cierre del día anterior o muy lejos de la 20mm. Tolerancia = 'Cercanía (× ATR)'.")

// ══ [6] CÁLCULOS CORE ══
sma8   = ta.sma(close, smaFastLen)
sma20  = ta.sma(close, smaMedLen)
sma200 = ta.sma(close, smaSlowLen)
atr    = ta.atr(14)
isStock = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
off     = offMode == "1 tick" or (offMode == "Auto" and not isStock) ? syminfo.mintick : math.max(0.01, syminfo.mintick)
volUp  = volume > ta.sma(volume, 20)

rng     = high - low
body    = math.abs(close - open)
avgRng  = ta.sma(rng,  avgLen)[1]
avgBody = ta.sma(body, avgLen)[1]
hasRng  = rng > 0
isGreen = close > open
isRed   = close < open

// Rachas (Cap. 7 / 10.1): altos más bajos o velas rojas; bajos más altos o velas verdes
var int lhRun    = 0
var int redRun   = 0
var int hlRun    = 0
var int greenRun = 0
var int dnRun    = 0
var int upRun    = 0
lhRun    := high < high[1] ? lhRun + 1    : 0
redRun   := isRed          ? redRun + 1   : 0
hlRun    := low > low[1]   ? hlRun + 1    : 0
greenRun := isGreen        ? greenRun + 1 : 0
// VBS/VSS (Cap. 10.1) exige altos Y bajos más bajos (o bajos Y altos más altos)
dnRun    := high < high[1] and low < low[1] ? dnRun + 1 : 0
upRun    := low > low[1] and high > high[1] ? upRun + 1 : 0
// Rachas de las velas ANTERIORES a la actual
prevDnRun = math.max(nz(lhRun[1]), nz(redRun[1]))
prevUpRun = math.max(nz(hlRun[1]), nz(greenRun[1]))
ctxDown   = prevDnRun >= ctxMin
ctxUp     = prevUpRun >= ctxMin

// TIF (Cap. 11.4): en histórico la vela ya está cerrada; en tiempo real se mide el tiempo transcurrido
tfSec   = timeframe.in_seconds(timeframe.period)
tifSec  = tfSec == 300 ? 292 : tfSec == 900 ? 870 : tfSec == 3600 ? 3420 : na
elapsed = (timenow - time) / 1000
tifOK   = barstate.isconfirmed or (not na(tifSec) and elapsed >= tifSec)

// Sesión (Fase 4): fin de sesión en la zona horaria elegida (admite sesiones que cruzan medianoche)
isIntra  = timeframe.isintraday
inSess   = not na(time(timeframe.period, sessStr, tz))
startMin = int(str.tonumber(str.substring(sessStr, 0, 2))) * 60 + int(str.tonumber(str.substring(sessStr, 2, 4)))
endMin   = int(str.tonumber(str.substring(sessStr, 5, 7))) * 60 + int(str.tonumber(str.substring(sessStr, 7, 9)))
barMin0  = hour(time, tz) * 60 + minute(time, tz)
barMin1  = hour(time_close, tz) * 60 + minute(time_close, tz)
sessEnd  = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), int(endMin / 60), endMin % 60) + (endMin <= startMin and barMin0 >= startMin ? 86400000 : 0)
sessOK   = not useSess or not isIntra or (inSess and time_close <= sessEnd - cutoffMin * 60000)
outSess  = useSess and isIntra and not inSess
eodNow   = useSess and eodExit and isIntra and time_close >= sessEnd

// Horas de reversa (Cap. 13-14), en minutos desde medianoche ET: inicio y fin de cada ventana
var rtA = array.from(575, 600, 630, 675, 720, 810, 855, 900, 930)
var rtB = array.from(575, 600, 630, 690, 720, 810, 870, 900, 930)
f_nearRT(int tol) =>
    bool hit = false
    for i = 0 to array.size(rtA) - 1
        if barMin1 >= array.get(rtA, i) - tol and barMin0 <= array.get(rtB, i) + tol
            hit := true
    hit
nearRT  = isIntra and f_nearRT(rtTol)
exactRT = isIntra and f_nearRT(0)

// Tendencia del marco superior (Cap. 4). [1] + lookahead_on = última vela superior CERRADA, sin repintado.
f_htfTrend() =>
    float m = ta.sma(close, smaMedLen)
    close > m and m > m[1] ? 1 : close < m and m < m[1] ? -1 : 0
htfTrend = request.security(syminfo.tickerid, htfTf, f_htfTrend()[1], lookahead=barmerge.lookahead_on)

// Día anterior: cierre (Cap. 10.1, 12), máximo y mínimo. [1] + lookahead_on = día ya cerrado, sin repintado.
[pdc, pdh, pdl] = request.security(syminfo.tickerid, "D", [close[1], high[1], low[1]], lookahead=barmerge.lookahead_on)

// ══ [6b] SOPORTE Y RESISTENCIA (FASE 5, Cap. 12) ══
srTol = locMult * atr

// 200mm plana: se movió menos de flatAtr × ATR en las últimas flatLen velas
sma200Flat = math.abs(sma200 - sma200[flatLen]) <= flatAtr * atr

// Pivotes confirmados (pivLen velas después) → zonas de máximo/mínimo anterior y último tramo para los retrocesos
ph    = ta.pivothigh(high, pivLen, pivLen)
pl    = ta.pivotlow(low, pivLen, pivLen)
zoneW = zoneAtr * atr

var SRZone[] zones = array.new<SRZone>()
var float lastPH  = na
var float lastPL  = na
var int   lastPHb = na
var int   lastPLb = na

f_zoneCol(bool isRes) =>
    color c = isRes ? cRes : cSup
    [showZones ? color.new(c, 85) : color(na), showZones ? color.new(c, 50) : color(na)]

f_addZone(float top, float bot, bool isRes, int x) =>
    bool overlap = false
    int  same    = 0
    for z in zones
        if z.isRes == isRes
            same += 1
            if top >= z.bot and bot <= z.top
                overlap := true
    if not overlap
        // Límite de zonas activas por tipo: se elimina la más antigua del mismo tipo
        if same >= maxZones
            for i = 0 to zones.size() - 1
                SRZone z = zones.get(i)
                if z.isRes == isRes
                    z.bx.delete()
                    zones.remove(i)
                    break
        [bg, bd] = f_zoneCol(isRes)
        zones.push(SRZone.new(box.new(x, top, bar_index, bot, border_color=bd, bgcolor=bg, extend=extend.right), top, bot, isRes, false))

// Pivote anterior y 20mm en cada pivote (para las líneas de tendencia)
var float prevPH   = na
var float prevPL   = na
var int   prevPHb  = na
var int   prevPLb  = na
var float lastPHma = na
var float lastPLma = na
var float prevPHma = na
var float prevPLma = na

newPH = not na(ph)
newPL = not na(pl)
if newPH
    prevPH   := lastPH
    prevPHb  := lastPHb
    prevPHma := lastPHma
    lastPH   := ph
    lastPHb  := bar_index - pivLen
    lastPHma := sma20[pivLen]
    f_addZone(ph, ph - zoneW, true, lastPHb)
if newPL
    prevPL   := lastPL
    prevPLb  := lastPLb
    prevPLma := lastPLma
    lastPL   := pl
    lastPLb  := bar_index - pivLen
    lastPLma := sma20[pivLen]
    f_addZone(pl + zoneW, pl, false, lastPLb)

// Cambio de rol al cerrar al otro lado (Cap. 12: un máximo anterior pasa a ser soporte); segunda ruptura → se elimina
if zones.size() > 0
    for i = zones.size() - 1 to 0
        SRZone z = zones.get(i)
        bool broken = z.isRes ? close > z.top : close < z.bot
        if broken
            if z.flipped
                z.bx.delete()
                zones.remove(i)
            else
                z.isRes   := not z.isRes
                z.flipped := true
                [bg, bd] = f_zoneCol(z.isRes)
                z.bx.set_bgcolor(bg)
                z.bx.set_border_color(bd)

f_inZone(float price, bool wantRes) =>
    bool hit = false
    for z in zones
        if z.isRes == wantRes and price <= z.top + srTol and price >= z.bot - srTol
            hit := true
    hit

zoneSupL = f_inZone(low,  false)
zoneResS = f_inZone(high, true)

// Retrocesos del último tramo entre pivotes: alcista (mínimo → máximo) da soporte; bajista da resistencia
upLeg    = not na(lastPHb) and not na(lastPLb) and lastPHb > lastPLb
legRange = lastPH - lastPL
f_retr(float pct) =>
    upLeg ? lastPH - pct * legRange : lastPL + pct * legRange
r33 = f_retr(0.333)
r50 = f_retr(0.5)
r55 = f_retr(0.55)
fibSupL = legRange > 0 and upLeg     and low  <= r33 + srTol and low  >= r55 - srTol
fibResS = legRange > 0 and not upLeg and high >= r33 - srTol and high <= r55 + srTol

// Líneas de tendencia (Cap. 6 y 12): une los dos últimos pivotes con bajo más alto (alcista) o alto más bajo (bajista).
// Solo si la 20mm tiene la misma pendiente entre ambos pivotes ("la línea de tendencia suele coincidir con la 20mm").
// Se rompe al cerrar al otro lado por más de la tolerancia: se corta y queda tenue.
var line  tlUp     = na
var line  tlDn     = na
var bool  tlUpOn   = false
var bool  tlDnOn   = false
var float tlUpY    = na
var float tlDnY    = na
var int   tlUpX    = na
var int   tlDnX    = na
var float tlUpSlp  = na
var float tlDnSlp  = na

if showTL and newPL and not na(prevPL) and lastPL > prevPL and lastPLma > prevPLma and lastPLb > prevPLb
    tlUp.delete()
    tlUpX   := prevPLb
    tlUpY   := prevPL
    tlUpSlp := (lastPL - prevPL) / (lastPLb - prevPLb)
    tlUp    := line.new(prevPLb, prevPL, lastPLb, lastPL, extend=extend.right, color=cSup, width=2)
    tlUpOn  := true
if showTL and newPH and not na(prevPH) and lastPH < prevPH and lastPHma < prevPHma and lastPHb > prevPHb
    tlDn.delete()
    tlDnX   := prevPHb
    tlDnY   := prevPH
    tlDnSlp := (lastPH - prevPH) / (lastPHb - prevPHb)
    tlDn    := line.new(prevPHb, prevPH, lastPHb, lastPH, extend=extend.right, color=cRes, width=2)
    tlDnOn  := true

tlUpVal = tlUpOn ? tlUpY + tlUpSlp * (bar_index - tlUpX) : na
tlDnVal = tlDnOn ? tlDnY + tlDnSlp * (bar_index - tlDnX) : na

if tlUpOn and close < tlUpVal - srTol
    tlUp.set_extend(extend.none)
    tlUp.set_xy2(bar_index, tlUpVal)
    tlUp.set_color(color.new(cSup, 70))
    tlUp.set_style(line.style_dotted)
    tlUpOn := false
if tlDnOn and close > tlDnVal + srTol
    tlDn.set_extend(extend.none)
    tlDn.set_xy2(bar_index, tlDnVal)
    tlDn.set_color(color.new(cRes, 70))
    tlDn.set_style(line.style_dotted)
    tlDnOn := false

tlSupL = tlUpOn and math.abs(low  - tlUpVal) <= srTol
tlResS = tlDnOn and math.abs(high - tlDnVal) <= srTol

// ══ [7] LÓGICA DE DETECCIÓN — VELAS (FASE 1) ══

// Control (Cap. 1): fracción del color máximo alcanzado que fue borrada dentro de la vela
f_erased() =>
    float maxColor = isGreen ? high - open : isRed ? open - low : 0.0
    maxColor > 0 ? (isGreen ? high - close : close - low) / maxColor : na

f_controlText(float e) =>
    na(e) ? "Sin color" : e <= 0.0 ? "Absoluto" : e < weakPct ? "Bueno" : e < lostPct ? "Débil" : "Perdido"

erased = f_erased()

// Colas (Cap. 11.4)
lowerTail = math.min(open, close) - low
upperTail = high - math.max(open, close)
isBT = hasRng and lowerTail / rng >= tailPct
isTT = hasRng and upperTail / rng >= tailPct

// Vela Verde / Roja de Reversa (Cap. 11.1): borra 2/3 o más del color de la vela anterior de color contrario (regla 2/3, Cap. 1)
isGBR = isGreen and isRed[1]   and close >= close[1] + body[1] * lostPct and not isBT and not isTT
isRBR = isRed   and isGreen[1] and close <= close[1] - body[1] * lostPct and not isBT and not isTT

// Vela Elefante (Cap. 1, "WRB velas de cuerpo amplio"): cuerpo grande frente a las velas anteriores y sólido (la mayor parte del rango es color)
isBigRng  = hasRng and rng > ebMult * avgRng
isBigBody = hasRng and body > ebMult * avgBody and body >= ebBodyPct * rng
isBullEB  = isBigBody and isGreen and close >= high - rng * ebClosePct and not isBT and not isTT
isBearEB  = isBigBody and isRed   and close <= low  + rng * ebClosePct and not isBT and not isTT

// Rango estrecho / cuerpo estrecho (Cap. 11.2, 11.3)
isNRB = hasRng and rng < nrbMult * avgRng and not isBT and not isTT
isNB  = hasRng and body < nbMult * avgBody and not isNRB and not isBT and not isTT and not isBigRng

conf    = barstate.isconfirmed
sBullEB = showEB   and conf and isBullEB
sBearEB = showEB   and conf and isBearEB
sBT     = showTail and conf and isBT
sTT     = showTail and conf and isTT
sNRB    = showNRB  and conf and isNRB
sNB     = showNB   and conf and isNB

// Tendencias (Cap. 6)
sma8Up   = sma8   > sma8[1]
sma8Dn   = sma8   < sma8[1]
sma20Up  = sma20  > sma20[1]
sma20Dn  = sma20  < sma20[1]
sma200Up = sma200 > sma200[1]
sma200Dn = sma200 < sma200[1]

superBull = close > sma8  and sma8Up  and sma8 > sma20 and sma20Up
powerBull = close > sma20 and sma20Up and sma20 > sma200
regBull   = close > sma20 and sma20Up
superBear = close < sma8  and sma8Dn  and sma8 < sma20 and sma20Dn
powerBear = close < sma20 and sma20Dn and sma20 < sma200
regBear   = close < sma20 and sma20Dn

trendCode = superBull ? 3 : powerBull ? 2 : regBull ? 1 : superBear ? -3 : powerBear ? -2 : regBear ? -1 : 0
trendText = switch trendCode
    3  => "Súper alcista"
    2  => "Poder alcista"
    1  => "Alcista regular"
    -1 => "Bajista regular"
    -2 => "Poder bajista"
    -3 => "Súper bajista"
    =>    "Sin tendencia"

// ══ [7b] LÓGICA DE DETECCIÓN — SETUPS (FASE 2) ══
// Cada setup se evalúa en la vela de señal; el gatillo ocurre en la vela siguiente.

nearL = math.min(math.abs(low  - sma20), math.abs(low  - sma8)) <= locMult * atr
nearS = math.min(math.abs(high - sma20), math.abs(high - sma8)) <= locMult * atr
// Ubicaciones de soporte / resistencia (Cap. 12, formas 1-8)
maSupL   = nearL and (sma8Up or sma20Up)
maResS   = nearS and (sma8Dn or sma20Dn)
f200SupL = sma200Flat and math.abs(low  - sma200) <= srTol
f200ResS = sma200Flat and math.abs(high - sma200) <= srTol
pdcSupL  = isIntra and math.abs(low  - pdc) <= srTol and close >= pdc - srTol
pdcResS  = isIntra and math.abs(high - pdc) <= srTol and close <= pdc + srTol
farBelow = sma20 - close > climDist * atr
farAbove = close - sma20 > climDist * atr
srSupL   = zoneSupL or fibSupL or tlSupL or maSupL or f200SupL or pdcSupL or farBelow
srResS   = zoneResS or fibResS or tlResS or maResS or f200ResS or pdcResS or farAbove
srTxtL   = (zoneSupL ? "Zona " : "") + (fibSupL ? "Retroceso " : "") + (tlSupL ? "Línea tend. " : "") + (maSupL ? "MM " : "") + (f200SupL ? "200 plana " : "") + (pdcSupL ? "PDC " : "") + (farBelow ? "Lejos 20mm " : "")
srTxtS   = (zoneResS ? "Zona " : "") + (fibResS ? "Retroceso " : "") + (tlResS ? "Línea tend. " : "") + (maResS ? "MM " : "") + (f200ResS ? "200 plana " : "") + (pdcResS ? "PDC " : "") + (farAbove ? "Lejos 20mm " : "")

// Señales de piso / techo (Cap. 10.1, 11, 15): BT, GBR, NRB, NB / TT, RBR, NRB, NB
floorSig = isBT or isGBR or isNRB or isNB
topSig   = isTT or isRBR or isNRB or isNB

// VBS / VSS (Cap. 10.1): precio del lado de la 20mm a favor + retroceso de 3+ velas (2 en tendencia muy poderosa)
pullDn   = math.max(dnRun, redRun, nz(dnRun[1]), nz(redRun[1]))
pullUp   = math.max(upRun, greenRun, nz(upRun[1]), nz(greenRun[1]))
strongUp = sma8Up and sma20Up and sma8 > sma20
strongDn = sma8Dn and sma20Dn and sma8 < sma20
// Ubicación (Cap. 12, Reglas #1-#4): cualquiera de las 8 formas. Señal de piso: complemento (Cap. 10.1), salvo que se exija.
vbsL = onVBS and close > sma20 and sma20Up and pullDn >= (strongUp ? vbsMinStrong : vbsMin) and (not useLoc or srSupL) and (not vbsSig or floorSig)
vssS = onVBS and close < sma20 and sma20Dn and pullUp >= (strongDn ? vbsMinStrong : vbsMin) and (not useLoc or srResS) and (not vbsSig or topSig)

// Reversa 3-5 (Cap. 7, 11): señal de piso/techo tras 3-5 velas, sin ir contra la 20mm y en soporte/resistencia (Cap. 12)
revL = onREV and floorSig and ctxDown and trendCode >= 0 and (not useLoc or srSupL)
revS = onREV and topSig   and ctxUp   and trendCode <= 0 and (not useLoc or srResS)

// CDB / CAS (Cap. 15): 5+ velas, señal de reversa y lejos de la 20mm (contratendencia permitida)
cdbL = onCLIM and floorSig and prevDnRun >= climBars and sma20 - close > climDist * atr
casS = onCLIM and topSig   and prevUpRun >= climBars and close - sma20 > climDist * atr

// Obstáculo entre la entrada e y la distancia dist en la dirección d: resistencia si d = 1, soporte si d = -1 (formas del Cap. 12)
f_blocked(int d, float e, float dist) =>
    float lo  = d == 1 ? e : e - dist
    float hi  = d == 1 ? e + dist : e
    bool  hit = false
    for z in zones
        if z.isRes == (d == 1) and z.top >= lo and z.bot <= hi
            hit := true
    bool  fibHit = legRange > 0 and (d == 1 ? not upLeg : upLeg) and math.max(r33, r55) >= lo and math.min(r33, r55) <= hi
    float tl     = d == 1 ? tlDnVal : tlUpVal
    bool  tlHit  = not na(tl) and tl >= lo and tl <= hi
    bool  maHit  = ((d == 1 ? sma20Dn : sma20Up) and sma20 >= lo and sma20 <= hi) or ((d == 1 ? sma8Dn : sma8Up) and sma8 >= lo and sma8 <= hi)
    bool  f200   = sma200Flat and sma200 >= lo and sma200 <= hi
    bool  pdcHit = isIntra and not na(pdc) and pdc >= lo and pdc <= hi
    hit or fibHit or tlHit or maHit or f200 or pdcHit

// Momentum (Cap. 10.3): Elefante de ignición sin resistencia (soporte) inmediata delante; riesgo = rango de la Elefante
momBlkL = momRoom > 0 and f_blocked(1,  high + off, momRoom * (rng + 2 * off))
momBlkS = momRoom > 0 and f_blocked(-1, low  - off, momRoom * (rng + 2 * off))
momL = onMOM and isBullEB and prevUpRun < ctxMin and not momBlkL
momS = onMOM and isBearEB and prevDnRun < ctxMin and not momBlkS

// Toro / Oso 180 (Cap. 17.1): vela 1 muy bajista / muy alcista
v180L = on180 and hasRng and (not v180Big or rng > avgRng) and isRed   and body >= v180Body * rng and open >= high - rng * v180Ext and close <= low  + rng * v180Ext
v180S = on180 and hasRng and (not v180Big or rng > avgRng) and isGreen and body >= v180Body * rng and open <= low  + rng * v180Ext and close >= high - rng * v180Ext

// RBI / GBI (Cap. 17.2): vela 1 a favor + vela 2 contraria (esta es la vela de señal)
rbiL = onRBI and isRed   and isGreen[1] and (not rbiIdeal or (high <= high[1] and low  >= high[1] - rng[1] * 0.333)) and (not rbiTrend or trendCode >= 1)
gbiS = onRBI and isGreen and isRed[1]   and (not rbiIdeal or (low  >= low[1]  and high <= low[1]  + rng[1] * 0.333)) and (not rbiTrend or trendCode <= -1)

// BOP / BDP (Cap. 16): base ajustada de velas pequeñas con 8mm/20mm a favor
baseHi   = ta.highest(high, baseBars)
baseLo   = ta.lowest(low, baseBars)
baseMaxR = ta.highest(rng, baseBars)   // fuera del 'and': en v6 'and' es perezoso y ta.* debe ejecutarse en cada vela
baseOK   = baseHi - baseLo <= baseAtr * atr and baseMaxR <= avgRng
baseVolL = ta.sma(volume, baseBars) < ta.sma(volume, 20)
baseVolOK = not bopVolReq or baseVolL or nz(volume) == 0
bopL = onBOP and baseOK and baseVolOK and (sma8Up or sma20Up) and (not bop20Req or baseLo >= sma20 - locMult * atr)
bdpS = onBOP and baseOK and baseVolOK and (sma8Dn or sma20Dn) and (not bop20Req or baseHi <= sma20 + locMult * atr)

// Setup nuevo de esta vela, por prioridad
newSetL = cdbL ? "CDB" : v180L ? "+180" : rbiL ? "RBI" : bopL ? "BOP" : vbsL ? "VBS" : revL ? "REV" : momL ? "MOM" : ""
newSetS = casS ? "CAS" : v180S ? "-180" : gbiS ? "GBI" : bdpS ? "BDP" : vssS ? "VSS" : revS ? "REV" : momS ? "MOM" : ""

// Vigencia de la señal de piso/techo (Cap. 11.1-11.4: "la próxima vez que se viole el máximo de una vela anterior").
// Reversa y CDB/CAS siguen armadas holdBars velas más mientras no se activen ni se pierda el extremo de la vela de señal.
// Estado al cierre de la vela anterior (se actualiza en GATILLOS).
var string hNameL  = ""
var string hNameS  = ""
var int    hBarL   = na
var int    hBarS   = na
var float  sigLoL  = na      // mínimo de la vela de señal del setup largo armado
var float  sigHiS  = na      // máximo de la vela de señal del setup corto armado
var bool   sigNrbL = false   // la vela de señal es un NRB (stop del Cap. 11.3)
var bool   sigNrbS = false
holdL = holdBars > 0 and hNameL != "" and bar_index - hBarL <= holdBars and high < high[1] + off and low  >= sigLoL
holdS = holdBars > 0 and hNameS != "" and bar_index - hBarS <= holdBars and low  > low[1]  - off and high <= sigHiS

// Setup armado para la vela siguiente: el nuevo o, si no hay, el que sigue vigente
setL = newSetL != "" ? newSetL : holdL ? hNameL : ""
setS = newSetS != "" ? newSetS : holdS ? hNameS : ""
lvlL = setL == "" ? na : (setL == "BOP" ? baseHi : high) + off
lvlS = setS == "" ? na : (setS == "BDP" ? baseLo : low)  - off
// 2/3 temprano en la vela siguiente: VBS/VSS y ±180 (este último solo si hubo velas del mismo color antes de la vela 1)
redBefore   = nz(redRun[1])   >= 1
greenBefore = nz(greenRun[1]) >= 1
earlyOkL = earlyOn and (setL == "VBS" or (setL == "+180" and redBefore))
earlyOkS = earlyOn and (setS == "VSS" or (setS == "-180" and greenBefore))
// 2/3 temprano en la PROPIA vela de reversa (Cap. 11.1, 11.4): la BT/GBR (TT/RBR) recupera 2/3 de la vela anterior → entrada al cierre con TIF
tailEarlyL = earlyOn and (revL or cdbL) and (isBT or isGBR) and close >= high[1] - rng[1] * 0.333 and tifOK
tailEarlyS = earlyOn and (revS or casS) and (isTT or isRBR) and close <= low[1]  + rng[1] * 0.333 and tifOK

// Complementos de la vela de señal (informativos)
compL = (isBT ? "BT " : "") + (isGBR ? "GBR " : "") + (isNRB ? "NRB " : "") + (isNB ? "NB " : "") + (srTxtL != "" ? "| Soporte: " + srTxtL + "| " : "") + (volUp ? "Vol↑ " : "") + (nearRT ? "Hora RT " : "") + (sma20 > sma200 ? "20>200 " : "") + (setL == "BOP" and baseVolL ? "Base vol. baja " : "")
compS = (isTT ? "TT " : "") + (isRBR ? "RBR " : "") + (isNRB ? "NRB " : "") + (isNB ? "NB " : "") + (srTxtS != "" ? "| Resistencia: " + srTxtS + "| " : "") + (volUp ? "Vol↑ " : "") + (nearRT ? "Hora RT " : "") + (sma20 < sma200 ? "20<200 " : "") + (setS == "BDP" and baseVolL ? "Base vol. baja " : "")

// ══ GATILLOS ══
armL = lvlL[1]
armS = lvlS[1]

stdL   = not na(armL) and high >= armL
stdS   = not na(armS) and low  <= armS
// RBI / GBI: la vela 4 también puede gatillar si la vela 3 no lo hizo
rbi2L  = setL[2] == "RBI" and not stdL and high[1] < lvlL[2] and high >= lvlL[2]
gbi2S  = setS[2] == "GBI" and not stdS and low[1]  > lvlS[2] and low  <= lvlS[2]
earlyPL = earlyOkL[1] and not stdL and close >= high[1] - rng[1] * 0.333 and tifOK
earlyPS = earlyOkS[1] and not stdS and close <= low[1]  + rng[1] * 0.333 and tifOK
earlyTL = tailEarlyL and not stdL and not rbi2L and not earlyPL
earlyTS = tailEarlyS and not stdS and not gbi2S and not earlyPS
earlyL  = earlyPL or earlyTL
earlyS  = earlyPS or earlyTS

nameL   = rbi2L ? "RBI" : earlyTL ? (cdbL ? "CDB" : "REV") : setL[1]
nameS   = gbi2S ? "GBI" : earlyTS ? (casS ? "CAS" : "REV") : setS[1]
sigCompL = rbi2L ? compL[2] : earlyTL ? compL : compL[1]
sigCompS = gbi2S ? compS[2] : earlyTS ? compS : compS[1]
// Stop del NRB (Cap. 11.3): bajo el mínimo (sobre el máximo) del NRB que dio la señal en VBS/VSS, Reversa o CDB/CAS
nrbStopL = not earlyTL and not rbi2L and sigNrbL and (nameL == "VBS" or nameL == "REV" or nameL == "CDB") ? sigLoL - off : na
nrbStopS = not earlyTS and not gbi2S and sigNrbS and (nameS == "VSS" or nameS == "REV" or nameS == "CAS") ? sigHiS + off : na

// Filtros (Fase 4): sesión, volumen de la vela de señal, hora de reversa y tendencia del marco superior
rtNow   = nearRT or nearRT[1]
fltBase = sessOK and (not volReq or volUp[1]) and (not rtAll or rtNow)
// Cap. 12, Reglas #1-#4: la señal de piso/techo debe formarse en o cerca de una ubicación (vela de señal o vela actual)
srOkL   = not srReq or srSupL or srSupL[1]
srOkS   = not srReq or srResS or srResS[1]
fltL    = fltBase and srOkL and (not useHtf or htfTrend >= 0 or nameL == "CDB") and (not rtClim or nameL != "CDB" or rtNow)
fltS    = fltBase and srOkS and (not useHtf or htfTrend <= 0 or nameS == "CAS") and (not rtClim or nameS != "CAS" or rtNow)

var int lastL = na
var int lastS = na
// Cap. 15: tras una caída (avance) climática, la primera VSS (VBS) tiene bajas posibilidades → se omite
var bool afterCDB = false
var bool afterCAS = false
vbsCand = nameL == "VBS" and (stdL or earlyL) and fltL
vssCand = nameS == "VSS" and (stdS or earlyS) and fltS
skipL   = skipFirst and afterCAS and vbsCand
skipS   = skipFirst and afterCDB and vssCand
if vbsCand
    afterCAS := false
if vssCand
    afterCDB := false

longSig  = (stdL or rbi2L or earlyL) and fltL and not skipL and (na(lastL) or bar_index - lastL >= cooldown)
shortSig = (stdS or gbi2S or earlyS) and fltS and not skipS and (na(lastS) or bar_index - lastS >= cooldown)
if longSig and nameL == "CDB"
    afterCDB := true
if shortSig and nameS == "CAS"
    afterCAS := true

// Vigencia al cierre: cada setup nuevo fija la vela de señal (solo Reversa y CDB/CAS quedan vigentes);
// la activación, la pérdida del extremo de la señal, el fin del plazo o una entrada la cierran
if newSetL != ""
    sigLoL  := low
    sigNrbL := isNRB
    hNameL  := (newSetL == "REV" or newSetL == "CDB") and not longSig ? newSetL : ""
    hBarL   := bar_index
else if not holdL or longSig
    hNameL  := ""
if newSetS != ""
    sigHiS  := high
    sigNrbS := isNRB
    hNameS  := (newSetS == "REV" or newSetS == "CAS") and not shortSig ? newSetS : ""
    hBarS   := bar_index
else if not holdS or shortSig
    hNameS  := ""
entryL  = stdL ? math.max(armL, open) : rbi2L ? math.max(lvlL[2], open) : close
entryS  = stdS ? math.min(armS, open) : gbi2S ? math.min(lvlS[2], open) : close
methodL = earlyTL ? "2/3 con TIF en la vela de reversa" : earlyL ? "2/3 con TIF" : "Stop 100%"
methodS = earlyTS ? "2/3 con TIF en la vela de reversa" : earlyS ? "2/3 con TIF" : "Stop 100%"

// ══ [7c] GESTIÓN DE LA OPERACIÓN (FASE 3) ══
// Una operación virtual a la vez. Orden dentro de cada vela: stop → objetivos → break-even → trailing al cierre.

mlptDist = mlpdUsd > 0 ? mlpdUsd * mlptPct / (posQty * syminfo.pointvalue) : 0.0

// Stop inicial (Cap. 8, 8.1, 10.1, 11.3, 16, 17): evento (o NRB / base) → 2/3 si está muy lejos → MLPT si sigue siendo mayor
f_initStop(int d, string setup, float entry, float nrbLvl) =>
    float ext  = d == 1 ? low : high
    float prev = d == 1 ? math.min(low, low[1]) : math.max(high, high[1])
    float ev   = (setup == "MOM" ? prev : ext) - d * off
    bool  onBase = setup == "BDP" and bdpStopBase
    bool  onNrb  = not onBase and not na(nrbLvl) and (entry - nrbLvl) * d > 0
    string typ = "evento"
    if onBase
        ev  := baseHi[1] + off
        typ := "base"
    else if onNrb
        ev  := nrbLvl
        typ := "NRB"
    else if (entry - ev) * d < tooClose * atr
        ev := prev - d * off
    if not onBase and not onNrb and (entry - ev) * d > tooFar * atr
        // Retroceso de 2/3 de la vela de entrada; en Momentum, de la Elefante de ignición (vela anterior)
        float refH = setup == "MOM" ? high[1] : high
        float refL = setup == "MOM" ? low[1]  : low
        float s23  = (d == 1 ? refH - (refH - refL) * 0.667 : refL + (refH - refL) * 0.667) - d * off
        if (entry - s23) * d > 0 and (s23 - ev) * d > 0
            ev  := s23
            typ := "2/3"
    if mlptDist > 0 and (entry - ev) * d > mlptDist
        ev  := entry - d * mlptDist
        typ := "MLPT"
    [ev, typ]

[stopCandL, stopTypL] = f_initStop(1,  nameL, entryL, nrbStopL)
[stopCandS, stopTypS] = f_initStop(-1, nameS, entryS, nrbStopS)

// Objetivos (Cap. 10.1, 15, 16): T1 = 50% del retroceso, T2 = pivote anterior, T3 = proyección de la base (BOP/BDP)
pivHi  = ta.highest(high, swingLook)[1]
pivLo  = ta.lowest(low, swingLook)[1]
pullLo = ta.lowest(low,  nz(-ta.highestbars(high, swingLook)[1]) + 2)
pullHi = ta.highest(high, nz(-ta.lowestbars(low,  swingLook)[1]) + 2)
fibL   = pullLo + 0.5 * (pivHi - pullLo)
fibS   = pullHi - 0.5 * (pullHi - pivLo)
t1RawL = nameL == "CDB" ? math.min(sma20, fibL) : fibL
t1RawS = nameS == "CAS" ? math.max(sma20, fibS) : fibS
t3RawL = nameL == "BOP" ? entryL + (baseHi[1] - baseLo[1]) : na
t3RawS = nameS == "BDP" ? entryS - (baseHi[1] - baseLo[1]) : na

f_beyond(float t, float entry, int d) =>
    not na(t) and (t - entry) * d > 0 ? t : na

f_final(float t1, float t2, float t3) =>
    switch tgtMode
        "T1"              => nz(t1, nz(t2, t3))
        "T2"              => nz(t2, t3)
        "Último objetivo" => nz(t3, nz(t2, t1))
        => float(na)

var int    posDir   = 0
var float  posEntry = na
var float  posStop  = na
var float  posRisk  = na
var float  posT1    = na
var float  posT2    = na
var float  posT3    = na
var float  posTgt   = na
var string posSet   = ""
var string posTyp   = ""
var int    posBar   = na
var int    posAdv   = 0
var bool   posBE    = false
var bool   posTrail = false
var bool   posT1Hit = false
var bool   posT2Hit = false

flatAtStart = posDir == 0
stopAtStart = posStop
exitNow = false
exitPx  = float(na)
exitWhy = ""
hitT1   = false
hitT2   = false

if posDir != 0 and bar_index > posBar
    int   d   = posDir
    float fav = d == 1 ? high : low
    float adv = d == 1 ? low  : high
    if outSess
        exitNow := true
        exitPx  := open
        exitWhy := "Fuera de sesión"
    else if (adv - posStop) * d <= 0
        exitNow := true
        exitPx  := d == 1 ? math.min(posStop, open) : math.max(posStop, open)
        exitWhy := posTrail ? "Trailing" : posBE ? "Break-even" : "Stop " + posTyp
    else
        if not posT1Hit and not na(posT1) and (fav - posT1) * d >= 0
            posT1Hit := true
            hitT1    := true
        if not posT2Hit and not na(posT2) and (fav - posT2) * d >= 0
            posT2Hit := true
            hitT2    := true
        if not na(posTgt) and (fav - posTgt) * d >= 0
            exitNow := true
            exitPx  := d == 1 ? math.max(posTgt, open) : math.min(posTgt, open)
            exitWhy := "Objetivo"
    if not exitNow
        if beOn and not posBE and (fav - (posEntry + d * posRisk)) * d >= 0
            posBE   := true
            posStop := d == 1 ? math.max(posStop, posEntry) : math.min(posStop, posEntry)
        // Cierre de la vela: velas a favor y trailing
        posAdv += (close - close[1]) * d > 0 ? 1 : 0
        // Cap. 15: en CDB/CAS, break-even tras el avance de dos velas
        if climBE and (posSet == "CDB" or posSet == "CAS") and not posBE and posAdv >= 2
            posBE   := true
            posStop := d == 1 ? math.max(posStop, posEntry) : math.min(posStop, posEntry)
        if not posTrail and trailMode != "Ninguno" and posAdv >= (posSet == "MOM" ? 1 : 2)
            posTrail := true
        if posTrail
            if trailMode == "Vela a vela"
                posStop := d == 1 ? math.max(posStop, low - off) : math.min(posStop, high + off)
                // Salidas por setup: Cap. 15 (CDB/CAS: solo una RBR/GBR mayor), Cap. 17.2 (RBI/GBI: solo el trailing), Cap. 10.1 (resto)
                bool exhaust = switch posSet
                    "CDB" => isRBR
                    "CAS" => isGBR
                    "RBI" => false
                    "GBI" => false
                    => d == 1 ? (isTT or isBullEB or (isRed and close < low[1] + rng[1] * 0.5)) : (isBT or isBearEB or (isGreen and close > high[1] - rng[1] * 0.5))
                if exhaustOn and exhaust
                    exitNow := true
                    exitPx  := close
                    exitWhy := "Agotamiento"
            else
                float ma = trailMode == "8mm" ? sma8 : sma20
                if (close - ma) * d < 0
                    exitNow := true
                    exitPx  := close
                    exitWhy := "Cierre al otro lado de la " + trailMode
    if not exitNow and eodNow
        exitNow := true
        exitPx  := close
        exitWhy := "Cierre de sesión"

exitD = posDir
exitR = exitNow ? (exitPx - posEntry) * exitD / posRisk : na

// Estadísticas (Fase 4): por setup y totales, en R
var map<string, int>   stCnt  = map.new<string, int>()
var map<string, int>   stWin  = map.new<string, int>()
var map<string, float> stSum  = map.new<string, float>()
var int   totCnt = 0
var int   totWin = 0
var float totR   = 0.0
var float grossW = 0.0
var float grossL = 0.0
var float peakR  = 0.0
var float maxDD  = 0.0

if exitNow
    string k = posSet == "REV" or posSet == "MOM" ? posSet + (exitD == 1 ? " ▲" : " ▼") : posSet
    stCnt.put(k, nz(stCnt.get(k)) + 1)
    stWin.put(k, nz(stWin.get(k)) + (exitR > 0 ? 1 : 0))
    stSum.put(k, nz(stSum.get(k)) + exitR)
    totCnt += 1
    totWin += exitR > 0 ? 1 : 0
    totR   += exitR
    grossW += math.max(exitR, 0)
    grossL += math.max(-exitR, 0)
    peakR  := math.max(peakR, totR)
    maxDD  := math.max(maxDD, peakR - totR)
    posDir := 0

// Nueva entrada solo si no había posición al inicio de la vela
takeL = longSig  and flatAtStart
takeS = shortSig and flatAtStart and not takeL

if takeL or takeS
    int   d  = takeL ? 1 : -1
    float e  = takeL ? entryL : entryS
    float st = takeL ? stopCandL : stopCandS
    float t1 = f_beyond(takeL ? t1RawL : t1RawS, e, d)
    float t2 = f_beyond(takeL ? pivHi  : pivLo,  e, d)
    float t3 = f_beyond(takeL ? t3RawL : t3RawS, e, d)
    posDir   := d
    posEntry := e
    posStop  := st
    posRisk  := math.max((e - st) * d, syminfo.mintick)
    posTyp   := takeL ? stopTypL : stopTypS
    posSet   := takeL ? nameL : nameS
    posT1    := t1
    posT2    := t2
    posT3    := t3
    posTgt   := f_final(t1, t2, t3)
    posBar   := bar_index
    posAdv   := (close - e) * d > 0 ? 1 : 0
    posBE    := false
    posTrail := false
    posT1Hit := false
    posT2Hit := false

// ══ [8] GESTIÓN DE OBJETOS ══
txtSz  = txtSize == "Diminuto" ? size.tiny : txtSize == "Pequeño" ? size.small : size.normal
useBox = entryStyle == "Caja"

// Señal visible = tomada, o cualquiera si no se ocultan con posición abierta. Solo las visibles cuentan para la separación y las alertas.
showL = longSig  and (takeL or not hideInPos)
showS = shortSig and (takeS or not hideInPos)

if showL
    lastL := bar_index
    if showEntries
        label.new(bar_index, low, useBox ? nameL : "▲\n" + nameL, yloc=yloc.belowbar,
             style=useBox ? label.style_label_up : label.style_none, color=useBox ? colBull : color(na),
             textcolor=useBox ? color.white : colBull, size=txtSz,
             tooltip="Largo: " + nameL + "\nEntrada: " + str.tostring(entryL, format.mintick) + " (" + methodL + ")\nStop: " + str.tostring(stopCandL, format.mintick) + " (" + stopTypL + ")\nComplementos: " + sigCompL)
if showS
    lastS := bar_index
    if showEntries
        label.new(bar_index, high, useBox ? nameS : nameS + "\n▼", yloc=yloc.abovebar,
             style=useBox ? label.style_label_down : label.style_none, color=useBox ? colBear : color(na),
             textcolor=useBox ? color.white : colBear, size=txtSz,
             tooltip="Corto: " + nameS + "\nEntrada: " + str.tostring(entryS, format.mintick) + " (" + methodS + ")\nStop: " + str.tostring(stopCandS, format.mintick) + " (" + stopTypS + ")\nComplementos: " + sigCompS)

if showTrade
    if hitT1
        label.new(bar_index, posT1, "T1", style=label.style_none, textcolor=colTgt, size=txtSz)
    if hitT2
        label.new(bar_index, posT2, "T2", style=label.style_none, textcolor=colTgt, size=txtSz)
    if exitNow
        label.new(bar_index, exitPx, "✕ " + str.tostring(exitR, "+#.#;-#.#") + "R", style=label.style_label_left,
             color=color(na), textcolor=exitR >= 0 ? colTgt : colStop, size=txtSz,
             tooltip=exitWhy + "\nSalida: " + str.tostring(exitPx, format.mintick) + "\nResultado: " + str.tostring(exitR, "+#.##;-#.##") + "R")

// ══ [9] PLOTS ══
plot(showMAs ? sma8   : na, "8mm",   color=#FF9800, linewidth=1)
plot(showMAs ? sma20  : na, "20mm",  color=#2962FF, linewidth=2)
plot(showMAs ? sma200 : na, "200mm", color=sma200Flat ? c200F : c200, linewidth=3)

// Día anterior (Fase 5): cierre (PDC) y, opcionalmente, máximo y mínimo
plot(showPDC  and isIntra ? pdc : na, "Cierre día anterior", color=cPDC, style=plot.style_stepline, linewidth=1)
plot(showPDHL and isIntra ? pdh : na, "Máximo día anterior", color=color.new(cPDC, 50), style=plot.style_stepline, linewidth=1)
plot(showPDHL and isIntra ? pdl : na, "Mínimo día anterior", color=color.new(cPDC, 50), style=plot.style_stepline, linewidth=1)

// Retrocesos 33% / 50% / 55% del último tramo (Fase 5): soporte en tramo alcista, resistencia en tramo bajista
var line[]  fibLines = array.new<line>()
var label[] fibLbls  = array.new<label>()
if barstate.islast
    for ln in fibLines
        ln.delete()
    for lb in fibLbls
        lb.delete()
    fibLines.clear()
    fibLbls.clear()
    if showFib and legRange > 0
        color fc = upLeg ? cSup : cRes
        int   x1 = upLeg ? lastPHb : lastPLb
        float lv = 0.0
        for [i, p] in array.from(0.333, 0.5, 0.55)
            lv := f_retr(p)
            fibLines.push(line.new(x1, lv, bar_index + 5, lv, color=color.new(fc, i == 0 ? 50 : 20), style=line.style_dashed, width=1))
            fibLbls.push(label.new(bar_index + 5, lv, str.tostring(p * 100, "#") + "%", style=label.style_label_left, color=color(na), textcolor=fc, size=size.tiny))

// Operación abierta: entrada, stop activo durante la vela y objetivos
inTrade = showTrade and (posDir != 0 or exitNow)
plot(inTrade ? posEntry : na, "Entrada", color=colEntry, style=plot.style_linebr, linewidth=1)
plot(inTrade ? (flatAtStart ? posStop : stopAtStart) : na, "Stop", color=colStop, style=plot.style_linebr, linewidth=2)
plot(inTrade ? posT1 : na, "T1", color=color.new(colTgt, 40), style=plot.style_linebr, linewidth=1)
plot(inTrade ? posT2 : na, "T2", color=colTgt, style=plot.style_linebr, linewidth=1)
plot(inTrade ? posT3 : na, "T3", color=colTgt, style=plot.style_linebr, linewidth=2)

plot(showPending ? armL : na, "Compra pendiente", color=color.new(colBull, 40), style=plot.style_circles, linewidth=1)
plot(showPending ? armS : na, "Venta pendiente",  color=color.new(colBear, 40), style=plot.style_circles, linewidth=1)

// Marcas con el mismo color que el pintado: fuerte si la vela aparece tras 3-5 velas en contra; tenue si no
ctxAny = ctxDown or ctxUp
colBT  = ctxDown ? cBTp  : color.new(cBTp, 55)
colTT  = ctxUp   ? cTTp  : color.new(cTTp, 55)
colNR  = ctxAny  ? cNRBp : color.new(cNRBp, 55)
colNBm = ctxAny  ? cNBp  : color.new(cNBp, 55)

plotshape(sBullEB, "Elefante alcista", shape.labelup,      location.belowbar, cEBUp,  text="EB",  textcolor=color.white, size=size.tiny)
plotshape(sBearEB, "Elefante bajista", shape.labeldown,    location.abovebar, cEBDn,  text="EB",  textcolor=color.white, size=size.tiny)
plotshape(sBT,     "Cola de Piso BT",  shape.triangleup,   location.belowbar, colBT,  text="BT",  textcolor=colBT,  size=size.tiny)
plotshape(sTT,     "Cola de Techo TT", shape.triangledown, location.abovebar, colTT,  text="TT",  textcolor=colTT,  size=size.tiny)
plotshape(sNRB,    "NRB",              shape.diamond,      location.abovebar, colNR,  text="NRB", textcolor=colNR,  size=size.tiny)
plotshape(sNB,     "NB",               shape.circle,       location.abovebar, colNBm, text="NB",  textcolor=colNBm, size=size.tiny)

bgcolor(showTrendBg ? (trendCode > 0 ? color.new(colBull, 92) : trendCode < 0 ? color.new(colBear, 92) : na) : na, title="Fondo tendencia")
bgcolor(rtShow and exactRT ? color.new(#FFD600, 88) : na, title="Hora de reversa")

// Pintar velas: setups Velez y patrones de vela (BT/TT > GBR/RBR > Elefante > NRB > NB); el resto, según tendencia
f_setCol(string s, int d) =>
    switch s
        "VBS"  => spVBS ? cVBS : color(na)
        "VSS"  => spVBS ? cVSS : color(na)
        "REV"  => spREV ? (d == 1 ? cREVL : cREVS) : color(na)
        "CDB"  => spCLI ? cCDB : color(na)
        "CAS"  => spCLI ? cCAS : color(na)
        "MOM"  => spMOM ? (d == 1 ? cMOML : cMOMS) : color(na)
        "+180" => sp180 ? c180L : color(na)
        "-180" => sp180 ? c180S : color(na)
        "RBI"  => spRBI ? cRBI : color(na)
        "GBI"  => spRBI ? cGBI : color(na)
        "BOP"  => spBOP ? cBOP : color(na)
        "BDP"  => spBOP ? cBDP : color(na)
        =>        color(na)

patOK    = conf or not paintConf
patCol   = not patOK ? color(na) : pTail and isBT ? cBTp : pTail and isTT ? cTTp : pGBR and isGBR ? cGBRp : pGBR and isRBR ? cRBRp : pEB and isBullEB ? cEBUp : pEB and isBearEB ? cEBDn : pNRB and isNRB ? cNRBp : pNB and isNB ? cNBp : color(na)
setColL  = spBar == "Vela de señal" ? f_setCol(newSetL, 1)  : showL ? f_setCol(nameL, 1)  : color(na)
setColS  = spBar == "Vela de señal" ? f_setCol(newSetS, -1) : showS ? f_setCol(nameS, -1) : color(na)
setCol   = not patOK ? color(na) : not na(setColL) ? setColL : setColS
firstCol = spPrio ? setCol : patCol
nextCol  = spPrio ? patCol : setCol
trendCol = color.new(trendCode > 0 ? colBull : trendCode < 0 ? colBear : colNeut, trTransp)
paintCol = not paintOn ? color(na) : not na(firstCol) ? firstCol : not na(nextCol) ? nextCol : pTrend ? trendCol : color(na)
doBody   = paintMode == "Solo cuerpo" and not na(paintCol)

plotcandle(doBody ? open : na, doBody ? high : na, doBody ? low : na, doBody ? close : na, "Cuerpo pintado",
     color=paintCol, wickcolor=color.new(color.black, 100), bordercolor=paintCol, editable=false)
barcolor(paintMode == "Vela completa" ? paintCol : na, title="Vela pintada")

// ══ [10] ALERTAS ══
alertcondition(isBullEB and conf, "Elefante alcista", "{{ticker}} {{interval}} — Vela Elefante alcista @ {{close}}")
alertcondition(isBearEB and conf, "Elefante bajista", "{{ticker}} {{interval}} — Vela Elefante bajista @ {{close}}")
alertcondition(isBT and conf,     "Cola de Piso BT",  "{{ticker}} {{interval}} — Cola de Piso (BT) @ {{close}}")
alertcondition(isTT and conf,     "Cola de Techo TT", "{{ticker}} {{interval}} — Cola de Techo (TT) @ {{close}}")
alertcondition(isNRB and conf,    "NRB",              "{{ticker}} {{interval}} — Vela de Rango Estrecho (NRB) @ {{close}}")
alertcondition(isNB and conf,     "NB",               "{{ticker}} {{interval}} — Cuerpo Estrecho (NB) @ {{close}}")
alertcondition(showL,             "Entrada larga",    "{{ticker}} {{interval}} — Entrada LARGA Velez @ {{close}}")
alertcondition(showS,             "Entrada corta",    "{{ticker}} {{interval}} — Entrada CORTA Velez @ {{close}}")
alertcondition(hitT1 or hitT2,    "Objetivo tocado",  "{{ticker}} {{interval}} — Objetivo (T1/T2) tocado @ {{close}}")
alertcondition(exitNow,           "Salida",           "{{ticker}} {{interval}} — Salida de la operación @ {{close}}")

// ══ [11] DASHBOARD ══
f_side(float ma) =>
    close > ma ? "Precio encima" : close < ma ? "Precio debajo" : "En la media"

f_slope(bool up, bool dn) =>
    up ? "▲" : dn ? "▼" : "▬"

f_pending(string src, float lvl) =>
    na(lvl) ? "—" : src + " @ " + str.tostring(lvl, format.mintick)

f_px(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

var table dash = table.new(position.top_right, 2, 11, bgcolor=color.new(#1a1a2e, 10), border_width=1, border_color=color.new(color.gray, 70))
if showDash and barstate.islast
    color  tCol      = trendCode > 0 ? colBull : trendCode < 0 ? colBear : colNeut
    string candleTxt = isBT ? "BT" : isTT ? "TT" : isGBR ? "GBR" : isRBR ? "RBR" : isBullEB ? "Elefante ▲" : isBearEB ? "Elefante ▼" : isNRB ? "NRB" : isNB ? "NB" : "—"
    table.cell(dash, 0, 0, "Oliver Velez", text_color=#FFD700, text_size=txtSz)
    bool tfOper = tfSec == 60 or tfSec == 120 or tfSec == 300
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period + (tfOper ? "" : " (no operativo)"), text_color=tfOper ? color.white : #FFD600, text_size=txtSz,
         tooltip="Cap. 3: marcos operativos 1, 2 y 5 min. 15 min, 60 min y Diario son de análisis.")
    table.cell(dash, 0, 1, "Tendencia", text_color=color.gray, text_size=txtSz)
    table.cell(dash, 1, 1, trendText, text_color=tCol, text_size=txtSz)
    table.cell(dash, 0, 2, "8mm " + f_slope(sma8Up, sma8Dn), text_color=#FF9800, text_size=txtSz)
    table.cell(dash, 1, 2, f_side(sma8), text_color=color.white, text_size=txtSz)
    table.cell(dash, 0, 3, str.tostring(smaMedLen) + "mm " + f_slope(sma20Up, sma20Dn), text_color=#2962FF, text_size=txtSz)
    table.cell(dash, 1, 3, f_side(sma20), text_color=color.white, text_size=txtSz)
    table.cell(dash, 0, 4, "200mm " + (sma200Flat ? "▬ plana" : f_slope(sma200Up, sma200Dn)), text_color=sma200Flat ? c200F : c200, text_size=txtSz,
         tooltip="Cap. 5 y 12: la 200mm plana es el soporte/resistencia más fiable ('la planitud es el rey').")
    table.cell(dash, 1, 4, f_side(sma200), text_color=color.white, text_size=txtSz)
    table.cell(dash, 0, 5, "Vela actual", text_color=color.gray, text_size=txtSz)
    table.cell(dash, 1, 5, candleTxt + " | Control " + f_controlText(erased), text_color=color.white, text_size=txtSz)
    table.cell(dash, 0, 6, "Compra pend.", text_color=colBull, text_size=txtSz)
    table.cell(dash, 1, 6, f_pending(setL[1], armL), text_color=color.white, text_size=txtSz)
    table.cell(dash, 0, 7, "Venta pend.", text_color=colBear, text_size=txtSz)
    table.cell(dash, 1, 7, f_pending(setS[1], armS), text_color=color.white, text_size=txtSz)
    string posTxt  = posDir == 0 ? "—" : (posDir == 1 ? "Largo " : "Corto ") + posSet + " @ " + f_px(posEntry) + " | " + str.tostring((close - posEntry) * posDir / posRisk, "+#.#;-#.#") + "R"
    string stopTxt = posDir == 0 ? "—" : f_px(posStop) + (posTrail ? " (trail)" : posBE ? " (BE)" : "") + " | Obj " + f_px(posTgt)
    table.cell(dash, 0, 8, "Posición", text_color=color.gray, text_size=txtSz)
    table.cell(dash, 1, 8, posTxt, text_color=posDir == 1 ? colBull : posDir == -1 ? colBear : color.white, text_size=txtSz)
    table.cell(dash, 0, 9, "Stop | Obj.", text_color=color.gray, text_size=txtSz)
    table.cell(dash, 1, 9, stopTxt, text_color=color.white, text_size=txtSz)
    string fltTxt = (not useSess or not isIntra ? "Sesión —" : sessOK ? "Sesión ✓" : "Sesión ✗") + (useHtf ? " | " + htfTf + " " + f_slope(htfTrend > 0, htfTrend < 0) : "") + (nearRT ? " | Hora RT" : "")
    table.cell(dash, 0, 10, "Filtros", text_color=color.gray, text_size=txtSz)
    table.cell(dash, 1, 10, fltTxt, text_color=color.white, text_size=txtSz)

// ══ [11b] ESTADÍSTICAS ══
var keysOrder = array.from("VBS", "VSS", "REV ▲", "REV ▼", "CDB", "CAS", "MOM ▲", "MOM ▼", "+180", "-180", "RBI", "GBI", "BOP", "BDP")
statLoc = statPos == "Abajo izquierda" ? position.bottom_left : statPos == "Arriba izquierda" ? position.top_left : position.bottom_right
var table stats = table.new(statLoc, 5, 17, bgcolor=color.new(#1a1a2e, 10), border_width=1, border_color=color.new(color.gray, 70))

f_statRow(int row, string name, int n, int w, float r, color c) =>
    table.cell(stats, 0, row, name, text_color=c, text_size=txtSz)
    table.cell(stats, 1, row, str.tostring(n), text_color=color.white, text_size=txtSz)
    table.cell(stats, 2, row, n > 0 ? str.tostring(100.0 * w / n, "#") + "%" : "—", text_color=color.white, text_size=txtSz)
    table.cell(stats, 3, row, str.tostring(r, "+#.#;-#.#"), text_color=r >= 0 ? colTgt : colStop, text_size=txtSz)
    table.cell(stats, 4, row, n > 0 ? str.tostring(r / n, "+#.##;-#.##") : "—", text_color=color.white, text_size=txtSz)

if showStats and barstate.islast
    table.clear(stats, 0, 0, 4, 16)
    table.cell(stats, 0, 0, "Setup",  text_color=#FFD700, text_size=txtSz)
    table.cell(stats, 1, 0, "Ops",    text_color=#FFD700, text_size=txtSz)
    table.cell(stats, 2, 0, "% Gan.", text_color=#FFD700, text_size=txtSz)
    table.cell(stats, 3, 0, "R total", text_color=#FFD700, text_size=txtSz)
    table.cell(stats, 4, 0, "R prom.", text_color=#FFD700, text_size=txtSz)
    f_statRow(1, "Total", totCnt, totWin, totR, color.white)
    int row = 2
    for k in keysOrder
        int n = nz(stCnt.get(k))
        if n > 0
            f_statRow(row, k, n, nz(stWin.get(k)), nz(stSum.get(k)), color.gray)
            row += 1
    table.cell(stats, 0, row, "F. benef.", text_color=color.gray, text_size=txtSz, tooltip="Factor de beneficio: suma de R ganados / suma de R perdidos.")
    table.cell(stats, 1, row, grossL > 0 ? str.tostring(grossW / grossL, "#.##") : "—", text_color=color.white, text_size=txtSz)
    table.cell(stats, 2, row, "Caída máx.", text_color=color.gray, text_size=txtSz, tooltip="Mayor caída desde un máximo de la curva de R acumulados.")
    table.cell(stats, 3, row, str.tostring(maxDD, "#.#") + "R", text_color=colStop, text_size=txtSz)
