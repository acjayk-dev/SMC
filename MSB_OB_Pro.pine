//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// MSB-OB PRO v1.0 — Market Structure Break & Order Blocks (reingeniería institucional)
// ───────────────────────────────────────────────────────────────────────────────────────────────
// Reescritura completa del concepto original "Market Structure Break & Order Block" de © EmreKb
// (MPL-2.0, Pine v5). Se conserva la TESIS —pivotes zigzag → ruptura de estructura → Order Block,
// Breaker y Mitigation Block— y se reconstruye toda la implementación.
//
// TF óptimo: 1 / 2 / 5 min intradía · Activo objetivo: futuros MNQ / MES (funciona en cualquier
// instrumento con volumen real; los filtros de volumen se auto-desactivan si el feed no lo trae).
//
// ── QUÉ SE CORRIGIÓ RESPECTO DEL ORIGINAL ─────────────────────────────────────────────────────
//  [R1] REPINTADO TOTAL. `to_up = high >= ta.highest(zigzag_len)` incluye la vela EN CURSO, así que
//       `trend` volteaba intrabar y volvía atrás; ningún estado estaba tras barstate.isconfirmed.
//       Pivotes, líneas, cajas y el propio MSB se redibujaban tick a tick. Aquí TODO el estado
//       persistente muta solo en vela cerrada, y los pivotes usan ta.pivothigh/low (confirmación
//       de dos lados) que por construcción no puede revisarse hacia atrás.
//  [R2] ARRAYS SEMILLA. `array.new_float(5)` NO crea un array vacío: crea 5 elementos en na/0. Con
//       menos de 2 pivotes reales, f_get_high/f_get_low devolvían na o 0, y `l0i = 0` alimentaba
//       `for i = h1i to l0i[zigzag_len]` con rangos de miles de barras — origen del clásico error
//       "loop is too long" y de cajas ancladas en la barra 0. Aquí los arrays nacen vacíos y todo
//       acceso está protegido por un if explícito (Pine NO garantiza cortocircuito en and/or, y un
//       array.get fuera de rango es error de runtime, no na).
//  [R3] BORRADO DE LA CAJA EQUIVOCADA. `f_delete_box` hacía array.shift() — elimina SIEMPRE el
//       elemento 0, no el que disparó la condición. Y se llamaba DENTRO de `for x in arr`, mutando
//       el array que se estaba recorriendo. Aquí se recorre por índice descendente y se elimina
//       exactamente el índice evaluado.
//  [R4] FUGA DE CAJAS. Con "Delete Old/Broken Boxes" en OFF, el original hacía array.shift() sin
//       box.delete(): la caja salía del array pero seguía viva en el gráfico, sin nadie que la
//       gestionara, hasta que max_boxes_count descartaba en silencio la más antigua. Aquí el ciclo
//       de vida es explícito: extender → 50% → mitigar → (breaker | expirar) → destruir.
//  [R5] RAMA `else if` PERDIDA. En el bucle bajista faltaba el `else`: con close > top la caja se
//       borraba Y ADEMÁS alertaba (close > top implica close > bottom). Asimétrico con las otras 3.
//  [R6] SPAM DE ALERTAS. `alert()` dentro del bucle se disparaba en CADA barra mientras el precio
//       estuviera en la zona. Aquí cada zona alerta una vez por entrada, con cooldown configurable.
//  [R7] TODO ERA "MSB". El original no distinguía continuación de reversión. BOS y CHoCH significan
//       cosas OPUESTAS: BOS confirma el régimen, CHoCH advierte de que se acabó. Se clasifican.
//  [R8] SEÑAL TARDÍA. El `market` del original volteaba comparando PIVOTES (h0 vs h1), así que el
//       MSB aparecía ~zigzag_len barras DESPUÉS de la ruptura real. Aquí la ruptura se evalúa sobre
//       el CIERRE contra el nivel del pivote confirmado: mismo rigor, pivLen barras antes.
//  [R9] COMPARACIÓN DE FLOATS PARA RECUPERAR ÍNDICES. `ta.barssince(low_val == low)` es frágil
//       (igualdad exacta entre floats y ambigüedad si el valor se repite). Los pivotes guardan su
//       bar_index real en el momento de confirmarse.
// [R10] ORDER BLOCK SIN CRITERIO. Tomaba la última vela de color opuesto, fuese un doji sin cuerpo
//       o una vela climática de pánico. Se añaden filtros de cuerpo mínimo y de rango máximo.
// [R11] SIN CONTEXTO NI GESTIÓN. Se añaden: sesgo HTF sin repintado, filtro de sesión/Kill Zone,
//       umbral medio 50% (mean threshold ICT), conversión OB→Breaker, señales con SL/TP y sizing,
//       dashboard y payload JSON para automatización.
//
// Licencia MPL-2.0 heredada del trabajo original de © EmreKb.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

indicator("MSB-OB Pro v1.0 · Market Structure & Order Blocks", shorttitle="MSB-OB Pro",
     overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ TIPOS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Una Zone es cualquier POI rectangular nacido de una ruptura de estructura: Order Block, Breaker
// Block o Mitigation Block. Comparten ciclo de vida, así que comparten tipo y un único array.
type Zone
    box    id
    line   mid
    float  top
    float  bottom
    float  mean
    bool   isBull          // dirección OPERATIVA actual — un breaker la invierte respecto al nacimiento
    int    birthBar
    string kind            // "OB" · "BB" · "MB"
    bool   mitigated
    bool   halfHit
    bool   flipped         // ya se convirtió en breaker una vez (no se vuelve a voltear)
    bool   hasFVG          // hay un FVG solapado = modelo Unicorn de ICT
    int    lastAlertBar

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ INPUTS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

gStr = "① 📐 ESTRUCTURA (ZigZag · BOS/CHoCH)"
gZon = "② 📦 ZONAS (OB · Breaker · Mitigation)"
gSig = "③ 🎯 SEÑALES Y RIESGO"
gCtx = "④ 🧭 CONTEXTO (HTF · Sesión)"
gVis = "⑤ 🎨 VISUAL"
gAlr = "⑥ 🔔 ALERTAS"

// ── ① Estructura ──────────────────────────────────────────────────────────────────────────────
pivLen        = input.int(9, "ZigZag Length (pivote)", minval=2, maxval=50, group=gStr, tooltip="Barras a cada lado que debe dominar una vela para ser pivote. 9 en 5min ≈ 45min de confirmación por lado. Bajarlo da más estructura (y más ruido); subirlo deja solo los giros mayores.")
showZigZag    = input.bool(true, "Mostrar ZigZag", group=gStr)
breakBufferFib= input.float(0.10, "Buffer de ruptura (× rango del leg)", minval=0.0, maxval=1.0, step=0.01, group=gStr, tooltip="El cierre debe superar el nivel del pivote por al menos esta fracción del rango del leg. Filtra el pinchazo marginal. NOTA: el original usaba 0.33, pero medía PIVOTE contra PIVOTE (varias barras después); sobre un modelo de ruptura por cierre ese valor es desproporcionado. 0.10 es el equivalente razonable. 0 = solo exige el cierre más allá.")
useDisplacement= input.bool(true, "Exigir desplazamiento en la ruptura", group=gStr, tooltip="La vela que rompe debe tener cuerpo ≥ (× ATR) y cerrar a favor. Una ruptura institucional se produce con expansión, no por deriva lenta. Separa el BOS real del goteo.")
dispAtrMult   = input.float(0.7, "Desplazamiento (× ATR)", minval=0.1, step=0.1, group=gStr)
useVolBreak   = input.bool(true, "Exigir volumen en la ruptura", group=gStr, tooltip="La vela de ruptura debe superar el volumen medio × el factor. Se auto-ignora si el feed del símbolo no publica volumen.")
volBreakMult  = input.float(1.2, "Volumen ruptura (× media)", minval=1.0, step=0.1, group=gStr)
bosCooldown   = input.int(3, "Barras mínimas entre rupturas", minval=0, maxval=50, group=gStr, tooltip="Evita una ráfaga de BOS encadenados dentro del mismo impulso.")
showStrongWeak= input.bool(true, "Mostrar Strong / Weak High-Low", group=gStr, tooltip="Clasifica el extremo estructural vigente por lo que el mercado HIZO con él. STRONG = no logró romperlo → liquidez PROTEGIDA, el imán real. WEAK = ya barrido → liquidez consumida. Se opera EN DIRECCIÓN del extremo Strong.")

// ── ② Zonas ───────────────────────────────────────────────────────────────────────────────────
showZones     = input.bool(true, "Mostrar zonas", group=gZon)
obSearchBars  = input.int(20, "Búsqueda del origen (barras)", minval=3, maxval=60, group=gZon, tooltip="Cuántas barras hacia atrás desde la ruptura se buscan para anclar el Order Block en la última vela de color OPUESTO al impulso.")
obMinBodyAtr  = input.float(0.20, "Origen: cuerpo mínimo (× ATR)", minval=0.0, step=0.05, group=gZon, tooltip="La vela de origen debe tener CUERPO real. Un Order Block nace de un desequilibrio de órdenes y un doji no lo representa: si la opuesta más cercana es un doji, se salta y se busca la siguiente. 0 = desactivado (comportamiento del original).")
obMaxRangeAtr = input.float(2.0, "Origen: rango máximo (× ATR)", minval=0.0, step=0.5, group=gZon, tooltip="La vela de origen no puede ser CLIMÁTICA. Un rango extremo es capitulación —liquidación de posiciones—, no colocación institucional; anclar ahí produce una zona enorme y difusa que el precio 'mitiga' de inmediato. 0 = desactivado.")
mitByWick     = input.bool(false, "Mitigar por mecha (no por cierre)", group=gZon, tooltip="OFF (institucional): la zona solo se invalida si el precio CIERRA más allá — una mecha que la perfora y vuelve dentro es un BARRIDO de liquidez, no una invalidación. ON: cualquier mecha la invalida (más conservador, menos zonas vivas).")
showMean      = input.bool(true, "Marcar umbral medio (50% CE)", group=gZon, tooltip="Consequent Encroachment de ICT: el 50% de la zona es el punto de entrada de mayor calidad dentro del POI.")
enableBreaker = input.bool(true, "Convertir zona violada en Breaker", group=gZon, tooltip="Una zona rota mientras la estructura va en contra no muere: invierte su papel (soporte→resistencia). Es el Breaker Block real de ICT. OFF: la zona violada se marca como mitigada y punto.")
removeMitig   = input.bool(false, "Borrar zonas mitigadas", group=gZon, tooltip="OFF: la zona mitigada se atenúa pero permanece como referencia histórica. ON: se elimina del gráfico.")
zoneMaxAge    = input.int(120, "Edad máxima de zona (barras)", minval=0, maxval=1000, group=gZon, tooltip="En 5min, 120 barras = 10 horas. Una zona sin tocar durante toda una sesión ya no representa órdenes vivas. 0 = sin caducidad.")
maxZones      = input.int(12, "Máx. zonas activas", minval=2, maxval=40, group=gZon, tooltip="Tope global. Al superarlo se descarta la más antigua no mitigada.")
tagUnicorn    = input.bool(true, "Marcar Unicorn (zona con FVG solapado)", group=gZon, tooltip="Modelo Unicorn de ICT: un Order Block que CONTIENE un Fair Value Gap. La confluencia de desequilibrio de órdenes + desequilibrio de precio es el POI de mayor probabilidad del modelo.")

// ── ③ Señales y riesgo ────────────────────────────────────────────────────────────────────────
showSignals   = input.bool(true, "Señales de entrada en retesteo", group=gSig, tooltip="Dispara cuando el precio retorna a una zona VIVA alineada con la estructura y la vela de retesteo cierra a favor. Es la entrada del modelo: la ruptura identifica el POI, el retesteo lo opera.")
requireMeanTouch= input.bool(false, "Exigir toque del 50% de la zona", group=gSig, tooltip="ON: solo entra si el precio alcanzó el Consequent Encroachment. Menos señales, mejor precio medio y SL más ajustado.")
requireUnicorn= input.bool(false, "Solo operar zonas Unicorn", group=gSig, tooltip="ON: descarta toda zona sin FVG solapado. Muy restrictivo — pensado para quien prioriza precisión sobre frecuencia.")
slBufferAtr   = input.float(0.25, "Colchón de SL (× ATR)", minval=0.0, step=0.05, group=gSig, tooltip="Distancia extra por debajo (compra) o encima (venta) del borde de la zona. Protege contra el barrido de stops pegado al borde exacto.")
tp1R          = input.float(1.0, "TP1 (R múltiplo)", minval=0.3, step=0.1, group=gSig)
tp2R          = input.float(2.0, "TP2 (R múltiplo)", minval=0.5, step=0.1, group=gSig)
sigCooldown   = input.int(5, "Barras mínimas entre señales", minval=0, maxval=100, group=gSig)
riskPerTrade  = input.float(200.0, "Riesgo por operación ($)", minval=1.0, step=25.0, group=gSig, tooltip="Para calcular el tamaño sugerido en el payload de alerta.")
tickValue     = input.float(0.50, "Valor del tick ($)", minval=0.01, step=0.01, group=gSig, tooltip="MNQ = 0.50 $ por tick de 0.25. MES = 1.25 $ por tick de 0.25. Ajústalo a tu instrumento.")
tickSizeIn    = input.float(0.25, "Tamaño del tick", minval=0.0001, step=0.01, group=gSig)

// ── ④ Contexto ────────────────────────────────────────────────────────────────────────────────
useHTF        = input.bool(true, "Filtrar por sesgo HTF", group=gCtx, tooltip="Solo admite señales a favor de la tendencia del marco superior. El sesgo se lee con [1] + lookahead_on: el patrón canónico ANTI-REPINTADO (toma la vela HTF ya CERRADA, nunca la que está formándose).")
htfMode       = input.string("Auto", "Marco superior", options=["Auto", "Manual"], group=gCtx)
htfManual     = input.timeframe("60", "HTF manual", group=gCtx)
useSession    = input.bool(true, "Filtrar por sesión", group=gCtx, tooltip="Restringe las señales a la ventana horaria de mayor participación institucional. Fuera de ella el flujo es de creadores de mercado y los POI fallan más.")
sessWindow    = input.session("0830-1130", "Sesión (hora de Nueva York)", group=gCtx, tooltip="0830-1130 NY = solape Londres/NY + primera hora de NY (Kill Zone). 0200-0500 para la sesión de Londres.")
showSessBG    = input.bool(false, "Sombrear la sesión", group=gCtx)

// ── ⑤ Visual ──────────────────────────────────────────────────────────────────────────────────
colBull       = input.color(color.new(#00E676, 78), "Zona alcista", group=gVis, inline="cb")
colBullBr     = input.color(#00E676, "Borde alcista", group=gVis, inline="cb")
colBear       = input.color(color.new(#FF5252, 78), "Zona bajista", group=gVis, inline="cs")
colBearBr     = input.color(#FF5252, "Borde bajista", group=gVis, inline="cs")
colMitig      = input.color(color.new(#78909C, 90), "Zona mitigada", group=gVis)
colZZ         = input.color(color.new(#90A4AE, 35), "ZigZag", group=gVis)
txtSize       = input.string(size.tiny, "Tamaño de texto", options=[size.tiny, size.small, size.normal], group=gVis)
showDash      = input.bool(true, "Mostrar dashboard", group=gVis)
dashPos       = input.string("Arriba derecha", "Posición", options=["Arriba derecha", "Abajo derecha", "Abajo izquierda"], group=gVis)

// ── ⑥ Alertas ─────────────────────────────────────────────────────────────────────────────────
alertOnZone   = input.bool(true, "Alertar al entrar en una zona", group=gAlr)
zoneAlertGap  = input.int(10, "Barras mínimas entre alertas de la misma zona", minval=1, maxval=200, group=gAlr)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ FUNCIONES
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Ancla institucional del Order Block: la ÚLTIMA vela de color OPUESTO al impulso antes de la
// ruptura — no el extremo del swing. Debe tener cuerpo real (no un doji: un OB nace de un
// desequilibrio de órdenes) y no ser climática (un rango extremo es capitulación, no acumulación).
// Si no encuentra ninguna válida en la ventana devuelve el fallback (el extremo del leg).
// Recibe atrVal por parámetro porque una función en Pine solo puede leer globales ya declaradas.
f_originOffset(bool bullish, int maxBars, int fallback, float minBodyAtr, float maxRangeAtr, float atrVal) =>
    int idx = fallback
    for k = 1 to maxBars
        bool opposite    = bullish ? close[k] < open[k] : close[k] > open[k]
        bool realBody    = math.abs(close[k] - open[k]) >= atrVal * minBodyAtr
        bool notClimactic= maxRangeAtr <= 0 or (high[k] - low[k]) < atrVal * maxRangeAtr
        if opposite and realBody and notClimactic
            idx := k
            break
    idx

f_htfBias() =>
    float ef = ta.ema(close, 21)
    float es = ta.ema(close, 50)
    close > ef and ef > es ? 1 : close < ef and ef < es ? -1 : 0

f_payload(string name, float entry, float sl, float tp1, float tp2, int qty) =>
    '{"signal":"' + name + '","ticker":"' + syminfo.ticker + '","tf":"' + timeframe.period +
      '","entry":' + str.tostring(entry, format.mintick) + ',"sl":' + str.tostring(sl, format.mintick) +
      ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) +
      ',"qty":' + str.tostring(qty) + '}'

// ── Métodos de Zone ───────────────────────────────────────────────────────────────────────────
method extendTo(Zone z, int rightBar) =>
    if not na(z.id)
        box.set_right(z.id, rightBar)
    if not na(z.mid)
        line.set_x2(z.mid, rightBar)

method destroy(Zone z) =>
    if not na(z.id)
        box.delete(z.id)
    if not na(z.mid)
        line.delete(z.mid)

method tagText(Zone z) =>
    string core = z.kind == "BB" ? "BB" : z.kind == "MB" ? "MB" : "OB"
    string dir  = z.isBull ? "Bull " : "Bear "
    string uni  = z.hasFVG and tagUnicorn ? " 🦄" : ""
    string flip = z.flipped ? " ⇄" : ""
    dir + core + uni + flip

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ CÁLCULOS BASE
// ═══════════════════════════════════════════════════════════════════════════════════════════════

float atr    = ta.atr(14)
float avgVol = ta.sma(volume, 20)
bool  hasVol = not na(avgVol) and avgVol > 0        // feeds sin volumen (algunos índices/forex)
float bodySz = math.abs(close - open)
bool  isBullBar = close > open
bool  isBearBar = close < open

// Sesgo HTF — patrón canónico anti-repintado: se pide la vela HTF YA CERRADA ([1]) y se permite
// lookahead para que esa vela cerrada llegue a su barra correcta del gráfico. Sin el [1],
// lookahead_on sí sería mirar al futuro; con él, es el único modo de no repintar el sesgo.
string htfAuto = not timeframe.isintraday ? "W" : timeframe.multiplier <= 1 ? "15" : timeframe.multiplier <= 5 ? "60" : timeframe.multiplier <= 15 ? "240" : "D"
string htfUse  = htfMode == "Auto" ? htfAuto : htfManual
htfBiasRaw     = request.security(syminfo.tickerid, htfUse, f_htfBias()[1], lookahead=barmerge.lookahead_on)
int    htfBias = useHTF ? nz(htfBiasRaw) : 0

bool inSession = not useSession or not na(time(timeframe.period, sessWindow, "America/New_York"))
bgcolor(showSessBG and inSession ? color.new(#FFD700, 95) : na, title="Sesión")

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ MOTOR DE PIVOTES (ZigZag confirmado — sin repintado)
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ta.pivothigh(src, left, right) devuelve el valor del pivote en la barra [right] SOLO cuando las
// `right` barras posteriores ya lo confirmaron. Es una confirmación de DOS LADOS: a diferencia del
// `high >= ta.highest(len)` del original, no puede ser cierta en un tick y falsa en el siguiente.
// El candado barstate.isconfirmed cierra el hueco restante: la última de esas `right` barras es la
// vela en curso, y su high todavía puede crecer dentro de la misma vela.

float pvH = ta.pivothigh(high, pivLen, pivLen)
float pvL = ta.pivotlow(low,  pivLen, pivLen)

var float h0  = na          // último pivote alto confirmado
var float h1  = na          // el anterior
var int   h0i = na
var int   h1i = na
var float l0  = na
var float l1  = na
var int   l0i = na
var int   l1i = na
var int   zzDir = 0         // -1 = el último pivote fue un MÁXIMO · +1 = fue un MÍNIMO
var line  zzSeg = na

bool newHigh = false
bool newLow  = false

if not na(pvH) and barstate.isconfirmed
    int pIdx = bar_index - pivLen
    if zzDir == -1
        // Dos máximos seguidos sin mínimo en medio: no son dos pivotes, es el mismo cúmulo de
        // liquidez. Regla zigzag → nos quedamos con el extremo y estiramos el segmento vigente.
        if pvH > h0
            h0  := pvH
            h0i := pIdx
            if showZigZag and not na(zzSeg)
                line.set_xy2(zzSeg, pIdx, pvH)
    else
        h1  := h0
        h1i := h0i
        h0  := pvH
        h0i := pIdx
        zzDir := -1
        newHigh := true
        if showZigZag and not na(l0i)
            zzSeg := line.new(l0i, l0, pIdx, pvH, color=colZZ, width=1)

if not na(pvL) and barstate.isconfirmed
    int pIdx = bar_index - pivLen
    if zzDir == 1
        if pvL < l0
            l0  := pvL
            l0i := pIdx
            if showZigZag and not na(zzSeg)
                line.set_xy2(zzSeg, pIdx, pvL)
    else
        l1  := l0
        l1i := l0i
        l0  := pvL
        l0i := pIdx
        zzDir := 1
        newLow := true
        if showZigZag and not na(h0i)
            zzSeg := line.new(h0i, h0, pIdx, pvL, color=colZZ, width=1)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ RUPTURA DE ESTRUCTURA (BOS / CHoCH)
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// [R7] El original llamaba "MSB" a todo. BOS y CHoCH son eventos OPUESTOS:
//   · BOS   (Break of Structure)     — el precio rompe en la MISMA dirección del régimen vigente.
//                                      Confirma continuación. Se opera a favor.
//   · CHoCH (Change of Character)    — rompe CONTRA el régimen. Es el primer aviso de que la
//                                      tendencia terminó. Se opera la reversión, con más cautela.
// [R8] La ruptura se evalúa sobre el CIERRE contra el nivel del pivote ya confirmado, no esperando
// al pivote siguiente: el evento llega pivLen barras antes sin perder un gramo de rigor.
// El flag `crossed` sustituye al truco de comparar floats con ta.valuewhen: un nivel gasta su
// evento UNA vez y se rearma solo cuando nace un nivel estructural nuevo. Si la ruptura llega
// durante el cooldown o sin desplazamiento, el evento queda PENDIENTE en vez de perderse.

var int  structTrend = 0
var bool hiCrossed   = false
var bool loCrossed   = false
var int  lastBreakBar= -999

if newHigh
    hiCrossed := false
if newLow
    loCrossed := false

float legRange = not na(h0) and not na(l0) ? math.abs(h0 - l0) : na

bool bufferUp = na(legRange) or legRange <= 0 or breakBufferFib <= 0 ? true : (close - h0) >= legRange * breakBufferFib
bool bufferDn = na(legRange) or legRange <= 0 or breakBufferFib <= 0 ? true : (l0 - close) >= legRange * breakBufferFib
bool dispUp   = not useDisplacement or (bodySz >= atr * dispAtrMult and isBullBar)
bool dispDn   = not useDisplacement or (bodySz >= atr * dispAtrMult and isBearBar)
bool volOK    = not useVolBreak or not hasVol or volume >= avgVol * volBreakMult
bool coolOK   = (bar_index - lastBreakBar) >= bosCooldown

bool breakUp = barstate.isconfirmed and not na(h0) and close > h0 and not hiCrossed and bufferUp and dispUp and volOK and coolOK
bool breakDn = barstate.isconfirmed and not na(l0) and close < l0 and not loCrossed and bufferDn and dispDn and volOK and coolOK

bool bosUp   = false
bool bosDn   = false
bool chochUp = false
bool chochDn = false

// El leg que FALLÓ decide la naturaleza de la zona que nace del CHoCH:
//   · si el mínimo del leg barrió el mínimo anterior (l0 < l1) hubo toma de liquidez → BREAKER.
//   · si no lo barrió (mínimo más alto, fracaso al extender) → MITIGATION BLOCK.
// Es la distinción ICT que el original insinuaba con `text = l0 < l1 ? "Bu-BB" : "Bu-MB"`.
string newZoneKind = "OB"

if breakUp
    if structTrend == 1
        bosUp := true
    else
        chochUp := true
        newZoneKind := (not na(l1) and not na(l0) and l0 < l1) ? "BB" : "MB"
    structTrend  := 1
    hiCrossed    := true
    lastBreakBar := bar_index

if breakDn
    if structTrend == -1
        bosDn := true
    else
        chochDn := true
        newZoneKind := (not na(h1) and not na(h0) and h0 > h1) ? "BB" : "MB"
    structTrend  := -1
    loCrossed    := true
    lastBreakBar := bar_index

// ── Strong / Weak High-Low ────────────────────────────────────────────────────────────────────
// No toda la liquidez vale lo mismo. STRONG HIGH = máximo que el precio intentó y NO rompió
// (estructura bajista): las órdenes acumuladas encima siguen intactas, es el imán real. WEAK HIGH
// = máximo ya barrido (estructura alcista): su liquidez fue consumida, perseguirlo es perseguir un
// pozo vacío. Regla operativa: se opera EN DIRECCIÓN del extremo Strong.
bool isStrongHigh = structTrend == -1
bool isStrongLow  = structTrend == 1

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ FVG (solo para etiquetar zonas Unicorn)
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Se exige que la vela de desplazamiento CIERRE más allá del hueco: un gap abierto por una mecha
// sin cierre desplazado es ruido de subasta, no un desequilibrio de precio que deba rebalancearse.
bool fvgBull = low > high[2] and close[1] > high[2] and (low - high[2]) > atr * 0.15
bool fvgBear = high < low[2] and close[1] < low[2]  and (low[2] - high) > atr * 0.15
var float fvgBullTop = na
var float fvgBullBot = na
var float fvgBearTop = na
var float fvgBearBot = na
if fvgBull and barstate.isconfirmed
    fvgBullTop := low
    fvgBullBot := high[2]
if fvgBear and barstate.isconfirmed
    fvgBearTop := low[2]
    fvgBearBot := high

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ CREACIÓN DE ZONAS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

var array<Zone> zones = array.new<Zone>()

f_zoneColors(bool isBull) =>
    [isBull ? colBull : colBear, isBull ? colBullBr : colBearBr]

if (breakUp or breakDn) and showZones
    bool  bull     = breakUp
    // Fallback: el extremo del leg (el pivote opuesto). Si aún no existe, la barra anterior.
    // El fallback se acota a la ventana de búsqueda: un pivote muy antiguo produciría un
    // high[off] fuera del historial accesible (max_bars_back) y una caja absurdamente ancha.
    int   fbRaw    = bull ? (na(l0i) ? 1 : bar_index - l0i) : (na(h0i) ? 1 : bar_index - h0i)
    int   fbIdx    = math.min(obSearchBars, math.max(1, fbRaw))
    int   off      = f_originOffset(bull, obSearchBars, fbIdx, obMinBodyAtr, obMaxRangeAtr, atr)
    float zTop     = high[off]
    float zBot     = low[off]
    float zMean    = (zTop + zBot) / 2.0

    // Unicorn: ¿el FVG vivo del mismo lado SOLAPA realmente la zona? (intersección, no vecindad)
    bool uni = false
    if bull and not na(fvgBullTop)
        uni := fvgBullBot <= zTop and fvgBullTop >= zBot
    if not bull and not na(fvgBearTop)
        uni := fvgBearBot <= zTop and fvgBearTop >= zBot

    [bg, br] = f_zoneColors(bull)
    // Constructor con argumentos nombrados: los campos de objeto (box/line) quedan en na por
    // defecto y se rellenan justo después, sin depender del orden posicional de los campos.
    Zone z = Zone.new(top = zTop, bottom = zBot, mean = zMean, isBull = bull, birthBar = bar_index,
                      kind = newZoneKind, mitigated = false, halfHit = false, flipped = false,
                      hasFVG = uni, lastAlertBar = -999)
    z.id  := box.new(bar_index - off, zTop, bar_index + 10, zBot, bgcolor=bg, border_color=br,
                     text=z.tagText(), text_color=br, text_halign=text.align_right, text_size=txtSize)
    if showMean
        z.mid := line.new(bar_index - off, zMean, bar_index + 10, zMean, color=color.new(br, 45), style=line.style_dotted, width=1)
    zones.push(z)

    // Tope global: se descarta la más antigua. Se prefiere sacrificar una ya mitigada.
    if zones.size() > maxZones
        int victim = 0
        for vi = 0 to zones.size() - 1
            Zone zv = zones.get(vi)
            if zv.mitigated
                victim := vi
                break
        Zone dead = zones.get(victim)
        dead.destroy()
        zones.remove(victim)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ CICLO DE VIDA DE LAS ZONAS
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// [R3] Se recorre por ÍNDICE DESCENDENTE y se elimina exactamente el índice evaluado. El original
// iteraba con `for x in arr` y llamaba array.shift() — borraba el elemento 0, no el evaluado, y
// además mutaba el array que estaba recorriendo.
// [R4] Toda salida pasa por destroy(): la caja y su línea media se eliminan juntas. Nunca queda un
// objeto huérfano vivo en el gráfico.

bool  zoneEnterBull = false
bool  zoneEnterBear = false
float sigZoneTop    = na
float sigZoneBot    = na
bool  sigZoneUni    = false
bool  sigZoneMean   = false

if zones.size() > 0
    for i = zones.size() - 1 to 0
        Zone z = zones.get(i)
        bool drop = false

        // ── Caducidad: una zona que nadie tocó en toda la sesión ya no representa órdenes vivas.
        if zoneMaxAge > 0 and not z.mitigated and (bar_index - z.birthBar) > zoneMaxAge
            drop := true

        if not drop and barstate.isconfirmed
            bool violated = z.isBull ? (mitByWick ? low < z.bottom : close < z.bottom)
                                     : (mitByWick ? high > z.top   : close > z.top)

            if violated and not z.mitigated
                // [R11] Breaker: la zona rota mientras la estructura va EN CONTRA no muere —
                // invierte su papel. Un soporte perforado con estructura bajista es resistencia.
                if enableBreaker and not z.flipped and (z.isBull ? structTrend == -1 : structTrend == 1)
                    z.isBull  := not z.isBull
                    z.flipped := true
                    z.kind    := "BB"
                    z.halfHit := false
                    z.lastAlertBar := -999
                    [nbg, nbr] = f_zoneColors(z.isBull)
                    if not na(z.id)
                        box.set_bgcolor(z.id, nbg)
                        box.set_border_color(z.id, nbr)
                        box.set_text(z.id, z.tagText())
                        box.set_text_color(z.id, nbr)
                    if not na(z.mid)
                        line.set_color(z.mid, color.new(nbr, 45))
                else
                    z.mitigated := true
                    if removeMitig
                        drop := true
                    else if not na(z.id)
                        box.set_bgcolor(z.id, colMitig)
                        box.set_border_color(z.id, color.new(colMitig, 40))
                        box.set_text(z.id, z.tagText() + " ✖")
                        box.set_text_color(z.id, color.new(colMitig, 20))

            // ── Contacto con el umbral medio (Consequent Encroachment, 50%)
            if not z.mitigated and not z.halfHit and showMean
                if z.isBull ? low <= z.mean : high >= z.mean
                    z.halfHit := true
                    if not na(z.mid)
                        line.set_width(z.mid, 2)

            // ── Entrada del precio en la zona (para señal y alerta)
            if not z.mitigated
                bool inside = low <= z.top and high >= z.bottom
                bool closeOK= z.isBull ? close > z.bottom : close < z.top
                if inside and closeOK
                    bool alignOK = z.isBull ? structTrend == 1 : structTrend == -1
                    if alignOK
                        if z.isBull and not zoneEnterBull
                            zoneEnterBull := true
                            sigZoneTop  := z.top
                            sigZoneBot  := z.bottom
                            sigZoneUni  := z.hasFVG
                            sigZoneMean := z.halfHit
                        if not z.isBull and not zoneEnterBear
                            zoneEnterBear := true
                            sigZoneTop  := z.top
                            sigZoneBot  := z.bottom
                            sigZoneUni  := z.hasFVG
                            sigZoneMean := z.halfHit
                    // [R6] Una alerta por ENTRADA, no una por barra dentro de la zona.
                    if alertOnZone and (bar_index - z.lastAlertBar) >= zoneAlertGap
                        z.lastAlertBar := bar_index
                        alert("MSB-OB Pro · precio en zona " + z.tagText() + " (" +
                              str.tostring(z.bottom, format.mintick) + " – " + str.tostring(z.top, format.mintick) + ")",
                              alert.freq_once_per_bar_close)

        if drop
            z.destroy()
            zones.remove(i)
        else
            z.extendTo(bar_index + 10)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ SEÑALES DE ENTRADA
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Modelo: la RUPTURA identifica el POI, el RETESTEO lo opera. Entrar en la vela de ruptura es
// perseguir precio; el retorno a la zona ofrece un stop definido y estructuralmente defendible.

var int lastSigBar = -999
bool sigCoolOK = (bar_index - lastSigBar) >= sigCooldown

bool htfOKBull = not useHTF or htfBias >= 0
bool htfOKBear = not useHTF or htfBias <= 0
bool meanOK    = not requireMeanTouch or sigZoneMean
bool uniOK     = not requireUnicorn or sigZoneUni

bool buySignal  = showSignals and barstate.isconfirmed and zoneEnterBull and isBullBar and inSession and htfOKBull and meanOK and uniOK and sigCoolOK
bool sellSignal = showSignals and barstate.isconfirmed and zoneEnterBear and isBearBar and inSession and htfOKBear and meanOK and uniOK and sigCoolOK

if buySignal or sellSignal
    lastSigBar := bar_index

float sigEntry = close
float sigSL    = buySignal  ? math.min(sigZoneBot, low)  - atr * slBufferAtr :
                 sellSignal ? math.max(sigZoneTop, high) + atr * slBufferAtr : na
float sigRisk  = na(sigSL) ? na : math.abs(sigEntry - sigSL)
float sigTP1   = na(sigRisk) ? na : buySignal ? sigEntry + sigRisk * tp1R : sigEntry - sigRisk * tp1R
float sigTP2   = na(sigRisk) ? na : buySignal ? sigEntry + sigRisk * tp2R : sigEntry - sigRisk * tp2R
int   sigQty   = na(sigRisk) or sigRisk <= 0 or tickSizeIn <= 0 ? 0 :
                 math.max(1, int(math.floor(riskPerTrade / math.max(sigRisk / tickSizeIn * tickValue, 0.01))))

if buySignal or sellSignal
    color cSig = buySignal ? colBullBr : colBearBr
    label.new(bar_index, buySignal ? low : high,
              (buySignal ? "▲ BUY" : "▼ SELL") + (sigZoneUni ? " 🦄" : "") + "\n" + str.tostring(sigQty) + "c",
              color=color.new(cSig, 12), textcolor=color.white,
              style=buySignal ? label.style_label_up : label.style_label_down, size=size.small)
    line.new(bar_index, sigSL,  bar_index + 14, sigSL,  color=color.new(#FF5252, 25), style=line.style_dashed, width=1)
    line.new(bar_index, sigTP1, bar_index + 14, sigTP1, color=color.new(#00E676, 45), style=line.style_dotted, width=1)
    line.new(bar_index, sigTP2, bar_index + 14, sigTP2, color=color.new(#00E676, 25), width=1)
    alert(f_payload(buySignal ? "MSBOB_BUY" : "MSBOB_SELL", sigEntry, sigSL, sigTP1, sigTP2, sigQty), alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ VISUALES DE ESTRUCTURA
// ═══════════════════════════════════════════════════════════════════════════════════════════════

if bosUp
    line.new(h0i, h0, bar_index, h0, color=colBullBr, width=2)
    label.new(int(math.avg(h0i, bar_index)), h0, "BOS", color=color.new(color.black, 100), textcolor=colBullBr, style=label.style_label_down, size=size.small)
if bosDn
    line.new(l0i, l0, bar_index, l0, color=colBearBr, width=2)
    label.new(int(math.avg(l0i, bar_index)), l0, "BOS", color=color.new(color.black, 100), textcolor=colBearBr, style=label.style_label_up, size=size.small)
if chochUp
    line.new(h0i, h0, bar_index, h0, color=colBullBr, width=2, style=line.style_dashed)
    label.new(int(math.avg(h0i, bar_index)), h0, "CHoCH", color=color.new(colBullBr, 15), textcolor=color.black, style=label.style_label_down, size=size.small)
if chochDn
    line.new(l0i, l0, bar_index, l0, color=colBearBr, width=2, style=line.style_dashed)
    label.new(int(math.avg(l0i, bar_index)), l0, "CHoCH", color=color.new(colBearBr, 15), textcolor=color.black, style=label.style_label_up, size=size.small)

var line  swHiLn = na
var line  swLoLn = na
var label swHiLb = na
var label swLoLb = na

if barstate.islast and showStrongWeak and not na(h0) and not na(l0)
    line.delete(swHiLn)
    line.delete(swLoLn)
    label.delete(swHiLb)
    label.delete(swLoLb)
    color cHi = isStrongHigh ? color.white : color.new(#787B86, 25)
    color cLo = isStrongLow  ? color.white : color.new(#787B86, 25)
    swHiLn := line.new(bar_index - 45, h0, bar_index + 10, h0, color=cHi, width=1, style=isStrongHigh ? line.style_solid : line.style_dotted)
    swLoLn := line.new(bar_index - 45, l0, bar_index + 10, l0, color=cLo, width=1, style=isStrongLow  ? line.style_solid : line.style_dotted)
    swHiLb := label.new(bar_index + 10, h0, isStrongHigh ? "STRONG HIGH" : "weak high", color=color.new(color.black, 100), textcolor=cHi, style=label.style_label_left, size=size.tiny)
    swLoLb := label.new(bar_index + 10, l0, isStrongLow  ? "STRONG LOW"  : "weak low",  color=color.new(color.black, 100), textcolor=cLo, style=label.style_label_left, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════════════════════

if showDash and barstate.islast
    var table dash = table.new(dashPos == "Arriba derecha" ? position.top_right : dashPos == "Abajo derecha" ? position.bottom_right : position.bottom_left,
                               2, 7, bgcolor=color.new(#0D1117, 8), border_width=1, border_color=color.new(color.gray, 75))
    int liveZones = 0
    int uniZones  = 0
    if zones.size() > 0
        for di = 0 to zones.size() - 1
            Zone zd = zones.get(di)
            if not zd.mitigated
                liveZones += 1
                if zd.hasFVG
                    uniZones += 1

    table.cell(dash, 0, 0, "MSB-OB PRO", text_color=#FFD700, bgcolor=#161B22, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.white, bgcolor=#161B22, text_size=size.small)

    table.cell(dash, 0, 1, "Estructura", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, structTrend == 1 ? "ALCISTA 🟢" : structTrend == -1 ? "BAJISTA 🔴" : "SIN DEFINIR ⚪",
               text_color=structTrend == 1 ? #00E676 : structTrend == -1 ? #FF5252 : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 2, "Sesgo HTF (" + (useHTF ? htfUse : "off") + ")", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, not useHTF ? "—" : htfBias == 1 ? "ALCISTA 🟢" : htfBias == -1 ? "BAJISTA 🔴" : "NEUTRO ⚪",
               text_color=htfBias == 1 ? #00E676 : htfBias == -1 ? #FF5252 : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 3, "Zonas vivas", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(liveZones) + " / " + str.tostring(zones.size()) + (uniZones > 0 ? "  🦄" + str.tostring(uniZones) : ""),
               text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 4, "Máximo estructural", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, na(h0) ? "—" : str.tostring(h0, format.mintick) + (isStrongHigh ? "  STRONG" : "  weak"),
               text_color=isStrongHigh ? color.white : color.new(color.gray, 20), text_size=size.tiny)

    table.cell(dash, 0, 5, "Mínimo estructural", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, na(l0) ? "—" : str.tostring(l0, format.mintick) + (isStrongLow ? "  STRONG" : "  weak"),
               text_color=isStrongLow ? color.white : color.new(color.gray, 20), text_size=size.tiny)

    table.cell(dash, 0, 6, "Sesión", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, not useSession ? "sin filtro" : inSession ? "ACTIVA 🟢" : "fuera ⚪",
               text_color=inSession ? #00E676 : color.gray, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ██ ALERTAS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

alertcondition(bosUp,   title="BOS alcista",    message="{{ticker}} {{interval}} · BOS ALCISTA — continuación confirmada @ {{close}}")
alertcondition(bosDn,   title="BOS bajista",    message="{{ticker}} {{interval}} · BOS BAJISTA — continuación confirmada @ {{close}}")
alertcondition(chochUp, title="CHoCH alcista",  message="{{ticker}} {{interval}} · CHoCH ALCISTA — posible fin de la tendencia bajista @ {{close}}")
alertcondition(chochDn, title="CHoCH bajista",  message="{{ticker}} {{interval}} · CHoCH BAJISTA — posible fin de la tendencia alcista @ {{close}}")
alertcondition(breakUp or breakDn, title="Cualquier ruptura de estructura", message="{{ticker}} {{interval}} · Ruptura de estructura @ {{close}}")
alertcondition(buySignal,  title="🎯 BUY (retesteo de zona)",  message="{{ticker}} {{interval}} · BUY en retesteo de zona @ {{close}}")
alertcondition(sellSignal, title="🎯 SELL (retesteo de zona)", message="{{ticker}} {{interval}} · SELL en retesteo de zona @ {{close}}")
